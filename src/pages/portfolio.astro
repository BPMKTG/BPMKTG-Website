---
import Layout from '../layouts/Layout.astro';
import BookCall from '../components/BookCall.astro';
import OnFilm from '../components/OnFilm.astro';
import { Image, getImage } from 'astro:assets';

// Page hero (kept as a direct import for the eager-loaded background)
import heroImg from '../assets/images/portfolio/portfolio-hero-theresistance-grimefest.jpg';

// Explicit imports for the Access featured row
import mgWickedOaks  from '../assets/images/carousel/carousel-martingarrix-wickedoaks.jpg';
import fluxDoctorP   from '../assets/images/carousel/carousel-flux-doctorp-rv.jpg';
import wooliAP       from '../assets/images/carousel/carousel-wooli-alienpark-backstage.jpg';
import atliens       from '../assets/images/carousel/carousel-atliens-sidestage.jpg';
import subLevelUp    from '../assets/images/carousel/carousel-subtronics-levelup.jpg';

// Glob every image folder — gallery shows everything we've shot
const heroGlob       = import.meta.glob<{ default: ImageMetadata }>('../assets/images/hero/*.jpg',        { eager: true });
const bgGlob         = import.meta.glob<{ default: ImageMetadata }>('../assets/images/backgrounds/*.jpg', { eager: true });
const carouselGlob   = import.meta.glob<{ default: ImageMetadata }>('../assets/images/carousel/*.jpg',    { eager: true });
const portfolioGlob  = import.meta.glob<{ default: ImageMetadata }>('../assets/images/portfolio/*.jpg',   { eager: true });

// Featured Access row — 5 cards, captions use · as the separator
const featured = [
  { src: mgWickedOaks, caption: 'Martin Garrix',            tag: 'Onstage · Wicked Oaks' },
  { src: fluxDoctorP,  caption: 'Flux Pavilion X Doctor P', tag: 'Artist Trailer · Wicked Oaks' },
  { src: wooliAP,      caption: 'Wooli X Alien Park',       tag: 'Backstage · Silo Dallas' },
  { src: atliens,      caption: 'ATLiens',                  tag: 'Sidestage · Dancefestopia' },
  { src: subLevelUp,   caption: 'Subtronics X Level Up',    tag: 'Sidestage · Dancefestopia' },
];

// Build a slug -> ImageMetadata lookup across every folder
const allFolders = { ...heroGlob, ...bgGlob, ...carouselGlob, ...portfolioGlob };
const imageBySlug: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(allFolders)) {
  const slug = path.split('/').pop()!.replace(/\.jpg$/, '');
  imageBySlug[slug] = mod.default;
}

// Explicit gallery order — left to right, top to bottom, like a book.
// Each entry has the file slug, big-text caption (uppercased via CSS),
// and small blue tag. Order and captions per the curated 54-tile spec
// (duplicate Neotek removed; several adjacencies reshuffled).
const galleryOrder: { slug: string; caption: string; tag: string }[] = [
  { slug: 'hero-4-martingarrix-wickedoaks',             caption: 'Martin Garrix',             tag: 'Wicked Oaks' },
  { slug: 'portfolio-hero-theresistance-grimefest',     caption: 'The Resistance',            tag: 'Grimefest' },
  { slug: 'hero-1-excision-magenta-713',                caption: 'Excision',                  tag: '713 Music Hall - Houston' },
  { slug: 'atliens-dft-sidestage',                      caption: 'ATLiens',                   tag: 'Sidestage - DFT' },
  { slug: 'martingarrix-onstage-pyro',                  caption: 'Martin Garrix',             tag: 'Wicked Oaks' },
  { slug: 'hero-3-grimefest-crowd-lightsaber',          caption: 'The Crowd',                 tag: 'Grimefest' },
  { slug: 'carousel-subtronics-red',                    caption: 'Subtronics',                tag: 'Dancefestopia' },
  { slug: 'hero-2-alienpark-green-silo',                caption: 'Alien Park',                tag: 'Silo - Dallas' },
  { slug: 'bg-1-svddendeath-red-wickedoaks',            caption: 'Svdden Death - Voyd',       tag: 'Wicked Oaks' },
  { slug: 'svddendeath-productionteam-screaming',       caption: 'Svdden Death Production',   tag: 'FOH - Wicked Oaks' },
  { slug: 'wankdat-wooli-crankdat-dancefestopia',       caption: 'Wankdat - Wooli + Crankdat',tag: 'Dancefestopia' },
  { slug: 'carousel-fireworks-dft',                     caption: 'Level Up',                  tag: 'Dancefestopia' },
  { slug: 'carousel-sanpacho-redlasers',                caption: 'San Pacho',                 tag: 'Silo - Dallas' },
  { slug: 'carousel-ahee-crowd',                        caption: 'AHEE',                      tag: 'Dancefestopia' },
  { slug: 'carousel-allthereason-graffiti',             caption: 'All The Reason',            tag: 'Vulcan Gas Co.' },
  { slug: 'carousel-levelup-wide',                      caption: 'Level Up',                  tag: 'Dancefestopia' },
  { slug: 'carousel-wooliees-silo',                     caption: 'Wooli',                     tag: 'Silo - Dallas' },
  { slug: 'carousel-sanpacho-selfie',                   caption: 'San Pacho',                 tag: 'Silo - Dallas' },
  { slug: 'yookie-grimefest-bassface',                  caption: 'Yookie',                    tag: 'Grimefest' },
  { slug: 'blankface-b2b-sqishi-grimefest',             caption: 'Blankface B2B Sqishi',      tag: 'Grimefest' },
  { slug: 'neotek-silo-onstage',                        caption: 'Neotek',                    tag: 'Silo - Dallas' },
  { slug: 'martingarrix-wickedoaks-festivalstage-pyro', caption: 'Martin Garrix',             tag: 'Wicked Oaks' },
  { slug: 'laurenmia-fluffycloud-silo',                 caption: 'Lauren Mia X Fluffy Cloud', tag: 'Silo - Dallas' },
  { slug: 'svddendeath-productionteam-foh',             caption: 'Svdden Death Production',   tag: 'Wicked Oaks' },
  { slug: 'subtronics-dancefestopia',                   caption: 'Subtronics',                tag: 'Dancefestopia' },
  { slug: 'carousel-sanpacho-yellowred',                caption: 'San Pacho',                 tag: 'Silo Dallas' },
  { slug: 'carousel-yookie-grimefest',                  caption: 'Yookie',                    tag: 'Grimefest' },
  { slug: 'rzrkt-drinkurwater-vulcangasco',             caption: 'Rzrkt X Drinkurwater',      tag: 'Vulcan Gas Co.' },
  { slug: 'automhate-grimefest',                        caption: 'Automhate',                 tag: 'Grimefest' },
  { slug: 'bg-2-perrywayne-purple-dft',                 caption: 'Perry Wayne',               tag: 'Dancefestopia' },
  { slug: 'sqishi-grimefest-beer',                      caption: 'Sqishi',                    tag: 'Grimefest' },
  { slug: 'alienpark-dft',                              caption: 'Alien Park',                tag: 'Dancefestopia' },
  { slug: 'ognixin-grimefest',                          caption: 'OG Nixin',                  tag: 'Grimefest' },
  { slug: 'izzyvadim-grimefest-wideangle',              caption: 'Izzy Vadim',                tag: 'Grimefest' },
  { slug: 'adventureclub-silo',                         caption: 'Adventure Club',            tag: 'Silo - Dallas' },
  { slug: 'ahee-dft',                                   caption: 'AHEE',                      tag: 'Dancefestopia' },
  { slug: 'izyyvadim-grimefest-smoking',                caption: 'Izzy Vadim',                tag: 'Grimefest' },
  { slug: 'carousel-martingarrix-freakyducky',          caption: 'Martin Garrix',             tag: 'Wicked Oaks' },
  { slug: 'blankface-b2b-sqishi-surprised-grimefest',   caption: 'Blankface B2B Sqishi',      tag: 'Grimefest' },
  { slug: 'svddendeath-wickedoaks',                     caption: 'Svdden Death - Voyd',       tag: 'Wicked Oaks' },
  { slug: 'spira-toatsatx',                             caption: 'Spira',                     tag: 'Toats - Austin' },
  { slug: 'ahee-managment-dft-backstage',               caption: 'AHEE Management',           tag: 'Backstage - DFT' },
  { slug: 'neotek-silo',                                caption: 'Neotek',                    tag: 'Silo - Dallas' },
  { slug: 'blankface-b2b-sqishi-grimefest-blue',        caption: 'Blankface B2B Sqishi',      tag: 'Grimefest' },
  { slug: 'crowd-grimefest',                            caption: 'The Crowd',                 tag: 'Grimefest' },
  { slug: 'crowd-alienpark-dft',                        caption: 'The Crowd - Alien Park',    tag: 'Dancefestopia' },
  { slug: 'alienpark-silo',                             caption: 'Alien Park',                tag: 'Silo - Dallas' },
  { slug: 'dancefestopia',                              caption: 'Emerald Stage',             tag: 'Dancefestopia' },
  { slug: 'svddendeath-productionteam-lasers-pyro',     caption: 'Svdden Death Production',   tag: 'FOH - Wicked Oaks' },
  { slug: 'allthereason-vulcangasco',                   caption: 'All The Reason',            tag: 'Vulcan Gas Co.' },
  { slug: 'blankface-b2b-sqishi-grimefest-wide',        caption: 'Grimefest',                 tag: 'The Galactic Wars II' },
  { slug: 'sanpacho-silo',                              caption: 'San Pacho',                 tag: 'Silo - Dallas' },
  { slug: 'laurenmia-fluffycloud-silo-red',             caption: 'Lauren Mia X Fluffy Cloud', tag: 'Silo - Dallas' },
  { slug: 'legendofshellda-toatsatx',                   caption: 'Legend of Shellda',         tag: 'Toats - Austin' },
  { slug: 'wooli-dft-pyro-lasers',                      caption: 'Wooli',                     tag: 'Dancefestopia' },          // 55, bottom of col 3
  { slug: 'levelup-dft-bubbles',                        caption: 'Level Up',                  tag: 'Dancefestopia' },          // 56, bottom of col 4
];

const allTiles = galleryOrder
  .filter(item => imageBySlug[item.slug])
  .map(item => ({
    src: imageBySlug[item.slug],
    slug: item.slug,
    caption: item.caption,
    tag: item.tag,
  }));

// Generate larger variants for the lightbox — full crisp resolution for the
// contained full-screen view. (Earlier shrinks to 1440/1200 were chasing a
// "GPU texture" theory that turned out to be a local driver fault on one PC,
// not a real memory limit — so there's no reason to serve soft images.)
const lightboxOf = async (src: ImageMetadata) =>
  (await getImage({ src, width: 1800, format: 'webp', quality: 86 })).src;

const orientationOf = (src: ImageMetadata) => (src.width >= src.height ? 'h' : 'v');

const featuredLB = await Promise.all(
  featured.map(async f => ({ ...f, full: await lightboxOf(f.src) }))
);
const tilesLBRaw = await Promise.all(
  allTiles.map(async t => ({
    ...t,
    full: await lightboxOf(t.src),
    orient: orientationOf(t.src),
  }))
);

// Preserve the explicit user-defined order — no shuffling
const tilesLB = tilesLBRaw;
---
<Layout
  title="Portfolio | Blueprint Marketing"
  description="In The Field: Blueprint Marketing's media access across festivals, headline sets, and backstage with EDM's biggest names."
>
  <section class="portfolio-hero">
    <div class="bg" aria-hidden="true">
      <Image
        src={heroImg}
        alt="The Resistance performing at Grimefest"
        width={1600}
        height={2400}
        format="webp"
        quality={85}
        loading="eager"
        fetchpriority="high"
      />
      <div class="overlay"></div>
    </div>

    <div class="container hero-inner">
      <p class="label" data-reveal="left">In The Field</p>
      <h1 data-reveal>We don't just market EDM.<br/><span class="highlight">We live it.</span></h1>
      <p class="lede" data-reveal>
        Credentialed media access across festivals, headline sets, and backstage
        with the artists shaping the scene. The portfolio you're scrolling
        through is the proof.
      </p>
      <div class="hero-ctas" data-reveal>
        <a href="/event-media" class="button accent">
          Request Event Coverage
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="#access" class="button ghost">See the work</a>
      </div>
    </div>
  </section>

  <section class="featured-block" id="access">
    <div class="container">
      <p class="label" data-reveal="left">Access</p>
      <h2 data-reveal>Where most cameras don't get to stand.</h2>

      <div class="featured-grid" data-reveal-group>
        {featuredLB.map(f => (
          <button
            class="feat-card"
            type="button"
            data-lightbox-open
            data-tilt
            data-reveal="scale"
            data-full={f.full}
            data-caption={f.caption}
            aria-label={`Open larger view: ${f.caption}`}
          >
            <span class="img-wrap">
              <Image
                src={f.src}
                alt={f.caption}
                width={1080}
                height={1440}
                format="webp"
                quality={86}
                loading="lazy"
              />
              <span class="hover-meta">
                {(() => {
                  const [prefix, ...rest] = f.tag.split(' · ');
                  const venue = rest.join(' · ');
                  return (
                    <span class="tag">
                      <span class="tag-prefix">{prefix}{venue ? ' ·' : ''}</span>
                      {venue && <span class="tag-venue">{venue}</span>}
                    </span>
                  );
                })()}
                <strong>{f.caption}</strong>
              </span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <OnFilm />

  <section class="gallery-block">
    <div class="container">
      <header class="gallery-head">
        <p class="label" data-reveal="left">The Full Set</p>
        <h2 data-reveal>Festival floors, headline sets,<br/><span class="glow-blue">and everything between.</span></h2>
      </header>

      <div class="masonry" data-masonry>
        {tilesLB.map((tile, i) => (
          <button
            class="tile"
            type="button"
            data-lightbox-open
            data-orientation={tile.orient}
            data-full={tile.full}
            data-caption={`${tile.caption} · ${tile.tag}`}
            data-mobile-deferred={i >= 20 ? '1' : undefined}
            aria-label={`Open larger view: ${tile.caption}`}
          >
            <span class="img-wrap">
              <Image
                src={tile.src}
                alt={tile.caption}
                width={1000}
                height={1250}
                format="webp"
                quality={84}
                loading="lazy"
              />
            </span>
            <span class="caption">
              <strong>{tile.caption}</strong>
              <span>{tile.tag}</span>
            </span>
          </button>
        ))}
      </div>

      {tilesLB.length > 20 && (
        <div class="load-more-wrap" data-load-more-wrap>
          <button type="button" class="load-more" data-load-more>
            <span class="load-more-label">Load More</span>
            <span class="load-more-count">+{tilesLB.length - 20} photos</span>
            <span class="arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
        </div>
      )}
    </div>
  </section>

  <!-- Lightbox overlay -->
  <dialog class="lightbox" data-lightbox>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <button type="button" class="lightbox-arrow lightbox-prev" data-lightbox-prev aria-label="Previous photo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button type="button" class="lightbox-arrow lightbox-next" data-lightbox-next aria-label="Next photo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <figure>
      <img alt="" data-lightbox-img />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
  </dialog>

  <script>
    // Photo lightbox. Re-inits on every astro:page-load and fully tears down
    // on astro:before-swap: all listeners go through one AbortController, and
    // cleanup also closes the dialog, clears the image, releases the body
    // scroll-lock, and returns the custom cursor to <body> — so navigating
    // away (even mid-open) never leaves a lock or a stale listener behind.
    let lbInited = false;
    let lbAc: AbortController | null = null;

    const lbReleaseCursor = () => {
      const cursor = document.querySelector<HTMLElement>('.bp-cursor');
      if (cursor && cursor.parentElement !== document.body) document.body.appendChild(cursor);
    };

    const lbCleanup = () => {
      lbInited = false;
      if (lbAc) { lbAc.abort(); lbAc = null; }
      lbReleaseCursor();
      const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
      if (dialog) {
        const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]');
        if (img) img.removeAttribute('src');
        if (dialog.open) { try { dialog.close(); } catch {} }
      }
      document.body.style.overflow = '';
      document.body.style.pointerEvents = '';
    };

    const initLightbox = () => {
      if (lbInited) return;
      const dialog  = document.querySelector<HTMLDialogElement>('[data-lightbox]');
      if (!dialog) return;
      lbInited = true;
      lbAc = new AbortController();
      const signal = lbAc.signal;

      const img     = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]');
      const cap     = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
      const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
      const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]');

      const openers = Array.from(
        document.querySelectorAll<HTMLElement>('[data-lightbox-open]')
      );
      let current = -1;

      const showAt = (idx: number) => {
        if (!openers.length || !img || !cap) return;
        const n = openers.length;
        const next = ((idx % n) + n) % n;
        current = next;
        const btn = openers[next];
        img.src = btn.dataset.full || '';
        img.alt = btn.dataset.caption || '';
        // Take the lightbox image out of the global fade-in system so it can
        // never get stranded at opacity:0 (the `img[data-mx-loading]` rule):
        // the modal manages its own visibility.
        img.removeAttribute('data-mx-loading');
        img.style.opacity = '1';
        cap.textContent = btn.dataset.caption || '';
      };

      const open = (btn: HTMLElement) => {
        if (!img || !cap) return;
        // Tear down the video lightbox first — its Vimeo <iframe> is GPU-heavy,
        // and leaving it loaded while opening a photo was the tipping point for
        // image-memory exhaustion. Removing the iframe frees the video's memory.
        const vlb = document.querySelector<HTMLDialogElement>('[data-vlb]');
        if (vlb) {
          const vframe = vlb.querySelector<HTMLElement>('[data-vlb-frame]');
          if (vframe) vframe.innerHTML = '';
          if (vlb.open) { try { vlb.close(); } catch {} }
        }
        const idx = openers.indexOf(btn);
        current = idx >= 0 ? idx : 0;
        showAt(current);
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
        document.body.style.overflow = 'hidden';
        const cursor = document.querySelector<HTMLElement>('.bp-cursor');
        if (cursor) dialog.appendChild(cursor);
      };

      const close = () => {
        lbReleaseCursor();
        if (typeof dialog.close === 'function') dialog.close();
        else dialog.removeAttribute('open');
        // Safety: force-close any dialog still flagged open so none can linger
        // in the top layer intercepting clicks.
        document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach(d => {
          try { d.close(); } catch { d.removeAttribute('open'); }
        });
        document.body.style.overflow = '';
        document.body.style.pointerEvents = '';
        if (img) img.removeAttribute('src');
        current = -1;
      };

      const next = () => showAt(current + 1);
      const prev = () => showAt(current - 1);

      openers.forEach(btn => btn.addEventListener('click', () => open(btn), { signal }));

      dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', close, { signal });
      prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); prev(); }, { signal });
      nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); next(); }, { signal });

      dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); }, { signal });
      dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); }, { signal });

      // Keyboard arrow nav — removed automatically on cleanup via the signal.
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!dialog.open) return;
        if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
      }, { signal });

      // Touch swipe — >50px horizontal navigates; smaller deltas are taps.
      let touchStartX = 0;
      let touchActive = false;
      dialog.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'touch') return;
        touchStartX = e.clientX;
        touchActive = true;
      }, { signal });
      dialog.addEventListener('pointerup', (e) => {
        if (!touchActive || e.pointerType !== 'touch') return;
        touchActive = false;
        const dx = e.clientX - touchStartX;
        if (Math.abs(dx) < 50) return;
        if (dx < 0) next();
        else prev();
      }, { signal });
      dialog.addEventListener('pointercancel', () => { touchActive = false; }, { signal });
    };
    document.addEventListener('astro:before-swap', lbCleanup);
    document.addEventListener('astro:page-load', initLightbox);
    if (document.readyState !== 'loading') initLightbox();
    else document.addEventListener('DOMContentLoaded', initLightbox, { once: true });

    // ─── Load More (mobile only) ───
    // Reveals the deferred gallery tiles by flipping .is-expanded on the
    // masonry, then removes itself (everything is now visible). Bound on
    // astro:page-load + idempotently so it re-attaches when the user
    // navigates BACK to /portfolio via a view transition (the page's other
    // listeners run once at parse; without re-binding here the button went
    // dead after a navigation — the "doesn't always work" symptom).
    const initLoadMore = () => {
      const loadMore     = document.querySelector<HTMLButtonElement>('[data-load-more]');
      const masonry      = document.querySelector<HTMLElement>('[data-masonry]');
      const loadMoreWrap = document.querySelector<HTMLElement>('[data-load-more-wrap]');
      if (!loadMore || !masonry) return;
      if (loadMore.dataset.lmBound) return;   // idempotent across re-inits
      loadMore.dataset.lmBound = '1';
      loadMore.addEventListener('click', () => {
        masonry.classList.add('is-expanded');
        // All deferred tiles are now visible — retire the button entirely.
        // Inline display:none beats the mobile `.load-more-wrap { display:block }`
        // rule (which otherwise overrode the [hidden] attribute and kept it shown).
        if (loadMoreWrap) {
          loadMoreWrap.hidden = true;
          loadMoreWrap.style.display = 'none';
        }
      });
    };
    document.addEventListener('astro:page-load', initLoadMore);
    if (document.readyState !== 'loading') initLoadMore();
    else document.addEventListener('DOMContentLoaded', initLoadMore, { once: true });
  </script>

  <BookCall />
</Layout>

<style>
  .portfolio-hero {
    position: relative;
    min-height: clamp(520px, 75vh, 760px);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .bg { position: absolute; inset: 0; z-index: 0; }
  .bg :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,10,15,0.45) 0%, rgba(10,10,15,0.6) 50%, rgba(10,10,15,0.94) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding: 5rem 1.5rem;
  }
  .hero-inner h1 {
    max-width: 16ch;
    margin-top: 0.75rem;
    text-shadow: 0 4px 30px rgba(0,0,0,0.6);
  }
  .lede {
    margin-top: 1.5rem;
    color: var(--ink);
    opacity: 0.85;
    max-width: 56ch;
    font-size: 1.1rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
  }
  .hero-ctas {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .featured-block { padding: 5rem 0 2rem; }
  .featured-block h2 { margin-top: 1rem; margin-bottom: 2.5rem; max-width: 22ch; }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }
  .feat-card {
    margin: 0;
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    text-align: left;
