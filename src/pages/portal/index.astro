---
// The client portal shell.
//
// One static page serves EVERY slug: functions/portal/[slug]/index.ts
// returns this same HTML whatever is in the URL, so the markup can
// never hint at whether a client exists. Everything real arrives from
// /portal/<slug>/data after the cookie is checked, and is rendered by
// the script below.
//
// Nothing here is per-client, and nothing here may become per-client.
import PortalLayout from '../../layouts/PortalLayout.astro';
import { DIRECT_EMAIL } from '../../config/cta';

const NAV = [
  { id: 'home',     label: 'Home',     icon: 'home' },
  { id: 'calendar', label: 'Calendar', icon: 'cal' },
  { id: 'content',  label: 'Content',  icon: 'film' },
  { id: 'reports',  label: 'Reports',  icon: 'chart' },
  { id: 'files',    label: 'Files',    icon: 'folder' },
];
---

<PortalLayout title="Client Portal | Blueprint Marketing">
  {/* Icon sprite. Referenced with <use href="#pt-i-…"> from both the
      template and the script, so script-built nodes never need
      innerHTML to get an icon. */}
  <svg class="pt-visually-hidden" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="pt-i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-6h5v6"/>
      </symbol>
      <symbol id="pt-i-cal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 3v4M16 3v4"/>
      </symbol>
      <symbol id="pt-i-chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
      </symbol>
      <symbol id="pt-i-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4.3a1.5 1.5 0 0 1 1.1.5l1.3 1.5h7.3A1.5 1.5 0 0 1 20 9.5v8A1.5 1.5 0 0 1 18.5 19h-14A1.5 1.5 0 0 1 3 17.5z"/>
      </symbol>
      <symbol id="pt-i-film" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M8 5v14M16 5v14M3 12h18"/>
      </symbol>
      <symbol id="pt-i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M12 5v14M5 12h14"/>
      </symbol>
      <symbol id="pt-i-grip" viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/>
      </symbol>
      <symbol id="pt-i-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13.5a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 0 0-5.7-5.7l-1.4 1.4"/>
        <path d="M14 10.5a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 0 0 5.7 5.7l1.4-1.4"/>
      </symbol>
      <symbol id="pt-i-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/><path d="m10 8.5 6 3.5-6 3.5z"/>
      </symbol>
      <symbol id="pt-i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 5 7 7-7 7"/>
      </symbol>
      <symbol id="pt-i-chev-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 5-7 7 7 7"/>
      </symbol>
      <symbol id="pt-i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6 6 18"/>
      </symbol>
      <symbol id="pt-i-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
      </symbol>
      <symbol id="pt-i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m4 12.5 5.5 5.5L20 7"/>
      </symbol>
      <symbol id="pt-i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.6v.5"/>
      </symbol>
      <symbol id="pt-i-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 15 7-7 7 7"/>
      </symbol>
      <symbol id="pt-i-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 9 7 7 7-7"/>
      </symbol>
      <symbol id="pt-i-ticket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h13A1.5 1.5 0 0 1 20 8.5v2a2 2 0 0 0 0 3.9v2a1.5 1.5 0 0 1-1.5 1.6h-13A1.5 1.5 0 0 1 4 16.4v-2a2 2 0 0 0 0-3.9z"/>
      </symbol>
      <symbol id="pt-i-inbox" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 13h5l1.5 3h5L16 13h5"/><path d="M4.6 5.5h14.8L21 13v5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18v-5z"/>
      </symbol>
    </defs>
  </svg>

  {/* ── loading ─────────────────────────────────────────────
      A skeleton of the real Home layout, so there is no blank page
      and nothing jumps when the data lands. */}
  <div class="pt-boot" data-state="loading">
    <div class="pt-skel pt-skel-line" style="width:120px;height:10px"></div>
    <div class="pt-skel pt-skel-title" style="margin:16px 0 10px"></div>
    <div class="pt-skel pt-skel-line" style="width:180px"></div>
    <div class="pt-skel" style="height:7px;width:420px;max-width:100%;margin:28px 0 36px;border-radius:999px"></div>
    <div class="pt-grid pt-grid-4">
      <div class="pt-skel pt-skel-card"></div>
      <div class="pt-skel pt-skel-card"></div>
      <div class="pt-skel pt-skel-card"></div>
      <div class="pt-skel pt-skel-card"></div>
    </div>
    <div class="pt-grid pt-grid-2" style="margin-top:24px">
      <div class="pt-skel" style="height:220px;border-radius:14px"></div>
      <div class="pt-skel" style="height:220px;border-radius:14px"></div>
    </div>
    <span class="pt-visually-hidden" role="status">Loading your portal</span>
  </div>

  {/* ── the one failure path ────────────────────────────────
      Unknown slug, wrong key, disabled portal, expired session: every
      one of them lands here, saying nothing about which. */}
  <div class="pt-centre" data-state="missing" hidden>
    <div class="pt-missing">
      <img src="/brand/logo-header-navy.svg" alt="Blueprint Marketing" />
      <h1>This link isn't working</h1>
      <p>
        It may have expired, or it may have been copied without the full
        address. Portal links are long, and a link that gets cut in half
        stops working.
      </p>
      <p>
        Send me the link you used and I'll get you a fresh one.
        <a data-missing-mail href={`mailto:${DIRECT_EMAIL}`}>{DIRECT_EMAIL}</a>
      </p>
    </div>
  </div>

  {/* ── the app ─────────────────────────────────────────────*/}
  <div class="pt-shell" data-app hidden>
    <header class="pt-topbar">
      <a class="pt-topbar-logo" href="/" aria-label="Blueprint Marketing home">
        <img src="/brand/logo-header-navy.svg" alt="Blueprint Marketing" width="150" height="24" />
      </a>
      <span class="pt-topbar-spacer"></span>
      <span class="pt-badge" data-tier hidden></span>
      <div class="pt-identity">
        <span class="pt-avatar" data-avatar aria-hidden="true"></span>
        <span class="pt-identity-text">
          <span class="pt-identity-name" data-topname></span>
          <span class="pt-identity-tier" data-topstage></span>
        </span>
      </div>
    </header>

    <div class="pt-body">
      <nav class="pt-sidebar" aria-label="Portal sections">
        {NAV.map((n) => (
          <a class="pt-nav-item" href={`#/${n.id}`} data-nav={n.id}>
            <svg aria-hidden="true"><use href={`#pt-i-${n.icon}`} /></svg>
            {n.label}
          </a>
        ))}
        <span class="pt-nav-spacer"></span>
        <p class="pt-nav-foot">
          Something look wrong?<br />
          <a href={`mailto:${DIRECT_EMAIL}`}>{DIRECT_EMAIL}</a>
        </p>
      </nav>

      <main class="pt-main">
        <section class="pt-view" data-view="home" aria-label="Home"></section>
        <section class="pt-view" data-view="calendar" aria-label="Calendar" hidden></section>
        <section class="pt-view" data-view="content" aria-label="Content" hidden></section>
        <section class="pt-view" data-view="reports" aria-label="Reports" hidden></section>
        <section class="pt-view" data-view="files" aria-label="Files" hidden></section>
      </main>
    </div>

    <nav class="pt-tabbar" aria-label="Portal sections">
      {NAV.map((n) => (
        <a class="pt-tab" href={`#/${n.id}`} data-tab={n.id}>
          <svg aria-hidden="true"><use href={`#pt-i-${n.icon}`} /></svg>
          {n.label}
          <span class="pt-tab-dot"></span>
        </a>
      ))}
    </nav>
  </div>

  {/* ── detail drawer ───────────────────────────────────────*/}
  <div class="pt-scrim" data-scrim hidden></div>
  <aside class="pt-drawer" data-drawer role="dialog" aria-modal="true" aria-labelledby="pt-drawer-title" hidden>
    <div class="pt-drawer-head">
      <h2 id="pt-drawer-title" data-drawer-title></h2>
      <button class="pt-announce-close" data-drawer-close aria-label="Close details">
        <svg aria-hidden="true"><use href="#pt-i-close" /></svg>
      </button>
    </div>
    <div class="pt-drawer-body" data-drawer-body></div>
    <div class="pt-drawer-foot" data-drawer-foot hidden></div>
  </aside>

  {/* ── sheet: quick add, mark as posted, paste a link ───────────
      A second, smaller dialog. The drawer is for reading a card; the
      sheet is for one short answer, and on a phone it comes up from
      the bottom where a thumb already is. */}
  <div class="pt-scrim" data-sheet-scrim hidden></div>
  <div class="pt-sheet" data-sheet role="dialog" aria-modal="true" aria-labelledby="pt-sheet-title" hidden>
    <div class="pt-sheet-head">
      <h2 id="pt-sheet-title" data-sheet-title></h2>
      <button class="pt-announce-close" data-sheet-close aria-label="Close">
        <svg aria-hidden="true"><use href="#pt-i-close" /></svg>
      </button>
    </div>
    <form class="pt-sheet-body" data-sheet-body></form>
  </div>

  {/* A save either worked or it did not, and the client needs to know
      which without a dialog in their way. */}
  <div class="pt-toast" data-toast role="status" aria-live="polite" hidden></div>
</PortalLayout>

<script>
  import {
    daysUntil,
    goalProgress,
    isOpenClientTodo,
    metricLabel,
    metricPlatform,
    parseNotionDate,
    showsInMonth,
    showsPerMonthAverage,
    songsAtTarget,
    weeklyPaceNeeded,
    termProgress,
    SONG_STREAM_TARGET,
    type PortalCalendarItem,
    type PortalMoment,
    type PortalPayload,
    type PortalSnapshot,
  } from '../../data/portal';
  import {
    canClientMove,
    contentPhase,
    isIdea,
    normaliseId,
    stageOf,
    MAX_TEXT,
    MAX_TITLE,
    STAGE_ORDER,
    STAGE_TITLE,
    type ContentPhase,
    type PortalContentItem,
    type PortalContentSchema,
    type Stage,
  } from '../../data/portal-content';
  import {
    compactNumber,
    displayMetricLabel,
    formatMetricValue,
    isPercentMetric,
    metricDefinition,
    metricSection,
    sumMetrics,
    NET_FOLLOW_ROLLUP,
    SECTION_BLURB,
    SECTION_ORDER,
    SECTION_TITLE,
    VIEW_ROLLUP,
  } from '../../data/portal-labels';
  import { DIRECT_EMAIL } from '../../config/cta';

  /* ── DOM helpers ───────────────────────────────────────────────
     Everything below builds nodes and sets textContent. None of these
     values are ours: they come out of a Notion database, and a title
     pasted in from somewhere else must never be able to run as markup
     in a client's browser. There is no innerHTML in this file. */
  const el = <K extends keyof HTMLElementTagNameMap>(
    tag: K, cls?: string, text?: string,
  ): HTMLElementTagNameMap[K] => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };
  const q = <T extends HTMLElement>(sel: string, root: ParentNode = document) =>
    root.querySelector<T>(sel);
  const qq = <T extends HTMLElement>(sel: string, root: ParentNode = document) =>
    Array.from(root.querySelectorAll<T>(sel));
  const show = (n: Element | null, on: boolean) => { if (n) (n as HTMLElement).hidden = !on; };
  const clear = (n: Element | null) => { while (n && n.firstChild) n.removeChild(n.firstChild); };

  const SVGNS = 'http://www.w3.org/2000/svg';
  const svgEl = <K extends keyof SVGElementTagNameMap>(
    tag: K, attrs: Record<string, string | number> = {},
  ): SVGElementTagNameMap[K] => {
    const n = document.createElementNS(SVGNS, tag);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    return n;
  };
  /** An icon from the sprite, without innerHTML. */
  const icon = (name: string, cls?: string): SVGSVGElement => {
    const s = svgEl('svg', { 'aria-hidden': 'true', focusable: 'false' });
    if (cls) s.setAttribute('class', cls);
    const u = svgEl('use');
    u.setAttribute('href', `#pt-i-${name}`);
    s.appendChild(u);
    return s;
  };

  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  const fmtDate = (iso: string | null) => {
    const d = parseNotionDate(iso);
    return d ? `${MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}, ${d.getFullYear()}` : '';
  };
  /** "Jan 30", for a sentence that already says which year it means. */
  const fmtDateShort = (iso: string | null) => {
    const d = parseNotionDate(iso);
    return d ? `${MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}` : '';
  };
  const fmtDayLong = (d: Date) =>
    `${DOW[d.getDay()]}, ${MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}`;
  const fmtNumber = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 0 });
  /* Cards compact at 10,000 so a six-figure view count cannot push the
     value out of its card; tables always show the full number. */
  const fmtMetric = (name: string, v: number) => formatMetricValue(name, v, { compact: true });
  const fmtMetricFull = (name: string, v: number) => formatMetricValue(name, v);

  const todayStart = () => { const d = new Date(); d.setHours(0, 0, 0, 0); return d; };
  const sameDay = (a: Date, b: Date) =>
    a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
  const keyOf = (d: Date) => `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;

  /* ── item classification ───────────────────────────────────────
     One function decides what colour and what words an item gets, so
     the calendar, the Home rows and the drawer can never disagree. */
  type Kind = 'show' | 'release' | 'content' | 'moment' | 'todo';

  function kindOf(it: PortalCalendarItem): Kind {
    if (isOpenClientTodo(it)) return 'todo';
    const mt = (it.momentType ?? '').toLowerCase();
    if (mt.includes('show')) return 'show';
    if (mt.includes('release') || mt.includes('drop') || mt.includes('single')) return 'release';
    if (it.type === 'Content') return 'content';
    return 'moment';
  }
  const KIND_LABEL: Record<Kind, string> = {
    show: 'Show', release: 'Release', content: 'Content', moment: 'Moment', todo: 'Your to-do',
  };

  /** The same colour rule as kindOf, applied to a moment on its own.
   *  A step's left edge wears this, so the two can never disagree. */
  function momentKind(m: PortalMoment): 'show' | 'release' | 'moment' {
    const mt = (m.momentType ?? '').toLowerCase();
    if (mt.includes('show')) return 'show';
    if (mt.includes('release') || mt.includes('drop') || mt.includes('single')) return 'release';
    return 'moment';
  }

  /* ── state ─────────────────────────────────────────────────── */
  let DATA: PortalPayload | null = null;
  let SLUG = '';

  /* ── the one failure path ──────────────────────────────────── */
  function renderMissing() {
    show(q('[data-state="loading"]'), false);
    show(q('[data-app]'), false);
    show(q('[data-state="missing"]'), true);
    const mail = q<HTMLAnchorElement>('[data-missing-mail]');
    if (mail) mail.href = `mailto:${DIRECT_EMAIL}?subject=Portal%20link`;
    document.title = 'Not found | Blueprint Marketing';
  }

  /* ── boot ──────────────────────────────────────────────────── */
  async function boot() {
    const parts = location.pathname.split('/').filter(Boolean);
    const slug = (parts[0] === 'portal' ? parts[1] : '') ?? '';
    if (!slug) return renderMissing();
    SLUG = slug;

    const base = `/portal/${encodeURIComponent(slug)}`;

    // A key in the URL is exchanged for a cookie once, then removed, so
    // a client who shares a screenshot or leaves the tab open in a
    // history list is not handing out their key.
    const params = new URLSearchParams(location.search);
    const key = params.get('key');
    if (key) {
      try {
        await fetch(`${base}/auth`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key }),
        });
      } catch { /* fall through: the data call decides */ }

      params.delete('key');
      const rest = params.toString();
      history.replaceState(null, '', location.pathname + (rest ? `?${rest}` : '') + location.hash);
    }

    let payload: PortalPayload;
    try {
      const res = await fetch(`${base}/data`, { credentials: 'same-origin' });
      if (!res.ok) return renderMissing();
      payload = await res.json();
    } catch {
      return renderMissing();
    }

    DATA = payload;
    mount(payload);
  }

  function mount(data: PortalPayload) {
    const c = data.client;

    const name = c.artist || 'Client';
    const topName = q('[data-topname]');
    if (topName) topName.textContent = name;
    const avatar = q('[data-avatar]');
    if (avatar) avatar.textContent = name.trim().charAt(0).toUpperCase() || '?';
    const stage = q('[data-topstage]');
    if (stage) stage.textContent = c.stage ?? '';
    const tier = q('[data-tier]');
    if (tier && c.tier) { tier.textContent = c.tier; show(tier, true); }

    // Content first: the calendar and Home both draw content rows, so
    // the content state has to exist before either of them runs.
    renderContent(data);
    renderCalendar(data.calendar);
    renderHome(data);
    renderReports(data.snapshots);
    renderFiles(c);

    show(q('[data-state="loading"]'), false);
    show(q('[data-app]'), true);
    document.title = `${name} | Blueprint Marketing`;

    window.addEventListener('hashchange', route);
    route();
  }

  /* ── router ────────────────────────────────────────────────────
     Hash routes so each section is its own view in the shell rather
     than one long scroll, and so a client can bookmark "my calendar". */
  const VIEWS = ['home', 'calendar', 'content', 'reports', 'files'] as const;
  type View = typeof VIEWS[number];

  function currentRoute(): { view: View; detail: string } {
    const raw = location.hash.replace(/^#\/?/, '');
    const [v, ...rest] = raw.split('/');
    const view = (VIEWS as readonly string[]).includes(v) ? (v as View) : 'home';
    return { view, detail: decodeURIComponent(rest.join('/') || '') };
  }

  function route() {
    closeTip();
    const { view, detail } = currentRoute();
    for (const v of VIEWS) show(q(`[data-view="${v}"]`), v === view);
    for (const n of qq('[data-nav]')) {
      const on = n.dataset.nav === view;
      if (on) n.setAttribute('aria-current', 'page'); else n.removeAttribute('aria-current');
    }
    for (const t of qq('[data-tab]')) {
      const on = t.dataset.tab === view;
      if (on) t.setAttribute('aria-current', 'page'); else t.removeAttribute('aria-current');
    }
    if (view === 'reports') showPlatform(detail);
    if (view === 'content') drawContent();
    closeDrawer();
    closeSheet();
    window.scrollTo({ top: 0, behavior: 'auto' });
  }

  /* ── home ──────────────────────────────────────────────────── */
  function renderHome(data: PortalPayload) {
    const root = q('[data-view="home"]');
    if (!root) return;
    clear(root);
    const c = data.client;

    /* hero */
    const hero = el('header', 'pt-hero');
    if (c.stage) hero.appendChild(el('p', 'pt-hero-eyebrow', c.stage));
    hero.appendChild(el('h1', undefined, c.artist || 'Your portal'));
    if (c.tier) hero.appendChild(el('p', 'pt-hero-sub', c.tier));

    const term = termProgress(c.termStart, c.termEnd);
    if (term) {
      const wrap = el('div', 'pt-term');
      const row = el('div', 'pt-term-row');
      const label =
        term.state === 'before'
          ? `Starts in ${term.daysUntilStart} ${term.daysUntilStart === 1 ? 'day' : 'days'}`
          : term.state === 'after'
            ? 'Term complete'
            : `Month ${term.month} of ${term.total}`;
      row.appendChild(el('span', 'pt-term-label', label));
      if (c.termStart && c.termEnd) {
        row.appendChild(el('span', 'pt-term-range', `${fmtDate(c.termStart)} – ${fmtDate(c.termEnd)}`));
      }
      const track = el('div', 'pt-term-track');
      const fill = el('div', 'pt-term-fill');
      fill.style.width = '0%';
      track.appendChild(fill);
      wrap.append(row, track);
      hero.appendChild(wrap);
      // Animate from empty on the first paint rather than snapping.
      requestAnimationFrame(() => { fill.style.width = `${Math.round(term.fraction * 100)}%`; });
    }
    root.appendChild(hero);

    /* announcement */
    if (c.announcement) {
      const dismissed = (() => {
        try { return localStorage.getItem(`pt-ann-${SLUG}`) === hash(c.announcement!); }
        catch { return false; }
      })();
      if (!dismissed) {
        const band = el('div', 'pt-announce');
        band.appendChild(el('p', undefined, c.announcement));
        const x = el('button', 'pt-announce-close');
        x.setAttribute('aria-label', 'Dismiss announcement');
        x.appendChild(icon('close'));
        x.addEventListener('click', () => {
          band.remove();
          try { localStorage.setItem(`pt-ann-${SLUG}`, hash(c.announcement!)); } catch { /* private mode */ }
        });
        band.appendChild(x);
        root.appendChild(band);
      }
    }

    const goals = goalCard(data);
    if (goals) root.appendChild(goals);

    /* KPI strip */
    const snap = data.snapshots[0];
    if (snap) {
      const picks = ['Instagram · Followers', 'TikTok · Followers', 'Spotify · Monthly Listeners', 'Email + SMS List']
        .filter((m) => typeof snap.metrics[m] === 'number');
      if (picks.length) {
        const grid = el('div', 'pt-grid pt-grid-4');
        for (const m of picks) grid.appendChild(kpiCard(m, data.snapshots));
        root.appendChild(grid);
      }
    }

    /* two columns: to-dos + coming up */
    const cols = el('div', 'pt-grid pt-grid-2');
    cols.style.marginTop = 'var(--pt-5)';

    // Everything beyond here is "the next fortnight". A whole term of
    // to-dos is a true list and a useless one.
    const today = todayStart();
    const horizon = new Date(today);
    horizon.setDate(horizon.getDate() + 14);

    // Campaign-calendar rows the client owns, plus the content they
    // are filming or posting in the next week. One list, because from
    // where they sit it is all the same question: what is on me?
    //
    // Sorted by date, not by where the row came from. Concatenating
    // put every calendar to-do first, so with six of those on the
    // board a shoot tomorrow never made the cut. Nothing is dropped
    // from the past end: a to-do that slipped is still on him.
    const todos = [...data.calendar.filter(isOpenClientTodo), ...contentTodos()]
      .filter((i) => { const d = parseNotionDate(i.date); return !d || d <= horizon; })
      .sort((a, b) => (parseNotionDate(a.date)?.getTime() ?? Infinity)
                    - (parseNotionDate(b.date)?.getTime() ?? Infinity));
    cols.appendChild(
      listCard('Your to-dos', todos.slice(0, 6), {
        emptyIcon: 'check',
        emptyTitle: "Nothing on you right now",
        emptyBody: "When we need something from you, it shows up here and on your calendar.",
      }, { count: Math.max(0, todos.length - 6), href: '#/calendar', label: 'in the next two weeks' }),
    );

    // "Coming up" is what WE are doing next. Client-owned rows belong in
    // the to-do card beside it, and listing them twice made the page look
    // like twice the work.
    const upcoming = data.calendar
      .filter((i) => i.owner !== 'Client')
      .filter((i) => { const d = parseNotionDate(i.date); return !!d && d >= today && d <= horizon; })
      .slice(0, 5);
    cols.appendChild(
      listCard('Coming up', upcoming, {
        emptyIcon: 'cal',
        emptyTitle: 'Nothing in the next two weeks',
        emptyBody: 'Your calendar fills in as we build out the next run of content and moments.',
      }),
    );
    root.appendChild(cols);
  }

  /* ── 90-day goals ──────────────────────────────────────────────
     What the client said they wanted, measured against what has
     actually happened. The numbers come from their own snapshots and
     their own calendar, so every bar here is something they did.

     Progress is measured from the BASELINE, never from zero: a client
     who signed at 3,117 followers has not already done 62% of a 5,000
     goal, they have done none of it yet. */

  /** Oldest and newest readings of one metric, oldest first. */
  function metricSpan(snapshots: PortalSnapshot[], name: string): { first: number; last: number } | null {
    const vals = snapshots.filter((s) => typeof s.metrics[name] === 'number');
    if (!vals.length) return null;
    // Snapshots arrive newest first.
    return { first: vals[vals.length - 1].metrics[name], last: vals[0].metrics[name] };
  }

  function bar(fraction: number, small = false): HTMLElement {
    const track = el('div', `pt-bar${small ? ' pt-bar-sm' : ''}`);
    const fill = el('div', 'pt-bar-fill');
    fill.style.width = '0%';
    track.appendChild(fill);
    requestAnimationFrame(() => { fill.style.width = `${Math.round(fraction * 100)}%`; });
    return track;
  }

  function goalCard(data: PortalPayload): HTMLElement | null {
    const c = data.client;
    const hasAny = c.goals
      || typeof c.goalInstagramFollowers === 'number'
      || typeof c.goalSongsAt10k === 'number'
      || typeof c.goalShowsPerMonth === 'number';
    if (!hasAny) return null;

    const card = el('section', 'pt-card pt-goals');
    const head = el('div', 'pt-card-head');
    head.appendChild(el('h2', undefined, '90-day goals'));
    card.appendChild(head);

    const body = el('div', 'pt-card-body');
    const top = el('div', 'pt-goals-head');

    if (c.goals) {
      const quote = el('blockquote', 'pt-goals-quote', c.goals);
      top.appendChild(quote);
    }

    const left = daysUntil(c.goalDeadline);
    const term = termProgress(c.termStart, c.termEnd);
    const count = el('div', 'pt-goals-count');
    if (term.state === 'before') {
      count.appendChild(el('div', 'pt-goals-days pt-num',
        String(term.daysUntilStart)));
      count.appendChild(el('div', 'pt-goals-days-label',
        term.daysUntilStart === 1 ? 'day until you start' : 'days until you start'));
    } else if (left !== null && left >= 0) {
      count.appendChild(el('div', 'pt-goals-days pt-num', String(left)));
      count.appendChild(el('div', 'pt-goals-days-label', left === 1 ? 'day left' : 'days left'));
    } else if (left !== null) {
      // Past the deadline, the countdown would read as a negative number.
      // The result is the thing worth showing instead.
      count.appendChild(el('span', 'pt-goals-final', 'Final numbers'));
      count.appendChild(el('div', 'pt-goals-days-label', `Deadline was ${fmtDate(c.goalDeadline)}`));
    }
    if (count.firstChild) top.appendChild(count);
    if (top.firstChild) body.appendChild(top);

    const grid = el('div', 'pt-goals-grid');

    /* Instagram followers */
    if (typeof c.goalInstagramFollowers === 'number') {
      const span = metricSpan(data.snapshots, 'Instagram · Followers');
      const block = el('div');
      const t = el('div', 'pt-goal-title');
      t.appendChild(el('span', 'pt-goal-name', 'Instagram followers'));
      if (span) {
        const num = el('span', 'pt-goal-num');
        num.appendChild(el('b', undefined, fmtNumber(span.last)));
        num.appendChild(document.createTextNode(` of ${fmtNumber(c.goalInstagramFollowers)}`));
        t.appendChild(num);
      }
      block.appendChild(t);
      if (span) {
        const g = goalProgress(span.first, span.last, c.goalInstagramFollowers);
        block.appendChild(bar(g.fraction));
        const foot = el('div', 'pt-goal-foot');
        // On the baseline snapshot there is nothing to compare to yet,
        // and "+0 since you started" reads like a failure rather than
        // a starting line.
        foot.appendChild(el('span', undefined, g.gained === 0 && span.first === span.last
          ? `Started at ${fmtNumber(g.baseline)}`
          : `${g.gained >= 0 ? '+' : ''}${fmtNumber(g.gained)} since ${fmtNumber(g.baseline)}`));
        // The pace is the only number on this card anyone can act on.
        const pace = weeklyPaceNeeded(span.last, c.goalInstagramFollowers, c.goalDeadline);
        if (pace !== null) {
          foot.appendChild(el('span', undefined,
            `need ~${fmtNumber(Math.ceil(pace))}/week to hit ${fmtNumber(c.goalInstagramFollowers)} by ${fmtDateShort(c.goalDeadline)}`));
        }
        block.appendChild(foot);
      } else {
        block.appendChild(el('div', 'pt-goal-foot',
          `Target ${fmtNumber(c.goalInstagramFollowers)}. Your first snapshot sets the starting line.`));
      }
      grid.appendChild(block);
    }

    /* songs at 10K streams */
    if (typeof c.goalSongsAt10k === 'number') {
      // Songs with streams first, biggest first: those are the ones that
      // count toward the goal. Unreleased songs follow in date order,
      // because what matters about them is when they land.
      const releases = data.calendar
        .filter((i) => (i.momentType ?? '').toLowerCase().includes('release'))
        .sort((a, b) => {
          const av = typeof a.streamsToDate === 'number', bv = typeof b.streamsToDate === 'number';
          if (av !== bv) return av ? -1 : 1;
          if (av && bv) return b.streamsToDate! - a.streamsToDate!;
          return (parseNotionDate(a.date)?.getTime() ?? 0) - (parseNotionDate(b.date)?.getTime() ?? 0);
        });
      const done = songsAtTarget(data.calendar);
      const block = el('div');
      const t = el('div', 'pt-goal-title');
      t.appendChild(el('span', 'pt-goal-name', `Songs past ${compactNumber(SONG_STREAM_TARGET)} streams`));
      const num = el('span', 'pt-goal-num');
      num.appendChild(el('b', undefined, String(done)));
      num.appendChild(document.createTextNode(` of ${c.goalSongsAt10k}`));
      t.appendChild(num);
      block.appendChild(t);
      block.appendChild(bar(c.goalSongsAt10k > 0 ? Math.min(1, done / c.goalSongsAt10k) : 0));

      if (releases.length) {
        const list = el('div');
        list.style.marginTop = 'var(--pt-3)';
        // A short list fits; a long one gets three and a link, never a
        // silent cut that hides releases a client is waiting on.
        const shown = releases.length <= 6 ? releases : releases.slice(0, 3);
        for (const r of shown) {
          const row = el('div', 'pt-song');
          const rh = el('div', 'pt-song-head');
          rh.appendChild(el('span', 'pt-song-name', r.title));
          if (typeof r.streamsToDate === 'number') {
            rh.appendChild(el('span', 'pt-song-num',
              `${fmtNumber(r.streamsToDate)} / ${compactNumber(SONG_STREAM_TARGET)}`));
            row.appendChild(rh);
            row.appendChild(bar(Math.min(1, r.streamsToDate / SONG_STREAM_TARGET), true));
          } else {
            // No streams yet because it is not out yet. Say so, rather
            // than drawing an empty bar that reads as a failure.
            rh.appendChild(el('span', 'pt-song-upcoming',
              r.date ? `Out ${fmtDate(r.date)}` : 'Not out yet'));
            row.appendChild(rh);
          }
          list.appendChild(row);
        }
        block.appendChild(list);
        const hidden = releases.length - shown.length;
        if (hidden > 0) {
          const more = el('button', 'pt-goal-more');
          more.type = 'button';
          more.textContent = `+${hidden} more ${hidden === 1 ? 'release' : 'releases'}`;
          more.appendChild(icon('chev'));
          more.addEventListener('click', () => {
            CAL.campaign = '';
            CAL.layers = new Set<Layer>(['moments']);
            CAL.view = isNarrow() ? 'agenda' : 'month';
            CAL.selected = null;
            saveCalPrefs();
            drawCalendar();
            if (currentRoute().view !== 'calendar') location.hash = '#/calendar';
          });
          block.appendChild(more);
        }
      }
      grid.appendChild(block);
    }

    /* shows per month */
    if (typeof c.goalShowsPerMonth === 'number') {
      const thisMonth = showsInMonth(data.calendar, new Date(), c.termStart);
      const avg = showsPerMonthAverage(data.calendar, c.termStart);
      const block = el('div');
      const t = el('div', 'pt-goal-title');
      t.appendChild(el('span', 'pt-goal-name', 'Shows this month'));
      const num = el('span', 'pt-goal-num');
      num.appendChild(el('b', undefined, String(thisMonth)));
      num.appendChild(document.createTextNode(` of ${c.goalShowsPerMonth}`));
      t.appendChild(num);
      block.appendChild(t);
      block.appendChild(bar(c.goalShowsPerMonth > 0 ? Math.min(1, thisMonth / c.goalShowsPerMonth) : 0));
      const foot = el('div', 'pt-goal-foot');
      foot.appendChild(el('span', undefined, avg === null
        ? `${MONTHS[new Date().getMonth()]} so far`
        : `${avg.toFixed(1)} a month since your term started`));
      block.appendChild(foot);
      grid.appendChild(block);
    }

    /* shares: the one engagement number worth putting on Home */
    const shares = metricSpan(data.snapshots, 'TikTok · Shares (28d)');
    if (shares) {
      const block = el('div');
      const t = el('div', 'pt-goal-title');
      t.appendChild(el('span', 'pt-goal-name', 'Content that gets shared'));
      const num = el('span', 'pt-goal-num');
      num.appendChild(el('b', undefined, fmtNumber(shares.last)));
      t.appendChild(num);
      block.appendChild(t);
      const foot = el('div', 'pt-goal-foot');
      if (shares.first !== shares.last) {
        foot.appendChild(deltaPill(shares.last, shares.first, 'TikTok · Shares (28d)'));
      }
      foot.appendChild(el('span', undefined,
        'Times people sent one of your TikToks to someone else in the last 28 days.'));
      block.appendChild(foot);
      grid.appendChild(block);
    }

    if (grid.firstChild) {
      // Two columns that read DOWN. The row count has to be known for
      // a grid to fill column-first, and only this function knows how
      // many blocks there turned out to be.
      const blocks = grid.children.length;
      grid.style.setProperty('--pt-goal-rows', String(Math.ceil(blocks / 2)));
      body.appendChild(grid);
    }
    card.appendChild(body);
    return card;
  }

  /** A tiny stable hash, only used to key "this announcement was
   *  dismissed" so a NEW announcement comes back. */
  function hash(s: string): string {
    let h = 0;
    for (let i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) | 0; }
    return String(h);
  }

  function kpiCard(metric: string, snapshots: PortalSnapshot[]): HTMLElement {
    const latest = snapshots[0];
    const a = el('a', 'pt-kpi');
    (a as HTMLAnchorElement).href = `#/reports/${encodeURIComponent(metricPlatform(metric) ?? metric)}`;

    const label = el('span', 'pt-kpi-label');
    const plat = metricPlatform(metric);
    label.appendChild(el('span', 'pt-kpi-platform', plat ?? metric));
    if (plat) label.appendChild(el('span', undefined, displayMetricLabel(metric)));
    a.appendChild(label);

    a.appendChild(el('div', 'pt-kpi-value pt-num', fmtMetric(metric, latest.metrics[metric])));

    const foot = el('div', 'pt-kpi-foot');
    const prev = snapshots[1];
    if (prev && typeof prev.metrics[metric] === 'number') {
      foot.appendChild(deltaPill(latest.metrics[metric], prev.metrics[metric], metric));
    } else {
      foot.appendChild(el('span', 'pt-kpi-note', 'Baseline'));
    }
    a.appendChild(foot);
    return a;
  }

  function deltaPill(now: number, then: number, metric: string): HTMLElement {
    const diff = now - then;
    const pct = then === 0 ? 0 : (diff / Math.abs(then)) * 100;
    const dir = diff > 0 ? 'up' : diff < 0 ? 'down' : 'flat';
    const pill = el('span', `pt-delta pt-delta-${dir}`);
    if (dir !== 'flat') pill.appendChild(icon(dir === 'up' ? 'up' : 'down'));
    const text = isPercentMetric(metric)
      ? `${diff > 0 ? '+' : ''}${(diff * 100).toFixed(1)} pts`
      : `${diff > 0 ? '+' : ''}${Math.abs(pct) >= 10 ? pct.toFixed(0) : pct.toFixed(1)}%`;
    pill.appendChild(el('span', undefined, dir === 'flat' ? 'No change' : text));
    return pill;
  }

  function listCard(
    title: string,
    items: PortalCalendarItem[],
    empty: { emptyIcon: string; emptyTitle: string; emptyBody: string },
    /** How many were cut, and where the rest of them live. */
    more?: { count: number; href: string; label: string },
  ): HTMLElement {
    const card = el('section', 'pt-card');
    const head = el('div', 'pt-card-head');
    head.appendChild(el('h2', undefined, title));
    card.appendChild(head);
    const body = el('div', 'pt-card-body');

    if (!items.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon(empty.emptyIcon));
      e.append(ic, el('h3', undefined, empty.emptyTitle), el('p', undefined, empty.emptyBody));
      body.appendChild(e);
    } else {
      const list = el('ul');
      for (const it of items) list.appendChild(itemRow(it));
      body.appendChild(list);
      // A card that quietly drops the seventh item is a card that can
      // hide a shoot. Say how many, and where they are.
      if (more && more.count > 0) {
        const a = el('a', 'pt-card-more') as HTMLAnchorElement;
        a.href = more.href;
        a.appendChild(el('span', undefined, `${more.count} more ${more.label}`));
        a.appendChild(icon('chev'));
        body.appendChild(a);
      }
    }
    card.appendChild(body);
    return card;
  }

  function itemRow(it: PortalCalendarItem): HTMLLIElement {
    const row = it as CalRow;
    const li = el('li');
    const btn = el('button', 'pt-row');
    btn.type = 'button';
    btn.addEventListener('click', () => openDrawer(it));

    const keyCls = row.content
      ? `pt-kind pt-kind-${row.contentRole} pt-nc-${bucketColor(row.content.bucket)}`
      : `pt-kind pt-kind-${kindOf(it)}`;
    btn.appendChild(el('span', keyCls));

    const d = parseNotionDate(it.date);
    if (d) {
      const chip = el('span', 'pt-datechip');
      chip.append(
        el('span', 'pt-datechip-m', MONTHS[d.getMonth()].slice(0, 3)),
        el('span', 'pt-datechip-d pt-num', String(d.getDate())),
      );
      btn.appendChild(chip);
    }

    const main = el('span', 'pt-row-main');
    const title = el('span', 'pt-row-title');
    title.appendChild(el('span', undefined, it.title));
    if (it.tentative) title.appendChild(el('span', 'pt-tag pt-tag-tentative', 'Tentative'));
    if (kindOf(it) === 'todo') title.appendChild(el('span', 'pt-tag pt-tag-todo', 'To-do'));
    main.appendChild(title);

    const meta = el('span', 'pt-row-meta');
    if (it.moment) {
      meta.appendChild(el('span', `pt-row-moment pt-mk-${momentKind(it.moment)}`, it.moment.title));
    }
    // The title already carries a "To-do" tag, so repeating "Your
    // to-do" in the meta line costs a wrapped line on a phone and
    // says nothing new.
    const k = kindOf(it);
    const bits = row.content
      ? [row.content.bucket, it.where, row.content.status].filter(Boolean) as string[]
      : [k === 'todo' ? null : KIND_LABEL[k], it.where, it.venueCity, it.status]
          .filter(Boolean) as string[];
    for (const b of bits.slice(0, it.moment ? 2 : 3)) meta.appendChild(el('span', undefined, b));
    main.appendChild(meta);
    btn.appendChild(main);

    const chev = el('span', 'pt-row-chev');
    chev.appendChild(icon('chev'));
    btn.appendChild(chev);

    // A post the client puts up themselves is one tap from done, and a
    // nested button inside the row would not be a button at all, so the
    // action sits beside it.
    const c = row.content;
    const canPost = !!c && row.contentRole === 'post' && c.postedBy === 'Client'
      && (c.status === 'Approved' || c.status === 'Scheduled');
    if (canPost) {
      const wrap = el('div', 'pt-row-wrap');
      const act = el('button', 'pt-row-act');
      act.type = 'button';
      act.appendChild(icon('check'));
      act.appendChild(el('span', undefined, 'Mark as posted'));
      act.addEventListener('click', () => openPostedSheet(c!));
      wrap.append(btn, act);
      li.appendChild(wrap);
      return li;
    }

    li.appendChild(btn);
    return li;
  }

  /* ── calendar ──────────────────────────────────────────────── */
  type CalView = 'month' | 'week' | 'agenda';

  /**
   * One calendar holds everything, and the layers decide what you are
   * looking at. This replaced a single-choice dropdown: a client who
   * wanted their shoots AND their own to-dos, but not our task list,
   * could not say so with one <select>.
   */
  type Layer = 'moments' | 'posts' | 'films' | 'todos' | 'blueprint';

  const LAYERS: Array<[Layer, string]> = [
    ['moments',   'Shows & releases'],
    ['posts',     'Posts'],
    ['films',     'Film days'],
    ['todos',     'Your to-dos'],
    ['blueprint', 'Blueprint tasks'],
  ];
  const ALL_LAYERS: Layer[] = LAYERS.map(([k]) => k);
  const LAYER_LABEL = new Map<Layer, string>(LAYERS);

  const PHASES: Array<[ContentPhase, string]> = [
    ['planned', 'Planned'], ['progress', 'In progress'], ['posted', 'Posted'],
  ];

  const CAL = {
    view: 'month' as CalView,
    cursor: todayStart(),
    /** Every layer on is the default: the calendar is the whole plan. */
    layers: new Set<Layer>(ALL_LAYERS),
    /** Empty means every bucket, not none. */
    buckets: new Set<string>(),
    phase: '' as '' | ContentPhase,
    /** A moment id, or '' for every campaign. */
    campaign: '',
    selected: null as Date | null,
    items: [] as PortalCalendarItem[],
    /** The unscheduled tray, desktop only. */
    tray: true,
    traySearch: '',
  };

  const isNarrow = () => window.matchMedia('(max-width: 900px)').matches;

  /** Every campaign a client could filter by: the moments on their own
   *  calendar, plus any moment a step points at that is not itself
   *  visible, so a filter never offers a name with nothing behind it. */
  function campaigns(): PortalMoment[] {
    const byId = new Map<string, PortalMoment>();
    for (const it of CAL.items) {
      if (it.moment) byId.set(it.moment.id, it.moment);
      if (it.id && kindOf(it) !== 'content' && kindOf(it) !== 'todo' && it.momentType) {
        byId.set(it.id, { id: it.id, title: it.title, momentType: it.momentType, date: it.date });
      }
    }
    const now = todayStart();
    const t = (m: PortalMoment) => parseNotionDate(m.date)?.getTime() ?? Infinity;
    // Upcoming first, soonest at the top; past campaigns fall below.
    return Array.from(byId.values()).sort((a, b) => {
      const ua = t(a) >= now.getTime(), ub = t(b) >= now.getTime();
      if (ua !== ub) return ua ? -1 : 1;
      return ua ? t(a) - t(b) : t(b) - t(a);
    });
  }

  function campaignName(id: string): string {
    return campaigns().find((m) => m.id === id)?.title ?? 'This campaign';
  }

  function filterToCampaign(id: string) {
    CAL.campaign = id;
    CAL.selected = null;
    // Land on the month the campaign lives in, not whatever was on screen.
    const d = parseNotionDate(campaigns().find((m) => m.id === id)?.date ?? null);
    if (d) CAL.cursor = d;
    drawCalendar();
    // The hash change redraws the shell; if we are already on the
    // calendar it does nothing, which is why the draw comes first.
    if (currentRoute().view !== 'calendar') location.hash = '#/calendar';
  }

  /** A post the client puts up themselves, still to go out. It is two
   *  things at once: a post on the calendar, and a job on their list,
   *  so it answers to either layer. */
  function isClientPostTodo(c: PortalContentItem): boolean {
    return c.postedBy === 'Client' && c.status !== 'Posted' && c.status !== 'Skipped';
  }

  /** Which layers an item belongs to. Most belong to exactly one. */
  function layersOf(it: PortalCalendarItem): Layer[] {
    const row = it as CalRow;
    if (row.content && row.contentRole) {
      if (row.contentRole === 'film') return ['films'];
      return isClientPostTodo(row.content) ? ['posts', 'todos'] : ['posts'];
    }
    // A moment is a moment whoever owns it: it is the thing the steps
    // are counting down to, not a task.
    if (it.momentType) return ['moments'];
    return it.owner === 'Client' ? ['todos'] : ['blueprint'];
  }

  function passesFilter(it: PortalCalendarItem): boolean {
    // A campaign filter keeps the moment itself as well as its steps:
    // the release date is the point the steps are counting down to.
    if (CAL.campaign && it.id !== CAL.campaign && it.moment?.id !== CAL.campaign) return false;
    if (!layersOf(it).some((l) => CAL.layers.has(l))) return false;

    // Bucket and status describe content and nothing else. They narrow
    // the content on the calendar and leave the campaign around it
    // standing: picking "Skit" should not hide the show you are making
    // skits for.
    const c = (it as CalRow).content;
    if (!c) return true;
    if (CAL.buckets.size && !(c.bucket && CAL.buckets.has(c.bucket))) return false;
    if (CAL.phase && contentPhase(c.status) !== CAL.phase) return false;
    return true;
  }

  /** Whether the calendar is showing a slice rather than all of it. */
  function calFiltering(): boolean {
    return CAL.layers.size !== ALL_LAYERS.length
      || CAL.buckets.size > 0 || !!CAL.phase || !!CAL.campaign;
  }

  /* ── quick views ──────────────────────────────────────────────
     A named set of layers, because "show me my week" is one thought
     and four chip taps. */
  type Quick = 'everything' | 'content' | 'week' | 'campaigns';

  const QUICK: Array<[Quick, string, Layer[]]> = [
    ['everything', 'Everything',   ALL_LAYERS],
    ['content',    'Content only', ['posts', 'films']],
    ['week',       'My week',      ['todos', 'films']],
    ['campaigns',  'Campaigns',    ['moments', 'blueprint']],
  ];

  /** "My week" means the week grid, except at phone width where a
   *  seven-column grid is unreadable and Agenda says the same thing. */
  function quickWants(q: Quick): CalView | null {
    return q === 'week' ? (isNarrow() ? 'agenda' : 'week') : null;
  }

  /** The tab to light up, worked out from the state rather than stored
   *  beside it, so toggling a chip by hand cannot leave a tab lying. */
  function activeQuick(): Quick | '' {
    for (const [k, , layers] of QUICK) {
      const want = quickWants(k);
      if (want && CAL.view !== want) continue;
      if (layers.length !== CAL.layers.size) continue;
      if (layers.every((l) => CAL.layers.has(l))) return k;
    }
    return '';
  }

  function applyQuick(k: Quick) {
    const entry = QUICK.find(([q]) => q === k)!;
    CAL.layers = new Set(entry[2]);
    const want = quickWants(k);
    if (want) CAL.view = want;
    // The week grid belongs to My week. Left behind, "Campaigns" would
    // show one week of a campaign that runs for months. Agenda is a
    // deliberate choice and is left alone.
    else if (CAL.view === 'week') CAL.view = isNarrow() ? 'agenda' : 'month';
    CAL.selected = null;
    saveCalPrefs();
    drawCalendar();
  }

  /* ── remembering the choice ───────────────────────────────────
     Per device, because which layers matter depends on whether you
     are at a desk or holding a phone on the way to a shoot. */
  const CAL_STORE = 'bp.portal.cal.v1';

  function saveCalPrefs() {
    try {
      localStorage.setItem(CAL_STORE, JSON.stringify({
        layers: Array.from(CAL.layers), view: CAL.view, tray: CAL.tray,
      }));
    } catch { /* a browser that will not remember is not an error */ }
  }

  /** Whether a view was restored, so the caller knows not to pick one. */
  function loadCalPrefs(): boolean {
    try {
      const raw = localStorage.getItem(CAL_STORE);
      if (!raw) return false;
      const v = JSON.parse(raw) as { layers?: unknown; view?: unknown; tray?: unknown };
      if (Array.isArray(v.layers)) {
        const keep = v.layers.filter((l): l is Layer => ALL_LAYERS.includes(l as Layer));
        // Every layer off is a blank calendar, which nobody meant to
        // leave behind. An empty set falls back to all of it.
        if (keep.length) CAL.layers = new Set(keep);
      }
      if (typeof v.tray === 'boolean') CAL.tray = v.tray;
      if (v.view === 'month' || v.view === 'week' || v.view === 'agenda') {
        CAL.view = v.view;
        return true;
      }
      return false;
    } catch {
      return false;   // unreadable storage is the same as none
    }
  }

  /** The calendar rows as they came from the server. CAL.items is this
   *  plus the content rows, rebuilt after every content save. */
  let CAL_BASE: PortalCalendarItem[] = [];

  function renderCalendar(items: PortalCalendarItem[]) {
    CAL_BASE = items;
    syncCalendarContent();
    const restored = loadCalPrefs();
    // On a phone a month grid of chips is unreadable, so Agenda leads
    // unless this device said otherwise last time. A week grid is the
    // one view that cannot survive the trip to phone width.
    if (!restored) CAL.view = isNarrow() ? 'agenda' : 'month';
    else if (isNarrow() && CAL.view === 'week') CAL.view = 'agenda';
    // Open on the month that actually has something in it.
    const first = CAL.items.find((i) => parseNotionDate(i.date));
    const now = todayStart();
    const firstDate = first ? parseNotionDate(first.date)! : now;
    CAL.cursor = firstDate > now ? firstDate : now;
    drawCalendar();
  }

  function drawCalendar() {
    const root = q('[data-view="calendar"]');
    if (!root) return;
    clear(root);
    root.appendChild(calToolbar());
    root.appendChild(quickTabs());
    root.appendChild(layerChips());

    const visible = CAL.items.filter(passesFilter);
    if (!visible.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('cal'));
      e.append(
        ic,
        el('h3', undefined, calFiltering()
          ? 'Nothing matches that'
          : 'Nothing on the calendar yet'),
        el('p', undefined, calFiltering()
          ? 'Turn a layer back on, or clear a filter, to see the rest of your calendar.'
          : 'Shows, releases and content steps appear here as we plan them.'),
      );
      root.appendChild(e);
      return;
    }

    // On a phone the month grid is dots, so a day has to be open for
    // the view to say anything at all. Today when today is on screen,
    // otherwise the first day of the month that has something in it.
    if (isNarrow() && CAL.view === 'month' && !CAL.selected) {
      const now = todayStart();
      const thisMonth = (d: Date) =>
        d.getFullYear() === CAL.cursor.getFullYear() && d.getMonth() === CAL.cursor.getMonth();
      const dates = visible
        .map((i) => parseNotionDate(i.date))
        .filter((d): d is Date => !!d && thisMonth(d))
        .sort((a, b) => a.getTime() - b.getTime());
      // Today, unless today is empty: opening on "Nothing scheduled on
      // this day" teaches a client the view is broken. Then the next
      // day with something on it, then today anyway.
      CAL.selected = dates.find((d) => sameDay(d, now))
        ?? dates.find((d) => d >= now)
        ?? dates[dates.length - 1]
        ?? (thisMonth(now) ? now : null);
    }

    const grid = el('div');
    if (CAL.view === 'agenda') grid.appendChild(agendaView(visible));
    else if (CAL.view === 'week') grid.appendChild(weekView(visible));
    else grid.appendChild(monthView(visible));

    if (CAL.view !== 'agenda') grid.appendChild(legend());
    if (isNarrow() && CAL.view === 'month' && CAL.selected) {
      grid.appendChild(selectedDayList(visible));
    }

    // The tray is a desktop idea: it exists so a card can be dragged
    // out of it onto a day, and there is no dragging on a phone.
    const tray = isNarrow() || CAL.view === 'agenda' ? null : unscheduledTray();
    if (tray) {
      const split = el('div', 'pt-calwrap');
      split.append(grid, tray);
      root.appendChild(split);
    } else {
      root.appendChild(grid);
    }
  }

  function calToolbar(): HTMLElement {
    const bar = el('div', 'pt-toolbar');

    const nav = el('div', 'pt-navgroup');
    const prev = el('button', 'pt-btn pt-btn-icon');
    prev.type = 'button';
    prev.setAttribute('aria-label', CAL.view === 'week' ? 'Previous week' : 'Previous month');
    prev.appendChild(icon('chev-left'));
    prev.addEventListener('click', () => stepCursor(-1));
    const next = el('button', 'pt-btn pt-btn-icon');
    next.type = 'button';
    next.setAttribute('aria-label', CAL.view === 'week' ? 'Next week' : 'Next month');
    next.appendChild(icon('chev'));
    next.addEventListener('click', () => stepCursor(1));
    nav.append(prev, next);

    const today = el('button', 'pt-btn', 'Today');
    today.type = 'button';
    today.addEventListener('click', () => { CAL.cursor = todayStart(); CAL.selected = null; drawCalendar(); });

    const label = el('span', 'pt-month-label',
      `${MONTHS[CAL.cursor.getMonth()]} ${CAL.cursor.getFullYear()}`);

    bar.append(nav, today, label, el('span', 'pt-toolbar-spacer'));

    const seg = el('div', 'pt-seg');
    seg.setAttribute('role', 'group');
    seg.setAttribute('aria-label', 'Calendar view');
    for (const [v, text] of [['month', 'Month'], ['week', 'Week'], ['agenda', 'Agenda']] as const) {
      const b = el('button', undefined, text);
      b.type = 'button';
      b.setAttribute('aria-pressed', String(CAL.view === v));
      b.addEventListener('click', () => {
        CAL.view = v;
        CAL.selected = null;
        saveCalPrefs();
        drawCalendar();
      });
      seg.appendChild(b);
    }

    bar.appendChild(seg);
    return bar;
  }

  /** Four named slices of the same calendar. */
  function quickTabs(): HTMLElement {
    const row = el('div', 'pt-calrow');

    const tabs = el('div', 'pt-quick');
    tabs.setAttribute('role', 'group');
    tabs.setAttribute('aria-label', 'Quick views');
    const on = activeQuick();
    for (const [k, text] of QUICK) {
      const b = el('button', 'pt-quick-tab' + (k === on ? ' pt-quick-on' : ''), text);
      b.type = 'button';
      b.setAttribute('aria-pressed', String(k === on));
      b.addEventListener('click', () => applyQuick(k));
      tabs.appendChild(b);
    }
    row.append(tabs, el('span', 'pt-toolbar-spacer'));

    /* bucket, multi-select, in the Notion colours */
    if (CON.schema.bucket.length) {
      const d = el('details', 'pt-multi') as HTMLDetailsElement;
      const s = el('summary', 'pt-select pt-multi-sum');
      s.appendChild(el('span', undefined,
        CAL.buckets.size ? `Bucket · ${CAL.buckets.size}` : 'Every bucket'));
      s.appendChild(icon('chev'));
      d.appendChild(s);
      const panel = el('div', 'pt-multi-panel');
      for (const o of CON.schema.bucket) {
        const lab = el('label', `pt-multi-opt pt-nc-${o.color}`);
        const box = el('input') as HTMLInputElement;
        box.type = 'checkbox';
        box.checked = CAL.buckets.has(o.name);
        box.addEventListener('change', () => {
          if (box.checked) CAL.buckets.add(o.name); else CAL.buckets.delete(o.name);
          CAL.selected = null;
          drawCalendar();
          // The panel is rebuilt by the redraw, so it is reopened here
          // rather than left shut under the pointer mid-selection.
          q<HTMLDetailsElement>('.pt-multi')?.setAttribute('open', '');
        });
        lab.append(box, el('span', 'pt-multi-dot'), el('span', undefined, o.name));
        panel.appendChild(lab);
      }
      if (CAL.buckets.size) {
        const clear = el('button', 'pt-multi-clear', 'Clear');
        clear.type = 'button';
        clear.addEventListener('click', () => { CAL.buckets.clear(); drawCalendar(); });
        panel.appendChild(clear);
      }
      d.appendChild(panel);
      row.appendChild(d);
    }

    const list = campaigns();
    if (list.length) {
      const camp = el('select', 'pt-select') as HTMLSelectElement;
      camp.setAttribute('aria-label', 'Filter by campaign');
      const any = el('option', undefined, 'Every campaign') as HTMLOptionElement;
      any.value = '';
      camp.appendChild(any);
      for (const m of list) {
        const d = parseNotionDate(m.date);
        const o = el('option', undefined,
          d ? `${m.title} · ${MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}` : m.title) as HTMLOptionElement;
        o.value = m.id;
        if (CAL.campaign === m.id) o.selected = true;
        camp.appendChild(o);
      }
      camp.addEventListener('change', () => {
        if (camp.value) { filterToCampaign(camp.value); return; }
        CAL.campaign = '';
        CAL.selected = null;
        drawCalendar();
      });
      row.appendChild(camp);
    }

    const phase = el('select', 'pt-select') as HTMLSelectElement;
    phase.setAttribute('aria-label', 'Filter by status');
    for (const [v, text] of [['', 'Any status'], ...PHASES] as Array<[string, string]>) {
      const o = el('option', undefined, text) as HTMLOptionElement;
      o.value = v;
      if (CAL.phase === v) o.selected = true;
      phase.appendChild(o);
    }
    phase.addEventListener('change', () => {
      CAL.phase = phase.value as '' | ContentPhase;
      CAL.selected = null;
      drawCalendar();
    });
    row.appendChild(phase);

    if (!isNarrow() && CAL.view !== 'agenda') {
      const n = unscheduled().length;
      const t = el('button', 'pt-btn' + (CAL.tray ? ' pt-btn-on' : ''));
      t.type = 'button';
      t.setAttribute('aria-pressed', String(CAL.tray));
      t.appendChild(icon('folder'));
      t.appendChild(el('span', undefined, `Unscheduled · ${n}`));
      t.addEventListener('click', () => {
        CAL.tray = !CAL.tray;
        saveCalPrefs();
        drawCalendar();
      });
      row.appendChild(t);
    }

    if (CAL.campaign) {
      const chipEl = el('span', 'pt-filter-chip');
      chipEl.appendChild(el('span', undefined, campaignName(CAL.campaign)));
      const x = el('button');
      x.type = 'button';
      x.setAttribute('aria-label', 'Clear campaign filter');
      x.appendChild(icon('close'));
      x.addEventListener('click', () => { CAL.campaign = ''; drawCalendar(); });
      chipEl.appendChild(x);
      row.appendChild(chipEl);
    }
    return row;
  }

  /** The five layers, all on by default. */
  function layerChips(): HTMLElement {
    const row = el('div', 'pt-layers');
    row.setAttribute('role', 'group');
    row.setAttribute('aria-label', 'Calendar layers');
    for (const [k, text] of LAYERS) {
      const on = CAL.layers.has(k);
      const b = el('button', `pt-layer pt-layer-${k}` + (on ? ' pt-layer-on' : ''));
      b.type = 'button';
      b.setAttribute('aria-pressed', String(on));
      b.append(el('span', 'pt-layer-key'), el('span', undefined, text));
      b.addEventListener('click', () => {
        if (on) CAL.layers.delete(k); else CAL.layers.add(k);
        CAL.selected = null;
        saveCalPrefs();
        drawCalendar();
      });
      row.appendChild(b);
    }
    return row;
  }

  function stepCursor(dir: number) {
    const c = new Date(CAL.cursor);
    if (CAL.view === 'week') c.setDate(c.getDate() + dir * 7);
    else c.setMonth(c.getMonth() + dir, 1);
    CAL.cursor = c;
    CAL.selected = null;
    drawCalendar();
  }

  /**
   * What a day reads, top to bottom. The moment is the headline, then
   * what is on the client, then the content, then our own tasks. With
   * only three chips to spend before the day collapses into "+N more",
   * the cut has to fall on our side of the list, not theirs.
   */
  const DAY_ORDER: Layer[] = ['moments', 'todos', 'posts', 'films', 'blueprint'];

  /**
   * Which of its layers an item is read as, when it belongs to more
   * than one. Only layers that are switched on count: under "Content
   * only" a post the client still has to put up is a post, because
   * the to-do layer it also belongs to is not on screen to explain
   * itself. The fallback keeps the function total.
   */
  function dayRank(it: PortalCalendarItem): number {
    const ls = layersOf(it);
    let best = DAY_ORDER.length;
    for (const l of ls) {
      if (CAL.layers.has(l)) best = Math.min(best, DAY_ORDER.indexOf(l));
    }
    if (best < DAY_ORDER.length) return best;
    for (const l of ls) best = Math.min(best, DAY_ORDER.indexOf(l));
    return best;
  }

  function sortDay(items: PortalCalendarItem[]): PortalCalendarItem[] {
    return items.slice().sort((a, b) => dayRank(a) - dayRank(b));
  }

  /* ── dragging a card onto a day ───────────────────────────────
     Desktop only. A phone gets the Schedule button in the drawer. */
  let CALDRAG: PortalContentItem | null = null;

  /** Whether the client may give this card a date at all. One we post,
   *  and one already posted, are theirs to read and not to move. */
  function canSchedule(c: PortalContentItem): boolean {
    return c.status !== 'Posted' && c.postedBy !== 'Blueprint';
  }

  const isoOf = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

  function dayDropTarget(cell: HTMLElement, day: Date) {
    cell.addEventListener('dragover', (ev) => {
      if (!CALDRAG) return;
      ev.preventDefault();
      if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'move';
      cell.classList.add('pt-cal-cell-drop');
    });
    cell.addEventListener('dragleave', (ev) => {
      // Crossing onto a chip inside the cell fires dragleave on the
      // cell. Without this the highlight strobes under the pointer.
      if (cell.contains(ev.relatedTarget as Node)) return;
      cell.classList.remove('pt-cal-cell-drop');
    });
    cell.addEventListener('drop', (ev) => {
      ev.preventDefault();
      cell.classList.remove('pt-cal-cell-drop');
      const c = CALDRAG;
      CALDRAG = null;
      if (c) void scheduleCard(c, isoOf(day));
    });
  }

  async function scheduleCard(c: PortalContentItem, iso: string) {
    if (c.postDate === iso) return;
    if (!canSchedule(c)) { toast('That one is ours to schedule.', true); return; }
    const had = c.postDate;
    const patch: Record<string, unknown> = { postDate: iso };
    const local: Partial<PortalContentItem> = { postDate: iso };
    // A dated idea is not an idea any more, and the board would put it
    // nowhere. The create endpoint defaults the same way.
    if (c.status === 'Idea') { patch.status = 'Planned'; local.status = 'Planned'; }
    if (await saveCard(c.id, patch, local)) {
      toast(had ? `Moved to ${fmtDate(iso)}` : `Scheduled for ${fmtDate(iso)}`);
    }
  }

  function byDay(items: PortalCalendarItem[]): Map<string, PortalCalendarItem[]> {
    const m = new Map<string, PortalCalendarItem[]>();
    for (const it of items) {
      const d = parseNotionDate(it.date);
      if (!d) continue;
      const k = keyOf(d);
      const arr = m.get(k);
      if (arr) arr.push(it); else m.set(k, [it]);
    }
    return m;
  }

  function monthView(items: PortalCalendarItem[]): HTMLElement {
    const wrap = el('div', 'pt-cal');
    const dow = el('div', 'pt-cal-dow');
    for (const d of DOW) dow.appendChild(el('div', undefined, d));
    wrap.appendChild(dow);

    const grid = el('div', 'pt-cal-grid');
    const map = byDay(items);
    const today = todayStart();

    const first = new Date(CAL.cursor.getFullYear(), CAL.cursor.getMonth(), 1);
    const start = new Date(first);
    start.setDate(1 - first.getDay());
    const last = new Date(CAL.cursor.getFullYear(), CAL.cursor.getMonth() + 1, 0);
    const weeks = Math.ceil((first.getDay() + last.getDate()) / 7);

    for (let i = 0; i < weeks * 7; i++) {
      const day = new Date(start);
      day.setDate(start.getDate() + i);
      const inMonth = day.getMonth() === CAL.cursor.getMonth();
      const cell = el('div', 'pt-cal-cell' + (inMonth ? '' : ' pt-cal-cell-out'));
      if (sameDay(day, today)) cell.classList.add('pt-cal-cell-today');
      if (CAL.selected && sameDay(day, CAL.selected)) cell.classList.add('pt-cal-cell-selected');

      const dayItems = sortDay(map.get(keyOf(day)) ?? []);

      if (isNarrow()) {
        const btn = el('button', 'pt-cal-date pt-num', String(day.getDate()));
        btn.type = 'button';
        btn.setAttribute('aria-label', `${fmtDayLong(day)}, ${dayItems.length} item${dayItems.length === 1 ? '' : 's'}`);
        btn.addEventListener('click', () => { CAL.selected = day; drawCalendar(); });
        cell.appendChild(btn);
        if (dayItems.length) {
          const dots = el('div', 'pt-dots');
          for (const it of dayItems.slice(0, 4)) dots.appendChild(el('span', `pt-dot pt-dot-${kindOf(it)}`));
          cell.appendChild(dots);
        }
      } else {
        cell.appendChild(el('span', 'pt-cal-date pt-num', String(day.getDate())));
        for (const it of dayItems.slice(0, 3)) cell.appendChild(chip(it));
        if (dayItems.length > 3) {
          const more = el('button', 'pt-chip-more', `+${dayItems.length - 3} more`);
          more.type = 'button';
          more.addEventListener('click', (ev) => {
            ev.stopPropagation();
            openPopover(more, day, dayItems);
          });
          cell.appendChild(more);
        }
        dayDropTarget(cell, day);
      }
      grid.appendChild(cell);
    }
    wrap.appendChild(grid);
    return wrap;
  }

  function chip(it: PortalCalendarItem): HTMLElement {
    const row = it as CalRow;
    // A content card wears its bucket's colour, because on the board it
    // already does. Film dates are the same colour, dashed: the same
    // piece of content, one step earlier.
    if (row.content && row.contentRole) {
      const c = row.content;
      const done = c.status === 'Posted';
      const b = el('button', `pt-chip pt-chip-${row.contentRole} pt-nc-${bucketColor(c.bucket)}`
        + (done ? ' pt-chip-done' : ''));
      b.type = 'button';
      // A post that already went out is a record, not a plan, so it
      // steps back and wears a tick rather than shouting at the month.
      if (done) b.appendChild(icon('check', 'pt-chip-tick'));
      b.appendChild(el('span', 'pt-chip-title', it.title));
      if (row.moment) b.appendChild(el('span', 'pt-chip-moment', row.moment.title));
      b.title = row.contentRole === 'film'
        ? `Film by: ${c.title}`
        : `Posts: ${c.title}${c.bucket ? ` · ${c.bucket}` : ''}`;
      b.addEventListener('click', (ev) => { ev.stopPropagation(); openDrawer(it); });

      // A post date the client owns can be dragged to another day. A
      // film date cannot: the shoot is planned around other things.
      if (row.contentRole === 'post' && canSchedule(c) && !isNarrow()) {
        b.draggable = true;
        b.addEventListener('dragstart', (ev) => {
          CALDRAG = c;
          b.classList.add('pt-chip-dragging');
          ev.dataTransfer?.setData('text/plain', c.title);
          if (ev.dataTransfer) ev.dataTransfer.effectAllowed = 'move';
        });
        b.addEventListener('dragend', () => {
          CALDRAG = null;
          b.classList.remove('pt-chip-dragging');
        });
      }
      return b;
    }
    const k = kindOf(it);
    const m = it.moment;
    // The fill says what KIND of work this is; the left edge says which
    // campaign it belongs to. Two campaigns in one week are otherwise a
    // wall of identical blue.
    const cls = `pt-chip pt-chip-${k}`
      + (it.tentative ? ' pt-chip-tentative' : '')
      + (m ? ` pt-edge-${momentKind(m)}` : '');
    const b = el('button', cls);
    b.type = 'button';
    b.appendChild(el('span', 'pt-chip-title', it.title));
    if (m) b.appendChild(el('span', 'pt-chip-moment', m.title));
    b.title = m
      ? `${KIND_LABEL[k]}: ${it.title} — part of ${m.title}`
      : `${KIND_LABEL[k]}: ${it.title}`;
    b.addEventListener('click', (ev) => { ev.stopPropagation(); openDrawer(it); });
    return b;
  }

  function weekView(items: PortalCalendarItem[]): HTMLElement {
    const wrap = el('div', 'pt-cal');
    const map = byDay(items);
    const today = todayStart();
    const start = new Date(CAL.cursor);
    start.setDate(start.getDate() - start.getDay());

    const dow = el('div', 'pt-cal-dow');
    for (let i = 0; i < 7; i++) {
      const d = new Date(start); d.setDate(start.getDate() + i);
      dow.appendChild(el('div', undefined, `${DOW[i]} ${d.getDate()}`));
    }
    wrap.appendChild(dow);

    const grid = el('div', 'pt-week');
    for (let i = 0; i < 7; i++) {
      const day = new Date(start); day.setDate(start.getDate() + i);
      const cell = el('div', 'pt-cal-cell');
      if (sameDay(day, today)) cell.classList.add('pt-cal-cell-today');
      for (const it of sortDay(map.get(keyOf(day)) ?? [])) cell.appendChild(chip(it));
      if (!isNarrow()) dayDropTarget(cell, day);
      grid.appendChild(cell);
    }
    wrap.appendChild(grid);
    return wrap;
  }

  function agendaView(items: PortalCalendarItem[]): HTMLElement {
    const wrap = el('div');
    const today = todayStart();
    // The agenda follows the cursor, like the other two views. It used
    // to list every dated row there was, which was fine with a handful
    // of campaign steps and useless against a year of posted history:
    // the month buttons appeared to do nothing and February was four
    // thousand pixels up.
    const dated = items.filter((i) => {
      const d = parseNotionDate(i.date);
      return !!d && d.getFullYear() === CAL.cursor.getFullYear()
                 && d.getMonth() === CAL.cursor.getMonth();
    });
    if (!dated.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('cal'));
      e.append(ic,
        el('h3', undefined, `Nothing in ${MONTHS[CAL.cursor.getMonth()]}`),
        el('p', undefined, calFiltering()
          ? 'Turn a layer back on, or step to another month.'
          : 'Step to another month to see what is planned.'));
      wrap.appendChild(e);
      return wrap;
    }
    const map = byDay(dated);
    const keys = Array.from(map.keys()).sort((a, b) => {
      const [ay, am, ad] = a.split('-').map(Number);
      const [by, bm, bd] = b.split('-').map(Number);
      return new Date(ay, am, ad).getTime() - new Date(by, bm, bd).getTime();
    });

    for (const k of keys) {
      const [y, m, d] = k.split('-').map(Number);
      const day = new Date(y, m, d);
      const group = el('section', 'pt-agenda-day');
      const head = el('h3', 'pt-agenda-date' + (sameDay(day, today) ? ' pt-agenda-date-today' : ''));
      head.appendChild(el('span', undefined, fmtDayLong(day)));
      if (sameDay(day, today)) head.appendChild(el('span', 'pt-tag', 'Today'));
      group.appendChild(head);
      const list = el('ul');
      for (const it of sortDay(map.get(k)!)) list.appendChild(itemRow(it));
      group.appendChild(list);
      wrap.appendChild(group);
    }
    return wrap;
  }

  function selectedDayList(items: PortalCalendarItem[]): HTMLElement {
    const day = CAL.selected!;
    const map = byDay(items);
    const dayItems = map.get(keyOf(day)) ?? [];
    const card = el('section', 'pt-card');
    card.style.marginTop = 'var(--pt-4)';
    const head = el('div', 'pt-card-head');
    head.appendChild(el('h2', undefined, fmtDayLong(day)));
    card.appendChild(head);
    const body = el('div', 'pt-card-body');
    if (!dayItems.length) {
      body.appendChild(el('p', 'pt-kpi-note', 'Nothing scheduled on this day.'));
    } else {
      const list = el('ul');
      for (const it of dayItems) list.appendChild(itemRow(it));
      body.appendChild(list);
    }
    card.appendChild(body);
    return card;
  }

  function legend(): HTMLElement {
    const wrap = el('div', 'pt-legend');
    wrap.setAttribute('aria-label', 'What the colours mean');
    for (const [k, text] of [
      ['show', 'Show'], ['release', 'Release'], ['content', 'Content step'],
      ['moment', 'Moment'], ['todo', 'Your to-do'],
    ] as const) {
      const item = el('span', 'pt-legend-item');
      item.append(el('span', `pt-legend-key pt-legend-${k}`), el('span', undefined, text));
      wrap.appendChild(item);
    }
    const post = el('span', 'pt-legend-item');
    post.append(el('span', 'pt-legend-key pt-legend-post'),
                el('span', undefined, 'A post (bucket colour)'));
    wrap.appendChild(post);
    const film = el('span', 'pt-legend-item');
    film.append(el('span', 'pt-legend-key pt-legend-film'), el('span', undefined, 'A shoot'));
    wrap.appendChild(film);
    const t = el('span', 'pt-legend-item');
    t.append(el('span', 'pt-legend-key pt-chip-tentative', ''), el('span', undefined, 'Tentative (dashed)'));
    wrap.appendChild(t);
    return wrap;
  }

  /* ── the unscheduled tray ─────────────────────────────────────
     A well of cards with no post date, beside the month. It is a
     staging area rather than a view of the calendar, so the layer
     chips and the filters above do not touch it: it has its own
     search, and grouping by bucket does the rest. */

  function unscheduled(): PortalContentItem[] {
    return CON.items.filter(
      (c) => (c.status === 'Idea' || c.status === 'Planned') && !c.postDate);
  }

  function unscheduledTray(): HTMLElement | null {
    if (!CAL.tray) return null;
    const all = unscheduled();
    const aside = el('aside', 'pt-tray');

    const head = el('div', 'pt-tray-head');
    head.appendChild(el('h3', undefined, 'Unscheduled'));
    head.appendChild(el('span', 'pt-tray-n pt-num', String(all.length)));
    const x = el('button', 'pt-tray-close');
    x.type = 'button';
    x.setAttribute('aria-label', 'Hide unscheduled');
    x.appendChild(icon('close'));
    x.addEventListener('click', () => { CAL.tray = false; saveCalPrefs(); drawCalendar(); });
    head.appendChild(x);
    aside.appendChild(head);

    const search = el('input', 'pt-input pt-tray-search') as HTMLInputElement;
    search.type = 'search';
    search.placeholder = 'Title or shoot code';
    search.setAttribute('aria-label', 'Search unscheduled');
    search.value = CAL.traySearch;
    search.addEventListener('input', () => {
      CAL.traySearch = search.value;
      drawCalendar();
      const again = q<HTMLInputElement>('.pt-tray-search');
      if (again) { again.focus(); again.setSelectionRange(again.value.length, again.value.length); }
    });
    aside.appendChild(search);

    const needle = CAL.traySearch.trim().toLowerCase();
    const items = needle
      ? all.filter((c) => c.title.toLowerCase().includes(needle)
          || (c.shootCode ?? '').toLowerCase().includes(needle))
      : all;

    if (!items.length) {
      aside.appendChild(el('p', 'pt-tray-none',
        all.length ? 'Nothing matches that.' : 'Everything you have has a date on it.'));
      return aside;
    }

    aside.appendChild(el('p', 'pt-tray-hint', 'Drag one onto a day to give it a post date.'));

    const groups = new Map<string, PortalContentItem[]>();
    for (const c of items) {
      const k = c.bucket ?? '';
      const arr = groups.get(k);
      if (arr) arr.push(c); else groups.set(k, [c]);
    }
    // Bucket order follows Notion, so the tray and the Ideas board
    // read in the same order. No bucket at all sorts last.
    const order = CON.schema.bucket.map((o) => o.name);
    const keys = Array.from(groups.keys()).sort((a, b) =>
      (a ? order.indexOf(a) : order.length) - (b ? order.indexOf(b) : order.length));

    const body = el('div', 'pt-tray-body');
    for (const k of keys) {
      const list = groups.get(k)!;
      const g = el('div', 'pt-tray-group' + (k ? ` pt-nc-${bucketColor(k)}` : ''));
      const gh = el('div', 'pt-tray-group-head');
      gh.append(
        el('span', 'pt-tray-dot'),
        el('span', undefined, k || 'No bucket yet'),
        el('span', 'pt-tray-gn pt-num', String(list.length)),
      );
      g.appendChild(gh);
      for (const c of list) g.appendChild(trayCard(c));
      body.appendChild(g);
    }
    aside.appendChild(body);
    return aside;
  }

  function trayCard(c: PortalContentItem): HTMLElement {
    const card = el('article', 'pt-traycard');
    const open = el('button', 'pt-traycard-open');
    open.type = 'button';
    open.setAttribute('aria-label', `Open ${c.title}`);
    open.appendChild(el('span', 'pt-traycard-title', c.title));
    if (c.filmBy) {
      open.appendChild(el('span', 'pt-traycard-meta', `Film by ${fmtDateShort(c.filmBy)}`));
    }
    open.addEventListener('click', () => openContentDrawer(c));
    card.appendChild(open);

    if (canSchedule(c)) {
      card.draggable = true;
      const grip = el('span', 'pt-traycard-grip');
      grip.setAttribute('aria-hidden', 'true');
      grip.appendChild(icon('grip'));
      card.appendChild(grip);
      card.addEventListener('dragstart', (ev) => {
        CALDRAG = c;
        card.classList.add('pt-traycard-dragging');
        ev.dataTransfer?.setData('text/plain', c.title);
        if (ev.dataTransfer) ev.dataTransfer.effectAllowed = 'move';
      });
      card.addEventListener('dragend', () => {
        CALDRAG = null;
        card.classList.remove('pt-traycard-dragging');
      });
    } else {
      card.classList.add('pt-traycard-locked');
      card.title = 'We put this one out, so we schedule it.';
    }
    return card;
  }

  /* ── "+N more" popover ─────────────────────────────────────── */
  let POP: HTMLElement | null = null;

  function closePopover() { if (POP) { POP.remove(); POP = null; } }

  function openPopover(anchor: HTMLElement, day: Date, items: PortalCalendarItem[]) {
    closePopover();
    const pop = el('div', 'pt-popover');
    pop.appendChild(el('div', 'pt-popover-title', fmtDayLong(day)));
    // A day that overflowed is a day with several kinds of thing on
    // it, so the popover says which is which rather than handing over
    // one more undifferentiated list.
    for (let i = 0; i < DAY_ORDER.length; i++) {
      const inLayer = items.filter((it) => dayRank(it) === i);
      if (!inLayer.length) continue;
      pop.appendChild(el('div', 'pt-popover-group', LAYER_LABEL.get(DAY_ORDER[i])!));
      for (const it of inLayer) pop.appendChild(chip(it));
    }
    document.body.appendChild(pop);

    const r = anchor.getBoundingClientRect();
    const top = Math.min(r.bottom + window.scrollY + 4, window.scrollY + window.innerHeight - 330);
    const left = Math.min(r.left + window.scrollX, window.scrollX + window.innerWidth - 268);
    pop.style.top = `${Math.max(window.scrollY + 8, top)}px`;
    pop.style.left = `${Math.max(8, left)}px`;
    POP = pop;

    setTimeout(() => {
      document.addEventListener('click', onDocClick, { once: true });
    }, 0);
  }
  function onDocClick(ev: MouseEvent) {
    if (POP && !POP.contains(ev.target as Node)) closePopover();
    else if (POP) setTimeout(() => document.addEventListener('click', onDocClick, { once: true }), 0);
  }

  /* ── detail drawer ─────────────────────────────────────────── */
  let LAST_FOCUS: HTMLElement | null = null;

  function openDrawer(it: PortalCalendarItem) {
    // A content row on the calendar is the same card as on the board,
    // so it opens the editable drawer, not the read-only one.
    const row = it as CalRow;
    if (row.content) { openContentDrawer(row.content); return; }
    DRAWER_ID = '';
    const drawer = q('[data-drawer]');
    const scrim = q('[data-scrim]');
    const title = q('[data-drawer-title]');
    const body = q('[data-drawer-body]');
    const foot = q('[data-drawer-foot]');
    if (!drawer || !scrim || !title || !body || !foot) return;

    LAST_FOCUS = document.activeElement as HTMLElement;
    title.textContent = it.title;
    clear(body);
    clear(foot);

    const k = kindOf(it);
    const tags = el('div');
    tags.style.cssText = 'display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px';
    const kindTag = el('span', `pt-tag`, KIND_LABEL[k]);
    if (k === 'todo') kindTag.className = 'pt-tag pt-tag-todo';
    tags.appendChild(kindTag);
    if (it.tentative) tags.appendChild(el('span', 'pt-tag pt-tag-tentative', 'Tentative'));
    body.appendChild(tags);

    if (it.moment) {
      const m = it.moment;
      const box = el('div', `pt-partof pt-edge-${momentKind(m)}`);
      box.appendChild(el('div', 'pt-partof-label', 'Part of'));
      box.appendChild(el('div', 'pt-partof-name', m.title));
      // The phase usually already starts with the playbook name
      // ("Pre-Show · Announce"), so naming both reads as a stutter.
      const phaseCoversPlaybook = !!it.playbook && !!it.phase && it.phase.startsWith(it.playbook);
      const meta = [m.momentType, fmtDate(m.date), phaseCoversPlaybook ? null : it.playbook, it.phase]
        .filter(Boolean).join(' · ');
      if (meta) box.appendChild(el('div', 'pt-partof-meta', meta));
      body.appendChild(box);

      const all = el('button', 'pt-btn');
      all.type = 'button';
      all.style.marginBottom = 'var(--pt-5)';
      all.textContent = 'See all steps for this moment';
      all.addEventListener('click', () => {
        closeDrawer();
        filterToCampaign(m.id);
      });
      body.appendChild(all);
    }

    const dl = el('dl', 'pt-deflist');
    const add = (label: string, value: string | null) => {
      if (!value) return;
      dl.append(el('dt', undefined, label), el('dd', undefined, value));
    };
    add('Date', fmtDate(it.date));
    add('Status', it.status);
    add('Channel', it.where);
    add('Venue', it.venueCity);
    add('Playbook', it.playbook);
    add('Phase', it.phase);
    add('Owner', it.owner);
    if (typeof it.streamsToDate === 'number') add('Streams to date', fmtNumber(it.streamsToDate));
    if (typeof it.ticketsSold === 'number') {
      add('Tickets sold', sellLabel(it.ticketsSold, it.capacity));
    } else if (typeof it.capacity === 'number') {
      add('Capacity', `${fmtNumber(it.capacity)} tickets`);
    }
    body.appendChild(dl);

    if (it.whyItMatters) {
      const why = el('div', 'pt-why');
      why.appendChild(el('strong', undefined, 'Why it matters'));
      why.appendChild(el('span', undefined, it.whyItMatters));
      body.appendChild(why);
    }

    if (it.ticketLink) {
      const a = el('a', 'pt-btn pt-btn-primary');
      (a as HTMLAnchorElement).href = it.ticketLink;
      (a as HTMLAnchorElement).target = '_blank';
      (a as HTMLAnchorElement).rel = 'noopener noreferrer';
      a.appendChild(icon('ticket'));
      a.appendChild(el('span', undefined, 'Tickets & RSVP'));
      a.style.width = '100%';
      foot.appendChild(a);
      show(foot, true);
    } else {
      show(foot, false);
    }

    show(scrim, true);
    show(drawer, true);
    requestAnimationFrame(() => {
      scrim.dataset.open = 'true';
      drawer.dataset.open = 'true';
    });
    q<HTMLButtonElement>('[data-drawer-close]')?.focus();
    document.addEventListener('keydown', onDrawerKey);
  }

  function closeDrawer() {
    const drawer = q('[data-drawer]');
    const scrim = q('[data-scrim]');
    if (!drawer || !scrim || drawer.hidden) return;
    drawer.dataset.open = 'false';
    scrim.dataset.open = 'false';
    document.removeEventListener('keydown', onDrawerKey);
    setTimeout(() => { show(drawer, false); show(scrim, false); }, 200);
    LAST_FOCUS?.focus();
    LAST_FOCUS = null;
  }

  function onDrawerKey(ev: KeyboardEvent) {
    if (ev.key === 'Escape') { ev.preventDefault(); closeDrawer(); return; }
    if (ev.key !== 'Tab') return;
    // Keep focus inside the dialog while it is open.
    const drawer = q('[data-drawer]');
    if (!drawer) return;
    const f = qq<HTMLElement>('a[href], button:not(:disabled), [tabindex]:not([tabindex="-1"])', drawer);
    if (!f.length) return;
    const first = f[0], last = f[f.length - 1];
    if (ev.shiftKey && document.activeElement === first) { ev.preventDefault(); last.focus(); }
    else if (!ev.shiftKey && document.activeElement === last) { ev.preventDefault(); first.focus(); }
  }

  /* ── content pipeline ─────────────────────────────────────────
     This tab replaces the board a client was keeping somewhere else,
     so it has to feel like a board: columns, cards, drag, one tap to
     add. Everything here is the SAME rows Blueprint works from, which
     is the whole point of moving it.

     It is also the only writable surface in the portal. Every save
     goes through the endpoints under functions/portal/[slug]/content/,
     which re-check ownership and the status rules server-side. Nothing
     below is trusted to enforce anything; it only tries not to offer
     what the server would refuse. */

  type ContentView = 'ideas' | 'pipeline' | 'posted';

  const CON = {
    view: 'ideas' as ContentView,
    bucket: '',
    source: '',
    campaign: '',
    search: '',
    /** On a phone one column shows at a time; this is which. */
    col: '',
    items: [] as PortalContentItem[],
    schema: { bucket: [], format: [], platforms: [], status: [] } as PortalContentSchema,
  };

  /** The Notion colour of a bucket, so a card in the portal and the
   *  same row in Notion read as the same thing. */
  function bucketColor(name: string | null): string {
    if (!name) return 'default';
    return CON.schema.bucket.find((o) => o.name === name)?.color ?? 'default';
  }

  const SOURCE_ICON: Record<string, string> = {
    'Client Films': 'film',
    'Show Media': 'ticket',
    'Flyer / Graphic': 'folder',
  };

  function renderContent(data: PortalPayload) {
    CON.items = (data.content ?? []).slice();
    if (data.contentSchema) CON.schema = data.contentSchema;
    CON.col = '';
    drawContent();
  }

  /** The content a card's own title and shoot code answer to. */
  function conMatchesSearch(c: PortalContentItem): boolean {
    if (!CON.search) return true;
    const needle = CON.search.toLowerCase();
    return c.title.toLowerCase().includes(needle)
      || (c.shootCode ?? '').toLowerCase().includes(needle);
  }

  function conFiltered(): PortalContentItem[] {
    return CON.items.filter((c) => {
      if (CON.bucket && c.bucket !== CON.bucket) return false;
      if (CON.source && c.source !== CON.source) return false;
      if (CON.campaign && !c.campaign.some((id) => normaliseId(id) === normaliseId(CON.campaign))) return false;
      return conMatchesSearch(c);
    });
  }

  /** Whether the board is showing a slice rather than the whole thing.
   *  An empty slice and an empty board need different words. */
  function conFiltering(): boolean {
    return !!(CON.bucket || CON.source || CON.campaign || CON.search.trim());
  }

  function drawContent() {
    const root = q('[data-view="content"]');
    if (!root) return;
    const scroll = qq('[data-board-scroll]', root)[0]?.scrollLeft ?? 0;
    clear(root);
    root.appendChild(contentToolbar());

    const items = conFiltered();
    if (!CON.items.length) {
      root.appendChild(contentEmpty(
        'Your content board starts here',
        'Ideas you jot down, shoots we plan and posts that go out all live on this one board.',
      ));
      root.appendChild(newIdeaFab());
      return;
    }

    if (CON.view === 'ideas') root.appendChild(ideasBoard(items));
    else if (CON.view === 'pipeline') root.appendChild(pipelineBoard(items));
    else root.appendChild(postedList(items));

    const sc = qq('[data-board-scroll]', root)[0];
    if (sc) sc.scrollLeft = scroll;
    root.appendChild(newIdeaFab());
  }

  function contentEmpty(title: string, body: string): HTMLElement {
    const e = el('div', 'pt-empty');
    const ic = el('div', 'pt-empty-icon');
    ic.appendChild(icon('film'));
    e.append(ic, el('h3', undefined, title), el('p', undefined, body));
    return e;
  }

  function contentToolbar(): HTMLElement {
    const bar = el('div', 'pt-toolbar');

    const seg = el('div', 'pt-seg');
    seg.setAttribute('role', 'group');
    seg.setAttribute('aria-label', 'Content view');
    for (const [v, text] of [['ideas', 'Ideas'], ['pipeline', 'Pipeline'], ['posted', 'Posted']] as const) {
      const b = el('button', undefined, text);
      b.type = 'button';
      b.setAttribute('aria-pressed', String(CON.view === v));
      b.addEventListener('click', () => { CON.view = v; CON.col = ''; drawContent(); });
      seg.appendChild(b);
    }
    bar.append(seg, el('span', 'pt-toolbar-spacer'));

    const search = el('input', 'pt-input pt-input-search') as HTMLInputElement;
    search.type = 'search';
    search.placeholder = 'Title or shoot code';
    search.setAttribute('aria-label', 'Search content');
    search.value = CON.search;
    search.addEventListener('input', () => {
      CON.search = search.value.trim();
      drawContent();
      q<HTMLInputElement>('.pt-input-search')?.focus();
    });
    bar.appendChild(search);

    const pick = (label: string, value: string, opts: Array<[string, string]>, set: (v: string) => void) => {
      const sel = el('select', 'pt-select') as HTMLSelectElement;
      sel.setAttribute('aria-label', label);
      for (const [v, text] of opts) {
        const o = el('option', undefined, text) as HTMLOptionElement;
        o.value = v;
        if (value === v) o.selected = true;
        sel.appendChild(o);
      }
      sel.addEventListener('change', () => { set(sel.value); CON.col = ''; drawContent(); });
      return sel;
    };

    bar.appendChild(pick('Filter by bucket', CON.bucket,
      [['', 'Every bucket'], ...CON.schema.bucket.map((o) => [o.name, o.name] as [string, string])],
      (v) => { CON.bucket = v; }));

    const sources = Array.from(new Set(CON.items.map((c) => c.source).filter(Boolean) as string[]));
    if (sources.length > 1) {
      bar.appendChild(pick('Filter by source', CON.source,
        [['', 'Any source'], ...sources.map((s) => [s, s] as [string, string])],
        (v) => { CON.source = v; }));
    }

    const camps = campaigns();
    if (camps.length) {
      bar.appendChild(pick('Filter by campaign', CON.campaign,
        [['', 'Every campaign'], ...camps.map((m) => [m.id, m.title] as [string, string])],
        (v) => { CON.campaign = v; }));
    }

    const add = el('button', 'pt-btn pt-btn-primary pt-btn-add');
    add.type = 'button';
    add.appendChild(icon('plus'));
    add.appendChild(el('span', undefined, 'New idea'));
    add.addEventListener('click', () => openQuickAdd(CON.bucket || null));
    bar.appendChild(add);

    return bar;
  }

  /** The sticky button a thumb can always reach. */
  function newIdeaFab(): HTMLElement {
    const b = el('button', 'pt-fab');
    b.type = 'button';
    b.setAttribute('aria-label', 'New idea');
    b.appendChild(icon('plus'));
    b.appendChild(el('span', undefined, 'New idea'));
    b.addEventListener('click', () => openQuickAdd(CON.bucket || null));
    return b;
  }

  /* ── the boards ───────────────────────────────────────────────── */

  interface Column {
    key: string;
    title: string;
    color?: string;
    items: PortalContentItem[];
    /** What a card dropped here becomes. Absent means no drop target. */
    onDrop?: (c: PortalContentItem) => void;
    /** Whether this card may be dropped here at all. */
    accepts?: (c: PortalContentItem) => boolean;
    add?: () => void;
    /** The column heading already names the bucket. */
    hideBucket?: boolean;
  }

  function ideasBoard(items: PortalContentItem[]): HTMLElement {
    const well = items.filter(isIdea);
    const cols: Column[] = CON.schema.bucket.map((o) => ({
      key: o.name,
      title: o.name,
      color: o.color,
      items: well.filter((c) => c.bucket === o.name),
      accepts: () => true,
      onDrop: (c) => { void setBucket(c, o.name); },
      add: () => openQuickAdd(o.name),
      hideBucket: true,
    }));
    // A card with no bucket yet would otherwise be invisible, which is
    // the one thing an idea well must never do.
    const loose = well.filter((c) => !c.bucket);
    if (loose.length) {
      cols.unshift({
        key: '', title: 'No bucket yet', items: loose,
        accepts: () => true, onDrop: (c) => { void setBucket(c, null); },
        add: () => openQuickAdd(null),
      });
    }
    return board(cols, 'Your idea well is empty',
                 'Jot one down and it lands here, ready to plan when you are.');
  }

  function pipelineBoard(items: PortalContentItem[]): HTMLElement {
    const now = todayStart();
    const cols: Column[] = STAGE_ORDER.map((stage) => ({
      key: stage,
      title: STAGE_TITLE[stage],
      items: items.filter((c) => stageOf(c, now) === stage),
      accepts: (c) => !!stageTarget(stage) && canClientMove(c.status, stageTarget(stage)!),
      onDrop: (c) => {
        const to = stageTarget(stage);
        if (to) void setStatus(c, to);
      },
    }));
    return board(cols, 'Nothing is moving yet',
                 'An idea joins the pipeline as soon as it has a shoot date or a post date.');
  }

  /** The status a drop into this column means. Columns a client cannot
   *  put a card into on their own have none. */
  function stageTarget(stage: Stage): string | null {
    switch (stage) {
      case 'planned': return 'Planned';
      case 'toFilm':  return 'Planned';
      case 'filmed':  return 'Filmed';
      case 'ready':   return 'Approved';
      case 'posted':  return 'Posted';
      default:        return null;   // In edit and Your review are ours
    }
  }

  function board(cols: Column[], emptyTitle: string, emptyBody: string): HTMLElement {
    const total = cols.reduce((n, c) => n + c.items.length, 0);
    if (!total) {
      return conFiltering()
        ? contentEmpty('Nothing matches that',
                       'Try a different filter to see the rest of your board.')
        : contentEmpty(emptyTitle, emptyBody);
    }

    const wrap = el('div', 'pt-boardwrap');

    // On a phone, a pill row picks the one column worth the width.
    if (isNarrow()) {
      if (!CON.col || !cols.some((c) => c.key === CON.col)) {
        CON.col = (cols.find((c) => c.items.length) ?? cols[0]).key;
      }
      const pills = el('div', 'pt-pillrow');
      pills.setAttribute('role', 'tablist');
      for (const c of cols) {
        const b = el('button', 'pt-pill' + (c.key === CON.col ? ' pt-pill-on' : ''));
        b.type = 'button';
        b.setAttribute('aria-pressed', String(c.key === CON.col));
        if (c.color) b.classList.add(`pt-nc-${c.color}`);
        b.append(el('span', undefined, c.title), el('span', 'pt-pill-n pt-num', String(c.items.length)));
        b.addEventListener('click', () => { CON.col = c.key; drawContent(); });
        pills.appendChild(b);
      }
      wrap.appendChild(pills);
      const only = cols.find((c) => c.key === CON.col)!;
      wrap.appendChild(boardColumn(only));
      return wrap;
    }

    const scroller = el('div', 'pt-board');
    scroller.dataset.boardScroll = 'true';
    for (const c of cols) scroller.appendChild(boardColumn(c));
    wrap.appendChild(scroller);
    return wrap;
  }

  let DRAG: PortalContentItem | null = null;

  function boardColumn(c: Column): HTMLElement {
    const col = el('section', 'pt-board-col');
    if (c.color) col.classList.add(`pt-nc-${c.color}`);
    col.appendChild(el('span', 'pt-board-accent'));

    const head = el('div', 'pt-board-col-head');
    head.appendChild(el('h3', undefined, c.title));
    head.appendChild(el('span', 'pt-board-count pt-num', String(c.items.length)));
    if (c.add && !isNarrow()) {
      const plus = el('button', 'pt-board-add');
      plus.type = 'button';
      plus.setAttribute('aria-label', `New idea in ${c.title}`);
      plus.appendChild(icon('plus'));
      plus.addEventListener('click', c.add);
      head.appendChild(plus);
    }
    col.appendChild(head);

    const list = el('div', 'pt-board-list');
    if (!c.items.length) list.appendChild(el('p', 'pt-board-none', 'Nothing here'));
    for (const item of c.items) list.appendChild(contentCard(item, { hideBucket: c.hideBucket }));

    if (c.onDrop && !isNarrow()) {
      list.addEventListener('dragover', (ev) => {
        if (!DRAG) return;
        if (c.accepts && !c.accepts(DRAG)) return;
        if (c.items.some((i) => i.id === DRAG!.id)) return;
        ev.preventDefault();
        list.classList.add('pt-board-drop');
      });
      list.addEventListener('dragleave', () => list.classList.remove('pt-board-drop'));
      list.addEventListener('drop', (ev) => {
        ev.preventDefault();
        list.classList.remove('pt-board-drop');
        const card = DRAG;
        DRAG = null;
        if (!card) return;
        if (c.accepts && !c.accepts(card)) return;
        c.onDrop!(card);
      });
    }
    col.appendChild(list);
    return col;
  }

  function contentCard(c: PortalContentItem, opts: { hideBucket?: boolean } = {}): HTMLElement {
    const card = el('article', 'pt-ccard');
    const open = el('button', 'pt-ccard-open');
    open.type = 'button';
    open.setAttribute('aria-label', `Open ${c.title}`);
    open.addEventListener('click', () => openContentDrawer(c));

    // A shoot-code title ("SM L1D1") is how he names things, so it is
    // shown exactly as typed, on one line, and never prettied up.
    const title = el('span', 'pt-ccard-title', c.title);
    open.appendChild(title);

    const tags = el('span', 'pt-ccard-tags');
    // On the Ideas board the column already says the bucket, and a
    // chip repeating it on every card is noise in a tight space.
    if (c.bucket && !opts.hideBucket) {
      tags.appendChild(el('span', `pt-bchip pt-nc-${bucketColor(c.bucket)}`, c.bucket));
    }
    for (const f of c.format) tags.appendChild(el('span', 'pt-tag', f));
    if (c.shootCode && c.shootCode !== c.title) {
      tags.appendChild(el('span', 'pt-ccard-code pt-num', c.shootCode));
    }
    if (tags.firstChild) open.appendChild(tags);

    const meta = el('span', 'pt-ccard-meta');
    const next = nextDateLine(c);
    if (next) meta.appendChild(el('span', undefined, next));
    if (c.source && SOURCE_ICON[c.source]) {
      const s = el('span', 'pt-ccard-src');
      s.appendChild(icon(SOURCE_ICON[c.source]));
      s.appendChild(el('span', undefined, c.source));
      meta.appendChild(s);
    }
    if (meta.firstChild) open.appendChild(meta);

    const badges = el('span', 'pt-ccard-badges');
    if (c.postedBy === 'Client') badges.appendChild(el('span', 'pt-tag pt-tag-todo', 'You post'));
    if (c.status === 'Ready for Review') {
      badges.appendChild(el('span', 'pt-tag pt-tag-review',
        c.feedback ? 'Changes requested' : 'Needs your review'));
    }
    if (badges.firstChild) open.appendChild(badges);

    card.appendChild(open);

    if (!isNarrow()) {
      card.draggable = true;
      const grip = el('span', 'pt-ccard-grip');
      grip.setAttribute('aria-hidden', 'true');
      grip.appendChild(icon('grip'));
      card.appendChild(grip);
      card.addEventListener('dragstart', (ev) => {
        DRAG = c;
        card.classList.add('pt-ccard-dragging');
        ev.dataTransfer?.setData('text/plain', c.title);
        if (ev.dataTransfer) ev.dataTransfer.effectAllowed = 'move';
      });
      card.addEventListener('dragend', () => {
        DRAG = null;
        card.classList.remove('pt-ccard-dragging');
      });
    }
    return card;
  }

  /** The one date that matters next for this card. */
  function nextDateLine(c: PortalContentItem): string | null {
    if (c.status === 'Posted') return c.postDate ? `Posted ${fmtDateShort(c.postDate)}` : null;
    if (c.filmBy && c.status !== 'Filmed' && c.status !== 'Footage In') {
      return `Film by ${fmtDateShort(c.filmBy)}`;
    }
    if (c.postDate) return `Posts ${fmtDateShort(c.postDate)}`;
    if (c.filmBy) return `Filmed ${fmtDateShort(c.filmBy)}`;
    return null;
  }

  function postedList(items: PortalContentItem[]): HTMLElement {
    const posted = items
      .filter((c) => c.status === 'Posted')
      .sort((a, b) => (parseNotionDate(b.postDate)?.getTime() ?? 0) - (parseNotionDate(a.postDate)?.getTime() ?? 0));
    if (!posted.length) {
      return conFiltering()
        ? contentEmpty('Nothing matches that',
                       'Try a different filter to see the rest of your posts.')
        : contentEmpty('Nothing posted yet',
                       'Once a piece goes out it moves here, newest first, with the link to the post.');
    }
    const grid = el('div', 'pt-posted');
    for (const c of posted) {
      const row = el('article', 'pt-posted-card');
      const open = el('button', 'pt-posted-open');
      open.type = 'button';
      open.addEventListener('click', () => openContentDrawer(c));
      open.appendChild(el('span', 'pt-ccard-title', c.title));
      const meta = el('span', 'pt-ccard-meta');
      if (c.bucket) meta.appendChild(el('span', `pt-bchip pt-nc-${bucketColor(c.bucket)}`, c.bucket));
      if (c.postDate) meta.appendChild(el('span', undefined, fmtDateShort(c.postDate)));
      if (c.platforms.length) meta.appendChild(el('span', undefined, c.platforms.join(' · ')));
      open.appendChild(meta);
      row.appendChild(open);
      if (c.postLink) {
        const a = el('a', 'pt-posted-link') as HTMLAnchorElement;
        a.href = c.postLink;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.setAttribute('aria-label', `See ${c.title} on ${c.platforms[0] ?? 'the platform'}`);
        a.appendChild(icon('ext'));
        row.appendChild(a);
      }
      grid.appendChild(row);
    }
    return grid;
  }

  /* ── saving ───────────────────────────────────────────────────── */

  let TOAST_T = 0;

  function toast(text: string, bad = false) {
    const t = q('[data-toast]');
    if (!t) return;
    t.textContent = text;
    t.classList.toggle('pt-toast-bad', bad);
    show(t, true);
    requestAnimationFrame(() => { t.dataset.open = 'true'; });
    window.clearTimeout(TOAST_T);
    TOAST_T = window.setTimeout(() => {
      t.dataset.open = 'false';
      window.setTimeout(() => show(t, false), 200);
    }, bad ? 5000 : 2200);
  }

  const conIndex = (id: string) => CON.items.findIndex((i) => i.id === id);

  /** Everything that shows content, redrawn from one place so a save
   *  can never leave the calendar saying one thing and the board
   *  another. */
  function refreshContent() {
    syncCalendarContent();
    drawContent();
    if (currentRoute().view === 'calendar') drawCalendar();
    if (DATA) { DATA.content = CON.items; renderHome(DATA); }
  }

  /**
   * One save.
   *
   * The card changes on screen first and goes back if the server says
   * no, because a board that waits for a round trip before it moves
   * feels broken. `local` is what we expect; the response is the truth
   * and replaces it either way.
   */
  async function saveCard(
    id: string,
    patch: Record<string, unknown>,
    local: Partial<PortalContentItem>,
  ): Promise<boolean> {
    const i = conIndex(id);
    if (i === -1) return false;
    const before = CON.items[i];
    CON.items[i] = { ...before, ...local };
    refreshContent();
    if (DRAWER_ID === id) fillContentDrawer(CON.items[i]);

    try {
      const res = await fetch(
        `/portal/${encodeURIComponent(SLUG)}/content/${encodeURIComponent(id)}`,
        {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(patch),
        },
      );
      if (!res.ok) throw new Error(String(res.status));
      const out = await res.json() as { ok?: boolean; item?: PortalContentItem; changed?: boolean };
      if (!out.ok || !out.item) throw new Error('refused');
      // The server replies with the row as it now stands, so whatever
      // it refused simply comes back as it was. `changed: false` means
      // nothing we sent survived validation, and showing a tick for
      // that would be a lie.
      const j = conIndex(id);
      if (j !== -1) CON.items[j] = out.item;
      refreshContent();
      if (DRAWER_ID === id) fillContentDrawer(out.item);
      if (out.changed === false) {
        toast('We could not save that one. Have another look at it.', true);
        return false;
      }
      return true;
    } catch {
      const j = conIndex(id);
      if (j !== -1) CON.items[j] = before;
      refreshContent();
      if (DRAWER_ID === id) fillContentDrawer(before);
      toast('That did not save. Check your connection and try again.', true);
      return false;
    }
  }

  async function setBucket(c: PortalContentItem, bucket: string | null) {
    if (c.bucket === bucket) return;
    if (await saveCard(c.id, { bucket }, { bucket })) {
      toast(bucket ? `Moved to ${bucket}` : 'Bucket cleared');
    }
  }

  async function setStatus(c: PortalContentItem, status: string, note?: string) {
    if (!canClientMove(c.status, status)) {
      toast('That move is ours to make. We will take it from here.', true);
      return;
    }
    if (await saveCard(c.id, { status }, { status })) toast(`Moved to ${status}`);
    if (note) toast(note);
  }

  async function createIdea(patch: Record<string, unknown>): Promise<boolean> {
    try {
      const res = await fetch(`/portal/${encodeURIComponent(SLUG)}/content`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(patch),
      });
      if (!res.ok) throw new Error(String(res.status));
      const out = await res.json() as { ok?: boolean; item?: PortalContentItem };
      if (!out.ok || !out.item) throw new Error('refused');
      CON.items = [out.item, ...CON.items];
      refreshContent();
      toast('Added to your board');
      return true;
    } catch {
      toast('That did not save. Check your connection and try again.', true);
      return false;
    }
  }

  /* ── the content drawer ───────────────────────────────────────── */

  let DRAWER_ID = '';

  function openContentDrawer(c: PortalContentItem) {
    const drawer = q('[data-drawer]');
    const scrim = q('[data-scrim]');
    if (!drawer || !scrim) return;
    LAST_FOCUS = document.activeElement as HTMLElement;
    DRAWER_ID = c.id;
    fillContentDrawer(c);
    show(scrim, true);
    show(drawer, true);
    requestAnimationFrame(() => {
      scrim.dataset.open = 'true';
      drawer.dataset.open = 'true';
    });
    q<HTMLButtonElement>('[data-drawer-close]')?.focus();
    document.addEventListener('keydown', onDrawerKey);
  }

  function fillContentDrawer(c: PortalContentItem) {
    const title = q('[data-drawer-title]');
    const body = q('[data-drawer-body]');
    const foot = q('[data-drawer-foot]');
    if (!title || !body || !foot) return;
    title.textContent = c.title;
    clear(body);
    clear(foot);

    const tags = el('div', 'pt-drawer-tags');
    if (c.status) tags.appendChild(el('span', 'pt-tag', c.status));
    if (c.bucket) tags.appendChild(el('span', `pt-bchip pt-nc-${bucketColor(c.bucket)}`, c.bucket));
    if (c.postedBy === 'Client') tags.appendChild(el('span', 'pt-tag pt-tag-todo', 'You post'));
    if (c.source) tags.appendChild(el('span', 'pt-tag', c.source));
    body.appendChild(tags);

    /* review, when it is the client's turn */
    if (c.status === 'Ready for Review') body.appendChild(reviewBox(c));

    /* the fields */
    const save = (patch: Record<string, unknown>, local: Partial<PortalContentItem>, tick: HTMLElement) =>
      saveCard(c.id, patch, local).then((ok) => { if (ok) flashTick(tick); });

    body.appendChild(textField('Title', c.title, 'A short name, the way you say it', MAX_TITLE,
      (v, tick) => save({ title: v }, { title: v ?? c.title }, tick)));

    body.appendChild(selectEditor('Bucket', c.bucket, CON.schema.bucket, 'No bucket',
      (v, tick) => save({ bucket: v }, { bucket: v }, tick)));

    // Only the moves this client is allowed to make are offered. The
    // server checks again; this is so the list never lies.
    const moves = CON.schema.status.filter((o) => canClientMove(c.status, o.name));
    if (moves.length) {
      body.appendChild(selectEditor('Status', c.status, moves, null,
        (v, tick) => { if (v) save({ status: v }, { status: v }, tick); }));
    }

    body.appendChild(multiEditor('Format', c.format, CON.schema.format,
      (v, tick) => save({ format: v }, { format: v }, tick)));
    body.appendChild(multiEditor('Platforms', c.platforms, CON.schema.platforms,
      (v, tick) => save({ platforms: v }, { platforms: v }, tick)));

    body.appendChild(dateField('Film by', c.filmBy,
      (v, tick) => save({ filmBy: v }, { filmBy: v }, tick)));
    body.appendChild(dateField('Post date', c.postDate,
      (v, tick) => save({ postDate: v }, { postDate: v }, tick)));

    const camps = campaigns();
    if (camps.length) {
      const current = c.campaign.map(normaliseId);
      const picked = camps.find((m) => current.includes(normaliseId(m.id)));
      body.appendChild(selectEditor('Campaign', picked?.id ?? null,
        camps.map((m) => ({ name: m.id, color: 'default', label: m.title })), 'No campaign',
        (v, tick) => save({ campaign: v ? [v] : [] }, { campaign: v ? [v] : [] }, tick)));
    }

    body.appendChild(textField('Shoot code', c.shootCode, 'SM L1D1', MAX_TEXT,
      (v, tick) => save({ shootCode: v }, { shootCode: v }, tick), { mono: true }));
    body.appendChild(textField('On-screen text', c.onScreenText, 'What the viewer reads', MAX_TEXT,
      (v, tick) => save({ onScreenText: v }, { onScreenText: v }, tick), { lines: 3 }));
    body.appendChild(textField('Caption', c.caption, 'The caption that goes with it', MAX_TEXT,
      (v, tick) => save({ caption: v }, { caption: v }, tick), { lines: 4 }));
    body.appendChild(textField('Notes', c.notes, 'Anything we should know', MAX_TEXT,
      (v, tick) => save({ notes: v }, { notes: v }, tick), { lines: 3 }));

    body.appendChild(urlField('Footage link', c.footageLink, 'Paste the Drive or iCloud link',
      (v, tick) => save({ footageLink: v }, { footageLink: v }, tick)));
    body.appendChild(urlField('Post link', c.postLink, 'Paste the link to the live post',
      (v, tick) => save({ postLink: v }, { postLink: v }, tick)));

    if (c.feedback) {
      const why = el('div', 'pt-why');
      why.appendChild(el('strong', undefined, 'Changes you asked for'));
      why.appendChild(el('span', undefined, c.feedback));
      body.appendChild(why);
    }

    /* read-only, and said so */
    if (c.editLink) {
      const a = el('a', 'pt-btn') as HTMLAnchorElement;
      a.href = c.editLink;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.style.width = '100%';
      a.appendChild(icon('play'));
      a.appendChild(el('span', undefined, 'Watch the edit'));
      body.appendChild(a);
    }

    /* the one action this card is waiting on */
    const actions = contentActions(c);
    if (actions) { foot.appendChild(actions); show(foot, true); } else show(foot, false);
  }

  function contentActions(c: PortalContentItem): HTMLElement | null {
    const row = el('div', 'pt-drawer-actions');

    // On a desktop a card gets its date by being dragged onto a day.
    // There is no dragging on a phone, so the same job is a button.
    if (isNarrow() && !c.postDate && canSchedule(c)) {
      const b = el('button', 'pt-btn');
      b.type = 'button';
      b.appendChild(icon('cal'));
      b.appendChild(el('span', undefined, 'Schedule'));
      b.addEventListener('click', () => openScheduleSheet(c));
      row.appendChild(b);
    }

    const needsFootage = c.status === 'Filmed' || (c.status === 'Planned' && !!c.filmBy);
    if (needsFootage && !c.footageLink) {
      const b = el('button', 'pt-btn');
      b.type = 'button';
      b.appendChild(icon('link'));
      b.appendChild(el('span', undefined, 'Add footage'));
      b.addEventListener('click', () => openFootageSheet(c));
      row.appendChild(b);
    }

    if ((c.status === 'Approved' || c.status === 'Scheduled') && c.postedBy === 'Client') {
      const b = el('button', 'pt-btn pt-btn-primary');
      b.type = 'button';
      b.appendChild(icon('check'));
      b.appendChild(el('span', undefined, 'Mark as posted'));
      b.addEventListener('click', () => openPostedSheet(c));
      row.appendChild(b);
    }

    return row.firstChild ? row : null;
  }

  /** Blueprint has put an edit up and it is the client's turn. */
  function reviewBox(c: PortalContentItem): HTMLElement {
    const box = el('div', 'pt-review');
    box.appendChild(el('div', 'pt-review-label', c.feedback ? 'Changes requested' : 'Ready for your review'));
    box.appendChild(el('p', undefined, c.feedback
      ? 'We have your notes. The next cut comes back here.'
      : 'Have a look at the edit, then approve it or tell us what to change.'));

    const row = el('div', 'pt-review-actions');
    if (c.editLink) {
      const watch = el('a', 'pt-btn') as HTMLAnchorElement;
      watch.href = c.editLink;
      watch.target = '_blank';
      watch.rel = 'noopener noreferrer';
      watch.appendChild(icon('play'));
      watch.appendChild(el('span', undefined, 'Watch the edit'));
      row.appendChild(watch);
    }
    const yes = el('button', 'pt-btn pt-btn-primary');
    yes.type = 'button';
    yes.appendChild(icon('check'));
    yes.appendChild(el('span', undefined, 'Approve'));
    yes.addEventListener('click', () => { void setStatus(c, 'Approved'); });
    row.appendChild(yes);

    const no = el('button', 'pt-btn');
    no.type = 'button';
    no.textContent = 'Request changes';
    no.addEventListener('click', () => openFeedbackSheet(c));
    row.appendChild(no);

    box.appendChild(row);
    return box;
  }

  /* ── editable fields ──────────────────────────────────────────── */

  type Tick = HTMLElement;

  /** Label, a quiet tick that appears after a save, and the control. */
  function fieldShell(label: string): { wrap: HTMLElement; tick: Tick; slot: HTMLElement } {
    const wrap = el('div', 'pt-field');
    const head = el('div', 'pt-field-head');
    const id = `pt-f-${label.toLowerCase().replace(/[^a-z]+/g, '-')}`;
    const lab = el('label', 'pt-field-label', label);
    (lab as HTMLLabelElement).htmlFor = id;
    head.appendChild(lab);
    const tick = el('span', 'pt-field-tick');
    tick.appendChild(icon('check'));
    tick.appendChild(el('span', undefined, 'Saved'));
    head.appendChild(tick);
    wrap.appendChild(head);
    const slot = el('div', 'pt-field-slot');
    slot.dataset.fieldId = id;
    wrap.appendChild(slot);
    return { wrap, tick, slot };
  }

  function flashTick(tick: Tick) {
    tick.dataset.on = 'true';
    window.setTimeout(() => { tick.dataset.on = 'false'; }, 1600);
  }

  function textField(
    label: string,
    value: string | null,
    placeholder: string,
    max: number,
    onSave: (v: string | null, tick: Tick) => void,
    opts: { lines?: number; mono?: boolean } = {},
  ): HTMLElement {
    const { wrap, tick, slot } = fieldShell(label);
    const input = opts.lines
      ? el('textarea', 'pt-input pt-textarea') as HTMLTextAreaElement
      : el('input', 'pt-input') as HTMLInputElement;
    if (opts.lines) (input as HTMLTextAreaElement).rows = opts.lines;
    if (opts.mono) input.classList.add('pt-num');
    input.id = slot.dataset.fieldId!;
    input.placeholder = placeholder;
    input.maxLength = max;
    input.value = value ?? '';
    // Blur, not keystroke: one save per edit, and no save while the
    // client is still mid-sentence.
    input.addEventListener('blur', () => {
      const next = input.value.trim();
      if (next === (value ?? '')) return;
      onSave(next || null, tick);
    });
    slot.appendChild(input);
    return wrap;
  }

  function urlField(
    label: string,
    value: string | null,
    placeholder: string,
    onSave: (v: string | null, tick: Tick) => void,
  ): HTMLElement {
    const { wrap, tick, slot } = fieldShell(label);
    const row = el('div', 'pt-field-row');
    const input = el('input', 'pt-input') as HTMLInputElement;
    input.id = slot.dataset.fieldId!;
    input.type = 'url';
    input.placeholder = placeholder;
    input.value = value ?? '';
    input.addEventListener('blur', () => {
      const next = input.value.trim();
      if (next === (value ?? '')) return;
      onSave(next || null, tick);
    });
    row.appendChild(input);
    if (value) {
      const a = el('a', 'pt-field-open') as HTMLAnchorElement;
      a.href = value;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.setAttribute('aria-label', `Open ${label}`);
      a.appendChild(icon('ext'));
      row.appendChild(a);
    }
    slot.appendChild(row);
    return wrap;
  }

  function dateField(
    label: string,
    value: string | null,
    onSave: (v: string | null, tick: Tick) => void,
  ): HTMLElement {
    const { wrap, tick, slot } = fieldShell(label);
    const input = el('input', 'pt-input') as HTMLInputElement;
    input.id = slot.dataset.fieldId!;
    input.type = 'date';
    input.value = (value ?? '').slice(0, 10);
    input.addEventListener('change', () => {
      const next = input.value;
      if (next === (value ?? '').slice(0, 10)) return;
      onSave(next || null, tick);
    });
    slot.appendChild(input);
    return wrap;
  }

  function selectEditor(
    label: string,
    value: string | null,
    options: Array<{ name: string; color: string; label?: string }>,
    blank: string | null,
    onSave: (v: string | null, tick: Tick) => void,
  ): HTMLElement {
    const { wrap, tick, slot } = fieldShell(label);
    const sel = el('select', 'pt-select pt-select-wide') as HTMLSelectElement;
    sel.id = slot.dataset.fieldId!;
    if (blank !== null) {
      const o = el('option', undefined, blank) as HTMLOptionElement;
      o.value = '';
      if (!value) o.selected = true;
      sel.appendChild(o);
    }
    for (const opt of options) {
      const o = el('option', undefined, opt.label ?? opt.name) as HTMLOptionElement;
      o.value = opt.name;
      if (value === opt.name) o.selected = true;
      sel.appendChild(o);
    }
    sel.addEventListener('change', () => onSave(sel.value || null, tick));
    slot.appendChild(sel);
    return wrap;
  }

  function multiEditor(
    label: string,
    values: string[],
    options: Array<{ name: string; color: string }>,
    onSave: (v: string[], tick: Tick) => void,
  ): HTMLElement {
    const { wrap, tick, slot } = fieldShell(label);
    if (!options.length) { wrap.remove(); return el('span'); }
    const set = el('div', 'pt-chipset');
    set.setAttribute('role', 'group');
    set.setAttribute('aria-label', label);
    let picked = values.slice();
    for (const opt of options) {
      const b = el('button', `pt-setchip pt-nc-${opt.color}`, opt.name);
      b.type = 'button';
      const sync = () => {
        const on = picked.includes(opt.name);
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('pt-setchip-on', on);
      };
      sync();
      b.addEventListener('click', () => {
        picked = picked.includes(opt.name)
          ? picked.filter((v) => v !== opt.name)
          : [...picked, opt.name];
        sync();
        onSave(picked.slice(), tick);
      });
      set.appendChild(b);
    }
    slot.appendChild(set);
    return wrap;
  }

  /* ── the sheet: one short answer ──────────────────────────────── */

  let SHEET_FOCUS: HTMLElement | null = null;

  function openSheet(title: string, build: (form: HTMLFormElement, close: () => void) => void) {
    const sheet = q('[data-sheet]');
    const scrim = q('[data-sheet-scrim]');
    const head = q('[data-sheet-title]');
    const body = q<HTMLFormElement>('[data-sheet-body]');
    if (!sheet || !scrim || !head || !body) return;
    SHEET_FOCUS = document.activeElement as HTMLElement;
    head.textContent = title;

    // A fresh form, not a cleared one. Clearing the children leaves
    // the previous sheet's submit listener on the element, so the next
    // sheet you submitted would run that one too, against the inputs
    // it had captured: adding a second idea quietly added the first
    // one again. cloneNode(false) keeps the attributes and takes none
    // of the listeners.
    const form = body.cloneNode(false) as HTMLFormElement;
    body.replaceWith(form);

    build(form, closeSheet);
    show(scrim, true);
    show(sheet, true);
    requestAnimationFrame(() => {
      scrim.dataset.open = 'true';
      sheet.dataset.open = 'true';
      q<HTMLElement>('input, select, textarea, button', form)?.focus();
    });
    document.addEventListener('keydown', onSheetKey);
  }

  function closeSheet() {
    const sheet = q('[data-sheet]');
    const scrim = q('[data-sheet-scrim]');
    if (!sheet || !scrim || sheet.hidden) return;
    sheet.dataset.open = 'false';
    scrim.dataset.open = 'false';
    document.removeEventListener('keydown', onSheetKey);
    window.setTimeout(() => { show(sheet, false); show(scrim, false); }, 200);
    SHEET_FOCUS?.focus();
    SHEET_FOCUS = null;
  }

  function onSheetKey(ev: KeyboardEvent) {
    if (ev.key === 'Escape') { ev.preventDefault(); closeSheet(); }
  }

  /** A labelled control for the sheet. Plainer than the drawer's
   *  fields: the sheet saves on submit, not on blur. */
  function sheetField(label: string, node: HTMLElement): HTMLElement {
    const wrap = el('div', 'pt-field');
    const id = `pt-s-${label.toLowerCase().replace(/[^a-z]+/g, '-')}`;
    const lab = el('label', 'pt-field-label', label);
    (lab as HTMLLabelElement).htmlFor = id;
    node.id = id;
    wrap.append(lab, node);
    return wrap;
  }

  function sheetSubmit(form: HTMLFormElement, text: string): HTMLButtonElement {
    const b = el('button', 'pt-btn pt-btn-primary') as HTMLButtonElement;
    b.type = 'submit';
    b.textContent = text;
    const row = el('div', 'pt-sheet-foot');
    row.appendChild(b);
    form.appendChild(row);
    return b;
  }

  /**
   * Quick add. One field matters, the rest are optional, and on a
   * phone it is a title and a tap.
   */
  function openQuickAdd(bucket: string | null) {
    openSheet('New idea', (form, close) => {
      const title = el('input', 'pt-input') as HTMLInputElement;
      title.required = true;
      title.maxLength = MAX_TITLE;
      title.placeholder = 'SM L1D1, or whatever you call it';
      form.appendChild(sheetField('Idea', title));

      const bucketSel = el('select', 'pt-select pt-select-wide') as HTMLSelectElement;
      const none = el('option', undefined, 'No bucket') as HTMLOptionElement;
      none.value = '';
      bucketSel.appendChild(none);
      for (const o of CON.schema.bucket) {
        const opt = el('option', undefined, o.name) as HTMLOptionElement;
        opt.value = o.name;
        if (bucket === o.name) opt.selected = true;
        bucketSel.appendChild(opt);
      }
      form.appendChild(sheetField('Bucket', bucketSel));

      const more = el('details', 'pt-more');
      more.appendChild(el('summary', undefined, 'Add dates'));
      const film = el('input', 'pt-input') as HTMLInputElement;
      film.type = 'date';
      more.appendChild(sheetField('Film by', film));
      const post = el('input', 'pt-input') as HTMLInputElement;
      post.type = 'date';
      more.appendChild(sheetField('Post date', post));
      form.appendChild(more);

      const go = sheetSubmit(form, 'Add it');
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const name = title.value.trim();
        if (!name) { title.focus(); return; }
        go.disabled = true;
        const ok = await createIdea({
          title: name,
          bucket: bucketSel.value || null,
          filmBy: film.value || null,
          postDate: post.value || null,
        });
        go.disabled = false;
        if (ok) close();
      });
    });
  }

  /** Mark as posted: the link is optional, the date is today unless
   *  one was already planned. */
  /** The phone's version of dragging a card onto a day. */
  function openScheduleSheet(c: PortalContentItem) {
    openSheet('Schedule this post', (form, close) => {
      const when = el('input', 'pt-input') as HTMLInputElement;
      when.type = 'date';
      when.required = true;
      when.value = c.postDate ?? dateKeyToday();
      form.appendChild(sheetField('Post date', when));
      form.appendChild(el('p', 'pt-sheet-note', c.status === 'Idea'
        ? 'Giving it a date moves it out of your ideas and onto the pipeline.'
        : 'It appears on your calendar on that day.'));

      const go = sheetSubmit(form, 'Put it on the calendar');
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const iso = when.value;
        if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) { when.focus(); return; }
        go.disabled = true;
        await scheduleCard(c, iso);
        go.disabled = false;
        close();
      });
    });
  }

  function openPostedSheet(c: PortalContentItem) {
    openSheet('Mark as posted', (form, close) => {
      const link = el('input', 'pt-input') as HTMLInputElement;
      link.type = 'url';
      link.placeholder = 'https://...';
      link.value = c.postLink ?? '';
      form.appendChild(sheetField('Link to the post (optional)', link));
      form.appendChild(el('p', 'pt-sheet-note', c.postDate
        ? `Post date stays ${fmtDate(c.postDate)}.`
        : 'We will set the post date to today.'));

      const go = sheetSubmit(form, 'It is posted');
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        go.disabled = true;
        const today = new Date();
        const iso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
        const patch: Record<string, unknown> = { status: 'Posted' };
        const local: Partial<PortalContentItem> = { status: 'Posted' };
        if (!c.postDate) { patch.postDate = iso; local.postDate = iso; }
        const typed = link.value.trim();
        if (typed && typed !== (c.postLink ?? '')) { patch.postLink = typed; local.postLink = typed; }
        const ok = await saveCard(c.id, patch, local);
        go.disabled = false;
        if (ok) { toast('Nice. That is posted.'); close(); }
      });
    });
  }

  /** Add footage: the Drive folder opens in its own tab, and the link
   *  comes back here. Saving one moves the card to Footage In. */
  function openFootageSheet(c: PortalContentItem) {
    openSheet('Add footage', (form, close) => {
      const drive = DATA?.client.driveFolder ?? null;
      if (drive) {
        const a = el('a', 'pt-btn') as HTMLAnchorElement;
        a.href = drive;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.appendChild(icon('ext'));
        a.appendChild(el('span', undefined, 'Open your Drive folder'));
        form.appendChild(a);
        form.appendChild(el('p', 'pt-sheet-note',
          'Drop the files in there, then paste the link to them below.'));
      }
      const link = el('input', 'pt-input') as HTMLInputElement;
      link.type = 'url';
      link.required = true;
      link.placeholder = 'https://...';
      link.value = c.footageLink ?? '';
      form.appendChild(sheetField('Link to the footage', link));

      const go = sheetSubmit(form, 'Send it over');
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const url = link.value.trim();
        if (!url) { link.focus(); return; }
        go.disabled = true;
        const patch: Record<string, unknown> = { footageLink: url };
        const local: Partial<PortalContentItem> = { footageLink: url };
        // Footage arriving is what Footage In means, so the status
        // follows the link rather than needing a second step.
        if (canClientMove(c.status, 'Footage In')) {
          patch.status = 'Footage In';
          local.status = 'Footage In';
        }
        const ok = await saveCard(c.id, patch, local);
        go.disabled = false;
        if (ok) { toast('Got it. We will take it from here.'); close(); }
      });
    });
  }

  /** Request changes. The note is the point, so it is required and the
   *  status does not move: the edit is still ours. */
  function openFeedbackSheet(c: PortalContentItem) {
    openSheet('Request changes', (form, close) => {
      const note = el('textarea', 'pt-input pt-textarea') as HTMLTextAreaElement;
      note.rows = 4;
      note.required = true;
      note.maxLength = MAX_TEXT;
      note.placeholder = 'Cut the intro, the text is late, use the second take...';
      note.value = c.feedback ?? '';
      form.appendChild(sheetField('What should change', note));

      const go = sheetSubmit(form, 'Send the notes');
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const text = note.value.trim();
        if (!text) { note.focus(); return; }
        go.disabled = true;
        const ok = await saveCard(c.id, { feedback: text }, { feedback: text });
        go.disabled = false;
        if (ok) { toast('Sent. We will recut it.'); close(); }
      });
    });
  }

  /* ── content on the calendar ──────────────────────────────────── */

  /** A content row shaped like a calendar row, so one calendar can
   *  draw both without knowing the difference. */
  type CalRow = PortalCalendarItem & {
    content?: PortalContentItem;
    contentRole?: 'post' | 'film';
  };

  function momentLookup(): Map<string, PortalMoment> {
    const m = new Map<string, PortalMoment>();
    for (const it of CAL_BASE) {
      if (it.moment) m.set(normaliseId(it.moment.id), it.moment);
      if (it.id && it.momentType) {
        m.set(normaliseId(it.id), { id: it.id, title: it.title, momentType: it.momentType, date: it.date });
      }
    }
    return m;
  }

  function contentRows(items: PortalContentItem[]): CalRow[] {
    const look = momentLookup();
    const out: CalRow[] = [];
    for (const c of items) {
      if (c.status === 'Skipped') continue;
      const moment = c.campaign
        .map((id) => look.get(normaliseId(id)))
        .find((m): m is PortalMoment => !!m) ?? null;
      if (c.postDate) out.push(contentRow(c, 'post', c.postDate, moment));
      if (c.filmBy && c.status !== 'Posted') out.push(contentRow(c, 'film', c.filmBy, moment));
    }
    return out;
  }

  function contentRow(
    c: PortalContentItem,
    role: 'post' | 'film',
    date: string,
    moment: PortalMoment | null,
  ): CalRow {
    return {
      title: role === 'film' ? `Film · ${c.title}` : c.title,
      tentative: false,
      kind: 'Content',
      momentType: null,
      date,
      status: c.status,
      type: 'Content',
      owner: c.postedBy === 'Client' ? 'Client' : 'Blueprint',
      playbook: null,
      phase: null,
      where: c.platforms.length ? c.platforms.join(' · ') : null,
      whyItMatters: null,
      venueCity: null,
      ticketLink: null,
      id: `${c.id}:${role}`,
      moment,
      streamsToDate: null,
      ticketsSold: null,
      capacity: null,
      content: c,
      contentRole: role,
    };
  }

  function syncCalendarContent() {
    CAL.items = (CAL_BASE as CalRow[]).concat(contentRows(CON.items));
  }

  /* ── content on Home ──────────────────────────────────────────── */

  /** What is on the client in the next week: a shoot to film, or a
   *  post they said they would put up themselves. */
  function contentTodos(): CalRow[] {
    const today = todayStart();
    const soon = new Date(today);
    soon.setDate(soon.getDate() + 7);
    const within = (iso: string | null) => {
      const d = parseNotionDate(iso);
      return !!d && d <= soon;
    };
    const out: CalRow[] = [];
    const look = momentLookup();
    const momentOf = (c: PortalContentItem) => c.campaign
      .map((id) => look.get(normaliseId(id)))
      .find((m): m is PortalMoment => !!m) ?? null;

    for (const c of CON.items) {
      if (c.status === 'Skipped' || c.status === 'Posted') continue;
      if (c.filmBy && within(c.filmBy) && c.status !== 'Filmed' && c.status !== 'Footage In') {
        out.push(contentRow(c, 'film', c.filmBy, momentOf(c)));
      } else if (
        c.postedBy === 'Client'
        && (c.status === 'Approved' || c.status === 'Scheduled')
        && (!c.postDate || within(c.postDate))
      ) {
        out.push(contentRow(c, 'post', c.postDate ?? dateKeyToday(), momentOf(c)));
      }
    }
    return out.sort((a, b) =>
      (parseNotionDate(a.date)?.getTime() ?? 0) - (parseNotionDate(b.date)?.getTime() ?? 0));
  }

  function dateKeyToday(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  /* ── reports ───────────────────────────────────────────────── */
  const PLATFORM_ORDER = ['Instagram', 'TikTok', 'YouTube', 'Spotify', 'Apple Music', 'SoundCloud', 'Facebook', 'X', 'Threads'];
  const REP = { snapIndex: 0, cmpIndex: -1, metricTab: '' };

  let SNAPS: PortalSnapshot[] = [];

  function renderReports(snapshots: PortalSnapshot[]) {
    // Newest first, so index 0 is always "now".
    SNAPS = [...snapshots].sort((a, b) => {
      const da = parseNotionDate(a.date)?.getTime() ?? 0;
      const db = parseNotionDate(b.date)?.getTime() ?? 0;
      return db - da;
    });
    REP.snapIndex = 0;
    REP.cmpIndex = SNAPS.length > 1 ? SNAPS.length - 1 : -1;
    showPlatform('');
  }

  function snapLabel(s: PortalSnapshot): string {
    return [s.type, fmtDate(s.date)].filter(Boolean).join(' · ');
  }

  /** Platforms present in a snapshot, in a deliberate order, plus the
   *  metrics that do not belong to one (Email + SMS List, Shows). */
  function groupMetrics(s: PortalSnapshot): Array<{ platform: string; metrics: string[] }> {
    const groups = new Map<string, string[]>();
    for (const name of Object.keys(s.metrics)) {
      const p = metricPlatform(name) ?? 'Other';
      const arr = groups.get(p);
      if (arr) arr.push(name); else groups.set(p, [name]);
    }
    const ordered: Array<{ platform: string; metrics: string[] }> = [];
    for (const p of PLATFORM_ORDER) {
      const m = groups.get(p);
      if (m && m.length) { ordered.push({ platform: p, metrics: sortMetrics(m) }); groups.delete(p); }
    }
    for (const [p, m] of groups) if (p !== 'Other' && m.length) ordered.push({ platform: p, metrics: sortMetrics(m) });
    const other = groups.get('Other');
    if (other && other.length) ordered.push({ platform: 'Other', metrics: other.sort() });
    return ordered;
  }

  /** Followers first, then reach, then output. */
  function sortMetrics(names: string[]): string[] {
    const rank = (n: string) => {
      const l = metricLabel(n).toLowerCase();
      if (l.includes('follower') || l.includes('subscriber') || l.includes('listener')) return 0;
      if (l.includes('view') || l.includes('play') || l.includes('stream') || l.includes('shazam')) return 1;
      if (l.includes('engagement')) return 2;
      return 3;
    };
    return [...names].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
  }

  /* ── explainers ────────────────────────────────────────────────
     Every section says in one line what it is for, and every metric
     that needs defining carries an info button. The words live in
     portal-labels.ts; this only puts them on screen. */
  let TIP: HTMLElement | null = null;

  function closeTip() { if (TIP) { TIP.remove(); TIP = null; } }

  function infoButton(text: string, label: string): HTMLElement {
    const b = el('button', 'pt-info');
    b.type = 'button';
    b.setAttribute('aria-label', `What ${label} means`);
    b.appendChild(icon('info'));
    const open = () => {
      closeTip();
      const tip = el('div', 'pt-tip', text);
      tip.setAttribute('role', 'tooltip');
      document.body.appendChild(tip);
      const r = b.getBoundingClientRect();
      const w = tip.getBoundingClientRect().width;
      tip.style.top = `${r.bottom + window.scrollY + 6}px`;
      tip.style.left = `${Math.max(8, Math.min(r.left + window.scrollX, window.scrollX + window.innerWidth - w - 12))}px`;
      TIP = tip;
    };
    b.addEventListener('mouseenter', open);
    b.addEventListener('focus', open);
    b.addEventListener('mouseleave', closeTip);
    b.addEventListener('blur', closeTip);
    b.addEventListener('click', (ev) => { ev.preventDefault(); if (TIP) closeTip(); else open(); });
    return b;
  }

  function sectionHead(title: string, blurb: string): HTMLElement {
    const wrap = el('div', 'pt-sect');
    const h = el('div', 'pt-sect-head');
    h.appendChild(el('h4', undefined, title));
    h.appendChild(el('span', 'pt-platform-rule'));
    wrap.appendChild(h);
    wrap.appendChild(el('p', 'pt-sect-blurb', blurb));
    return wrap;
  }

  function showPlatform(platform: string) {
    const root = q('[data-view="reports"]');
    if (!root) return;
    // The tip lives on <body>, so clearing the view would otherwise
    // leave it floating over whatever replaces it.
    closeTip();
    clear(root);

    if (!SNAPS.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('chart'));
      e.append(ic, el('h3', undefined, 'No reports yet'),
        el('p', undefined, 'Your first snapshot lands after we have access to your accounts.'));
      root.appendChild(e);
      return;
    }
    if (platform === 'Shows') root.appendChild(showsDetail());
    else if (platform) root.appendChild(platformDetail(platform));
    else root.appendChild(reportsOverview());
  }

  /* ── shows and ticket sales ───────────────────────────────────
     A show either sold more tickets than the last one or it did not,
     and that is the whole chart. One series, labelled directly, no
     legend to read: the bars are the shows.

     The first bar is the baseline reading, because growth from a
     standing start is the only honest way to show the second show. */

  interface ShowPoint {
    label: string;
    date: string | null;
    tickets: number;
    capacity: number | null;
    /** The first bar: the starting line everything after it grew from. */
    baseline: boolean;
    /** A KPI reading rather than a show, so it has no name or room size. */
    snapshot: boolean;
  }

  function showPoints(): ShowPoint[] {
    // A show we actually ran beats a snapshot reading every time: it has
    // a name, a date and a room size, and the client was there. The
    // snapshot is the starting line only while no show has sold a ticket.
    const shows: ShowPoint[] = CAL_BASE
      .filter((i) => kindOf(i) === 'show' && typeof i.ticketsSold === 'number')
      .sort((a, b) => (parseNotionDate(a.date)?.getTime() ?? 0) - (parseNotionDate(b.date)?.getTime() ?? 0))
      .map((s) => ({
        label: s.title,
        date: s.date,
        tickets: s.ticketsSold!,
        capacity: s.capacity,
        baseline: false,
        snapshot: false,
      }));
    if (shows.length) {
      shows[0].baseline = true;
      return shows;
    }

    const base = [...SNAPS].reverse().find((s) => typeof s.metrics['Tickets Sold'] === 'number');
    if (!base) return [];
    return [{
      label: 'Baseline',
      date: base.date,
      tickets: base.metrics['Tickets Sold'],
      capacity: null,
      baseline: true,
      snapshot: true,
    }];
  }

  /** How the starting line reads in prose, before there is a trend. */
  function baselineLine(p: ShowPoint): string {
    return p.snapshot
      ? `Baseline: ${sellLabel(p.tickets, p.capacity)}.`
      : `Baseline: ${p.label}, ${sellLabel(p.tickets, p.capacity)}.`;
  }

  /** How full the room was, when we know how big the room is. */
  function sellThrough(p: { tickets: number; capacity: number | null }): number | null {
    if (!p.capacity || p.capacity <= 0) return null;
    return Math.min(1, p.tickets / p.capacity);
  }

  function sellLabel(tickets: number, capacity: number | null): string {
    const f = sellThrough({ tickets, capacity });
    if (f === null) return `${fmtNumber(tickets)} tickets`;
    return `${fmtNumber(tickets)} tickets · ${f >= 0.99 ? 'Sold out' : `${Math.round(f * 100)}% sold`}`;
  }

  /** The next show we have not sold yet, for the empty state. */
  function nextShow(): PortalCalendarItem | null {
    const today = todayStart();
    return CAL_BASE
      .filter((i) => kindOf(i) === 'show')
      .filter((i) => { const d = parseNotionDate(i.date); return !!d && d >= today; })
      .sort((a, b) => (parseNotionDate(a.date)!.getTime()) - (parseNotionDate(b.date)!.getTime()))[0] ?? null;
  }

  /** The Shows block on the overview. Null when there is nothing at
   *  all to say, which is not the same as nothing to show yet. */
  function showsSection(): HTMLElement | null {
    const pts = showPoints();
    if (!pts.length) return null;

    const wrap = el('div');
    const h = el('div', 'pt-platform-head');
    h.appendChild(el('h3', undefined, 'Shows'));
    h.appendChild(el('span', 'pt-platform-rule'));
    const link = el('a', 'pt-back');
    (link as HTMLAnchorElement).href = '#/reports/Shows';
    link.style.margin = '0';
    link.appendChild(el('span', undefined, 'Detail'));
    link.appendChild(icon('chev'));
    h.appendChild(link);
    wrap.appendChild(h);

    const card = el('section', 'pt-card');
    const body = el('div', 'pt-card-body');

    // Not "is there data" but "is there a trend": one bar is a starting
    // line, and a chart of it would say nothing a sentence cannot.
    const later = pts.filter((p) => !p.baseline);
    if (!later.length) {
      const base = pts[0];
      const next = nextShow();
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('ticket'));
      e.append(
        ic,
        el('h3', undefined, next
          ? `Your ticket trend starts after ${next.title}`
          : 'Your ticket trend starts at your first show'),
        el('p', undefined, [
          next ? `${next.title} is on ${fmtDateShort(next.date)}.` : null,
          baselineLine(base),
        ].filter(Boolean).join(' ')),
      );
      body.appendChild(e);
      card.appendChild(body);
      wrap.appendChild(card);
      return wrap;
    }

    body.appendChild(ticketHeadline(pts));
    body.appendChild(ticketBars(pts));
    body.appendChild(showStats(pts));
    card.appendChild(body);
    wrap.appendChild(card);
    return wrap;
  }

  /** Tickets at the last show, against whatever came before it. */
  function ticketHeadline(pts: ShowPoint[]): HTMLElement {
    const last = pts[pts.length - 1];
    const prev = pts[pts.length - 2] ?? null;
    const row = el('div', 'pt-headline');
    const cardEl = el('div', 'pt-headline-card');
    cardEl.appendChild(el('span', 'pt-headline-label', 'Tickets (last show)'));
    cardEl.appendChild(el('span', 'pt-headline-value pt-num', fmtNumber(last.tickets)));
    const foot = el('span', 'pt-headline-foot');
    if (prev) {
      const diff = last.tickets - prev.tickets;
      const dir = diff > 0 ? 'up' : diff < 0 ? 'down' : 'flat';
      const pill = el('span', `pt-delta pt-delta-${dir}`);
      if (dir !== 'flat') pill.appendChild(icon(dir === 'up' ? 'up' : 'down'));
      pill.appendChild(el('span', undefined,
        dir === 'flat' ? 'No change' : `${diff > 0 ? '+' : '−'}${fmtNumber(Math.abs(diff))}`));
      foot.appendChild(pill);
      foot.appendChild(el('span', undefined, `vs. ${prev.label}`));
    } else {
      foot.appendChild(el('span', undefined, last.label));
    }
    cardEl.appendChild(foot);
    row.appendChild(cardEl);
    return row;
  }

  /** One bar per show, in time order, each labelled with its own
   *  number so there is no axis to read across. */
  function ticketBars(pts: ShowPoint[]): HTMLElement {
    const wrap = el('div', 'pt-bars');
    wrap.setAttribute('role', 'img');
    wrap.setAttribute('aria-label',
      `Tickets per show: ${pts.map((p) => `${p.label}, ${p.tickets}`).join('; ')}`);
    const top = Math.max(...pts.map((p) => p.capacity ?? p.tickets), 1);
    for (const p of pts) {
      const col = el('div', 'pt-bar-col');
      col.title = `${p.label}: ${sellLabel(p.tickets, p.capacity)}`;
      col.appendChild(el('span', 'pt-bar-num pt-num', fmtNumber(p.tickets)));
      const track = el('span', 'pt-bar-track');
      const fill = el('span', 'pt-bar-col-fill' + (p.baseline ? ' pt-bar-col-base' : ''));
      fill.style.height = '0%';
      track.appendChild(fill);
      col.appendChild(track);
      const f = sellThrough(p);
      col.appendChild(el('span', 'pt-bar-sell',
        f === null ? '' : f >= 0.99 ? 'Sold out' : `${Math.round(f * 100)}% sold`));
      col.appendChild(el('span', 'pt-bar-name', p.label));
      col.appendChild(el('span', 'pt-bar-date', p.snapshot ? 'Starting line' : fmtDateShort(p.date)));
      wrap.appendChild(col);
      // Grow from the baseline on the first paint, like the term bar.
      requestAnimationFrame(() => {
        fill.style.height = `${Math.max(3, Math.round((p.tickets / top) * 100))}%`;
      });
    }
    return wrap;
  }

  function showStats(pts: ShowPoint[]): HTMLElement {
    // Every real show counts here, the first one included. It is the
    // starting line of the chart, but it was still a night they played.
    const real = pts.filter((p) => !p.snapshot);
    const avg = real.length ? real.reduce((n, p) => n + p.tickets, 0) / real.length : 0;
    const best = real.reduce((b, p) => (p.tickets > (b?.tickets ?? -1) ? p : b), null as ShowPoint | null);
    const soldOut = real.filter((p) => (sellThrough(p) ?? 0) >= 0.99).length;
    const inTerm = DATA ? showsSinceTerm() : real.length;

    const grid = el('div', 'pt-ministats');
    const add = (label: string, value: string) => {
      const s = el('div', 'pt-ministat');
      s.appendChild(el('span', 'pt-ministat-value pt-num', value));
      s.appendChild(el('span', 'pt-ministat-label', label));
      grid.appendChild(s);
    };
    add('Average per show', fmtNumber(Math.round(avg)));
    if (best) add('Best show', `${fmtNumber(best.tickets)}`);
    add('Shows this term', String(inTerm));
    add('Sold out', String(soldOut));
    if (best) {
      grid.appendChild(el('p', 'pt-ministat-note', `Your best night so far was ${best.label}.`));
    }
    return grid;
  }

  /** Shows on the calendar since the term started, counted whether or
   *  not anyone wrote down how many tickets went. */
  function showsSinceTerm(): number {
    const start = parseNotionDate(DATA?.client.termStart ?? null);
    const today = todayStart();
    return CAL_BASE.filter((i) => {
      if (kindOf(i) !== 'show') return false;
      const d = parseNotionDate(i.date);
      if (!d || d > today) return false;
      return !start || d >= start;
    }).length;
  }

  /** The Shows detail page: the same chart with room to breathe, then
   *  every show as a row. */
  function showsDetail(): HTMLElement {
    const wrap = el('div');
    const back = el('a', 'pt-back');
    (back as HTMLAnchorElement).href = '#/reports';
    back.appendChild(icon('chev-left'));
    back.appendChild(el('span', undefined, 'All reports'));
    wrap.appendChild(back);

    const head = el('div', 'pt-platform-head');
    head.appendChild(el('h3', undefined, 'Shows'));
    head.appendChild(el('span', 'pt-platform-rule'));
    wrap.appendChild(head);
    wrap.appendChild(el('p', 'pt-sect-blurb',
      'Tickets sold at each show, in the order they happened. The first bar is where you started.'));

    const pts = showPoints();
    const later = pts.filter((p) => !p.baseline);

    const card = el('section', 'pt-card');
    const body = el('div', 'pt-card-body');
    if (!later.length) {
      const next = nextShow();
      body.appendChild(el('p', 'pt-kpi-note', next
        ? `Nothing to chart yet. ${next.title} is on ${fmtDateShort(next.date)}.`
        : 'Nothing to chart yet.'));
      if (pts.length) body.appendChild(el('p', 'pt-kpi-note', baselineLine(pts[0])));
    } else {
      body.appendChild(ticketHeadline(pts));
      body.appendChild(ticketBars(pts));
      body.appendChild(showStats(pts));
    }
    card.appendChild(body);
    wrap.appendChild(card);

    if (pts.length) {
      const table = el('section', 'pt-card');
      table.style.marginTop = 'var(--pt-5)';
      const th = el('div', 'pt-card-head');
      th.appendChild(el('h2', undefined, 'Every show'));
      table.appendChild(th);
      const tb = el('div', 'pt-card-body');
      const dl = el('dl', 'pt-deflist');
      for (const p of [...pts].reverse()) {
        dl.append(
          el('dt', undefined, p.snapshot ? 'Baseline' : fmtDateShort(p.date)),
          el('dd', undefined, `${p.label} · ${sellLabel(p.tickets, p.capacity)}`),
        );
      }
      tb.appendChild(dl);
      table.appendChild(tb);
      wrap.appendChild(table);
    }
    return wrap;
  }

  function reportsOverview(): HTMLElement {
    const wrap = el('div');
    const snap = SNAPS[REP.snapIndex];
    const cmp = REP.cmpIndex >= 0 && REP.cmpIndex !== REP.snapIndex ? SNAPS[REP.cmpIndex] : null;

    /* header controls */
    const head = el('div', 'pt-rep-head');
    head.appendChild(selectField('Snapshot', SNAPS.map((s, i) => [String(i), snapLabel(s)]), String(REP.snapIndex), (v) => {
      REP.snapIndex = Number(v); showPlatform('');
    }));
    const cmpOpts: Array<[string, string]> = [['-1', 'No comparison']];
    SNAPS.forEach((s, i) => { if (i !== REP.snapIndex) cmpOpts.push([String(i), snapLabel(s)]); });
    const cmpField = selectField('Compare to', cmpOpts, String(REP.cmpIndex), (v) => {
      REP.cmpIndex = Number(v); showPlatform('');
    });
    if (SNAPS.length < 2) {
      const sel = q<HTMLSelectElement>('select', cmpField);
      if (sel) sel.disabled = true;
    }
    head.appendChild(cmpField);
    wrap.appendChild(head);

    wrap.appendChild(headlineRow(snap, cmp));

    /* growth score */
    if (typeof snap.growthScore === 'number') {
      const card = el('section', 'pt-card pt-score-card');
      const body = el('div', 'pt-card-body');
      const score = el('div', 'pt-score');
      score.appendChild(gauge(snap.growthScore, 40));
      const text = el('div', 'pt-score-text');
      const val = el('div', 'pt-score-value pt-num', String(snap.growthScore));
      val.appendChild(el('span', undefined, ' / 40'));
      text.appendChild(val);
      text.appendChild(el('div', 'pt-section-title', 'Growth score'));
      if (snap.dataSource.length) {
        text.appendChild(el('p', 'pt-score-note', `Measured from ${snap.dataSource.join(' and ').toLowerCase()}.`));
      }
      score.appendChild(text);
      body.appendChild(score);
      card.appendChild(body);
      wrap.appendChild(card);
    }

    /* the single-snapshot state, designed rather than left broken */
    if (SNAPS.length < 2) {
      const note = el('div', 'pt-note');
      note.style.marginTop = 'var(--pt-5)';
      note.appendChild(icon('info'));
      const p = el('p');
      p.appendChild(el('strong', undefined, 'This is your baseline. '));
      p.appendChild(el('span', undefined,
        `Every number below is the starting point we measure against. Your trend starts with your first monthly report on ${firstReportDate(snap)}.`));
      note.appendChild(p);
      wrap.appendChild(note);
    }

    /* shows: the one number that is not a platform's */
    const shows = showsSection();
    if (shows) wrap.appendChild(shows);

    /* platform groups */
    for (const g of groupMetrics(snap)) {
      const h = el('div', 'pt-platform-head');
      h.appendChild(el('h3', undefined, g.platform === 'Other' ? 'Audience you own' : g.platform));
      h.appendChild(el('span', 'pt-platform-rule'));
      if (g.platform !== 'Other') {
        const link = el('a', 'pt-back');
        (link as HTMLAnchorElement).href = `#/reports/${encodeURIComponent(g.platform)}`;
        link.style.margin = '0';
        link.appendChild(el('span', undefined, 'Detail'));
        link.appendChild(icon('chev'));
        h.appendChild(link);
      }
      wrap.appendChild(h);

      const grid = el('div', 'pt-grid pt-grid-4');
      for (const m of g.metrics) grid.appendChild(metricCard(m, snap, cmp, g.platform !== 'Other'));
      wrap.appendChild(grid);
    }
    return wrap;
  }

  /**
   * The four numbers a client asks about before any other.
   *
   * Three are roll-ups across platforms, which no single Notion column
   * holds, so they are summed here. A roll-up with no data at all is
   * dropped rather than shown as zero: a missing number and a real zero
   * mean very different things to someone reading their own report.
   */
  function headlineRow(snap: PortalSnapshot, cmp: PortalSnapshot | null): HTMLElement {
    const sum = (names: readonly string[]) => sumMetrics(snap.metrics, names);
    const cards: Array<{ label: string; value: string; note: string; delta?: HTMLElement }> = [];

    const push = (label: string, now: number | null, then: number | null, fmt: (v: number) => string, note: string) => {
      if (now === null) return;
      const c: typeof cards[number] = { label, value: fmt(now), note };
      if (then !== null && then !== now) {
        c.delta = deltaPill(now, then, label);
      }
      cards.push(c);
    };

    const cmpSum = (names: readonly string[]) => (cmp ? sumMetrics(cmp.metrics, names) : null);
    push('Total views', sum(VIEW_ROLLUP), cmpSum(VIEW_ROLLUP), compactNumber, 'Instagram, TikTok, Facebook and YouTube');
    push('Net new followers', sum(NET_FOLLOW_ROLLUP), cmpSum(NET_FOLLOW_ROLLUP), compactNumber, 'Gained minus lost, across platforms');
    push('Spotify streams', sum(['Spotify · Streams (28d)']), cmpSum(['Spotify · Streams (28d)']), compactNumber, 'Last 28 days');
    push('Email + SMS list', sum(['Email + SMS List']), cmpSum(['Email + SMS List']), compactNumber, 'The audience nobody can take from you');

    const wrap = el('div');
    if (!cards.length) return wrap;

    const h = el('div', 'pt-platform-head');
    h.style.marginTop = '0';
    // "This month" was a guess. A baseline is a single reading on one
    // day, and every rolling metric under it covers 28 days, so the
    // heading says which.
    h.appendChild(el('h3', undefined, /baseline/i.test(snap.type ?? '')
      ? `Baseline · ${fmtDateShort(snap.date)}`
      : 'Last 28 days'));
    h.appendChild(el('span', 'pt-platform-rule'));
    wrap.appendChild(h);

    const grid = el('div', 'pt-grid pt-grid-4');
    for (const c of cards) {
      const card = el('div', 'pt-kpi pt-headline');
      const label = el('span', 'pt-kpi-label');
      label.appendChild(el('span', 'pt-kpi-platform', c.label));
      card.appendChild(label);
      card.appendChild(el('div', 'pt-kpi-value pt-num', c.value));
      const foot = el('div', 'pt-kpi-foot');
      if (c.delta) foot.appendChild(c.delta);
      foot.appendChild(el('span', 'pt-kpi-note', c.note));
      card.appendChild(foot);
      grid.appendChild(card);
    }
    wrap.appendChild(grid);
    return wrap;
  }

  /** The 1st of the month after the next full one: a baseline taken on
   *  Oct 26 is reported on from Nov, delivered Dec 1. */
  function firstReportDate(s: PortalSnapshot): string {
    const d = parseNotionDate(s.date) ?? new Date();
    const next = new Date(d.getFullYear(), d.getMonth() + (d.getDate() > 15 ? 2 : 1), 1);
    return `${MONTHS[next.getMonth()]} ${next.getDate()}`;
  }

  function selectField(label: string, opts: Array<[string, string]>, value: string, onChange: (v: string) => void): HTMLElement {
    const f = el('div', 'pt-field');
    const id = `pt-sel-${label.replace(/\W+/g, '-').toLowerCase()}`;
    const l = el('label', undefined, label);
    (l as HTMLLabelElement).htmlFor = id;
    const s = el('select', 'pt-select') as HTMLSelectElement;
    s.id = id;
    for (const [v, text] of opts) {
      const o = el('option', undefined, text) as HTMLOptionElement;
      o.value = v;
      if (v === value) o.selected = true;
      s.appendChild(o);
    }
    s.addEventListener('change', () => onChange(s.value));
    f.append(l, s);
    return f;
  }

  /**
   * The value to show for a metric.
   *
   * "Shows This Month" exists as a Notion column AND as something the
   * calendar can count. Two sources means two answers, and the client
   * can see the calendar, so the calendar wins.
   */
  function metricValue(name: string, snap: PortalSnapshot): number {
    if (name === 'Shows This Month' && DATA) {
      return showsInMonth(DATA.calendar, new Date(), DATA.client.termStart);
    }
    return snap.metrics[name];
  }

  function metricCard(
    name: string, snap: PortalSnapshot, cmp: PortalSnapshot | null, linkable: boolean,
  ): HTMLElement {
    const plat = metricPlatform(name);
    const node = linkable && plat ? el('a', 'pt-kpi') : el('div', 'pt-kpi');
    if (linkable && plat) (node as HTMLAnchorElement).href = `#/reports/${encodeURIComponent(plat)}`;

    const label = el('span', 'pt-kpi-label');
    label.appendChild(el('span', 'pt-kpi-platform', displayMetricLabel(name)));
    // A button inside an anchor is invalid markup and would swallow the
    // link, so the definition only appears on cards that are not links.
    // The platform detail, where the definitions matter, uses those.
    const def = linkable && plat ? null : metricDefinition(name);
    if (def) label.appendChild(infoButton(def, displayMetricLabel(name)));
    node.appendChild(label);
    node.appendChild(el('div', 'pt-kpi-value pt-num', fmtMetric(name, metricValue(name, snap))));

    const foot = el('div', 'pt-kpi-foot');
    const before = cmp?.metrics[name];
    if (typeof before === 'number') foot.appendChild(deltaPill(metricValue(name, snap), before, name));
    else foot.appendChild(el('span', 'pt-kpi-note', 'Baseline'));
    node.appendChild(foot);

    const series = SNAPS.filter((s) => typeof s.metrics[name] === 'number');
    if (series.length > 1) node.appendChild(sparkline(name, series));
    return node;
  }

  function platformDetail(platform: string): HTMLElement {
    const wrap = el('div');
    const snap = SNAPS[REP.snapIndex];

    const back = el('a', 'pt-back');
    (back as HTMLAnchorElement).href = '#/reports';
    back.appendChild(icon('chev-left'));
    back.appendChild(el('span', undefined, 'All reports'));
    wrap.appendChild(back);

    const metrics = sortMetrics(Object.keys(snap.metrics).filter((m) => metricPlatform(m) === platform));
    if (!metrics.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('chart'));
      e.append(ic, el('h3', undefined, `No ${platform} data yet`),
        el('p', undefined, 'This platform appears here once it has numbers in a snapshot.'));
      wrap.appendChild(e);
      return wrap;
    }

    const h = el('div', 'pt-platform-head');
    h.style.marginTop = '0';
    h.appendChild(el('h3', undefined, platform));
    h.appendChild(el('span', 'pt-platform-rule'));
    wrap.appendChild(h);

    if (!REP.metricTab || !metrics.includes(REP.metricTab)) REP.metricTab = metrics[0];

    /* chart card */
    const card = el('section', 'pt-card');
    const body = el('div', 'pt-card-body');

    const tabs = el('div', 'pt-tabs');
    tabs.setAttribute('role', 'tablist');
    for (const m of metrics) {
      const b = el('button', 'pt-tab-btn', displayMetricLabel(m));
      b.type = 'button';
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(m === REP.metricTab));
      b.addEventListener('click', () => { REP.metricTab = m; showPlatform(platform); });
      tabs.appendChild(b);
    }
    body.appendChild(tabs);

    const series = SNAPS
      .filter((s) => typeof s.metrics[REP.metricTab] === 'number')
      .slice()
      .reverse(); // oldest first, so time runs left to right

    if (series.length > 1) {
      body.appendChild(lineChart(REP.metricTab, series));
    } else {
      const note = el('div', 'pt-note');
      note.appendChild(icon('info'));
      const p = el('p');
      p.appendChild(el('strong', undefined, `${fmtMetric(REP.metricTab, snap.metrics[REP.metricTab])} today. `));
      p.appendChild(el('span', undefined,
        `One snapshot cannot make a trend line. Your chart starts with your first monthly report on ${firstReportDate(snap)}.`));
      note.appendChild(p);
      body.appendChild(note);
    }
    card.appendChild(body);
    wrap.appendChild(card);

    /* grouped cards: six sections, each one explained, empty ones gone */
    const cmpSnap = REP.cmpIndex >= 0 && REP.cmpIndex !== REP.snapIndex ? SNAPS[REP.cmpIndex] : null;
    for (const id of SECTION_ORDER) {
      const inSection = metrics.filter((m) => metricSection(m) === id);
      if (!inSection.length) continue;
      wrap.appendChild(sectionHead(SECTION_TITLE[id], SECTION_BLURB[id]));
      const grid = el('div', 'pt-grid pt-grid-4');
      for (const m of inSection) grid.appendChild(metricCard(m, snap, cmpSnap, false));
      wrap.appendChild(grid);
    }

    /* table of every metric for this platform */
    const tcard = el('section', 'pt-card');
    tcard.style.marginTop = 'var(--pt-5)';
    const thead = el('div', 'pt-card-head');
    thead.appendChild(el('h2', undefined, 'Every metric'));
    tcard.appendChild(thead);
    const tbody = el('div', 'pt-card-body');
    const table = el('table', 'pt-table');
    const hr = el('tr');
    for (const [text, cls] of [['Metric', ''], ['Value', 'pt-td-num'], ['Change', 'pt-td-num']] as const) {
      const th = el('th', undefined, text);
      if (cls) th.style.textAlign = 'right';
      hr.appendChild(th);
    }
    const thead2 = el('thead'); thead2.appendChild(hr); table.appendChild(thead2);
    const tb = el('tbody');
    const cmp = REP.cmpIndex >= 0 && REP.cmpIndex !== REP.snapIndex ? SNAPS[REP.cmpIndex] : null;
    for (const m of metrics) {
      const tr = el('tr');
      tr.appendChild(el('td', undefined, displayMetricLabel(m)));
      tr.appendChild(el('td', 'pt-td-num', fmtMetricFull(m, metricValue(m, snap))));
      const td = el('td', 'pt-td-num');
      const before = cmp?.metrics[m];
      if (typeof before === 'number') td.appendChild(deltaPill(metricValue(m, snap), before, m));
      else td.appendChild(el('span', 'pt-kpi-note', '—'));
      tr.appendChild(td);
      tb.appendChild(tr);
    }
    table.appendChild(tb);
    tbody.appendChild(table);
    const foot = el('p', 'pt-score-note',
      `${snapLabel(snap)}${snap.dataSource.length ? ` · ${snap.dataSource.join(', ')}` : ''}`);
    foot.style.marginTop = 'var(--pt-4)';
    tbody.appendChild(foot);
    tcard.appendChild(tbody);
    wrap.appendChild(tcard);
    return wrap;
  }

  /* ── charts ────────────────────────────────────────────────────
     Hand-built SVG rather than a charting library: these are three
     simple forms, and a dependency would cost more bytes than the
     code. One series each, so no legend is needed; the card title
     names the thing. Navy carries the line because it is the only
     blue here that clears 3:1 on white. */

  function gauge(value: number, max: number): SVGSVGElement {
    const size = 104, r = 44, cx = size / 2, cy = size / 2;
    const circ = 2 * Math.PI * r;
    const frac = Math.max(0, Math.min(1, value / max));
    const svg = svgEl('svg', { class: 'pt-score-gauge', width: size, height: size, viewBox: `0 0 ${size} ${size}`, role: 'img' });
    svg.appendChild(svgEl('title')).textContent = `Growth score ${value} out of ${max}`;
    svg.appendChild(svgEl('circle', {
      cx, cy, r, fill: 'none', stroke: 'var(--pt-tint)', 'stroke-width': 10,
    }));
    const arc = svgEl('circle', {
      cx, cy, r, fill: 'none', stroke: 'var(--pt-navy)', 'stroke-width': 10,
      'stroke-linecap': 'round', 'stroke-dasharray': circ,
      'stroke-dashoffset': circ, transform: `rotate(-90 ${cx} ${cy})`,
    });
    arc.style.transition = 'stroke-dashoffset 800ms cubic-bezier(.4,0,.2,1)';
    svg.appendChild(arc);
    requestAnimationFrame(() => arc.setAttribute('stroke-dashoffset', String(circ * (1 - frac))));
    return svg;
  }

  function sparkline(name: string, series: PortalSnapshot[]): SVGSVGElement {
    const pts = series.slice().reverse().map((s) => s.metrics[name]);
    const w = 160, h = 30, pad = 3;
    const min = Math.min(...pts), max = Math.max(...pts);
    const span = max - min || 1;
    const x = (i: number) => pad + (i / Math.max(1, pts.length - 1)) * (w - pad * 2);
    const y = (v: number) => h - pad - ((v - min) / span) * (h - pad * 2);
    const svg = svgEl('svg', {
      class: 'pt-spark', viewBox: `0 0 ${w} ${h}`, preserveAspectRatio: 'none',
      'aria-hidden': 'true', focusable: 'false',
    });
    svg.setAttribute('style', 'width:100%;height:30px');
    const d = pts.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
    svg.appendChild(svgEl('path', {
      d: `${d} L${x(pts.length - 1).toFixed(1)} ${h} L${x(0).toFixed(1)} ${h} Z`,
      fill: 'var(--pt-tint)', stroke: 'none',
    }));
    svg.appendChild(svgEl('path', { d, fill: 'none', stroke: 'var(--pt-navy)', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }));
    return svg;
  }

  function lineChart(name: string, series: PortalSnapshot[]): HTMLElement {
    const wrap = el('div', 'pt-chart-wrap');
    const W = 680, H = 240, L = 54, R = 16, T = 18, B = 34;
    const vals = series.map((s) => s.metrics[name]);
    const rawMin = Math.min(...vals), rawMax = Math.max(...vals);
    const pad = (rawMax - rawMin) * 0.15 || Math.abs(rawMax) * 0.1 || 1;
    const min = Math.max(0, rawMin - pad), max = rawMax + pad;
    const span = max - min || 1;
    const x = (i: number) => L + (i / Math.max(1, series.length - 1)) * (W - L - R);
    const y = (v: number) => T + (1 - (v - min) / span) * (H - T - B);

    const svg = svgEl('svg', { class: 'pt-chart', viewBox: `0 0 ${W} ${H}`, role: 'img' });
    svg.setAttribute('style', 'width:100%;height:auto');
    svg.appendChild(svgEl('title')).textContent =
      `${displayMetricLabel(name)} across ${series.length} snapshots`;

    /* recessive grid + axis labels */
    for (let i = 0; i <= 3; i++) {
      const v = min + (span * i) / 3;
      const yy = y(v);
      svg.appendChild(svgEl('line', {
        x1: L, x2: W - R, y1: yy, y2: yy,
        stroke: 'var(--pt-line-soft)', 'stroke-width': 1,
      }));
      const t = svgEl('text', {
        x: L - 10, y: yy + 4, 'text-anchor': 'end',
        fill: 'var(--pt-muted)', 'font-size': 11, 'font-family': 'var(--pt-sans)',
      });
      t.textContent = isPercentMetric(name) ? formatMetricValue(name, v) : compact(v);
      svg.appendChild(t);
    }

    const line = vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
    svg.appendChild(svgEl('path', {
      d: `${line} L${x(vals.length - 1)} ${H - B} L${x(0)} ${H - B} Z`,
      fill: 'var(--pt-tint)', stroke: 'none', opacity: 0.85,
    }));
    svg.appendChild(svgEl('path', {
      d: line, fill: 'none', stroke: 'var(--pt-navy)',
      'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round',
    }));

    /* x labels + markers (>=8px, with a surface ring) */
    series.forEach((s, i) => {
      const t = svgEl('text', {
        x: x(i), y: H - 12, 'text-anchor': 'middle',
        fill: 'var(--pt-muted)', 'font-size': 11, 'font-family': 'var(--pt-sans)',
      });
      t.textContent = shortDate(s.date);
      svg.appendChild(t);
      svg.appendChild(svgEl('circle', {
        cx: x(i), cy: y(vals[i]), r: 5,
        fill: 'var(--pt-navy)', stroke: 'var(--pt-surface)', 'stroke-width': 2,
      }));
    });

    const cross = svgEl('line', {
      y1: T, y2: H - B, stroke: 'var(--pt-navy)', 'stroke-width': 1,
      'stroke-dasharray': '3 3', opacity: 0,
    });
    svg.appendChild(cross);

    const hit = svgEl('rect', { x: 0, y: 0, width: W, height: H, fill: 'transparent' });
    svg.appendChild(hit);
    wrap.appendChild(svg);

    const tip = el('div', 'pt-chart-tip');
    wrap.appendChild(tip);

    const move = (ev: PointerEvent) => {
      const box = svg.getBoundingClientRect();
      const px = ((ev.clientX - box.left) / box.width) * W;
      let best = 0, bestD = Infinity;
      series.forEach((_, i) => { const d = Math.abs(x(i) - px); if (d < bestD) { bestD = d; best = i; } });
      cross.setAttribute('x1', String(x(best)));
      cross.setAttribute('x2', String(x(best)));
      cross.setAttribute('opacity', '0.45');
      clear(tip);
      tip.appendChild(el('span', undefined, snapLabel(series[best])));
      tip.appendChild(document.createTextNode(fmtMetric(name, vals[best])));
      tip.dataset.open = 'true';
      const left = (x(best) / W) * box.width;
      tip.style.left = `${Math.max(4, Math.min(box.width - 4, left))}px`;
      tip.style.top = `${(y(vals[best]) / H) * box.height - 46}px`;
      tip.style.transform = 'translateX(-50%)';
    };
    const leave = () => { cross.setAttribute('opacity', '0'); tip.dataset.open = 'false'; };
    svg.addEventListener('pointermove', move);
    svg.addEventListener('pointerleave', leave);

    return wrap;
  }

  const compact = (v: number) =>
    v >= 1_000_000 ? `${(v / 1_000_000).toFixed(1)}M`
    : v >= 1000 ? `${(v / 1000).toFixed(v >= 10_000 ? 0 : 1)}k`
    : String(Math.round(v));

  const shortDate = (iso: string | null) => {
    const d = parseNotionDate(iso);
    return d ? `${MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}` : '';
  };

  /* ── files ─────────────────────────────────────────────────── */
  function renderFiles(c: PortalPayload['client']) {
    const root = q('[data-view="files"]');
    if (!root) return;
    clear(root);

    const defs: Array<[string | null, string, string, string]> = [
      [c.driveFolder, 'Drive folder', 'Everything we shoot and cut for you: raw files, finished edits, stills.', 'folder'],
      [c.contentVault, 'Content Vault', 'Your captions, hooks and posting plan, in the sheet we both work from.', 'inbox'],
      [c.roadmapLink, 'Roadmap', 'The plan for your term: what we are building, in what order, and why.', 'chart'],
    ];
    const live = defs.filter(([url]) => !!url);

    if (!live.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('folder'));
      e.append(ic, el('h3', undefined, 'Nothing shared yet'),
        el('p', undefined, 'Your Drive folder, Content Vault and roadmap land here as we set them up.'));
      root.appendChild(e);
      return;
    }

    const grid = el('div', 'pt-grid pt-grid-2');
    for (const [url, title, desc, ic] of live) {
      const a = el('a', 'pt-file');
      (a as HTMLAnchorElement).href = url!;
      (a as HTMLAnchorElement).target = '_blank';
      (a as HTMLAnchorElement).rel = 'noopener noreferrer';
      const box = el('div', 'pt-file-icon');
      box.appendChild(icon(ic));
      a.append(box, el('h3', undefined, title), el('p', undefined, desc));
      const open = el('span', 'pt-file-open');
      open.append(el('span', undefined, 'Open'), icon('ext'));
      a.appendChild(open);
      grid.appendChild(a);
    }
    root.appendChild(grid);
  }

  /* ── wiring ────────────────────────────────────────────────── */
  q('[data-drawer-close]')?.addEventListener('click', closeDrawer);
  q('[data-scrim]')?.addEventListener('click', closeDrawer);
  q('[data-sheet-close]')?.addEventListener('click', closeSheet);
  q('[data-sheet-scrim]')?.addEventListener('click', closeSheet);
  // Month grid and agenda are different components, not one that
  // rescales, so crossing the breakpoint has to re-pick the view
  // rather than redraw the desktop one at phone width.
  let wasNarrow = isNarrow();
  window.addEventListener('resize', () => {
    closePopover();
    if (!DATA) return;
    const now = isNarrow();
    if (now !== wasNarrow) {
      wasNarrow = now;
      CAL.view = now ? 'agenda' : 'month';
      CAL.selected = null;
      CON.col = '';
      // A drag cannot survive the components under it being replaced.
      CALDRAG = null;
      saveCalPrefs();
    }
    drawCalendar();
    drawContent();
  });

  boot();
</script>
