---
// Blueprint HQ: the shell.
//
// Served ONLY by functions/portal/hq/index.ts, which checks the admin
// cookie against ADMIN_EMAILS and fetches this page through the
// ASSETS binding. The asset path itself is guarded by
// functions/portal/hq-ui/index.ts, which 404s everybody: ASSETS goes
// straight to the asset store and does not come back through a
// Function, so the only way in is the gate.
//
// Nothing here is data. Everything real arrives from /portal/hq/data,
// which runs the same gate again.
//
// The layout classes are the portal's own (pt-topbar, pt-sidebar,
// pt-nav-item, pt-card). HQ is the same design system seen from our
// side, so it reuses them rather than restating them; only the HQ
// classes at the foot of portal.css are new.
import PortalLayout from '../../layouts/PortalLayout.astro';

const NAV = [
  { id: 'today',    label: 'Today',    icon: 'check' },
  { id: 'clients',  label: 'Clients',  icon: 'home' },
  { id: 'pipeline', label: 'Pipeline', icon: 'grip' },
  { id: 'reports',  label: 'Reports',  icon: 'chart' },
];
---

<PortalLayout title="Blueprint HQ">
  {/* The same sprite the portal uses, trimmed to what HQ draws. */}
  <svg class="pt-visually-hidden" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="pt-i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-6h5v6"/>
      </symbol>
      <symbol id="pt-i-cal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 3v4M16 3v4"/>
      </symbol>
      <symbol id="pt-i-chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
      </symbol>
      <symbol id="pt-i-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4.3a1.5 1.5 0 0 1 1.1.5l1.3 1.5h7.3A1.5 1.5 0 0 1 20 9.5v8A1.5 1.5 0 0 1 18.5 19h-14A1.5 1.5 0 0 1 3 17.5z"/>
      </symbol>
      <symbol id="pt-i-film" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M8 5v14M16 5v14M3 12h18"/>
      </symbol>
      <symbol id="pt-i-grip" viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/>
      </symbol>
      <symbol id="pt-i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M12 5v14M5 12h14"/>
      </symbol>
      <symbol id="pt-i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m4.5 12.5 5 5 10-11"/>
      </symbol>
      <symbol id="pt-i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>
      </symbol>
      <symbol id="pt-i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 5 7 7-7 7"/>
      </symbol>
      <symbol id="pt-i-chev-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 5-7 7 7 7"/>
      </symbol>
      <symbol id="pt-i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6 6 18"/>
      </symbol>
      <symbol id="pt-i-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>
      </symbol>
      <symbol id="pt-i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
      </symbol>
      <symbol id="pt-i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
      </symbol>
      <symbol id="pt-i-ticket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h13A1.5 1.5 0 0 1 20 8.5v2a2 2 0 0 0 0 3.9v2A1.5 1.5 0 0 1 18.5 18h-13A1.5 1.5 0 0 1 4 16.5v-2a2 2 0 0 0 0-3.9z"/>
      </symbol>
      <symbol id="pt-i-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4v11"/><path d="m7.5 11 4.5 4.5 4.5-4.5"/><path d="M5 19h14"/>
      </symbol>
    </defs>
  </svg>

  <div class="pt-shell">
    <header class="pt-topbar hq-top">
      <a class="hq-logo" href="#/today" aria-label="Blueprint HQ">
        <span class="hq-word">blueprint</span><span class="hq-mark">HQ</span>
      </a>

      <div class="hq-search" data-search>
        <label class="pt-visually-hidden" for="hq-q">Search clients, moments and content</label>
        <svg class="hq-search-icon" aria-hidden="true" focusable="false"><use href="#pt-i-search"/></svg>
        <input id="hq-q" type="search" placeholder="Search clients, moments, content" autocomplete="off" data-q />
        <div class="hq-results" data-results hidden></div>
      </div>

      <div class="pt-topbar-spacer"></div>
      <div class="hq-who" data-who></div>
    </header>

    <div class="pt-body">
      <nav class="pt-sidebar" aria-label="Blueprint HQ">
        {NAV.map((n) => (
          <a class="pt-nav-item" href={`#/${n.id}`} data-nav={n.id}>
            <svg aria-hidden="true" focusable="false"><use href={`#pt-i-${n.icon}`}/></svg>
            <span>{n.label}</span>
          </a>
        ))}
        <div class="pt-nav-spacer"></div>
        <a class="pt-nav-item" href="/portal">
          <svg aria-hidden="true" focusable="false"><use href="#pt-i-ext"/></svg>
          <span>Client portals</span>
        </a>
        <div class="hq-timing" data-timing></div>
      </nav>

      <main class="pt-main">
        <div data-state="loading" class="pt-empty">
          <div class="pt-empty-icon"><svg aria-hidden="true" focusable="false"><use href="#pt-i-chart"/></svg></div>
          <h3>Loading HQ</h3>
          <p>Reading every client out of Notion.</p>
        </div>

        <div data-state="locked" class="pt-empty" hidden>
          <div class="pt-empty-icon"><svg aria-hidden="true" focusable="false"><use href="#pt-i-info"/></svg></div>
          <h3>Not available</h3>
          <p>This page is for Blueprint. <a href="/portal">Go to the portals</a>.</p>
        </div>

        <div data-app hidden>
          <section class="pt-view" data-view="today" hidden></section>
          <section class="pt-view" data-view="clients" hidden></section>
          <section class="pt-view" data-view="pipeline" hidden></section>
          <section class="pt-view" data-view="reports" hidden></section>
        </div>
      </main>
    </div>

    {/* The sidebar is display:none under 900px, so without this there
        is no way off the Today tab on a phone. Same markup and the
        same classes the client portal's tab bar uses. */}
    <nav class="pt-tabbar" aria-label="Blueprint HQ">
      {NAV.map((n) => (
        <a class="pt-tab" href={`#/${n.id}`} data-nav={n.id}>
          <svg aria-hidden="true" focusable="false"><use href={`#pt-i-${n.icon}`}/></svg>
          <span>{n.label}</span>
          <span class="pt-tab-dot"></span>
        </a>
      ))}
    </nav>

    <div class="pt-toast" data-toast></div>
  </div>
</PortalLayout>

<script>
  /* ──────────────────────────────────────────────────────────────
     Blueprint HQ.

     Same rules as the client portal's script: every node is built
     with createElement and textContent. There is no innerHTML in
     this file, because everything on screen came out of Notion and a
     client's own text must never be able to run as markup here.

     What a row may do is never decided here. src/data/hq.ts asks the
     same predicates the write endpoints ask, so a tick box HQ draws is
     one the server will honour, and a row that cannot move draws no
     button at all.
     ────────────────────────────────────────────────────────────── */

  import {
    buildToday, stripItems, snoozeTo, isoToday,
    clientFacts, clientHealth, stepUpSoon, daysUntilDay, CARD_STAGES,
    type HqFilter, type HqRow, type RowClient, type StripItem,
    type CardClient, type HealthVerdict,
  } from '../../data/hq';
  import { termProgress } from '../../data/portal';

  const el = <K extends keyof HTMLElementTagNameMap>(
    tag: K, cls?: string, text?: string,
  ): HTMLElementTagNameMap[K] => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };
  const q = <T extends HTMLElement>(sel: string, root: ParentNode = document) =>
    root.querySelector<T>(sel);
  const qq = <T extends HTMLElement>(sel: string, root: ParentNode = document) =>
    Array.from(root.querySelectorAll<T>(sel));
  const show = (n: Element | null, on: boolean) => { if (n) (n as HTMLElement).hidden = !on; };
  const clear = (n: Element | null) => { while (n && n.firstChild) n.removeChild(n.firstChild); };
  const icon = (name: string, cls?: string): SVGSVGElement => {
    const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    s.setAttribute('aria-hidden', 'true');
    s.setAttribute('focusable', 'false');
    if (cls) s.setAttribute('class', cls);
    const u = document.createElementNS('http://www.w3.org/2000/svg', 'use');
    u.setAttribute('href', `#pt-i-${name}`);
    s.appendChild(u);
    return s;
  };

  const VIEWS = ['today', 'clients', 'pipeline', 'reports'] as const;
  type View = typeof VIEWS[number];

  let HQ: any = null;
  let FILTER: HqFilter = 'all';

  /* ── toast ───────────────────────────────────────────────────── */

  let toastTimer = 0;
  function toast(text: string, bad = false) {
    const t = q('[data-toast]');
    if (!t) return;
    t.textContent = text;
    t.classList.toggle('pt-toast-bad', bad);
    // The portal's toast is driven by data-open, not hidden: the
    // transition needs an element that is already in the layout.
    t.dataset.open = 'true';
    window.clearTimeout(toastTimer);
    // An error stays long enough to read and copy. A confirmation
    // does not need to.
    toastTimer = window.setTimeout(() => { t.dataset.open = 'false'; }, bad ? 9000 : 2600);
  }

  /* ── dates, as a person reads them ──────────────────────────── */

  const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  /** Read at UTC, like every date in this codebase, so a plain day
   *  never slips to the one before it in a western timezone. */
  function parts(day: string) {
    const d = new Date(`${day}T00:00:00Z`);
    return { dow: DAYS[d.getUTCDay()], d: d.getUTCDate(), m: MONTHS[d.getUTCMonth()] };
  }

  function shortDay(day: string): string {
    const p = parts(day);
    return `${p.dow} ${p.d} ${p.m}`;
  }

  function daysFromToday(day: string): number {
    const a = Date.parse(`${isoToday()}T00:00:00Z`);
    const b = Date.parse(`${day}T00:00:00Z`);
    return Math.round((b - a) / 86400000);
  }

  /** "3 days late", "today", "Thu 12 Nov". The overdue case says how
   *  late rather than when, because that is the thing to know. */
  function whenLabel(day: string): { text: string; late: boolean } {
    const n = daysFromToday(day);
    if (n < 0) {
      const late = Math.abs(n);
      return { text: late === 1 ? '1 day late' : `${late} days late`, late: true };
    }
    if (n === 0) return { text: 'today', late: false };
    if (n === 1) return { text: 'tomorrow', late: false };
    return { text: shortDay(day), late: false };
  }

  function stripWhen(it: StripItem): string {
    if (it.days === 0) return 'today';
    if (it.days === 1) return 'tomorrow';
    return `in ${it.days} days`;
  }

  /* ── reading the payload ─────────────────────────────────────── */

  const clients = (): RowClient[] => (HQ?.clients ?? []);

  /* ── routing ─────────────────────────────────────────────────── */

  function currentView(): View {
    const raw = (location.hash || '').replace(/^#\/?/, '').split('/')[0];
    return (VIEWS as readonly string[]).includes(raw) ? raw as View : 'today';
  }

  function route() {
    const view = currentView();
    for (const v of VIEWS) show(q(`[data-view="${v}"]`), v === view);
    for (const a of qq('[data-nav]')) {
      if (a.dataset.nav === view) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    }
    draw(view);
  }

  function draw(view: View) {
    if (!HQ) return;
    const root = q(`[data-view="${view}"]`);
    if (!root) return;
    clear(root);
    if (view === 'today') drawToday(root);
    if (view === 'clients') drawClients(root);
    if (view === 'pipeline') drawPipeline(root);
    if (view === 'reports') drawReports(root);
  }

  /* Placeholders until each tab lands. They are deliberately plain:
     a half-drawn tab should look unfinished rather than broken. */
  function soon(root: HTMLElement, what: string) {
    const e = el('div', 'pt-empty');
    const ic = el('div', 'pt-empty-icon');
    ic.appendChild(icon('info'));
    e.append(ic, el('h3', undefined, what), el('p', undefined, 'Not built yet.'));
    root.appendChild(e);
  }
  /* ══ CLIENTS ════════════════════════════════════════════════ */

  /** The segment after the view, if there is one: #/clients/sean-comma. */
  function currentParam(): string {
    return (location.hash || '').replace(/^#\/?/, '').split('/')[1] ?? '';
  }

  const cards = (): CardClient[] => clients()
    .filter((c) => (CARD_STAGES as readonly string[]).includes(c.stage ?? ''))
    .sort((a, b) => a.artist.localeCompare(b.artist));

  function factsFor(c: CardClient) {
    return clientFacts(c, {
      steps: HQ?.calendar ?? [],
      content: HQ?.content ?? [],
      snapshots: HQ?.snapshots ?? [],
    });
  }

  /** The soonest show or release still ahead of this client. */
  function nextMoment(c: CardClient) {
    const today = isoToday();
    return (HQ?.calendar ?? [])
      .filter((m: any) => m.clientId === c.pageId && m.kind === 'Moment'
        && m.date && m.date >= today
        && m.status !== 'Skipped' && m.status !== 'Moved')
      .sort((a: any, b: any) => a.date.localeCompare(b.date))[0] ?? null;
  }

  function drawClients(root: HTMLElement) {
    const slug = currentParam();
    if (slug) return drawClientDetail(root, slug);

    const list = cards();
    const bar = el('div', 'hq-bar');
    bar.appendChild(el('h1', undefined, 'Clients'));
    bar.appendChild(el('span', 'hq-sec-count', String(list.length)));
    root.appendChild(bar);

    if (!list.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('home'));
      e.append(ic, el('h3', undefined, 'No live clients'),
        el('p', undefined, 'Nobody is at Onboarding or Active. The Pipeline tab has the rest.'));
      root.appendChild(e);
      return;
    }

    const grid = el('div', 'hq-cards');
    for (const c of list) grid.appendChild(clientCard(c));
    root.appendChild(grid);
  }

  /** The dot, and the sentence behind it. The reason is on the title
   *  for the hover the spec asks for, and repeated for a screen
   *  reader, which never gets a hover. */
  function healthDot(v: HealthVerdict): HTMLElement {
    const wrap = el('span', 'hq-health');
    const dot = el('span', `hq-dot hq-dot-${v.level}`);
    const why = v.reasons.length ? v.reasons.join('; ') : 'nothing outstanding';
    dot.title = why;
    wrap.appendChild(dot);
    wrap.appendChild(el('span', 'pt-visually-hidden', `Health ${v.level}: ${why}`));
    return wrap;
  }

  function stat(label: string, value: string, tone?: string): HTMLElement {
    const s = el('div', 'hq-stat');
    s.append(
      el('div', `hq-stat-v${tone ? ` hq-stat-${tone}` : ''}`, value),
      el('div', 'hq-stat-l', label),
    );
    return s;
  }

  function clientCard(c: CardClient): HTMLElement {
    const f = factsFor(c);
    const v = clientHealth(f);

    const card = el('a', 'hq-card');
    card.href = `#/clients/${c.slug}`;

    const head = el('div', 'hq-card-head');
    head.appendChild(healthDot(v));
    const names = el('div', 'hq-card-names');
    names.append(
      el('div', 'hq-card-name', c.artist),
      el('div', 'hq-card-tier', c.tier ?? c.stage ?? ''),
    );
    head.appendChild(names);
    if (c.stage === 'Onboarding') head.appendChild(el('span', 'hq-tag', 'Onboarding'));
    card.appendChild(head);

    // Term progress.
    const t = termProgress(c.termStart ?? null, c.termEnd ?? null);
    if (t) {
      const term = el('div', 'hq-term');
      const label = el('div', 'hq-term-l');
      label.append(
        el('span', undefined, t.state === 'before'
          ? `Starts in ${t.daysUntilStart} days`
          : `Month ${t.month} of ${t.total}`),
        el('span', undefined, t.state === 'after' ? 'Term ended' : ''),
      );
      const bar = el('div', 'hq-term-bar');
      const fill = el('div', 'hq-term-fill');
      fill.style.width = `${Math.round(t.fraction * 100)}%`;
      bar.appendChild(fill);
      term.append(label, bar);
      card.appendChild(term);
    }

    const next = nextMoment(c);
    const line = el('div', 'hq-card-next');
    if (next) {
      const n = daysUntilDay(next.date) ?? 0;
      line.appendChild(icon(next.momentType === 'Show' ? 'ticket' : 'film'));
      line.appendChild(el('span', undefined,
        `${next.title} · ${n === 0 ? 'today' : n === 1 ? 'tomorrow' : `in ${n} days`}`));
    } else {
      line.appendChild(el('span', 'hq-card-none', 'No show or release booked'));
    }
    card.appendChild(line);

    const stats = el('div', 'hq-stats');
    stats.append(
      stat('ours overdue', String(f.overdueBlueprint), f.overdueBlueprint ? 'bad' : undefined),
      stat('theirs overdue', String(f.overdueClient), f.overdueClient >= 3 ? 'bad' : undefined),
      stat('posted / due', `${f.postedThisWeek} / ${f.scheduledThisWeek}`),
      stat('last report', f.lastReport ? shortDay(f.lastReport) : 'none',
        f.lastReport ? undefined : 'bad'),
    );
    card.appendChild(stats);

    // The step-up is a date you must not miss, so it only appears
    // when it is close enough to act on.
    const up = stepUpSoon(c.rateStepUp ?? null);
    if (up !== null) {
      card.appendChild(el('div', 'hq-card-flag',
        `Rate step-up ${up === 0 ? 'today' : `in ${up} days`}`));
    }

    if (v.reasons.length) {
      card.appendChild(el('div', `hq-card-why hq-why-${v.level}`, v.reasons[0]));
    }

    return card;
  }

  /* ── one client ──────────────────────────────────────────────── */

  function drawClientDetail(root: HTMLElement, slug: string) {
    const c = clients().find((x) => x.slug === slug) as CardClient | undefined;
    if (!c) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('info'));
      e.append(ic, el('h3', undefined, 'No such client'),
        el('p', undefined, 'Nothing here matches that link.'));
      const back = el('a', 'pt-btn', 'Back to clients');
      back.href = '#/clients';
      e.appendChild(back);
      root.appendChild(e);
      return;
    }

    const f = factsFor(c);
    const v = clientHealth(f);

    const back = el('a', 'hq-back');
    back.href = '#/clients';
    back.appendChild(icon('chev-left'));
    back.appendChild(el('span', undefined, 'Clients'));
    root.appendChild(back);

    const bar = el('div', 'hq-bar');
    const h = el('h1', undefined, c.artist);
    bar.append(healthDot(v), h);

    // The spec's "View as client". The portal already shows a band
    // saying you are looking at it as Blueprint, so the warning the
    // spec asks for is the one that is already there.
    const asClient = el('a', 'pt-btn pt-btn-primary');
    asClient.href = `/portal/${c.slug}`;
    asClient.appendChild(icon('ext'));
    asClient.appendChild(el('span', undefined, 'View as client'));
    bar.appendChild(asClient);
    root.appendChild(bar);

    if (v.reasons.length) {
      const why = el('div', `hq-why-band hq-why-${v.level}`);
      why.appendChild(icon('info'));
      why.appendChild(el('span', undefined, v.reasons.join(' · ')));
      root.appendChild(why);
    }

    root.appendChild(detailFacts(c, f));
    root.appendChild(linksCard(c));
    root.appendChild(todosCard(c));
    root.appendChild(calendarCard(c));
    root.appendChild(contentCard(c));
    root.appendChild(reportsCard(c));
  }

  function cardShell(title: string): { card: HTMLElement; body: HTMLElement } {
    const card = el('section', 'pt-card hq-block');
    const head = el('div', 'pt-card-head');
    head.appendChild(el('h2', undefined, title));
    const body = el('div', 'pt-card-body');
    card.append(head, body);
    return { card, body };
  }

  function detailFacts(c: CardClient, f: ReturnType<typeof factsFor>): HTMLElement {
    const { card, body } = cardShell('Where they are');
    const stats = el('div', 'hq-stats hq-stats-wide');
    const t = termProgress(c.termStart ?? null, c.termEnd ?? null);
    stats.append(
      stat('stage', c.stage ?? 'none'),
      stat('tier', (c.tier ?? 'none').replace(/^Tier \d+ · /, '')),
      stat('monthly', c.monthlyRate ? `$${c.monthlyRate.toLocaleString('en-US')}` : 'none'),
      stat('term', t ? `Month ${t.month} of ${t.total}` : 'none'),
      stat('ours overdue', String(f.overdueBlueprint), f.overdueBlueprint ? 'bad' : undefined),
      stat('theirs overdue', String(f.overdueClient), f.overdueClient >= 3 ? 'bad' : undefined),
      stat('posted this week', String(f.postedThisWeek)),
      stat('last report', f.lastReport ? shortDay(f.lastReport) : 'none'),
    );
    body.appendChild(stats);

    const up = stepUpSoon(c.rateStepUp ?? null);
    if (up !== null) {
      body.appendChild(el('div', 'hq-card-flag',
        `Rate step-up ${up === 0 ? 'today' : `in ${up} days`}${
          c.fullRate ? `, to $${Number(c.fullRate).toLocaleString('en-US')}` : ''}`));
    }
    return card;
  }

  function linkRow(label: string, href: string | null | undefined): HTMLElement | null {
    if (!href) return null;
    const a = el('a', 'hq-link');
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.append(el('span', undefined, label), icon('ext'));
    return a;
  }

  function linksCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Links');
    const row = el('div', 'hq-links');
    const any = [
      linkRow('Client Folder', c.clientFolder),
      linkRow('Content Vault', c.contentVault),
      linkRow('Drive Folder', c.driveFolder),
      linkRow('Brand Kit', c.brandKit),
      linkRow('Instagram', c.instagram),
      linkRow('TikTok', c.tiktok),
    ].filter(Boolean) as HTMLElement[];

    // The brand brief sits with the links rather than in its own
    // card: it is one more thing you open, not a section.
    const brief = c.brandBriefPdf ?? null;
    if (brief) {
      const b = linkRow('Brand Brief', brief);
      if (b) { b.classList.add('hq-link-strong'); any.unshift(b); }
    }

    if (!any.length) {
      body.appendChild(el('p', 'hq-none', 'No links on this client yet.'));
      return card;
    }
    for (const a of any) row.appendChild(a);
    body.appendChild(row);
    if (!brief) {
      body.appendChild(el('p', 'hq-none',
        'No brand brief yet. Upload one from the client’s Files tab.'));
    }
    return card;
  }

  /** Their open to-dos, ours kept out: this card answers "what are we
   *  waiting on them for". */
  function todosCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('What we are waiting on');
    const today = isoToday();
    const rows = (HQ?.calendar ?? [])
      .filter((s: any) => s.clientId === c.pageId && s.kind !== 'Moment'
        && s.owner === 'Client'
        && !['Done', 'Skipped', 'Moved'].includes(s.status ?? ''))
      .sort((a: any, b: any) => (a.date ?? '9999').localeCompare(b.date ?? '9999'));

    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'Nothing outstanding on their side.'));
      return card;
    }
    const list = el('div', 'hq-mini');
    for (const s of rows.slice(0, 12)) {
      const r = el('div', 'hq-mini-row');
      r.appendChild(el('span', 'hq-mini-t', s.title || 'Untitled'));
      const late = s.date && s.date < today;
      r.appendChild(el('span', `hq-mini-d${late ? ' hq-when-late' : ''}`,
        s.date ? (late ? whenLabel(s.date).text : shortDay(s.date)) : 'no date'));
      list.appendChild(r);
    }
    body.appendChild(list);
    return card;
  }

  function calendarCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Coming up');
    const today = isoToday();
    const rows = (HQ?.calendar ?? [])
      .filter((m: any) => m.clientId === c.pageId && m.date && m.date >= today
        && m.status !== 'Skipped' && m.status !== 'Moved')
      .sort((a: any, b: any) => a.date.localeCompare(b.date));

    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'Nothing on the calendar ahead.'));
      return card;
    }
    const list = el('div', 'hq-mini');
    for (const m of rows.slice(0, 14)) {
      const r = el('div', 'hq-mini-row');
      const t = el('span', 'hq-mini-t', m.title || 'Untitled');
      if (m.kind === 'Moment') t.classList.add('hq-mini-strong');
      r.appendChild(t);
      r.appendChild(el('span', 'hq-mini-k', m.momentType ?? m.type ?? m.owner ?? ''));
      r.appendChild(el('span', 'hq-mini-d', shortDay(m.date)));
      list.appendChild(r);
    }
    body.appendChild(list);
    return card;
  }

  function contentCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Content');
    const rows = (HQ?.content ?? []).filter((p: any) => p.clientId === c.pageId);
    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'No content in the window.'));
      return card;
    }

    // Grouped by status, in the order the pipeline runs rather than
    // alphabetically, so the board reads left to right.
    const ORDER = ['Idea', 'Planned', 'Filmed', 'Footage In', 'Editing',
                   'Ready for Review', 'Approved', 'Scheduled', 'Posted', 'Skipped'];
    const groups = new Map<string, any[]>();
    for (const p of rows) {
      const k = p.status ?? 'No status';
      if (!groups.has(k)) groups.set(k, []);
      groups.get(k)!.push(p);
    }
    const board = el('div', 'hq-board');
    for (const name of [...groups.keys()].sort((a, b) =>
      (ORDER.indexOf(a) + 1 || 99) - (ORDER.indexOf(b) + 1 || 99))) {
      const col = el('div', 'hq-col');
      const h = el('div', 'hq-col-head');
      h.append(el('span', undefined, name),
        el('span', 'hq-sec-count', String(groups.get(name)!.length)));
      col.appendChild(h);
      for (const p of groups.get(name)!) {
        const t = el('div', 'hq-col-card');
        t.append(el('div', 'hq-col-t', p.title || 'Untitled'),
          el('div', 'hq-col-d', p.postDate ? shortDay(p.postDate) : 'no date'));
        col.appendChild(t);
      }
      board.appendChild(col);
    }
    body.appendChild(board);
    return card;
  }

  function reportsCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Reports');
    const rows = (HQ?.snapshots ?? [])
      .filter((s: any) => s.clientId === c.pageId)
      .sort((a: any, b: any) => String(b.date ?? '').localeCompare(String(a.date ?? '')));

    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'No snapshots yet.'));
      return card;
    }
    const list = el('div', 'hq-mini');
    for (const s of rows.slice(0, 12)) {
      const r = el('div', 'hq-mini-row');
      r.appendChild(el('span', 'hq-mini-t', s.date ? monthLabel(s.date) : 'Undated'));
      r.appendChild(el('span', 'hq-mini-k', s.type ?? ''));
      if (s.published) {
        if (s.reportPdf) {
          const a = el('a', 'hq-mini-d hq-link-strong');
          a.href = s.reportPdf;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = s.publishedAt ? shortDay(String(s.publishedAt).slice(0, 10)) : 'published';
          r.appendChild(a);
        } else {
          r.appendChild(el('span', 'hq-mini-d', 'published'));
        }
      } else {
        r.appendChild(el('span', 'hq-mini-d hq-mini-draft', 'draft'));
      }
      list.appendChild(r);
    }
    body.appendChild(list);
    return card;
  }

  function monthLabel(day: string): string {
    const d = new Date(`${day}T00:00:00Z`);
    return `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
  }
  function drawPipeline(root: HTMLElement) { soon(root, 'Pipeline'); }
  function drawReports(root: HTMLElement) { soon(root, 'Reports'); }

  /* ══ TODAY ══════════════════════════════════════════════════ */

  function drawToday(root: HTMLElement) {
    root.appendChild(strip());
    root.appendChild(todayBar());

    const lists = buildToday(
      { clients: clients(), steps: HQ?.calendar ?? [], content: HQ?.content ?? [] },
      FILTER,
    );

    const total = lists.overdue.length + lists.today.length + lists.week.length;
    if (!total) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('check'));
      e.append(ic, el('h3', undefined, 'Nothing outstanding'),
        el('p', undefined, FILTER === 'all'
          ? 'No step, post or next action is due in the next seven days.'
          : 'Nothing here under this filter. Try All.'));
      root.appendChild(e);
      return;
    }

    if (lists.overdue.length) root.appendChild(section('Overdue', lists.overdue, true));
    if (lists.today.length) root.appendChild(section('Due today', lists.today));
    if (lists.week.length) root.appendChild(section('This week', lists.week));
  }

  /** Shows and releases across every client, next fortnight. */
  function strip(): HTMLElement {
    const byId = new Map(clients().map((c) => [c.pageId, c]));
    const items = stripItems(HQ?.calendar ?? [], byId);

    if (!items.length) {
      return el('div', 'hq-strip-empty', 'No show or release in the next fortnight.');
    }

    const wrap = el('div', 'hq-strip');
    wrap.setAttribute('aria-label', 'Shows and releases, next fortnight');
    for (const it of items) {
      const a = el('a', `hq-strip-item hq-strip-${it.momentType === 'Show' ? 'show' : 'release'}`);
      a.href = `/portal/${it.clientSlug}#calendar`;
      a.append(
        el('div', 'hq-strip-when', stripWhen(it)),
        el('div', 'hq-strip-title', it.title),
        el('div', 'hq-strip-client',
          it.venueCity ? `${it.clientName} · ${it.venueCity}` : it.clientName),
      );
      wrap.appendChild(a);
    }
    return wrap;
  }

  function todayBar(): HTMLElement {
    const bar = el('div', 'hq-bar');
    bar.appendChild(el('h1', undefined, 'Today'));

    const seg = el('div', 'hq-seg');
    seg.setAttribute('role', 'group');
    seg.setAttribute('aria-label', 'Whose work to show');
    const opts: Array<[HqFilter, string]> = [
      ['mine', 'Mine'], ['clients', "Clients'"], ['all', 'All'],
    ];
    for (const [value, label] of opts) {
      const b = el('button', undefined, label);
      b.type = 'button';
      b.setAttribute('aria-pressed', String(FILTER === value));
      b.addEventListener('click', () => {
        FILTER = value;
        draw('today');
      });
      seg.appendChild(b);
    }
    bar.appendChild(seg);
    return bar;
  }

  function section(title: string, rows: HqRow[], overdue = false): HTMLElement {
    const sec = el('section', `hq-sec${overdue ? ' hq-sec-overdue' : ''}`);
    const head = el('div', 'hq-sec-head');
    head.append(el('h2', undefined, title), el('span', 'hq-sec-count', String(rows.length)));
    sec.appendChild(head);

    const list = el('div', 'hq-list');
    for (const r of rows) list.appendChild(rowNode(r));
    sec.appendChild(list);
    return sec;
  }

  function rowNode(r: HqRow): HTMLElement {
    const row = el('div', 'hq-row');
    row.dataset.key = r.key;

    // The tick box, but only where the server would accept one.
    if (r.tickTo) {
      const tick = el('button', 'hq-tick');
      tick.type = 'button';
      tick.setAttribute('aria-pressed', 'false');
      tick.setAttribute('aria-label', `Mark "${r.title}" done`);
      tick.appendChild(icon('check'));
      tick.addEventListener('click', () => void doTick(row, r));
      row.appendChild(tick);
    } else {
      row.appendChild(el('div', 'hq-tick-none'));
    }

    const main = el('div', 'hq-row-main');
    main.appendChild(el('div', 'hq-row-title', r.title));

    const meta = el('div', 'hq-row-meta');
    const chip = el('a', 'hq-client', r.clientName);
    chip.href = `/portal/${r.clientSlug}`;
    meta.appendChild(chip);
    meta.appendChild(el('span', `hq-own hq-own-${r.owner}`,
      r.owner === 'blueprint' ? 'Blueprint' : 'Client'));
    if (r.type) meta.appendChild(el('span', 'hq-type', r.type));
    const when = whenLabel(r.date);
    meta.appendChild(el('span', `hq-when${when.late ? ' hq-when-late' : ''}`, when.text));
    main.appendChild(meta);
    row.appendChild(main);

    const acts = el('div', 'hq-row-acts');
    if (r.snoozable) addSnooze(acts, row, r);
    row.appendChild(acts);

    return row;
  }

  /* ── snooze ──────────────────────────────────────────────────── */

  function closeMenus() {
    for (const m of qq('.hq-menu')) m.hidden = true;
  }

  /** Appends the button and its menu straight onto the actions cell,
   *  which is the positioned ancestor the menu hangs off. */
  function addSnooze(acts: HTMLElement, row: HTMLElement, r: HqRow) {
    const btn = el('button', 'pt-btn pt-btn-icon');
    btn.type = 'button';
    btn.title = 'Snooze';
    btn.setAttribute('aria-label', `Snooze "${r.title}"`);
    btn.appendChild(icon('clock'));

    const menu = el('div', 'hq-menu');
    menu.hidden = true;

    const option = (label: string, days: number) => {
      const b = el('button', undefined, label);
      b.type = 'button';
      b.addEventListener('click', () => {
        closeMenus();
        void doSnooze(row, r, snoozeTo(r.date, days));
      });
      return b;
    };
    menu.append(option('Tomorrow', 1), option('Next week', 7));
    menu.appendChild(el('div', 'hq-menu-sep'));

    const pick = el('label', 'hq-menu-pick');
    pick.appendChild(el('span', undefined, 'Pick a date'));
    const input = el('input');
    input.type = 'date';
    input.value = r.date;
    // Nothing on this calendar is in the past on purpose, and a
    // snooze backwards is not a snooze.
    input.min = isoToday();
    input.addEventListener('change', () => {
      const v = input.value;
      if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
      closeMenus();
      void doSnooze(row, r, v);
    });
    pick.appendChild(input);
    menu.appendChild(pick);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = !menu.hidden;
      closeMenus();
      menu.hidden = wasOpen;
    });

    acts.append(btn, menu);
  }

  /* ── the writes ──────────────────────────────────────────────── */

  async function patch(url: string, body: unknown): Promise<boolean> {
    try {
      const res = await fetch(url, {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      return res.ok;
    } catch {
      return false;
    }
  }

  /** Where a tick goes, by kind. The portal's own endpoints for a step
   *  and a content card; HQ's for a next action, which lives on the
   *  Clients row and has no status to write. */
  function tickRequest(r: HqRow): { url: string; body: unknown } {
    if (r.kind === 'step') {
      return { url: `/portal/${r.clientSlug}/step/${r.id}`, body: { status: 'Done' } };
    }
    if (r.kind === 'content') {
      return { url: `/portal/${r.clientSlug}/content/${r.id}`, body: { status: 'Posted' } };
    }
    return { url: `/portal/hq/client/${r.id}`, body: { nextActionDate: null } };
  }

  function snoozeRequest(r: HqRow, to: string): { url: string; body: unknown } {
    if (r.kind === 'step') {
      return { url: `/portal/${r.clientSlug}/step/${r.id}`, body: { date: to } };
    }
    if (r.kind === 'content') {
      return { url: `/portal/${r.clientSlug}/content/${r.id}`, body: { postDate: to } };
    }
    return { url: `/portal/hq/client/${r.id}`, body: { nextActionDate: to } };
  }

  async function doTick(row: HTMLElement, r: HqRow) {
    row.dataset.busy = 'true';
    const { url, body } = tickRequest(r);
    const ok = await patch(url, body);
    delete row.dataset.busy;

    if (!ok) {
      toast(`That did not save. ${r.clientName}'s row is unchanged.`, true);
      return;
    }

    // The payload is edited in place rather than refetched. A refetch
    // would be a full read of five Notion databases to learn one thing
    // we already know, and the ninety-second cache would hand back the
    // old answer anyway.
    applyTick(r);
    toast('Done.');
    draw('today');
  }

  async function doSnooze(row: HTMLElement, r: HqRow, to: string) {
    row.dataset.busy = 'true';
    const { url, body } = snoozeRequest(r, to);
    const ok = await patch(url, body);
    delete row.dataset.busy;

    if (!ok) {
      toast(`That did not save. ${r.clientName}'s row is unchanged.`, true);
      return;
    }

    applyDate(r, to);
    toast(`Moved to ${shortDay(to)}.`);
    draw('today');
  }

  function applyTick(r: HqRow) {
    if (r.kind === 'step') {
      const it = (HQ?.calendar ?? []).find((x: any) => x.id === r.id);
      if (it) it.status = 'Done';
      return;
    }
    if (r.kind === 'content') {
      const it = (HQ?.content ?? []).find((x: any) => x.id === r.id);
      if (it) it.status = 'Posted';
      return;
    }
    const c = (HQ?.clients ?? []).find((x: any) => x.pageId === r.id);
    if (c) c.nextActionDate = null;
  }

  function applyDate(r: HqRow, to: string) {
    if (r.kind === 'step') {
      const it = (HQ?.calendar ?? []).find((x: any) => x.id === r.id);
      if (it) it.date = to;
      return;
    }
    if (r.kind === 'content') {
      const it = (HQ?.content ?? []).find((x: any) => x.id === r.id);
      if (it) it.postDate = to;
      return;
    }
    const c = (HQ?.clients ?? []).find((x: any) => x.pageId === r.id);
    if (c) c.nextActionDate = to;
  }

  /* ══ SEARCH ═════════════════════════════════════════════════ */

  const MAX_RESULTS = 12;

  interface Hit { what: string; title: string; who: string; href: string; }

  function searchAll(raw: string): Hit[] {
    const term = raw.trim().toLowerCase();
    if (term.length < 2) return [];
    const hits: Hit[] = [];
    const byId = new Map(clients().map((c) => [c.pageId, c]));

    for (const c of clients()) {
      if (c.artist.toLowerCase().includes(term)) {
        hits.push({
          what: 'Client', title: c.artist, who: c.stage ?? '',
          href: `/portal/${c.slug}`,
        });
      }
    }
    for (const m of (HQ?.calendar ?? [])) {
      if (!m.title || !m.title.toLowerCase().includes(term)) continue;
      const c = m.clientId ? byId.get(m.clientId) : null;
      if (!c) continue;
      hits.push({
        what: m.kind === 'Moment' ? 'Moment' : 'Step', title: m.title,
        who: c.artist, href: `/portal/${c.slug}#calendar`,
      });
    }
    for (const p of (HQ?.content ?? [])) {
      if (!p.title || !p.title.toLowerCase().includes(term)) continue;
      const c = p.clientId ? byId.get(p.clientId) : null;
      if (!c) continue;
      hits.push({
        what: 'Content', title: p.title, who: c.artist,
        href: `/portal/${c.slug}#content`,
      });
    }

    return hits.slice(0, MAX_RESULTS);
  }

  function wireSearch() {
    const input = q<HTMLInputElement>('[data-q]');
    const panel = q('[data-results]');
    if (!input || !panel) return;

    const render = () => {
      const hits = searchAll(input.value);
      clear(panel);

      if (input.value.trim().length < 2) { panel.hidden = true; return; }

      if (!hits.length) {
        panel.appendChild(el('div', 'hq-results-none', 'Nothing matches.'));
        panel.hidden = false;
        return;
      }

      for (const h of hits) {
        const a = el('a', 'hq-result');
        a.href = h.href;
        a.append(
          el('span', 'hq-result-what', h.what),
          el('span', 'hq-result-title', h.title),
          el('span', 'hq-result-who', h.who),
        );
        panel.appendChild(a);
      }
      panel.hidden = false;
    };

    input.addEventListener('input', render);
    input.addEventListener('focus', render);
    // Escape closes it and gives the box back, which is what a search
    // field that covers the page has to do.
    input.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') { panel.hidden = true; input.blur(); }
    });
  }

  /* ── boot ────────────────────────────────────────────────────── */

  async function boot() {
    const started = performance.now();
    let res: Response;
    try {
      res = await fetch('/portal/hq/data', { credentials: 'same-origin' });
    } catch {
      show(q('[data-state="loading"]'), false);
      show(q('[data-state="locked"]'), true);
      return;
    }

    if (!res.ok) {
      show(q('[data-state="loading"]'), false);
      show(q('[data-state="locked"]'), true);
      return;
    }

    HQ = await res.json();
    const ms = Math.round(performance.now() - started);

    const who = q('[data-who]');
    if (who) who.textContent = String(HQ?.viewer?.email ?? '');

    // The spec asks for page load timing, so it is on the page rather
    // than in a console nobody has open: server time as the endpoint
    // measured it, and the round trip as the browser saw it.
    const timing = q('[data-timing]');
    if (timing) {
      const server = Number(HQ?.timing?.totalMs ?? 0);
      timing.textContent = `${ms}ms · server ${server}ms${HQ?.timing?.cached ? ' · cached' : ''}`;
    }

    show(q('[data-state="loading"]'), false);
    show(q('[data-app]'), true);
    wireSearch();

    // One listener for every menu on the page, rather than one per
    // row: a click anywhere else closes whatever is open.
    document.addEventListener('click', (e) => {
      const t = e.target as Element | null;
      if (t && t.closest('.hq-menu')) return;
      closeMenus();
      const panel = q('[data-results]');
      if (panel && t && !t.closest('[data-search]')) panel.hidden = true;
    });

    window.addEventListener('hashchange', route);
    route();
  }

  void boot();
</script>
