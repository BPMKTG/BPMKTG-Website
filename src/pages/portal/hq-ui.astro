---
// Blueprint HQ: the shell.
//
// Served ONLY by functions/portal/hq/index.ts, which checks the admin
// cookie against ADMIN_EMAILS and fetches this page through the
// ASSETS binding. The asset path itself is guarded by
// functions/portal/hq-ui/index.ts, which 404s everybody: ASSETS goes
// straight to the asset store and does not come back through a
// Function, so the only way in is the gate.
//
// Nothing here is data. Everything real arrives from /portal/hq/data,
// which runs the same gate again.
//
// The layout classes are the portal's own (pt-topbar, pt-sidebar,
// pt-nav-item, pt-card). HQ is the same design system seen from our
// side, so it reuses them rather than restating them; only the HQ
// classes at the foot of portal.css are new.
import PortalLayout from '../../layouts/PortalLayout.astro';

const NAV = [
  { id: 'today',    label: 'Today',    icon: 'check' },
  { id: 'clients',  label: 'Clients',  icon: 'home' },
  { id: 'calendar', label: 'Calendar', icon: 'cal' },
  { id: 'content',  label: 'Content',  icon: 'film' },
  { id: 'pipeline', label: 'Pipeline', icon: 'grip' },
  { id: 'reports',  label: 'Reports',  icon: 'chart' },
];
---

<PortalLayout title="Blueprint HQ">
  {/* The same sprite the portal uses, trimmed to what HQ draws. */}
  <svg class="pt-visually-hidden" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="pt-i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-6h5v6"/>
      </symbol>
      <symbol id="pt-i-cal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 3v4M16 3v4"/>
      </symbol>
      <symbol id="pt-i-chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
      </symbol>
      <symbol id="pt-i-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4.3a1.5 1.5 0 0 1 1.1.5l1.3 1.5h7.3A1.5 1.5 0 0 1 20 9.5v8A1.5 1.5 0 0 1 18.5 19h-14A1.5 1.5 0 0 1 3 17.5z"/>
      </symbol>
      <symbol id="pt-i-film" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M8 5v14M16 5v14M3 12h18"/>
      </symbol>
      <symbol id="pt-i-grip" viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/>
      </symbol>
      <symbol id="pt-i-video" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="6" width="13" height="12" rx="2.5"/><path d="M16 10.5l5-3v9l-5-3"/>
      </symbol>
      <symbol id="pt-i-photo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="M21 15l-4.5-4.5L8 19"/>
      </symbol>
      <symbol id="pt-i-carousel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="7" y="5" width="10" height="14" rx="2"/><path d="M3.5 8v8M20.5 8v8"/>
      </symbol>
      <symbol id="pt-i-graphic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="4" width="16" height="16" rx="2.5"/><path d="M8 9h8M8 13h5"/><circle cx="15.5" cy="15.5" r="1.4"/>
      </symbol>
      <symbol id="pt-i-story" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="7" y="3" width="10" height="18" rx="2.5"/><path d="M10.5 6.5h3"/>
      </symbol>
      <symbol id="pt-i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M12 5v14M5 12h14"/>
      </symbol>
      <symbol id="pt-i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m4.5 12.5 5 5 10-11"/>
      </symbol>
      <symbol id="pt-i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>
      </symbol>
      <symbol id="pt-i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 5 7 7-7 7"/>
      </symbol>
      <symbol id="pt-i-chev-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 5-7 7 7 7"/>
      </symbol>
      <symbol id="pt-i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6 6 18"/>
      </symbol>
      <symbol id="pt-i-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>
      </symbol>
      <symbol id="pt-i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
      </symbol>
      <symbol id="pt-i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
      </symbol>
      <symbol id="pt-i-ticket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h13A1.5 1.5 0 0 1 20 8.5v2a2 2 0 0 0 0 3.9v2A1.5 1.5 0 0 1 18.5 18h-13A1.5 1.5 0 0 1 4 16.5v-2a2 2 0 0 0 0-3.9z"/>
      </symbol>
      <symbol id="pt-i-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4v11"/><path d="m7.5 11 4.5 4.5 4.5-4.5"/><path d="M5 19h14"/>
      </symbol>
    </defs>
  </svg>

  <div class="pt-shell">
    <header class="pt-topbar hq-top">
      <a class="hq-logo" href="#/today" aria-label="Blueprint HQ">
        <span class="hq-word">blueprint</span><span class="hq-mark">HQ</span>
      </a>

      <div class="hq-search" data-search>
        <label class="pt-visually-hidden" for="hq-q">Search clients, moments and content</label>
        <svg class="hq-search-icon" aria-hidden="true" focusable="false"><use href="#pt-i-search"/></svg>
        <input id="hq-q" type="search" placeholder="Search clients, moments, content" autocomplete="off" data-q />
        <div class="hq-results" data-results hidden></div>
      </div>

      <div class="pt-topbar-spacer"></div>
      <div class="hq-who" data-who></div>
    </header>

    <div class="pt-body">
      <nav class="pt-sidebar" aria-label="Blueprint HQ">
        {NAV.map((n) => (
          <a class="pt-nav-item" href={`#/${n.id}`} data-nav={n.id}>
            <svg aria-hidden="true" focusable="false"><use href={`#pt-i-${n.icon}`}/></svg>
            <span>{n.label}</span>
          </a>
        ))}
        <div class="pt-nav-spacer"></div>
        <a class="pt-nav-item" href="/portal">
          <svg aria-hidden="true" focusable="false"><use href="#pt-i-ext"/></svg>
          <span>Client portals</span>
        </a>
        <div class="hq-timing" data-timing></div>
      </nav>

      <main class="pt-main">
        <div data-state="loading" class="pt-empty">
          <div class="pt-empty-icon"><svg aria-hidden="true" focusable="false"><use href="#pt-i-chart"/></svg></div>
          <h3>Loading HQ</h3>
          <p>Reading every client out of Notion.</p>
        </div>

        <div data-state="locked" class="pt-empty" hidden>
          <div class="pt-empty-icon"><svg aria-hidden="true" focusable="false"><use href="#pt-i-info"/></svg></div>
          <h3>Not available</h3>
          <p>This page is for Blueprint. <a href="/portal">Go to the portals</a>.</p>
        </div>

        <div data-app hidden>
          <section class="pt-view" data-view="today" hidden></section>
          <section class="pt-view" data-view="clients" hidden></section>
          <section class="pt-view" data-view="calendar" hidden></section>
          <section class="pt-view" data-view="content" hidden></section>
          <section class="pt-view" data-view="pipeline" hidden></section>
          <section class="pt-view" data-view="reports" hidden></section>
        </div>
      </main>
    </div>

    {/* The sidebar is display:none under 900px, so without this there
        is no way off the Today tab on a phone. Same markup and the
        same classes the client portal's tab bar uses. */}
    <nav class="pt-tabbar" aria-label="Blueprint HQ">
      {NAV.map((n) => (
        <a class="pt-tab" href={`#/${n.id}`} data-nav={n.id}>
          <svg aria-hidden="true" focusable="false"><use href={`#pt-i-${n.icon}`}/></svg>
          <span>{n.label}</span>
          <span class="pt-tab-dot"></span>
        </a>
      ))}
    </nav>

    {/* ── the calendar's two dialogs ───────────────────────────
        The drawer reads a row; the sheet asks one short question, which
        for the calendar is "move the whole campaign?". Same markup and
        the same classes the client portal uses, because the shared
        calendar and the shared move flow look for these attributes. */}
    <div class="pt-scrim" data-scrim hidden></div>
    <aside class="pt-drawer" data-drawer role="dialog" aria-modal="true" aria-labelledby="hq-drawer-title" hidden>
      <div class="pt-drawer-head">
        <h2 id="hq-drawer-title" data-drawer-title></h2>
        <button class="pt-announce-close" data-drawer-close aria-label="Close details">
          <svg aria-hidden="true" focusable="false"><use href="#pt-i-close"/></svg>
        </button>
      </div>
      <div class="pt-drawer-body" data-drawer-body></div>
      <div class="pt-drawer-foot" data-drawer-foot hidden></div>
    </aside>

    <div class="pt-scrim" data-sheet-scrim hidden></div>
    <div class="pt-sheet" data-sheet role="dialog" aria-modal="true" aria-labelledby="hq-sheet-title" hidden>
      <div class="pt-sheet-head">
        <h2 id="hq-sheet-title" data-sheet-title></h2>
        <button class="pt-announce-close" data-sheet-close aria-label="Close">
          <svg aria-hidden="true" focusable="false"><use href="#pt-i-close"/></svg>
        </button>
      </div>
      <form class="pt-sheet-body" data-sheet-body></form>
    </div>

    <div class="pt-toast" data-toast></div>
  </div>
</PortalLayout>

<script>
  /* ──────────────────────────────────────────────────────────────
     Blueprint HQ.

     Same rules as the client portal's script: every node is built
     with createElement and textContent. There is no innerHTML in
     this file, because everything on screen came out of Notion and a
     client's own text must never be able to run as markup here.

     What a row may do is never decided here. src/data/hq.ts asks the
     same predicates the write endpoints ask, so a tick box HQ draws is
     one the server will honour, and a row that cannot move draws no
     button at all.
     ────────────────────────────────────────────────────────────── */

  import {
    buildToday, stripItems, snoozeTo, isoToday,
    clientFacts, clientHealth, stepUpSoon, daysUntilDay, CARD_STAGES,
    reportDrafts, reportPublished, reportGaps, sortAudits, docBase,
    groupByCampaign, momentIndex, oneLine, NOTE_SEP,
    clientColor, dayClash, deliverables, onCalendar,
    DELIVERABLES_MIN, DELIVERABLES_MAX,
    type HqCampaignGroup, type HqFilter, type HqMomentRef, type HqRow,
    type RowClient, type StripItem, type CardClient, type HealthVerdict,
  } from '../../data/hq';
  import {
    canSetStepStatus, cardFilmCovered, cardFilmRow, cardMoment, cardMomentIndex,
    cardOnCalendar, cardRowTitle, filmCover, flowOf,
    cleanItemTitle, isStepDone, itemKind, momentKind,
    termProgress, HQ_LAYERS, KIND_LABEL,
    type PortalCalendarItem,
  } from '../../data/portal';
  import {
    postedRecently, stageOf,
    type PortalContentItem, type Voice,
  } from '../../data/portal-content';
  import type { HqCalItem, HqContentItem } from '../../server/hq-data';
  import { createCalendar, type Calendar } from '../../scripts/portal-calendar';
  import { createMover, type Mover } from '../../scripts/portal-move';
  import { bindSheet } from '../../scripts/portal-sheet';
  import { HQ_STAGES, LEAD_SOURCES } from '../../data/hq';
  // The same pieces the client portal is built from, so there is one
  // copy of them rather than one per screen.
  import { createBoard, isPhone, type Board } from '../../scripts/portal-board';
  import { fillContentDrawer as fillSharedDrawer } from '../../scripts/portal-content-drawer';
  import { clear, el, icon, q, qq, show } from '../../scripts/portal-dom';

  const VIEWS = ['today', 'clients', 'calendar', 'content', 'pipeline', 'reports'] as const;
  type View = typeof VIEWS[number];

  let HQ: any = null;
  let FILTER: HqFilter = 'all';

  /* ── how Today is grouped ────────────────────────────────────────
     By day, or by campaign. The choice is remembered because it is a
     way of working rather than a thing you flick between: someone who
     reads their week as rollouts wants it that way every morning. */

  type GroupBy = 'date' | 'campaign';
  const HQ_STORE = 'bp.hq.v1';
  let GROUP: GroupBy = 'date';

  /** Which clients the calendar is showing. Empty means all of them.
   *  Declared up here because loadHqPrefs restores it before the
   *  calendar block has run. */
  let WHO = new Set<string>();

  function loadHqPrefs() {
    try {
      const raw = localStorage.getItem(HQ_STORE);
      if (!raw) return;
      const v = JSON.parse(raw) as { group?: unknown; who?: unknown };
      if (v.group === 'date' || v.group === 'campaign') GROUP = v.group;
      // An empty list means every client, which is also what a browser
      // that has never been here means, so the two agree.
      if (Array.isArray(v.who)) WHO = new Set(v.who.filter((x): x is string => typeof x === 'string'));
    } catch { /* a browser that will not remember is not an error */ }
  }

  function saveHqPrefs() {
    try {
      localStorage.setItem(HQ_STORE, JSON.stringify({
        group: GROUP, who: Array.from(WHO),
      }));
    } catch { /* same */ }
  }

  /** Every moment on the calendar, by id, for the rows that are drawn
   *  outside buildToday: the Clients tab builds its own. */
  function momentsNow(): Map<string, HqMomentRef> {
    const byId = new Map(clients().map((c) => [c.pageId, c]));
    return momentIndex((HQ?.calendar ?? []) as any[], byId);
  }

  /* ── toast ───────────────────────────────────────────────────── */

  let toastTimer = 0;
  function toast(text: string, bad = false) {
    const t = q('[data-toast]');
    if (!t) return;
    t.textContent = text;
    t.classList.toggle('pt-toast-bad', bad);
    // The portal's toast is driven by data-open, not hidden: the
    // transition needs an element that is already in the layout.
    t.dataset.open = 'true';
    window.clearTimeout(toastTimer);
    // An error stays long enough to read and copy. A confirmation
    // does not need to.
    toastTimer = window.setTimeout(() => { t.dataset.open = 'false'; }, bad ? 9000 : 2600);
  }

  /* ── dates, as a person reads them ──────────────────────────── */

  const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  /** Read at UTC, like every date in this codebase, so a plain day
   *  never slips to the one before it in a western timezone. */
  function parts(day: string) {
    const d = new Date(`${day}T00:00:00Z`);
    return { dow: DAYS[d.getUTCDay()], d: d.getUTCDate(), m: MONTHS[d.getUTCMonth()] };
  }

  function shortDay(day: string): string {
    const p = parts(day);
    return `${p.dow} ${p.d} ${p.m}`;
  }

  function daysFromToday(day: string): number {
    const a = Date.parse(`${isoToday()}T00:00:00Z`);
    const b = Date.parse(`${day}T00:00:00Z`);
    return Math.round((b - a) / 86400000);
  }

  /** "3 days late", "today", "Thu 12 Nov". The overdue case says how
   *  late rather than when, because that is the thing to know. */
  function whenLabel(day: string): { text: string; late: boolean } {
    const n = daysFromToday(day);
    if (n < 0) {
      const late = Math.abs(n);
      return { text: late === 1 ? '1 day late' : `${late} days late`, late: true };
    }
    if (n === 0) return { text: 'today', late: false };
    if (n === 1) return { text: 'tomorrow', late: false };
    return { text: shortDay(day), late: false };
  }

  function stripWhen(it: StripItem): string {
    if (it.days === 0) return 'today';
    if (it.days === 1) return 'tomorrow';
    return `in ${it.days} days`;
  }

  /* ── reading the payload ─────────────────────────────────────── */

  const clients = (): RowClient[] => (HQ?.clients ?? []);

  /* ── routing ─────────────────────────────────────────────────── */

  function currentView(): View {
    const raw = (location.hash || '').replace(/^#\/?/, '').split('/')[0];
    return (VIEWS as readonly string[]).includes(raw) ? raw as View : 'today';
  }

  function route() {
    const view = currentView();
    for (const v of VIEWS) show(q(`[data-view="${v}"]`), v === view);
    for (const a of qq('[data-nav]')) {
      if (a.dataset.nav === view) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    }
    draw(view);
  }

  function draw(view: View) {
    if (!HQ) return;
    const root = q(`[data-view="${view}"]`);
    if (!root) return;
    clear(root);
    if (view === 'today') drawToday(root);
    if (view === 'clients') drawClients(root);
    if (view === 'calendar') drawCalendarTab(root);
    if (view === 'content') drawContentTab(root);
    if (view === 'pipeline') drawPipeline(root);
    if (view === 'reports') drawReports(root);
  }

  /* ══ CLIENTS ════════════════════════════════════════════════ */

  /** The segment after the view, if there is one: #/clients/sean-comma. */
  function currentParam(): string {
    return (location.hash || '').replace(/^#\/?/, '').split('/')[1] ?? '';
  }

  const cards = (): CardClient[] => clients()
    .filter((c) => (CARD_STAGES as readonly string[]).includes(c.stage ?? ''))
    .sort((a, b) => a.artist.localeCompare(b.artist));

  function factsFor(c: CardClient) {
    return clientFacts(c, {
      steps: HQ?.calendar ?? [],
      content: HQ?.content ?? [],
      snapshots: HQ?.snapshots ?? [],
    });
  }

  /** What we owe this client this month. Counted off the content
   *  board, which is where our posts live. */
  function deliverablesFor(c: { pageId: string }) {
    return deliverables((HQ?.content ?? []).filter((x: any) => x.clientId === c.pageId));
  }

  /** The soonest show or release still ahead of this client. */
  function nextMoment(c: CardClient) {
    const today = isoToday();
    return (HQ?.calendar ?? [])
      .filter((m: any) => m.clientId === c.pageId && m.kind === 'Moment'
        && m.date && m.date >= today
        && m.status !== 'Skipped' && m.status !== 'Moved')
      .sort((a: any, b: any) => a.date.localeCompare(b.date))[0] ?? null;
  }

  function drawClients(root: HTMLElement) {
    const slug = currentParam();
    if (slug) return drawClientDetail(root, slug);

    const list = cards();
    const bar = el('div', 'hq-bar');
    bar.appendChild(el('h1', undefined, 'Clients'));
    bar.appendChild(el('span', 'hq-sec-count', String(list.length)));
    root.appendChild(bar);

    if (!list.length) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('home'));
      e.append(ic, el('h3', undefined, 'No live clients'),
        el('p', undefined, 'Nobody is at Onboarding or Active. The Pipeline tab has the rest.'));
      root.appendChild(e);
      return;
    }

    const grid = el('div', 'hq-cards');
    for (const c of list) grid.appendChild(clientCard(c));
    root.appendChild(grid);
  }

  /** The dot, and the sentence behind it. The reason is on the title
   *  for the hover the spec asks for, and repeated for a screen
   *  reader, which never gets a hover. */
  function healthDot(v: HealthVerdict): HTMLElement {
    const wrap = el('span', 'hq-health');
    const dot = el('span', `hq-dot hq-dot-${v.level}`);
    const why = v.reasons.length ? v.reasons.join('; ') : 'nothing outstanding';
    dot.title = why;
    wrap.appendChild(dot);
    wrap.appendChild(el('span', 'pt-visually-hidden', `Health ${v.level}: ${why}`));
    return wrap;
  }

  function stat(label: string, value: string, tone?: string): HTMLElement {
    const s = el('div', 'hq-stat');
    s.append(
      el('div', `hq-stat-v${tone ? ` hq-stat-${tone}` : ''}`, value),
      el('div', 'hq-stat-l', label),
    );
    return s;
  }

  function clientCard(c: CardClient): HTMLElement {
    const f = factsFor(c);
    const v = clientHealth(f);

    const card = el('a', 'hq-card');
    card.href = `#/clients/${c.slug}`;

    const head = el('div', 'hq-card-head');
    head.appendChild(healthDot(v));
    const names = el('div', 'hq-card-names');
    names.append(
      el('div', 'hq-card-name', c.artist),
      el('div', 'hq-card-tier', c.tier ?? c.stage ?? ''),
    );
    head.appendChild(names);
    if (c.stage === 'Onboarding') head.appendChild(el('span', 'hq-tag', 'Onboarding'));
    card.appendChild(head);

    // Term progress.
    const t = termProgress(c.termStart ?? null, c.termEnd ?? null);
    if (t) {
      const term = el('div', 'hq-term');
      const label = el('div', 'hq-term-l');
      label.append(
        el('span', undefined, t.state === 'before'
          ? `Starts in ${t.daysUntilStart} days`
          : `Month ${t.month} of ${t.total}`),
        el('span', undefined, t.state === 'after' ? 'Term ended' : ''),
      );
      const bar = el('div', 'hq-term-bar');
      const fill = el('div', 'hq-term-fill');
      fill.style.width = `${Math.round(t.fraction * 100)}%`;
      bar.appendChild(fill);
      term.append(label, bar);
      card.appendChild(term);
    }

    const next = nextMoment(c);
    const line = el('div', 'hq-card-next');
    if (next) {
      const n = daysUntilDay(next.date) ?? 0;
      line.appendChild(icon(next.momentType === 'Show' ? 'ticket' : 'film'));
      line.appendChild(el('span', undefined,
        `${next.title} · ${n === 0 ? 'today' : n === 1 ? 'tomorrow' : `in ${n} days`}`));
    } else {
      line.appendChild(el('span', 'hq-card-none', 'No show or release booked'));
    }
    card.appendChild(line);

    const stats = el('div', 'hq-stats');
    const owed = deliverablesFor(c);
    stats.append(
      stat('ours overdue', String(f.overdueBlueprint), f.overdueBlueprint ? 'bad' : undefined),
      stat('theirs overdue', String(f.overdueClient), f.overdueClient >= 3 ? 'bad' : undefined),
      stat('posted / due', `${f.postedThisWeek} / ${f.scheduledThisWeek}`),
      // What we owe them this month, and whether the month is even
      // planned to the right size. Red for a month with too few or
      // too many of ours in it, which is a thing to fix in the first
      // week rather than on the last day.
      stat(`${owed.month} deliverables`, `${owed.posted} / ${owed.total}`,
        owed.off ? 'bad' : undefined),
      stat('last report', f.lastReport ? shortDay(f.lastReport) : 'none',
        f.lastReport ? undefined : 'bad'),
    );
    card.appendChild(stats);

    // The step-up is a date you must not miss, so it only appears
    // when it is close enough to act on.
    const up = stepUpSoon(c.rateStepUp ?? null);
    if (up !== null) {
      card.appendChild(el('div', 'hq-card-flag',
        `Rate step-up ${up === 0 ? 'today' : `in ${up} days`}`));
    }

    if (v.reasons.length) {
      card.appendChild(el('div', `hq-card-why hq-why-${v.level}`, v.reasons[0]));
    }

    return card;
  }

  /* ── one client ──────────────────────────────────────────────── */

  function drawClientDetail(root: HTMLElement, slug: string) {
    const c = clients().find((x) => x.slug === slug) as CardClient | undefined;
    if (!c) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('info'));
      e.append(ic, el('h3', undefined, 'No such client'),
        el('p', undefined, 'Nothing here matches that link.'));
      const back = el('a', 'pt-btn', 'Back to clients');
      back.href = '#/clients';
      e.appendChild(back);
      root.appendChild(e);
      return;
    }

    const f = factsFor(c);
    const v = clientHealth(f);

    const back = el('a', 'hq-back');
    back.href = '#/clients';
    back.appendChild(icon('chev-left'));
    back.appendChild(el('span', undefined, 'Clients'));
    root.appendChild(back);

    const bar = el('div', 'hq-bar');
    const h = el('h1', undefined, c.artist);
    bar.append(healthDot(v), h);

    // The spec's "View as client". The portal already shows a band
    // saying you are looking at it as Blueprint, so the warning the
    // spec asks for is the one that is already there.
    const asClient = el('a', 'pt-btn pt-btn-primary');
    asClient.href = `/portal/${c.slug}`;
    asClient.appendChild(icon('ext'));
    asClient.appendChild(el('span', undefined, 'View as client'));
    bar.appendChild(asClient);
    root.appendChild(bar);

    if (v.reasons.length) {
      const why = el('div', `hq-why-band hq-why-${v.level}`);
      why.appendChild(icon('info'));
      why.appendChild(el('span', undefined, v.reasons.join(' · ')));
      root.appendChild(why);
    }

    root.appendChild(detailFacts(c, f));
    root.appendChild(linksCard(c));
    root.appendChild(todosCard(c));
    root.appendChild(calendarCard(c));
    root.appendChild(contentCard(c));
    // The same board the client is looking at, with our hands on it.
    root.appendChild(clientBoard(c.slug));
    root.appendChild(reportsCard(c));
  }

  function cardShell(title: string): { card: HTMLElement; body: HTMLElement } {
    const card = el('section', 'pt-card hq-block');
    const head = el('div', 'pt-card-head');
    head.appendChild(el('h2', undefined, title));
    const body = el('div', 'pt-card-body');
    card.append(head, body);
    return { card, body };
  }

  function detailFacts(c: CardClient, f: ReturnType<typeof factsFor>): HTMLElement {
    const { card, body } = cardShell('Where they are');
    const stats = el('div', 'hq-stats hq-stats-wide');
    const t = termProgress(c.termStart ?? null, c.termEnd ?? null);
    stats.append(
      stat('stage', c.stage ?? 'none'),
      stat('tier', (c.tier ?? 'none').replace(/^Tier \d+ · /, '')),
      stat('monthly', c.monthlyRate ? `$${c.monthlyRate.toLocaleString('en-US')}` : 'none'),
      stat('term', t ? `Month ${t.month} of ${t.total}` : 'none'),
      stat('ours overdue', String(f.overdueBlueprint), f.overdueBlueprint ? 'bad' : undefined),
      stat('theirs overdue', String(f.overdueClient), f.overdueClient >= 3 ? 'bad' : undefined),
      stat('posted this week', String(f.postedThisWeek)),
      stat('last report', f.lastReport ? shortDay(f.lastReport) : 'none'),
    );
    body.appendChild(stats);

    const up = stepUpSoon(c.rateStepUp ?? null);
    if (up !== null) {
      body.appendChild(el('div', 'hq-card-flag',
        `Rate step-up ${up === 0 ? 'today' : `in ${up} days`}${
          c.fullRate ? `, to $${Number(c.fullRate).toLocaleString('en-US')}` : ''}`));
    }
    return card;
  }

  function linkRow(label: string, href: string | null | undefined): HTMLElement | null {
    if (!href) return null;
    const a = el('a', 'hq-link');
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.append(el('span', undefined, label), icon('ext'));
    return a;
  }

  /** A brief we hold is written as a root-relative URL by the upload
   *  endpoint; anything pasted is absolute. So the first character
   *  tells the two apart, with no slug arithmetic in the browser. */
  const briefIsOurs = (url: string | null | undefined) => !!url && url.startsWith('/');

  /** Which client's brief link is being typed, so a redraw does not
   *  close the box under the cursor. Keyed by page id, like `editing`
   *  on the pipeline board. */
  let briefEdit = '';

  function linksCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Links');
    const row = el('div', 'hq-links');
    const any = [
      linkRow('Client Folder', c.clientFolder),
      linkRow('Content Vault', c.contentVault),
      linkRow('Drive Folder', c.driveFolder),
      linkRow('Brand Kit', c.brandKit),
      linkRow('Instagram', c.instagram),
      linkRow('TikTok', c.tiktok),
    ].filter(Boolean) as HTMLElement[];

    // The brand brief sits with the links rather than in its own
    // card: it is one more thing you open, not a section.
    const brief = c.brandBriefPdf ?? null;
    if (brief) {
      const b = linkRow(briefIsOurs(brief) ? 'Brand Brief (PDF)' : 'Brand Brief', brief);
      if (b) { b.classList.add('hq-link-strong'); any.unshift(b); }
    }

    if (!any.length) {
      body.appendChild(el('p', 'hq-none', 'No links on this client yet.'));
    } else {
      for (const a of any) row.appendChild(a);
      body.appendChild(row);
    }
    body.appendChild(briefControl(c));
    return card;
  }

  /**
   * The brand brief, as the one line under the links.
   *
   * Both halves of the same column: a PDF we hold, uploaded from the
   * client's Files tab, or a link to a document somebody else holds.
   * Pasting a link here is the whole point of the control, and it is
   * also the only way to take a brief down, which is why Remove sits
   * beside it rather than in Notion.
   */
  function briefControl(c: CardClient): HTMLElement {
    const brief = c.brandBriefPdf ?? null;
    const ours = briefIsOurs(brief);
    const wrap = el('div', 'hq-brief');

    if (briefEdit === c.pageId) {
      wrap.appendChild(briefForm(c));
      return wrap;
    }

    const said = el('p', 'hq-none');
    said.textContent = !brief
      ? 'No brand brief yet. Upload a PDF, or paste a link to one held elsewhere.'
      : ours
        ? 'Brand brief: a PDF we hold, on their Files tab.'
        : `Brand brief: a link to ${briefHostOf(brief) ?? 'another app'}.`;
    wrap.appendChild(said);

    const acts = el('div', 'hq-brief-acts');
    // Upload first: a PDF we hold is the normal case, and a link is
    // what you reach for when the brief lives somewhere else.
    if (c.slug) {
      acts.appendChild(briefUpload(c, ours ? 'Replace the PDF' : 'Upload a PDF'));
    }
    const add = el('button', 'hq-pipe-link', brief ? 'Paste a different link' : 'Paste a link');
    add.type = 'button';
    add.addEventListener('click', () => { briefEdit = c.pageId; draw('clients'); });
    acts.appendChild(add);

    if (brief) {
      const off = el('button', 'hq-pipe-link', 'Remove');
      off.type = 'button';
      off.addEventListener('click', async () => {
        off.disabled = true;
        const ok = await patch(`/portal/hq/client/${c.pageId}`, { brandBriefUrl: null });
        off.disabled = false;
        if (!ok) { toast('That did not save.', true); return; }
        c.brandBriefPdf = null;
        // Said plainly: the bytes outlive the pointer, and somebody
        // will want to know that before they go looking for them.
        toast(ours
          ? 'Brand brief removed from the portal. The PDF is still in the bucket.'
          : 'Brand brief removed from the portal.');
        draw('clients');
      });
      acts.appendChild(off);
    }

    wrap.appendChild(acts);
    return wrap;
  }

  /** Mirrors MAX_BRIEF_BYTES in src/server/brief.ts, which has the
   *  final say. Checking here only saves uploading 40MB to be told no
   *  at the other end. A test keeps the two in step. */
  const MAX_BRIEF_MB = 25;
  const briefMb = (bytes: number) =>
    bytes < 1024 * 1024 ? `${Math.round(bytes / 1024)} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`;

  /**
   * The file picker, as one button.
   *
   * Posts the bytes to the client's own admin endpoint rather than to
   * an HQ one: that route already stores the PDF, points the Notion
   * column at it and drops the client's cached payload, and a second
   * copy of all that under /portal/hq would be two things to keep in
   * step. The admin cookie is scoped to /portal, so it reaches both.
   */
  function briefUpload(c: CardClient, label: string): HTMLElement {
    const wrap = el('span', 'hq-brief-pick');
    const input = el('input') as HTMLInputElement;
    input.type = 'file';
    input.accept = 'application/pdf,.pdf';
    input.hidden = true;

    const btn = el('button', 'hq-pipe-link', label) as HTMLButtonElement;
    btn.type = 'button';
    btn.addEventListener('click', () => { if (!btn.disabled) input.click(); });

    input.addEventListener('change', async () => {
      const file = input.files && input.files[0];
      // Cleared straight away, so picking the same file twice after a
      // failure still fires a change event.
      input.value = '';
      if (!file) return;

      if (file.size > MAX_BRIEF_MB * 1024 * 1024) {
        toast(`That file is ${briefMb(file.size)} and the limit is ${MAX_BRIEF_MB} MB.`, true);
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Uploading…';
      try {
        const res = await fetch(`/portal/${encodeURIComponent(c.slug)}/admin/brief`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/pdf' },
          body: file,
        });
        const json = await res.json().catch(() => null) as any;
        if (!res.ok || !json?.ok) {
          toast(json?.detail || 'That did not upload.', true);
          return;
        }
        c.brandBriefPdf = json.brief?.url ?? c.brandBriefPdf;
        // The PDF is stored either way; this says when Notion did not
        // keep up, because that is the half nobody would notice.
        toast(json.warning || 'Brand brief uploaded. The client can see it now.',
          Boolean(json.warning));
        draw('clients');
      } catch (err) {
        toast(`That did not go through. ${err instanceof Error ? err.message : String(err)}`, true);
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });

    wrap.append(input, btn);
    return wrap;
  }

  /** "figma.com", for a sentence about where a brief lives. */
  function briefHostOf(url: string): string | null {
    try {
      return new URL(url, location.origin).hostname.replace(/^www\./, '') || null;
    } catch {
      return null;
    }
  }

  function briefForm(c: CardClient): HTMLElement {
    const form = el('form', 'hq-form');
    const input = el('input');
    input.type = 'url';
    input.required = true;
    input.maxLength = 1500;
    input.placeholder = 'https://…';
    // An uploaded PDF's URL is ours and not a thing to edit by hand,
    // so the box starts empty in that case rather than inviting it.
    input.value = briefIsOurs(c.brandBriefPdf) ? '' : (c.brandBriefPdf ?? '');

    form.appendChild(field('Brand brief link', input));
    if (briefIsOurs(c.brandBriefPdf)) {
      form.appendChild(el('p', 'hq-none',
        'This replaces the uploaded PDF as what the client opens. The PDF stays in the bucket.'));
    }

    const row = el('div', 'hq-form-acts');
    const save = el('button', 'pt-btn pt-btn-primary', 'Save');
    save.type = 'submit';
    const cancel = el('button', 'pt-btn', 'Cancel');
    cancel.type = 'button';
    cancel.addEventListener('click', () => { briefEdit = ''; draw('clients'); });
    row.append(save, cancel);
    form.appendChild(row);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = input.value.trim();
      if (!url) return;
      form.classList.add('is-busy');
      const ok = await patch(`/portal/hq/client/${c.pageId}`, { brandBriefUrl: url });
      form.classList.remove('is-busy');
      if (!ok) { toast('That link did not save. It has to start with http.', true); return; }
      c.brandBriefPdf = url;
      briefEdit = '';
      toast('Brand brief link saved. The client can open it now.');
      draw('clients');
    });

    return form;
  }

  /** Their open to-dos, ours kept out: this card answers "what are we
   *  waiting on them for". */
  function todosCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('What we are waiting on');
    const today = isoToday();
    const rows = (HQ?.calendar ?? [])
      .filter((s: any) => s.clientId === c.pageId && s.kind !== 'Moment'
        && s.owner === 'Client'
        && !['Done', 'Skipped', 'Moved'].includes(s.status ?? ''))
      .sort((a: any, b: any) => (a.date ?? '9999').localeCompare(b.date ?? '9999'));

    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'Nothing outstanding on their side.'));
      return card;
    }
    const list = el('div', 'hq-mini');
    const moments = momentsNow();
    for (const s of rows.slice(0, 12)) {
      const r = el('div', 'hq-mini-row hq-mini-row-tall');
      const main = el('div', 'hq-mini-main');
      main.appendChild(el('span', 'hq-mini-t', s.title || 'Untitled'));
      const note = oneLine(s.notes);
      if (note) main.appendChild(el('span', 'hq-row-note', note));
      r.appendChild(main);
      const m = s.momentId ? moments.get(s.momentId) : undefined;
      if (m) r.appendChild(campChip(m));
      const late = s.date && s.date < today;
      r.appendChild(el('span', `hq-mini-d${late ? ' hq-when-late' : ''}`,
        s.date ? (late ? whenLabel(s.date).text : shortDay(s.date)) : 'no date'));
      list.appendChild(r);
    }
    body.appendChild(list);
    return card;
  }

  function calendarCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Coming up');
    const today = isoToday();
    const rows = (HQ?.calendar ?? [])
      .filter((m: any) => m.clientId === c.pageId && m.date && m.date >= today
        && m.status !== 'Skipped' && m.status !== 'Moved')
      .sort((a: any, b: any) => a.date.localeCompare(b.date));

    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'Nothing on the calendar ahead.'));
      return card;
    }
    const list = el('div', 'hq-mini');
    for (const m of rows.slice(0, 14)) {
      const r = el('div', 'hq-mini-row');
      const t = el('span', 'hq-mini-t', m.title || 'Untitled');
      if (m.kind === 'Moment') t.classList.add('hq-mini-strong');
      r.appendChild(t);
      r.appendChild(el('span', 'hq-mini-k', m.momentType ?? m.type ?? m.owner ?? ''));
      r.appendChild(el('span', 'hq-mini-d', shortDay(m.date)));
      list.appendChild(r);
    }
    body.appendChild(list);
    return card;
  }

  function contentCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Content');
    const rows = (HQ?.content ?? []).filter((p: any) => p.clientId === c.pageId);
    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'No content in the window.'));
      return card;
    }

    // Grouped by status, in the order the pipeline runs rather than
    // alphabetically, so the board reads left to right.
    const ORDER = ['Idea', 'Planned', 'Filmed', 'Footage In', 'Editing',
                   'Ready for Review', 'Approved', 'Scheduled', 'Posted', 'Skipped'];
    const groups = new Map<string, any[]>();
    for (const p of rows) {
      const k = p.status ?? 'No status';
      if (!groups.has(k)) groups.set(k, []);
      groups.get(k)!.push(p);
    }
    const board = el('div', 'hq-board');
    for (const name of [...groups.keys()].sort((a, b) =>
      (ORDER.indexOf(a) + 1 || 99) - (ORDER.indexOf(b) + 1 || 99))) {
      const col = el('div', 'hq-col');
      const h = el('div', 'hq-col-head');
      h.append(el('span', undefined, name),
        el('span', 'hq-sec-count', String(groups.get(name)!.length)));
      col.appendChild(h);
      for (const p of groups.get(name)!) {
        const t = el('div', 'hq-col-card');
        t.append(el('div', 'hq-col-t', p.title || 'Untitled'),
          el('div', 'hq-col-d', p.postDate ? shortDay(p.postDate) : 'no date'));
        col.appendChild(t);
      }
      board.appendChild(col);
    }
    body.appendChild(board);
    return card;
  }

  function reportsCard(c: CardClient): HTMLElement {
    const { card, body } = cardShell('Reports');
    const rows = (HQ?.snapshots ?? [])
      .filter((s: any) => s.clientId === c.pageId)
      .sort((a: any, b: any) => String(b.date ?? '').localeCompare(String(a.date ?? '')));

    if (!rows.length) {
      body.appendChild(el('p', 'hq-none', 'No snapshots yet.'));
      return card;
    }
    const list = el('div', 'hq-mini');
    for (const s of rows.slice(0, 12)) {
      const r = el('div', 'hq-mini-row');
      r.appendChild(el('span', 'hq-mini-t', s.date ? monthLabel(s.date) : 'Undated'));
      r.appendChild(el('span', 'hq-mini-k', s.type ?? ''));
      if (s.published) {
        if (s.reportPdf) {
          const a = el('a', 'hq-mini-d hq-link-strong');
          a.href = s.reportPdf;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = s.publishedAt ? shortDay(String(s.publishedAt).slice(0, 10)) : 'published';
          r.appendChild(a);
        } else {
          r.appendChild(el('span', 'hq-mini-d', 'published'));
        }
      } else {
        r.appendChild(el('span', 'hq-mini-d hq-mini-draft', 'draft'));
      }
      list.appendChild(r);
    }
    body.appendChild(list);
    return card;
  }

  function monthLabel(day: string): string {
    const d = new Date(`${day}T00:00:00Z`);
    return `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
  }
  /* ══ CALENDAR ═══════════════════════════════════════════════════

     The client portal's calendar, over every live client at once.

     It is not a second calendar: src/scripts/portal-calendar.ts is the
     one calendar, and what follows is HQ's half of its host. The month
     grid, the week, the agenda, the layer chips, the quick views, the
     Unscheduled tray, the "+N more" popover and the drag are all the
     same code a client is looking at.

     HQ adds the three things a single-client calendar never needs: a
     colour per client, a filter over them, and a mark on a day two
     clients are both busy. It takes nothing away: the drag goes to the
     same /portal/<slug>/step/<id> the client's own drag uses, with
     role admin, and the server decides.                              */

  const HQ_CAL_STORE = 'bp.hq.cal.v1';

  let CAL_DREW = false;
  let HQCAL: Calendar | null = null;
  let MOVER: Mover | null = null;

  /** The clients the calendar covers, in the order the filter shows
   *  them. Onboarding and Active only: a prospect has no plan yet and
   *  an ended client's plan is history. */
  const calClients = (): RowClient[] => clients()
    .filter(onCalendar)
    .sort((a, b) => a.artist.localeCompare(b.artist));

  const calClientById = (): Map<string, RowClient> =>
    new Map(calClients().map((c) => [c.pageId, c]));

  const calClientBySlug = (): Map<string, RowClient> =>
    new Map(calClients().map((c) => [c.slug, c]));

  function showingClient(slug: string): boolean {
    return WHO.size === 0 || WHO.has(slug);
  }

  /* ── the rows, as the calendar wants them ─────────────────────
     HQ reads flatter rows than the portal does: it fetches every
     client's calendar before it knows whose each row is, so the
     moment a step hangs off is an id rather than a resolved object,
     and the artist prefix is still on the title. Both are put right
     here, where the client IS in hand. */

  /** Rows for the clients on screen, with their moment resolved and
   *  their title cleaned, ready for the shared calendar. */
  function calRows(): PortalCalendarItem[] {
    const byId = calClientById();
    const moments = momentsNow();
    const out: PortalCalendarItem[] = [];
    for (const r of (HQ?.calendar ?? []) as HqCalItem[]) {
      const client = r.clientId ? byId.get(r.clientId) : undefined;
      if (!client || !showingClient(client.slug)) continue;
      const { title } = cleanItemTitle(r.title ?? '', client.artist);
      const m = r.momentId ? moments.get(r.momentId) : undefined;
      out.push({
        id: r.id,
        title: title || 'Untitled',
        tentative: r.tentative,
        kind: r.kind,
        momentType: r.momentType,
        date: r.date,
        status: r.status,
        type: r.type,
        owner: r.owner,
        flow: r.flow,
        notes: r.notes,
        playbook: null,
        phase: null,
        where: null,
        whyItMatters: null,
        venueCity: r.venueCity,
        ticketLink: null,
        streamsToDate: null,
        ticketsSold: null,
        capacity: null,
        moment: m
          ? { id: m.id, title: m.title, momentType: m.type, date: m.date }
          : null,
        clientSlug: client.slug,
        clientName: client.artist,
      } as PortalCalendarItem & { clientSlug: string; clientName: string });
    }
    return out;
  }

  /** Content Pipeline cards for the clients on screen. */
  function calCards(): PortalContentItem[] {
    const byId = calClientById();
    const out: PortalContentItem[] = [];
    for (const c of (HQ?.content ?? []) as HqContentItem[]) {
      const client = c.clientId ? byId.get(c.clientId) : undefined;
      if (!client || !showingClient(client.slug)) continue;
      out.push({
        id: c.id,
        title: c.title || 'Untitled',
        status: c.status,
        bucket: c.bucket,
        format: c.formats ?? [],
        source: c.source ?? null,
        filmBy: c.filmBy,
        postDate: c.postDate,
        postedBy: c.postedBy,
        platforms: c.platforms ?? [],
        campaign: c.campaignId ? [c.campaignId] : [],
        shootCode: c.shootCode ?? null,
        onScreenText: c.onScreenText ?? null,
        caption: c.caption ?? null,
        notes: c.notes,
        feedback: c.feedback,
        footageLink: c.footageLink ?? null,
        editLink: c.editLink ?? null,
        postLink: c.postLink ?? null,
        media: c.media ?? null,
        clientSlug: client.slug,
        clientName: client.artist,
      } as PortalContentItem & { clientSlug: string; clientName: string });
    }
    return out;
  }

  /**
   * A card, as calendar rows.
   *
   * The same shape the portal builds: a card with a post date is a row
   * on that day, and a card with a shoot date is a second row earlier
   * in the month. One piece of content, two things to be ready for.
   */
  function calCardRows(): PortalCalendarItem[] {
    const moments = momentsNow();
    // The campaigns already covered by a 🎥 step, from the same
    // function the client portal uses. Built off every step HQ holds,
    // not the filtered view, so turning a client off does not make
    // another client's cards start drawing film chips.
    const cover = filmCover(((HQ?.calendar ?? []) as any[]).map((r) => ({
      id: r.id, kind: r.kind, momentType: r.momentType, status: r.status,
      flow: r.flow, owner: r.owner, type: r.type, title: r.title,
      moment: r.momentId ? { id: r.momentId } : null,
    })));
    const out: PortalCalendarItem[] = [];
    for (const c of calCards()) {
      if (!cardOnCalendar(c)) continue;
      const ref = cardMoment(c, hqMomentIdx());
      const m = ref ? moments.get(ref.id) : undefined;
      const base = {
        kind: 'Content',
        momentType: null,
        status: c.status,
        type: 'Content',
        owner: c.postedBy === 'Client' ? 'Client' : 'Blueprint',
        flow: null,
        notes: c.notes,
        tentative: false,
        playbook: null, phase: null, where: null, whyItMatters: null,
        venueCity: null, ticketLink: null,
        streamsToDate: null, ticketsSold: null, capacity: null,
        moment: m ? { id: m.id, title: m.title, momentType: m.type, date: m.date } : null,
        content: c,
        clientSlug: (c as any).clientSlug,
        clientName: (c as any).clientName,
      };
      if (c.postDate) {
        out.push({ ...base, id: `${c.id}:post`, title: cardRowTitle(c.title, 'post'),
                   date: c.postDate, contentRole: 'post' } as any);
      }
      // Whether a shoot still earns a row, and what the chip says, are
      // the client portal's rules, read from the one place that holds
      // them: a card has to read the same on both screens or HQ is
      // looking at a different calendar.
      if (cardFilmRow(c) && !cardFilmCovered(c, cover)) {
        out.push({ ...base, id: `${c.id}:film`, title: cardRowTitle(c.title, 'film'),
                   date: c.filmBy, contentRole: 'film' } as any);
      }
    }
    return out;
  }

  const rowClientSlug = (it: any): string | null => it?.clientSlug ?? null;

  /* ── the host ─────────────────────────────────────────────────── */

  function hqCal(): Calendar {
    if (HQCAL) return HQCAL;
    HQCAL = createCalendar({
      root: () => q('[data-calroot]'),
      // The same checks the client's drag goes through, with a
      // different answer to "who is asking". Not a looser rule: a step
      // we have taken out of the plan still does not move.
      role: () => 'admin',
      store: HQ_CAL_STORE,
      layers: () => [...HQ_LAYERS],
      content: () => calCards(),
      schema: () => ({ bucket: (HQ?.contentSchema?.bucket ?? []) as any }),
      extraRows: () => calCardRows(),
      showCalendar: () => {
        if (currentView() !== 'calendar') location.hash = '#/calendar';
      },
      clientOf: (it) => {
        const slug = rowClientSlug(it);
        if (!slug) return null;
        const c = calClientBySlug().get(slug);
        return c ? { slug: c.slug, name: c.artist, color: clientColor(c.slug) } : null;
      },
      dayFlag: (items) => dayClash(items.map((it: any) => ({
        momentType: it.momentType ?? null,
        kind: it.kind ?? null,
        title: it.title ?? null,
        flow: it.flow ?? null,
        clientSlug: rowClientSlug(it),
        contentRole: it.contentRole,
      }))),
      kindOf: hqKind,
      kindLabel: (k) => HQ_KIND_LABEL[k] ?? k,
      momentKind,
      // "Your to-dos" is right in front of the client whose they are.
      // Across a roster they are somebody else's.
      layerLabel: (l) => (l === 'todos' ? 'Client to-dos' : null),
      bucketColor: calBucketColor,
      canTick: calCanTick,
      tickBox: calTickBox,
      itemRow: calItemRow,
      openItem: openCalDrawer,
      openCard: (c) => openCalDrawer(cardAsRow(c)),
      toast,
      moveStep: (it, iso) => hqMover().moveStep(it, iso),
      askMoveMoment: (it, iso) => hqMover().askMoveMoment(it, iso),
      saveCard: saveCalCard,
    });
    return HQCAL;
  }

  function hqMover(): Mover {
    if (MOVER) return MOVER;
    MOVER = createMover({
      slugOf: (it) => rowClientSlug(it),
      rows: () => hqCal().rows(),
      canMoveStep: (it) => hqCal().canDragStep(it),
      redraw: () => { if (currentView() === 'calendar') hqCal().draw(); },
      reload: refreshCalendar,
      toast,
      undoToast: hqUndoToast,
    });
    return MOVER;
  }

  /**
   * What a row IS, HQ's wording.
   *
   * itemKind is the shared rule and this does not disagree with it: it
   * puts a word to the one case the client portal never has to, which
   * is a Blueprint task. That layer does not exist over there, so the
   * shared fallback of "moment" was never wrong in front of a client
   * and is plainly wrong on a roster, where a step is not a show.
   */
  // itemKind answers this for both screens now, including the step
  // that used to come back as "moment". All HQ changes is the wording
  // of one of them: on our own screen a client's to-do is theirs.
  const hqKind = (it: PortalCalendarItem): string => itemKind(it);

  const HQ_KIND_LABEL: Record<string, string> = {
    ...KIND_LABEL, todo: 'Client to-do',
  };

  function calBucketColor(name: string | null): string {
    if (!name) return 'default';
    const opts = (HQ?.contentSchema?.bucket ?? []) as Array<{ name: string; color: string }>;
    return opts.find((o) => o.name === name)?.color ?? 'default';
  }

  /** A step one of us may tick. The same predicate the endpoint asks,
   *  with admin as the asker, so a box HQ draws is one the server will
   *  honour. */
  function calCanTick(it: PortalCalendarItem): boolean {
    if ((it as any).content) return false;
    if (it.momentType || it.kind === 'Moment') return false;
    return canSetStepStatus(it, 'Done', 'admin');
  }

  function calTickBox(it: PortalCalendarItem, big = false): HTMLElement {
    const done = isStepDone(it);
    const b = el('button', 'pt-check' + (big ? ' pt-check-big' : '') + (done ? ' pt-check-on' : ''));
    b.type = 'button';
    b.setAttribute('role', 'checkbox');
    b.setAttribute('aria-checked', String(done));
    b.setAttribute('aria-label', `Mark "${it.title}" ${done ? 'not started' : 'done'}`);
    b.dataset.stepBox = '';
    b.dataset.stepId = it.id;
    // The tick inside its own span: .pt-check-mark is what sizes it.
    // Without the wrapper the svg has nothing to size against and
    // stretches the chip to the height of the whole day cell.
    const mark = el('span', 'pt-check-mark');
    mark.appendChild(icon('check'));
    b.appendChild(mark);
    b.addEventListener('click', (ev) => {
      ev.stopPropagation();
      void setCalStep(it, done ? 'Not Started' : 'Done');
    });
    return b;
  }

  async function setCalStep(it: PortalCalendarItem, status: string) {
    const slug = rowClientSlug(it);
    if (!slug) return;
    const before = it.status;
    it.status = status;
    hqCal().sync();
    if (currentView() === 'calendar') hqCal().draw();
    const ok = await patch(`/portal/${encodeURIComponent(slug)}/step/${encodeURIComponent(it.id)}`,
                           { status });
    if (!ok) {
      it.status = before;
      hqCal().sync();
      if (currentView() === 'calendar') hqCal().draw();
      toast('That did not save. Check your connection and try again.', true);
      return;
    }
    toast(status === 'Done' ? 'Ticked off' : 'Back on the list');
    void refreshCalendar();
  }

  /** One row of the agenda, or of a selected day on a phone. The
   *  client's name leads, because across a roster that is the first
   *  thing to know. */
  function calItemRow(it: PortalCalendarItem, pad = false): HTMLLIElement {
    const li = el('li') as HTMLLIElement;
    const row = el('div', 'pt-row' + (pad ? ' pt-row-pad' : ''));
    if (calCanTick(it)) row.appendChild(calTickBox(it));

    const open = el('button', 'hq-calrow');
    open.type = 'button';
    const top = el('div', 'hq-calrow-top');
    const who = calClientBySlug().get(rowClientSlug(it) ?? '');
    if (who) {
      const dot = el('span', `pt-chip-who pt-cc-${clientColor(who.slug)}`);
      dot.setAttribute('aria-hidden', 'true');
      top.append(dot, el('span', 'hq-calrow-who', who.artist));
    }
    top.appendChild(el('span', 'hq-calrow-title', it.title));
    open.appendChild(top);

    const bits: string[] = [];
    const k = hqKind(it);
    bits.push(HQ_KIND_LABEL[k] ?? k);
    // flowOf, not the raw property: a step Notion has not been given
    // a Flow yet still has one, implied by its Owner and Type, and HQ
    // is the screen that most needs to see it.
    const flow = it.kind === 'Step' ? flowOf(it as any) : null;
    if (flow) bits.push(flow);
    if (it.moment) bits.push(`↳ ${it.moment.title}`);
    const note = oneLine((it as any).notes);
    if (note) bits.push(note);
    if (bits.length) open.appendChild(el('span', 'hq-calrow-meta', bits.join(NOTE_SEP)));

    open.addEventListener('click', () => openCalDrawer(it));
    row.appendChild(open);
    li.appendChild(row);
    return li;
  }

  /** A content card as the calendar row the drawer reads. */
  function cardAsRow(c: PortalContentItem): PortalCalendarItem {
    return calCardRows().find((r: any) => r.content?.id === c.id)
      ?? ({
        id: c.id, title: c.title, date: c.postDate ?? c.filmBy,
        status: c.status, type: 'Content', owner: c.postedBy,
        kind: 'Content', momentType: null, moment: null, tentative: false,
        content: c, clientSlug: (c as any).clientSlug,
        clientName: (c as any).clientName,
      } as any);
  }

  async function saveCalCard(
    id: string,
    patchBody: Record<string, unknown>,
    local: Partial<PortalContentItem>,
  ): Promise<boolean> {
    const rows = (HQ?.content ?? []) as HqContentItem[];
    const row = rows.find((c) => c.id === id);
    const slug = row?.clientId
      ? calClientById().get(row.clientId)?.slug ?? null
      : null;
    if (!row || !slug) return false;
    const before = { ...row };
    // On screen first, back if Notion refuses: the same bargain the
    // client's board makes.
    Object.assign(row, rowPatch(local));
    // Remembered BEFORE the request, not after. A refresh already in
    // flight can land while we are waiting on Notion, and it replaces
    // the whole payload: anything not written down by then is lost,
    // which is how a second quick drag used to snap back.
    remember(id, local as Record<string, any>);
    hqCal().sync();
    if (currentView() === 'calendar') hqCal().draw();
    redrawBoard();

    const ok = await patch(
      `/portal/${encodeURIComponent(slug)}/content/${encodeURIComponent(id)}`, patchBody);
    if (!ok) {
      PENDING.delete(id);
      Object.assign(row, before);
      hqCal().sync();
      if (currentView() === 'calendar') hqCal().draw();
      redrawBoard();
      refillCardDrawer();
      toast('That did not save. Check your connection and try again.', true);
      return false;
    }
    void refreshCalendar();
    return true;
  }

  /** A card's fields as the HQ payload names them. The payload is
   *  flatter than the card: one campaign id, and Format under its own
   *  key. Anything the card does not carry is left alone. */
  function rowPatch(local: Partial<PortalContentItem>): Record<string, unknown> {
    const out: Record<string, unknown> = {};
    for (const k of ['status', 'postDate', 'filmBy', 'media', 'caption', 'onScreenText',
      'editLink', 'footageLink', 'postLink', 'title', 'bucket', 'platforms', 'shootCode',
      'notes', 'feedback'] as const) {
      if (local[k] !== undefined) out[k] = local[k];
    }
    if (local.format !== undefined) out.formats = local.format;
    if (local.campaign !== undefined) out.campaignId = local.campaign[0] ?? null;
    return out;
  }

  /* ── the drawer ───────────────────────────────────────────────── */

  function openCalDrawer(it: PortalCalendarItem) {
    // A content row on the calendar is the same card as on the board,
    // so it opens the same drawer.
    const card = (it as any).content as PortalContentItem | undefined;
    if (card) { openCardDrawer(calCards().find((x) => x.id === card.id) ?? card); return; }
    CARD_DRAWER_ID = '';
    const drawer = q('[data-drawer]');
    const scrim = q('[data-scrim]');
    const head = q('[data-drawer-title]');
    const body = q('[data-drawer-body]');
    const foot = q('[data-drawer-foot]');
    if (!drawer || !scrim || !head || !body || !foot) return;

    head.textContent = it.title;
    clear(body);
    clear(foot);

    const who = calClientBySlug().get(rowClientSlug(it) ?? '');
    const k = hqKind(it);
    const facts: Array<[string, string]> = [];
    if (who) facts.push(['Client', who.artist]);
    facts.push(['What', HQ_KIND_LABEL[k] ?? k]);
    if (it.date) facts.push(['When', shortDay(it.date)]);
    if (it.status) facts.push(['Status', it.status]);
    const drawerFlow = it.kind === 'Step' ? flowOf(it as any) : null;
    if (drawerFlow) facts.push(['Flow', drawerFlow]);
    if (it.moment) {
      facts.push(['Campaign', it.moment.date
        ? `${it.moment.title} · ${shortDay(it.moment.date)}`
        : it.moment.title]);
    }
    if (it.venueCity) facts.push(['Where', it.venueCity]);

    const list = el('dl', 'hq-facts');
    for (const [k2, v] of facts) {
      list.append(el('dt', undefined, k2), el('dd', undefined, v));
    }
    body.appendChild(list);

    const note = oneLine((it as any).notes);
    if (note) {
      const box = el('div', 'hq-drawer-note');
      box.append(el('h3', undefined, 'Notes'), el('p', undefined, note));
      body.appendChild(box);
    }

    if (who) {
      const links = el('div', 'pt-drawer-links');
      const detail = el('a', 'pt-btn', `Open ${who.artist} in HQ`) as HTMLAnchorElement;
      detail.href = `#/clients/${encodeURIComponent(who.slug)}`;
      detail.addEventListener('click', closeCalDrawer);
      const portal = el('a', 'pt-btn', 'Their portal') as HTMLAnchorElement;
      portal.href = `/portal/${encodeURIComponent(who.slug)}`;
      links.append(detail, portal);
      foot.appendChild(links);
      show(foot, true);
    }

    show(scrim, true);
    show(drawer, true);
    requestAnimationFrame(() => {
      scrim.dataset.open = 'true';
      drawer.dataset.open = 'true';
      q<HTMLElement>('[data-drawer-close]')?.focus();
    });
    document.addEventListener('keydown', onCalDrawerKey);
  }

  function closeCalDrawer() {
    CARD_DRAWER_ID = '';
    const drawer = q('[data-drawer]');
    const scrim = q('[data-scrim]');
    if (!drawer || !scrim || drawer.hidden) return;
    drawer.dataset.open = 'false';
    scrim.dataset.open = 'false';
    document.removeEventListener('keydown', onCalDrawerKey);
    window.setTimeout(() => { show(drawer, false); show(scrim, false); }, 200);
  }

  function onCalDrawerKey(ev: KeyboardEvent) {
    if (ev.key === 'Escape') { ev.preventDefault(); closeCalDrawer(); }
  }

  /* ── an undo that lasts as long as the server's does ──────────── */

  function hqUndoToast(text: string, undo: () => void) {
    const t = q('[data-toast]');
    if (!t) return;
    clear(t);
    t.classList.remove('pt-toast-bad');
    t.appendChild(el('span', undefined, text));
    const b = el('button', 'pt-toast-undo');
    b.type = 'button';
    b.textContent = 'Undo';
    b.addEventListener('click', () => {
      t.dataset.open = 'false';
      undo();
    });
    t.appendChild(b);
    t.dataset.open = 'true';
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { t.dataset.open = 'false'; }, 8000);
  }

  /* ── refreshing after a write ─────────────────────────────────── */

  /**
   * Read HQ again and put the calendar back on screen.
   *
   * The client writes already drop HQ's cached payload, so this comes
   * back with what just happened rather than what was true a minute
   * ago. The month, the layers and the open day are left where they
   * were: a reload that threw those away would be its own small bug.
   */
  /**
   * Rows we have just written, and what we wrote.
   *
   * Notion answers a page PATCH before that change shows up in a
   * database query, so the refresh that follows a save can come back
   * still holding the old value and put the card back in the column it
   * was dragged out of. The drag looked broken; it had already saved.
   *
   * So a write is remembered until a refresh agrees with it, or until
   * it has been waited on long enough that something else is wrong and
   * the server's answer is the better one to trust.
   */
  const PENDING = new Map<string, { at: number; want: Record<string, unknown> }>();
  const PENDING_MS = 25_000;

  function remember(id: string, local: Record<string, any>): void {
    const want = rowPatch(local);
    if (!Object.keys(want).length) return;
    // A second write to the same card before the first has settled
    // adds to what is being waited on rather than replacing it.
    PENDING.set(id, { at: Date.now(), want: { ...(PENDING.get(id)?.want ?? {}), ...want } });
  }

  const sameValue = (a: unknown, b: unknown) => JSON.stringify(a ?? null) === JSON.stringify(b ?? null);

  /** Lay the writes we are still waiting on back over a fresh payload,
   *  and forget the ones it has caught up with. */
  function applyPending(payload: any): void {
    if (!PENDING.size) return;
    const rows = new Map<string, any>(
      ((payload?.content ?? []) as any[]).map((r) => [r.id, r]));
    for (const [id, want] of [...PENDING]) {
      const row = rows.get(id);
      if (!row) { PENDING.delete(id); continue; }
      const agreed = Object.entries(want.want).every(([k, v]) => sameValue(row[k], v));
      if (agreed || Date.now() - want.at > PENDING_MS) { PENDING.delete(id); continue; }
      Object.assign(row, want.want);
    }
  }

  async function refreshCalendar(): Promise<boolean> {
    try {
      const res = await fetch('/portal/hq/data', { credentials: 'same-origin' });
      if (!res.ok) return false;
      const next = await res.json();
      if (!next?.clients) return false;
      applyPending(next);
      HQ = next;
      if (HQCAL) {
        HQCAL.setRows(calRows());
        HQCAL.sync();
        if (currentView() === 'calendar') HQCAL.draw();
      }
      redrawBoard();
      refillCardDrawer();
      return true;
    } catch {
      return false;
    }
  }

  /* ── the tab ──────────────────────────────────────────────────── */

  function drawCalendarTab(root: HTMLElement) {
    root.appendChild(whoBar());
    const mount = el('div');
    mount.dataset.calroot = '1';
    root.appendChild(mount);

    const cal = hqCal();
    if (!CAL_DREW) {
      CAL_DREW = true;
      cal.render(calRows());
    } else {
      // Coming back to the tab, not arriving: the month and the layers
      // stay where they were left.
      cal.setRows(calRows());
      cal.sync();
      cal.draw();
    }
  }

  /* ══ CONTENT ════════════════════════════════════════════════
     The client's pipeline board, drawn by the same component the
     client sees, with role admin. Cross-client here and one client at
     a time on a client's own page: same board, different `items`. */

  let HQBOARD: Board | null = null;
  let BOARD_ITEMS: PortalContentItem[] = [];
  /** Where the board is on the page and whose cards it is showing, so
   *  a save can move the card there and then rather than leaving it in
   *  the column it was dragged out of until the tab is reopened. */
  let BOARD_MOUNT: HTMLElement | null = null;
  let BOARD_SCOPE: string | null = null;

  /** Who the client of a card is to us: always by name. */
  const hqVoice = (c: PortalContentItem): Voice => ({ name: (c as any).clientName ?? 'Client' });

  /** Every id a card might be linked to, mapped to its moment. Built
   *  once per payload: a card links to the step it delivers, and the
   *  step is what knows which moment it counts down to. */
  let HQ_MIDX: { of: unknown; idx: ReturnType<typeof cardMomentIndex> } | null = null;
  function hqMomentIdx() {
    if (HQ_MIDX?.of !== HQ) {
      const moments = momentsNow();
      HQ_MIDX = {
        of: HQ,
        idx: cardMomentIndex(((HQ?.calendar ?? []) as HqCalItem[]).map((r) => {
          const m = r.momentId ? moments.get(r.momentId) : undefined;
          const self = r.kind === 'Moment' ? moments.get(r.id) : undefined;
          return {
            id: r.id, title: self?.title ?? r.title, date: r.date, kind: r.kind,
            momentType: r.momentType,
            moment: m ? { id: m.id, title: m.title, date: m.date, momentType: m.type } : null,
          };
        })),
      };
    }
    return HQ_MIDX.idx;
  }

  const hqMomentOf = (c: PortalContentItem): string | null =>
    cardMoment(c, hqMomentIdx())?.title ?? null;

  function hqBoard(): Board {
    HQBOARD ??= createBoard({
      // One of us is looking, so any card may go in any column. The
      // server is told the same thing and checks it again; this is not
      // a way around it.
      role: () => 'admin',
      voice: hqVoice,
      momentOf: hqMomentOf,
      openCard: openCardDrawer,
      setStatus: (c, status) => { void saveCalCard(c.id, { status }, { status }); },
      toast,
      clientOf: (c) => (BOARD_SCOPE ? null : (c as any).clientName ?? null),
    });
    return HQBOARD;
  }

  /** The cards the board should be showing, for whatever scope it is
   *  mounted in. Read fresh so a save is reflected. */
  function boardItems(): PortalContentItem[] {
    const all = calCards();
    return BOARD_SCOPE ? all.filter((c) => (c as any).clientSlug === BOARD_SCOPE) : all;
  }

  function boardBody(): HTMLElement {
    const now = new Date();
    const live = BOARD_ITEMS.filter((c) => {
      const st = stageOf(c);
      return !!st && (st !== 'posted' || postedRecently(c, now));
    });
    if (!live.length) {
      return WHO.size > 0
        ? hqEmpty('Nothing matches that', 'Try a different client to see the rest of the board.')
        : hqEmpty('Nothing is moving yet', 'A card joins the board as soon as it is planned.');
    }
    const board = hqBoard();
    board.begin();
    const wrap = el('div', 'pt-boardwrap');
    wrap.appendChild(isPhone() ? board.list(live) : board.lane(live));
    return wrap;
  }

  function mountBoard(scope: string | null): HTMLElement {
    BOARD_SCOPE = scope;
    BOARD_ITEMS = boardItems();
    const mount = el('div');
    mount.dataset.boardroot = '1';
    mount.appendChild(boardBody());
    BOARD_MOUNT = mount;
    return mount;
  }

  /** Draw the board again where it already is. Called after a save,
   *  because a card that writes to Notion and stays in the column it
   *  came from reads as a drag that did not work. */
  function redrawBoard(): void {
    if (!BOARD_MOUNT?.isConnected) { BOARD_MOUNT = null; return; }
    BOARD_ITEMS = boardItems();
    const scroll = q('[data-board-scroll]', BOARD_MOUNT)?.scrollLeft ?? 0;
    clear(BOARD_MOUNT);
    BOARD_MOUNT.appendChild(boardBody());
    const sc = q('[data-board-scroll]', BOARD_MOUNT);
    if (sc) sc.scrollLeft = scroll;
  }

  /* ── the card drawer ──────────────────────────────────────────
     The same drawer the client opens, with role admin: every field
     saves, the Edit Link is ours to attach, and a note on the thread
     is stamped Blueprint by the server. */

  let CARD_DRAWER_ID = '';

  function openCardDrawer(c: PortalContentItem) {
    const drawer = q('[data-drawer]');
    const scrim = q('[data-scrim]');
    if (!drawer || !scrim) return;
    CARD_DRAWER_ID = c.id;
    fillCardDrawer(c);
    show(scrim, true);
    show(drawer, true);
    requestAnimationFrame(() => {
      scrim.dataset.open = 'true';
      drawer.dataset.open = 'true';
      q<HTMLElement>('[data-drawer-close]')?.focus();
    });
    document.addEventListener('keydown', onCalDrawerKey);
  }

  function fillCardDrawer(c: PortalContentItem) {
    const head = q('[data-drawer-title]');
    const body = q('[data-drawer-body]');
    const foot = q('[data-drawer-foot]');
    if (!head || !body || !foot) return;
    head.textContent = c.title;
    clear(body);
    clear(foot);
    const slug = (c as any).clientSlug as string | undefined;
    fillSharedDrawer({
      role: () => 'admin',
      schema: () => ({ bucket: [], format: [], platforms: [], status: [], media: [],
                       ...(HQ?.contentSchema ?? {}) }),
      voice: hqVoice,
      momentOf: hqMomentOf,
      campaigns: (card) => [...momentsNow().values()]
        .filter((m) => m.clientSlug === (card as any).clientSlug)
        .map((m) => ({ id: m.id, title: m.title })),
      save: (card, patchBody, local) => saveCalCard(card.id, patchBody, local),
      toast,
      clientOf: (card) => (card as any).clientName ?? null,
    }, c, body);

    const who = slug ? calClientBySlug().get(slug) : undefined;
    if (who) {
      const links = el('div', 'pt-drawer-links');
      const detail = el('a', 'pt-btn', `Open ${who.artist} in HQ`) as HTMLAnchorElement;
      detail.href = `#/clients/${encodeURIComponent(who.slug)}`;
      detail.addEventListener('click', closeCalDrawer);
      const portal = el('a', 'pt-btn', 'Their portal') as HTMLAnchorElement;
      portal.href = `/portal/${encodeURIComponent(who.slug)}`;
      links.append(detail, portal);
      foot.appendChild(links);
      show(foot, true);
    } else show(foot, false);
  }

  /** After a save or a refresh, the open drawer shows the row as it
   *  now stands, unless someone is mid-sentence in one of its fields:
   *  replacing a box under a cursor loses what was being typed. */
  function refillCardDrawer(): void {
    if (!CARD_DRAWER_ID) return;
    const drawer = q('[data-drawer]');
    if (!drawer || drawer.hidden) { CARD_DRAWER_ID = ''; return; }
    const active = document.activeElement;
    if (active && drawer.contains(active)
        && (active.tagName === 'TEXTAREA' || (active.tagName === 'INPUT'
            && (active as HTMLInputElement).type !== 'date'))) return;
    const c = calCards().find((x) => x.id === CARD_DRAWER_ID);
    if (!c) return;
    const body = q('[data-drawer-body]');
    const top = body?.scrollTop ?? 0;
    const open = !!q<HTMLDetailsElement>('.pt-drawer-more', drawer)?.open;
    fillCardDrawer(c);
    const more = q<HTMLDetailsElement>('.pt-drawer-more', drawer);
    if (more) more.open = open;
    if (body) body.scrollTop = top;
  }

  function drawContentTab(root: HTMLElement) {
    root.appendChild(whoBar());
    const n = boardItemCount();
    const bar = el('div', 'pt-toolbar');
    bar.appendChild(el('h1', undefined, 'Content'));
    bar.appendChild(el('p', 'pt-sub',
      `${n} card${n === 1 ? '' : 's'} across every live client. `
      + 'Drag one to move it; the drop writes straight to Notion.'));
    root.appendChild(bar);
    root.appendChild(mountBoard(null));
  }

  function boardItemCount(): number {
    BOARD_SCOPE = null;
    return boardItems().length;
  }

  /** The same board on one client's own page, filtered to them. */
  function clientBoard(slug: string): HTMLElement {
    const wrap = el('section', 'hq-sec');
    wrap.appendChild(el('h2', undefined, 'Content'));
    wrap.appendChild(mountBoard(slug));
    return wrap;
  }

  function hqEmpty(title: string, body: string): HTMLElement {
    const e = el('div', 'pt-empty');
    const ic = el('div', 'pt-empty-icon');
    ic.appendChild(icon('film'));
    e.append(ic, el('h3', undefined, title), el('p', undefined, body));
    return e;
  }

  /** All clients, or any set of them. The colour beside each name is
   *  the colour its chips wear on the grid, so the two can be read
   *  against each other without a legend. */
  function whoBar(): HTMLElement {
    const bar = el('div', 'pt-whobar');
    bar.setAttribute('role', 'group');
    bar.setAttribute('aria-label', 'Which clients');
    bar.appendChild(el('span', 'pt-whobar-label', 'Clients'));

    const all = el('button', 'pt-who' + (WHO.size === 0 ? ' pt-who-on' : ''));
    all.type = 'button';
    all.textContent = 'All';
    all.setAttribute('aria-pressed', String(WHO.size === 0));
    all.addEventListener('click', () => { WHO = new Set(); afterWho(); });
    bar.appendChild(all);

    for (const c of calClients()) {
      const on = WHO.has(c.slug);
      const b = el('button', 'pt-who' + (on ? ' pt-who-on' : ''));
      b.type = 'button';
      b.setAttribute('aria-pressed', String(on));
      const dot = el('span', `pt-chip-who pt-cc-${clientColor(c.slug)}`);
      dot.setAttribute('aria-hidden', 'true');
      b.append(dot, el('span', undefined, c.artist));
      b.addEventListener('click', () => {
        if (WHO.has(c.slug)) WHO.delete(c.slug);
        else WHO.add(c.slug);
        afterWho();
      });
      bar.appendChild(b);
    }
    return bar;
  }

  function afterWho() {
    saveHqPrefs();
    const cal = hqCal();
    cal.setRows(calRows());
    cal.sync();
    draw('calendar');
  }

  /* ══ PIPELINE ═══════════════════════════════════════════════ */

  /** The cap Blueprint runs to. Three active clients at a time is the
   *  whole business model, so the header says where we are against it. */
  const ACTIVE_CAP = 3;

  /** Ended is collapsed by default: it is history, not pipeline. */
  let endedOpen = false;
  /** The card currently open for editing, by page id. */
  let editing = '';
  /** Whether the quick-add form is showing. */
  let adding = false;

  const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;

  function drawPipeline(root: HTMLElement) {
    const all = clients() as CardClient[];

    const bar = el('div', 'hq-bar');
    bar.appendChild(el('h1', undefined, 'Pipeline'));

    const activeRows = all.filter((c) => c.stage === 'Active');
    const mrr = activeRows.reduce((t, c) => t + (c.monthlyRate ?? 0), 0);
    const pipeline = all
      .filter((c) => c.stage === 'Proposal Sent')
      .reduce((t, c) => t + (c.monthlyRate ?? 0), 0);

    const totals = el('div', 'hq-totals');
    totals.append(
      total('active MRR', money(mrr)),
      total('in proposals', money(pipeline)),
      total('active', `${activeRows.length} of ${ACTIVE_CAP}`,
        activeRows.length >= ACTIVE_CAP ? 'full' : undefined),
    );
    bar.appendChild(totals);

    const add = el('button', 'pt-btn pt-btn-primary');
    add.type = 'button';
    add.appendChild(icon('plus'));
    add.appendChild(el('span', undefined, 'New lead'));
    add.addEventListener('click', () => { adding = true; draw('pipeline'); });
    bar.appendChild(add);
    root.appendChild(bar);

    const board = el('div', 'hq-pipe');
    for (const stage of HQ_STAGES) {
      board.appendChild(pipeColumn(stage, all.filter((c) => c.stage === stage)));
    }
    root.appendChild(board);
  }

  function total(label: string, value: string, tone?: string): HTMLElement {
    const t = el('div', 'hq-total');
    t.append(
      el('div', `hq-total-v${tone ? ` hq-total-${tone}` : ''}`, value),
      el('div', 'hq-total-l', label),
    );
    return t;
  }

  function pipeColumn(stage: string, rows: CardClient[]): HTMLElement {
    const col = el('div', 'hq-pipe-col');
    col.dataset.stage = stage;

    const collapsed = stage === 'Ended' && !endedOpen;
    if (collapsed) col.classList.add('is-collapsed');

    const head = el('div', 'hq-pipe-head');
    const title = el('span', undefined, stage);
    head.append(title, el('span', 'hq-sec-count', String(rows.length)));
    if (stage === 'Ended') {
      const toggle = el('button', 'hq-pipe-toggle');
      toggle.type = 'button';
      toggle.setAttribute('aria-expanded', String(endedOpen));
      toggle.setAttribute('aria-label', endedOpen ? 'Collapse Ended' : 'Expand Ended');
      toggle.appendChild(icon(endedOpen ? 'chev' : 'chev-left'));
      toggle.addEventListener('click', () => { endedOpen = !endedOpen; draw('pipeline'); });
      head.appendChild(toggle);
    }
    col.appendChild(head);

    if (collapsed) return col;

    const body = el('div', 'hq-pipe-body');
    body.dataset.drop = stage;

    if (stage === 'Lead' && adding) body.appendChild(newLeadForm());

    rows.sort((a, b) => {
      // Soonest next action first, then by name. A column sorted by
      // when you have to act on it is the only sort that helps.
      const ad = a.nextActionDate ?? '9999';
      const bd = b.nextActionDate ?? '9999';
      return ad.localeCompare(bd) || a.artist.localeCompare(b.artist);
    });
    for (const c of rows) body.appendChild(pipeCard(c));

    if (!rows.length && !(stage === 'Lead' && adding)) {
      body.appendChild(el('div', 'hq-pipe-empty', 'Nothing here'));
    }
    col.appendChild(body);
    return col;
  }

  function pipeCard(c: CardClient): HTMLElement {
    const card = el('div', 'hq-pipe-card');
    card.dataset.id = c.pageId;
    card.dataset.stage = c.stage ?? '';

    // `editing` is the empty string when nothing is open, so an
    // empty pageId would match it and the card would render as an
    // open form. A row Notion gave no id is still a row to look at.
    if (editing && editing === c.pageId) {
      card.appendChild(editForm(c));
      card.classList.add('is-editing');
      return card;
    }

    const top = el('div', 'hq-pipe-top');
    top.appendChild(el('span', 'hq-pipe-name', c.artist));
    if (c.monthlyRate) top.appendChild(el('span', 'hq-pipe-rate', money(c.monthlyRate)));
    card.appendChild(top);

    const meta: string[] = [];
    if (c.tier) meta.push(c.tier.replace(/^Tier \d+ · /, ''));
    if (c.leadSource) meta.push(c.leadSource);
    if (meta.length) card.appendChild(el('div', 'hq-pipe-meta', meta.join(' · ')));

    const act = el('div', 'hq-pipe-act');
    if (c.nextAction || c.nextActionDate) {
      act.appendChild(el('span', 'hq-pipe-what', c.nextAction || 'Next action'));
      if (c.nextActionDate) {
        const late = c.nextActionDate < isoToday();
        act.appendChild(el('span', `hq-pipe-when${late ? ' hq-when-late' : ''}`,
          late ? whenLabel(c.nextActionDate).text : shortDay(c.nextActionDate)));
      }
    } else {
      act.appendChild(el('span', 'hq-pipe-what hq-pipe-none', 'No next action'));
    }
    card.appendChild(act);

    const acts = el('div', 'hq-pipe-foot');
    const edit = el('button', 'hq-pipe-link', 'Edit');
    edit.type = 'button';
    edit.addEventListener('click', (e) => {
      e.stopPropagation();
      editing = c.pageId;
      draw('pipeline');
    });
    acts.appendChild(edit);
    if (c.slug) {
      const open = el('a', 'hq-pipe-link', 'Open');
      open.href = `#/clients/${c.slug}`;
      acts.appendChild(open);
    }
    card.appendChild(acts);

    makeDraggable(card, c);
    return card;
  }

  /* ── inline edit ─────────────────────────────────────────────── */

  function field(label: string, node: HTMLElement): HTMLElement {
    const w = el('label', 'hq-field');
    w.append(el('span', undefined, label), node);
    return w;
  }

  function editForm(c: CardClient): HTMLElement {
    const form = el('form', 'hq-form');

    const what = el('input');
    what.type = 'text';
    what.value = c.nextAction ?? '';
    what.maxLength = 200;
    what.placeholder = 'What happens next';

    const when = el('input');
    when.type = 'date';
    when.value = c.nextActionDate ?? '';

    const stage = el('select');
    for (const s of HQ_STAGES) {
      const o = el('option', undefined, s);
      o.value = s;
      if (s === c.stage) o.selected = true;
      stage.appendChild(o);
    }

    form.append(
      field('Next action', what),
      field('Date', when),
      // Drag is the quick way; this is the one that works from a
      // keyboard, and the one that works when the board is scrolled.
      field('Stage', stage),
    );

    const row = el('div', 'hq-form-acts');
    const save = el('button', 'pt-btn pt-btn-primary', 'Save');
    save.type = 'submit';
    const cancel = el('button', 'pt-btn', 'Cancel');
    cancel.type = 'button';
    cancel.addEventListener('click', () => { editing = ''; draw('pipeline'); });
    row.append(save, cancel);
    form.appendChild(row);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body: Record<string, unknown> = {};
      const nextAction = what.value.trim();
      if (nextAction !== (c.nextAction ?? '')) body.nextAction = nextAction || null;
      const nextActionDate = when.value || null;
      if (nextActionDate !== (c.nextActionDate ?? null)) body.nextActionDate = nextActionDate;
      if (stage.value !== c.stage) body.stage = stage.value;

      if (!Object.keys(body).length) { editing = ''; draw('pipeline'); return; }

      form.classList.add('is-busy');
      const ok = await patch(`/portal/hq/client/${c.pageId}`, body);
      form.classList.remove('is-busy');
      if (!ok) { toast('That did not save.', true); return; }

      if ('nextAction' in body) c.nextAction = (body.nextAction as string | null);
      if ('nextActionDate' in body) c.nextActionDate = (body.nextActionDate as string | null);
      if ('stage' in body) c.stage = body.stage as string;
      editing = '';
      toast('Saved.');
      draw('pipeline');
    });

    return form;
  }

  function newLeadForm(): HTMLElement {
    const form = el('form', 'hq-form hq-form-new');

    const artist = el('input');
    artist.type = 'text';
    artist.required = true;
    artist.maxLength = 120;
    artist.placeholder = 'Artist';

    const source = el('select');
    const none = el('option', undefined, 'No source yet');
    none.value = '';
    source.appendChild(none);
    for (const s of LEAD_SOURCES) {
      const o = el('option', undefined, s);
      o.value = s;
      source.appendChild(o);
    }

    const what = el('input');
    what.type = 'text';
    what.maxLength = 200;
    what.placeholder = 'What happens next';

    const when = el('input');
    when.type = 'date';

    form.append(
      field('Artist', artist),
      field('Lead source', source),
      field('Next action', what),
      field('Date', when),
    );

    const row = el('div', 'hq-form-acts');
    const save = el('button', 'pt-btn pt-btn-primary', 'Add lead');
    save.type = 'submit';
    const cancel = el('button', 'pt-btn', 'Cancel');
    cancel.type = 'button';
    cancel.addEventListener('click', () => { adding = false; draw('pipeline'); });
    row.append(save, cancel);
    form.appendChild(row);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = artist.value.trim();
      if (!name) { artist.focus(); return; }

      form.classList.add('is-busy');
      let ok = false;
      let id = '';
      try {
        const res = await fetch('/portal/hq/client', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            artist: name,
            leadSource: source.value || null,
            nextAction: what.value.trim() || null,
            nextActionDate: when.value || null,
          }),
        });
        ok = res.ok;
        if (ok) id = String((await res.json())?.id ?? '');
      } catch { ok = false; }
      form.classList.remove('is-busy');

      if (!ok) { toast('That lead did not save.', true); return; }

      // Put it on the board without a refetch, same as every other
      // write here. The id comes back from Notion so a later edit
      // writes to the right row.
      (HQ.clients ??= []).push({
        pageId: id, slug: '', artist: name, stage: 'Lead',
        tier: null, monthlyRate: null, leadSource: source.value || null,
        nextAction: what.value.trim() || null,
        nextActionDate: when.value || null,
        termStart: null, termEnd: null, rateStepUp: null,
      });
      adding = false;
      toast(`${name} added.`);
      draw('pipeline');
    });

    window.setTimeout(() => artist.focus(), 0);
    return form;
  }

  /* ── drag ────────────────────────────────────────────────────── */

  /**
   * Pointer events, not the HTML5 drag API.
   *
   * Safari's native drag-and-drop does not fire on touch at all and
   * is awkward on a trackpad, so the board does it by hand. Three
   * things make it work there specifically:
   *
   *   touch-action: none on the card, or Safari scrolls the board
   *   instead of starting the drag;
   *   setPointerCapture, so the moves keep arriving when the pointer
   *   leaves the card, which it does immediately;
   *   a ghost with pointer-events: none, so elementFromPoint under
   *   the cursor finds the column rather than the thing being dragged.
   *
   * A drag only begins after a few pixels of movement, so a click on
   * Edit is still a click.
   */
  const DRAG_START_PX = 5;

  function makeDraggable(card: HTMLElement, c: CardClient) {
    let startX = 0, startY = 0;
    let ghost: HTMLElement | null = null;
    let over: HTMLElement | null = null;
    let live = false;
    let id = -1;

    const clearOver = () => {
      if (over) over.classList.remove('is-over');
      over = null;
    };

    const stop = () => {
      if (ghost) { ghost.remove(); ghost = null; }
      card.classList.remove('is-dragging');
      clearOver();
      live = false;
      if (id !== -1 && card.hasPointerCapture?.(id)) card.releasePointerCapture(id);
      id = -1;
    };

    card.addEventListener('pointerdown', (ev) => {
      const e = ev as PointerEvent;
      // Never start a drag from a control inside the card.
      if ((e.target as Element)?.closest('button, a, input, select, form')) return;
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      startX = e.clientX; startY = e.clientY;
      id = e.pointerId;
      card.setPointerCapture(id);
    });

    card.addEventListener('pointermove', (ev) => {
      const e = ev as PointerEvent;
      if (id === -1 || e.pointerId !== id) return;

      if (!live) {
        if (Math.abs(e.clientX - startX) < DRAG_START_PX
          && Math.abs(e.clientY - startY) < DRAG_START_PX) return;
        live = true;
        card.classList.add('is-dragging');
        ghost = card.cloneNode(true) as HTMLElement;
        ghost.className = 'hq-pipe-card hq-ghost';
        ghost.style.width = `${card.offsetWidth}px`;
        document.body.appendChild(ghost);
      }
      if (!ghost) return;

      ghost.style.left = `${e.clientX - 20}px`;
      ghost.style.top = `${e.clientY - 18}px`;

      const under = document.elementFromPoint(e.clientX, e.clientY);
      const col = under?.closest('[data-drop]') as HTMLElement | null;
      if (col !== over) {
        clearOver();
        over = col;
        if (over) over.classList.add('is-over');
      }
    });

    const finish = async (ev: Event) => {
      const e = ev as PointerEvent;
      if (id === -1 || e.pointerId !== id) return;
      const target = over?.dataset.drop ?? '';
      const moved = live;
      stop();
      if (!moved || !target || target === c.stage) return;

      const from = c.stage;
      // Optimistic: the card is already where you dropped it, and it
      // goes back if Notion refuses.
      c.stage = target;
      draw('pipeline');

      const ok = await patch(`/portal/hq/client/${c.pageId}`, { stage: target });
      if (!ok) {
        c.stage = from;
        toast(`${c.artist} did not move. Still ${from}.`, true);
        draw('pipeline');
        return;
      }
      toast(`${c.artist} moved to ${target}.`);
    };

    card.addEventListener('pointerup', (e) => void finish(e));
    card.addEventListener('pointercancel', () => stop());
  }
  /* ══ REPORTS ════════════════════════════════════════════════ */

  /**
   * The publishing desk.
   *
   * Every button here posts to an endpoint that already existed,
   * because the publish pipeline is the one part of this codebase it
   * would be actively wrong to have a second copy of: it renders a
   * PDF, writes R2, flips a Notion row and emails a client, in that
   * order, and the order is the correctness argument. See
   * functions/portal/<slug>/admin/report/<id>/<action>.ts.
   *
   * The one exception is a prospect teardown, which has no client and
   * therefore no portal and therefore no slug to put in that URL.
   * Those go to /portal/hq/audit/<id>/<action>, which refuses
   * anything that DOES have a client, so each document has exactly
   * one path and the ownership check is never the thing that got
   * skipped. docBase() in src/data/hq.ts decides which.
   */

  /** A client by page id, for the chip on every row. */
  function clientOf(id: string | null): RowClient | null {
    if (!id) return null;
    return clients().find((c) => c.pageId === id) ?? null;
  }

  function drawReports(root: HTMLElement) {
    const bar = el('div', 'hq-bar');
    bar.appendChild(el('h1', undefined, 'Reports'));
    root.appendChild(bar);

    const snaps = (HQ?.snapshots ?? []) as any[];
    const drafts = reportDrafts(snaps);
    const live = reportPublished(snaps);
    const audits = sortAudits((HQ?.audits ?? []) as any[]);

    root.appendChild(docSection('Drafts', drafts.length, drafts.length
      ? drafts.map(draftRow)
      : [note('Nothing unpublished. Every month on file has gone out.')]));

    root.appendChild(docSection('Published', live.length, live.length
      ? live.slice(0, 24).map(publishedRow)
      : [note('No month has been published yet.')]));

    root.appendChild(docSection('Growth audits', audits.length, audits.length
      ? audits.map(auditRow)
      : [note('No audits on file.')]));

    root.appendChild(coverSection());
  }

  function note(text: string): HTMLElement {
    return el('p', 'hq-none', text);
  }

  function docSection(title: string, count: number, rows: HTMLElement[]): HTMLElement {
    const sec = el('section', 'hq-sec');
    const head = el('div', 'hq-sec-head');
    head.append(el('h2', undefined, title), el('span', 'hq-sec-count', String(count)));
    sec.appendChild(head);
    const list = el('div', 'hq-docs');
    for (const r of rows) list.appendChild(r);
    sec.appendChild(list);
    return sec;
  }

  /** The frame every row on this tab shares: who it is about, what it
   *  is, a pill, a sub-line, and a row of buttons. */
  function docRow(
    heading: string, sub: string[], pill: [string, 'good' | 'warn'] | null,
  ): { row: HTMLElement; meta: HTMLElement; acts: HTMLElement } {
    const row = el('div', 'hq-doc');
    const meta = el('div', 'hq-doc-meta');

    const top = el('div', 'hq-doc-top');
    top.appendChild(el('span', 'hq-doc-h', heading));
    if (pill) top.appendChild(el('span', `hq-pill hq-pill-${pill[1]}`, pill[0]));
    meta.appendChild(top);

    const line = sub.filter(Boolean).join(' · ');
    if (line) meta.appendChild(el('div', 'hq-doc-sub', line));

    const acts = el('div', 'hq-doc-acts');
    row.append(meta, acts);
    return { row, meta, acts };
  }

  /* ── one draft ────────────────────────────────────────────────── */

  function draftRow(s: any): HTMLElement {
    const c = clientOf(s.clientId);
    const base = docBase('report', s.id, c?.slug || null);

    const { row, meta, acts } = docRow(
      `${c?.artist ?? 'No client'} · ${s.date ? monthLabel(s.date) : 'Undated'}`,
      [s.type && s.type !== 'Monthly' ? s.type : ''],
      ['Draft', 'warn'],
    );

    const win = (s.win ?? '').trim();
    const watch = (s.watch ?? '').trim();
    if (win) meta.appendChild(quote('Win', win));
    if (watch) meta.appendChild(quote('Watch', watch));

    const gaps = reportGaps(s);
    if (gaps.length) meta.appendChild(gapLine(gaps));

    if (!base) {
      // A snapshot whose client has no Intake Slug. There is no URL
      // that reaches the publish route, so there is no button to draw
      // and the honest thing is to say which row to go and fix.
      acts.appendChild(el('span', 'hq-doc-cant', 'No portal slug on the client row.'));
      return row;
    }

    acts.appendChild(previewLink(base));
    acts.appendChild(actionButton('Regenerate PDF', async () => {
      const res = await hqPost(`${base}/pdf`);
      coverFrom(res, c?.slug ?? '');
      if (!res.ok) return bad(whyFailed(res, 'The PDF did not generate.'));
      draw('reports');
      return 'PDF regenerated.';
    }));
    acts.appendChild(actionButton('Publish', async () => {
      const res = await hqPost(`${base}/publish`);
      coverFrom(res, c?.slug ?? '');
      if (!res.ok) return bad(whyFailed(res, 'Publishing did not go through.'));
      // The row is now published, so move it without a refetch: the
      // payload is cached for ninety seconds and the write has
      // already dropped that cache, but a redraw is instant and a
      // round trip is not.
      s.published = true;
      s.publishedAt = new Date().toISOString();
      s.reportPdf = String(res.json?.url ?? '') || s.reportPdf;
      const mail = String(res.json?.mail ?? '');
      s.mailedAt = mail === 'sent' ? s.publishedAt : s.mailedAt ?? null;
      draw('reports');
      if (mail === 'sent') return 'Published, and the email is on its way.';
      if (mail === 'already') return 'Published. The email had already gone.';
      if (mail === 'no-recipients') {
        return bad('Published. No portal emails on file, so nothing was sent.');
      }
      return bad('Published. The email did not send, which is in the logs.');
    }));
    if (s.reportPdf) acts.appendChild(fileLink(s.reportPdf, 'PDF'));
    return row;
  }

  /** A line of Mason's own words, clipped. The point is to recognise
   *  the month, not to read it here. */
  function quote(label: string, text: string): HTMLElement {
    const p = el('div', 'hq-doc-quote');
    p.append(el('span', 'hq-doc-ql', label), el('span', undefined, text));
    return p;
  }

  /**
   * What is not written yet.
   *
   * Blocking gaps are red and named first, because those are the ones
   * that come out of the printer wrong rather than short. Publish
   * stays enabled either way: the server will take it, sometimes a
   * month genuinely is three numbers and a sentence, and a button
   * that lies about what the server would accept is worse than a
   * warning Mason can read.
   */
  function gapLine(gaps: ReturnType<typeof reportGaps>): HTMLElement {
    const wrap = el('div', 'hq-doc-gaps');
    wrap.appendChild(el('span', 'hq-doc-ql', 'Not written'));
    const ordered = [...gaps].sort((a, b) => Number(b.blocking) - Number(a.blocking));
    for (const g of ordered) {
      const chip = el('span', `hq-gap${g.blocking ? ' hq-gap-bad' : ''}`, g.label);
      chip.title = `Not written. It shows in ${g.where}.`;
      wrap.appendChild(chip);
    }
    return wrap;
  }

  /* ── one published month ──────────────────────────────────────── */

  function publishedRow(s: any): HTMLElement {
    const c = clientOf(s.clientId);
    const base = docBase('report', s.id, c?.slug || null);
    const on = s.publishedAt ? String(s.publishedAt).slice(0, 10) : null;

    const { row, acts } = docRow(
      `${c?.artist ?? 'No client'} · ${s.date ? monthLabel(s.date) : 'Undated'}`,
      [on ? `published ${shortDay(on)}` : 'published', mailLabel(s)],
      ['Published', 'good'],
    );

    if (base) {
      acts.appendChild(previewLink(base));
      acts.appendChild(actionButton('Regenerate PDF', async () => {
        const res = await hqPost(`${base}/pdf`);
        coverFrom(res, c?.slug ?? '');
        if (!res.ok) return bad(whyFailed(res, 'The PDF did not generate.'));
        draw('reports');
        return 'PDF regenerated.';
      }));
    }
    if (s.reportPdf) acts.appendChild(fileLink(s.reportPdf, 'PDF'));
    return row;
  }

  /**
   * The email, in one phrase.
   *
   * `mailedAt` comes from the send claim in KV, which is the only
   * record of a send anywhere. Beyond the twelve most recent
   * published months it is not read at all, so the absent case says
   * "no record" rather than "not sent": those are different things
   * and only one of them is a problem.
   */
  function mailLabel(s: any): string {
    if (s.mailedAt) return `emailed ${shortDay(String(s.mailedAt).slice(0, 10))}`;
    return s.mailedAt === null ? 'no email on record' : '';
  }

  /* ── one audit ────────────────────────────────────────────────── */

  function auditRow(a: any): HTMLElement {
    const c = clientOf(a.clientId);
    const who = c?.artist ?? a.prospectName ?? 'Unnamed';
    const base = docBase('audit', a.id, c?.slug || null);

    const { row, meta, acts } = docRow(
      `${who} · ${a.title || 'Growth audit'}`,
      [a.audience, a.status ?? 'no status',
       a.auditDate ? shortDay(a.auditDate) : '', a.dataWindow ?? ''],
      a.audience === 'Client'
        ? (a.published ? ['In their portal', 'good'] : ['Not shown', 'warn'])
        : (a.shareLink ? ['Link live', 'good'] : ['No link', 'warn']),
    );

    const short = (a.shortVersion ?? '').trim();
    if (short) meta.appendChild(quote('Short version', short));

    if (!base) {
      acts.appendChild(el('span', 'hq-doc-cant', 'No portal slug on the client row.'));
      return row;
    }

    acts.appendChild(previewLink(base));
    acts.appendChild(actionButton('Generate PDF', async () => {
      const res = await hqPost(`${base}/pdf`);
      coverFrom(res, c?.slug ?? '');
      if (!res.ok) return bad(whyFailed(res, 'The PDF did not generate.'));
      const missing = Array.isArray(res.json?.missing) ? res.json?.missing as string[] : [];
      return missing.length
        ? bad(`PDF ready. ${missing.length} heading${missing.length === 1 ? '' : 's'} `
          + `not written: ${missing.join(', ')}`)
        : 'PDF ready.';
    }));

    // Share links are for prospects. A client audit reaches its
    // client through their own portal, and a second, revocable,
    // unauthenticated URL to the same document is a liability rather
    // than a convenience.
    if (a.audience === 'Prospect') {
      acts.appendChild(actionButton(a.shareLink ? 'New share link' : 'Create share link',
        async () => {
          const res = await hqPost(`${base}/share`, { days: SHARE_DAYS });
          if (res.json?.error === 'no_pdf_yet') return bad('Generate the PDF first.');
          if (!res.ok) return bad(whyFailed(res, 'The share link was not created.'));
          const url = String(res.json?.url ?? '');
          a.shareLink = url || a.shareLink;
          draw('reports');
          if (!url) return 'Share link created.';
          return (await copyText(url))
            ? `Share link copied. It expires in ${SHARE_DAYS} days.`
            : bad(`Share link created, but it did not copy: ${url}`);
        }));
      if (a.shareLink) {
        acts.appendChild(actionButton('Copy link', async () =>
          (await copyText(String(a.shareLink)))
            ? 'Copied.'
            : bad(`That did not copy: ${a.shareLink}`)));
        acts.appendChild(actionButton('Revoke', async () => {
          const res = await hqPost(`${base}/revoke`);
          if (!res.ok) return bad(whyFailed(res, 'The link was not revoked.'));
          a.shareLink = null;
          draw('reports');
          return 'That link no longer works.';
        }));
      }
    }

    if (a.auditPdf) acts.appendChild(fileLink(a.auditPdf, 'PDF'));
    return row;
  }

  /** How long a prospect's link lives. Thirty days is long enough to
   *  follow up twice and short enough that a teardown does not stay
   *  readable for a year after they said no. */
  const SHARE_DAYS = 30;

  /* ── cover photos ─────────────────────────────────────────────── */

  /**
   * Which photo each client's next document will use.
   *
   * It is a property of the client, not of a month: one "Report
   * Covers" folder in Drive, read again on every Publish and
   * Regenerate. Shown here because it is the one thing about a report
   * that cannot be seen from the row, and it is the difference
   * between a cover photo and a blue grid.
   *
   * One GET per client, in parallel, and silent on failure: a cover
   * line that would not load is not a reason to put an error in front
   * of somebody who came here to publish a report.
   */
  /** What /admin/cover last said, by slug. A redraw after a Publish
   *  must not send three more requests to Drive. */
  const COVERS = new Map<string, CoverStatus>();

  function coverSection(): HTMLElement {
    const withPortals = cards().filter((c) => c.slug);
    const sec = el('section', 'hq-sec');
    const head = el('div', 'hq-sec-head');
    head.append(el('h2', undefined, 'Cover photos'),
      el('span', 'hq-sec-count', String(withPortals.length)));
    sec.appendChild(head);

    const list = el('div', 'hq-docs');
    if (!withPortals.length) {
      list.appendChild(note('No client has a portal yet.'));
      sec.appendChild(list);
      return sec;
    }

    for (const c of withPortals) {
      const row = el('div', 'hq-doc hq-doc-cover');
      const meta = el('div', 'hq-doc-meta');
      meta.appendChild(el('div', 'hq-doc-h', c.artist));
      const known = COVERS.get(c.slug);
      const sub = el('div', 'hq-doc-sub', known ? coverLine(known) : 'Checking Drive…');
      // A document that will print the blue grid is the one thing on
      // this tab worth noticing before you publish.
      if (known?.source === 'grid') sub.classList.add('hq-when-late');
      meta.appendChild(sub);
      row.appendChild(meta);
      list.appendChild(row);

      if (known) continue;
      void (async () => {
        const res = await hqGet(`/portal/${encodeURIComponent(c.slug)}/admin/cover`);
        const cover = res.ok ? res.json?.cover as CoverStatus | undefined : undefined;
        if (!cover) { sub.textContent = 'Could not read the cover.'; return; }
        COVERS.set(c.slug, cover);
        sub.textContent = coverLine(cover);
        if (cover.source === 'grid') sub.classList.add('hq-when-late');
      })();
    }
    sec.appendChild(list);
    return sec;
  }

  /** What /admin/cover answers with. Mirrors coverStatus in
   *  src/server/cover.ts; a test holds the two together. */
  interface CoverStatus {
    source: string;
    label: string;
    filename: string | null;
    focus: string;
    image: string | null;
    note: string | null;
  }

  function coverLine(cover: CoverStatus): string {
    const crop = cover.focus
      ? cover.focus[0].toUpperCase() + cover.focus.slice(1)
      : '';
    return [
      `Source: ${cover.label}`,
      cover.filename ?? '',
      cover.image && crop ? `Crop: ${crop}` : '',
      cover.note ?? '',
    ].filter(Boolean).join(' · ');
  }

  /** Publish and Regenerate are the two actions that go and look at
   *  Drive, and both hand back what they found. Taking it from the
   *  answer rather than asking again is one request saved and, more
   *  to the point, one that cannot disagree with what was just used
   *  to render the document. */
  function coverFrom(res: Answer, slug: string): void {
    const cover = res.json?.cover;
    if (cover && typeof cover === 'object' && slug) {
      COVERS.set(slug, cover as CoverStatus);
    }
  }

  /* ── talking to the endpoints ─────────────────────────────────── */

  interface Answer {
    ok: boolean;
    status: number;
    json: Record<string, unknown> | null;
  }

  async function sendJson(url: string, method: 'GET' | 'POST', body?: unknown): Promise<Answer> {
    try {
      const res = await fetch(url, {
        method,
        credentials: 'same-origin',
        headers: method === 'POST' ? { 'Content-Type': 'application/json' } : undefined,
        body: method === 'POST' ? JSON.stringify(body ?? {}) : undefined,
      });
      let json: Record<string, unknown> | null = null;
      try { json = JSON.parse(await res.text()) as Record<string, unknown>; } catch { json = null; }
      return { ok: res.ok && json?.ok === true, status: res.status, json };
    } catch (err) {
      return { ok: false, status: 0, json: { detail: String(err) } };
    }
  }

  const hqPost = (url: string, body?: unknown) => sendJson(url, 'POST', body);
  const hqGet = (url: string) => sendJson(url, 'GET');

  /** What the server said went wrong, or a fallback. These endpoints
   *  are admin-only and the renderer redacts its own signed token, so
   *  the real cause belongs on the button rather than in a log Mason
   *  has to go and open. */
  function whyFailed(res: Answer, fallback: string): string {
    const detail = String(res.json?.detail ?? '').trim();
    return detail ? `${fallback} ${detail}` : fallback;
  }

  /**
   * What an action came back with.
   *
   * A plain string clears itself. `bad` is anything Mason needs to
   * read rather than glimpse: a render error naming the fault, a list
   * of unwritten headings, a publish that went through but sent no
   * email. Sniffing the English for "did not" was the first version
   * of this and it was one rewording away from silently clearing an
   * error.
   */
  type Said = string | { text: string; bad: true };
  const bad = (text: string): Said => ({ text, bad: true });

  /**
   * One button: disables itself, runs, says what happened.
   *
   * Disabling is the double-click guard in the browser. The real one
   * is on the server, where the publish email is claimed in KV before
   * it is sent, because a disabled button does nothing about a second
   * tab.
   */
  function actionButton(label: string, run: () => Promise<Said>): HTMLElement {
    const b = el('button', 'pt-btn pt-btn-sm');
    b.type = 'button';
    const span = el('span', undefined, label);
    b.appendChild(span);
    b.addEventListener('click', async () => {
      if (b.disabled) return;
      b.disabled = true;
      span.textContent = 'Working…';
      try {
        const said = await run();
        if (typeof said === 'string') toast(said); else toast(said.text, true);
      } catch (err) {
        toast(`That did not go through. ${err instanceof Error ? err.message : String(err)}`,
          true);
      } finally {
        // The redraw in a successful run replaces this node, so these
        // two lines are for the failures that leave it on screen.
        b.disabled = false;
        span.textContent = label;
      }
    });
    return b;
  }

  function previewLink(base: string): HTMLElement {
    const a = el('a', 'pt-btn pt-btn-sm') as HTMLAnchorElement;
    a.href = `${base}/preview`;
    a.target = '_blank';
    a.rel = 'noopener';
    a.appendChild(el('span', undefined, 'Preview'));
    return a;
  }

  function fileLink(href: string, label: string): HTMLElement {
    const a = el('a', 'pt-btn pt-btn-sm') as HTMLAnchorElement;
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.appendChild(el('span', undefined, label));
    return a;
  }

  /** Clipboard, with the old-fashioned fallback and an honest answer.
   *  A share link that is created but not copied is a link Mason has
   *  to go and find, so the caller puts it in the toast instead. */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch { /* fall through */ }
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    } catch {
      return false;
    }
  }

  /* ══ TODAY ══════════════════════════════════════════════════ */

  function drawToday(root: HTMLElement) {
    root.appendChild(strip());
    root.appendChild(owedBar());
    root.appendChild(todayBar());

    const lists = buildToday(
      { clients: clients(), steps: HQ?.calendar ?? [], content: HQ?.content ?? [] },
      FILTER,
    );

    const total = lists.overdue.length + lists.today.length + lists.week.length;
    if (!total) {
      const e = el('div', 'pt-empty');
      const ic = el('div', 'pt-empty-icon');
      ic.appendChild(icon('check'));
      e.append(ic, el('h3', undefined, 'Nothing outstanding'),
        el('p', undefined, FILTER === 'all'
          ? 'No step, post or next action is due in the next seven days.'
          : 'Nothing here under this filter. Try All.'));
      root.appendChild(e);
      return;
    }

    if (GROUP === 'campaign') {
      // One pass over all three buckets: a campaign does not stop at
      // the end of the week, and splitting it by day here would be the
      // view this toggle exists to get away from. Overdue rows keep
      // their late date, which is how they still read as late.
      const rows = [...lists.overdue, ...lists.today, ...lists.week];
      for (const g of groupByCampaign(rows)) root.appendChild(campSection(g));
      return;
    }

    if (lists.overdue.length) root.appendChild(section('Overdue', lists.overdue, true));
    if (lists.today.length) root.appendChild(section('Due today', lists.today));
    if (lists.week.length) root.appendChild(section('This week', lists.week));
  }

  /** One campaign and the work under it. */
  function campSection(g: HqCampaignGroup): HTMLElement {
    const sec = el('section', 'hq-sec');
    const head = el('div', 'hq-sec-head');

    if (g.moment) {
      head.appendChild(campChip(g.moment));
      // The client's name is on every row in a by-day list; here the
      // section carries it once, because a campaign belongs to one.
      const who = el('a', 'hq-client', g.rows[0].clientName);
      who.href = `/portal/${g.rows[0].clientSlug}`;
      head.appendChild(who);
    } else {
      head.appendChild(el('h2', undefined, g.title));
    }

    head.appendChild(el('span', 'hq-sec-count', String(g.rows.length)));
    sec.appendChild(head);

    const list = el('div', 'hq-list');
    for (const r of g.rows) list.appendChild(rowNode(r));
    sec.appendChild(list);
    return sec;
  }

  /**
   * What we owe each live client this month, on one line.
   *
   * The number that matters is not how many posts went out: it is
   * whether the month was planned to the size it was sold at. A month
   * with nine of our posts in it on the 3rd is a month to fix now,
   * and the only place anyone would notice is here.
   */
  function owedBar(): HTMLElement {
    const live = calClients();
    const wrap = el('div', 'hq-owed');
    wrap.setAttribute('aria-label', 'Deliverables this month');
    if (!live.length) { show(wrap, false); return wrap; }
    for (const c of live) {
      const d = deliverablesFor(c);
      const a = el('a', `hq-owed-item${d.off ? ' hq-owed-off' : ''}`);
      a.href = `#/clients/${c.slug}`;
      const dot = el('span', `pt-chip-who pt-cc-${clientColor(c.slug)}`);
      dot.setAttribute('aria-hidden', 'true');
      a.append(dot, el('span', 'hq-owed-who', c.artist),
               el('span', 'hq-owed-n', d.label));
      a.title = d.off
        ? `${c.artist}: ${d.total} of our posts dated in ${d.month}. `
          + `A month should hold between ${DELIVERABLES_MIN} and ${DELIVERABLES_MAX}.`
        : `${c.artist}: ${d.posted} of ${d.total} out so far this month.`;
      wrap.appendChild(a);
    }
    return wrap;
  }

  /** Shows and releases across every client, next fortnight. */
  function strip(): HTMLElement {
    const byId = new Map(clients().map((c) => [c.pageId, c]));
    const items = stripItems(HQ?.calendar ?? [], byId);

    if (!items.length) {
      return el('div', 'hq-strip-empty', 'No show or release in the next fortnight.');
    }

    const wrap = el('div', 'hq-strip');
    wrap.setAttribute('aria-label', 'Shows and releases, next fortnight');
    for (const it of items) {
      const a = el('a', `hq-strip-item hq-strip-${it.momentType === 'Show' ? 'show' : 'release'}`);
      a.href = `/portal/${it.clientSlug}#calendar`;
      a.append(
        el('div', 'hq-strip-when', stripWhen(it)),
        el('div', 'hq-strip-title', it.title),
        el('div', 'hq-strip-client',
          it.venueCity ? `${it.clientName} · ${it.venueCity}` : it.clientName),
      );
      wrap.appendChild(a);
    }
    return wrap;
  }

  function todayBar(): HTMLElement {
    const bar = el('div', 'hq-bar');
    bar.appendChild(el('h1', undefined, 'Today'));

    const seg = el('div', 'hq-seg');
    seg.setAttribute('role', 'group');
    seg.setAttribute('aria-label', 'Whose work to show');
    const opts: Array<[HqFilter, string]> = [
      ['mine', 'Mine'], ['clients', "Clients'"], ['all', 'All'],
    ];
    for (const [value, label] of opts) {
      const b = el('button', undefined, label);
      b.type = 'button';
      b.setAttribute('aria-pressed', String(FILTER === value));
      b.addEventListener('click', () => {
        FILTER = value;
        draw('today');
      });
      seg.appendChild(b);
    }
    bar.appendChild(seg);

    const grp = el('div', 'hq-seg');
    grp.setAttribute('role', 'group');
    grp.setAttribute('aria-label', 'Group by');
    for (const [value, label] of [['date', 'Date'], ['campaign', 'Campaign']] as Array<[GroupBy, string]>) {
      const b = el('button', undefined, label);
      b.type = 'button';
      b.setAttribute('aria-pressed', String(GROUP === value));
      b.addEventListener('click', () => {
        GROUP = value;
        saveHqPrefs();
        draw('today');
      });
      grp.appendChild(b);
    }
    bar.append(el('span', 'hq-bar-label', 'Group by'), grp);
    return bar;
  }

  function section(title: string, rows: HqRow[], overdue = false): HTMLElement {
    const sec = el('section', `hq-sec${overdue ? ' hq-sec-overdue' : ''}`);
    const head = el('div', 'hq-sec-head');
    head.append(el('h2', undefined, title), el('span', 'hq-sec-count', String(rows.length)));
    sec.appendChild(head);

    const list = el('div', 'hq-list');
    for (const r of rows) list.appendChild(rowNode(r));
    sec.appendChild(list);
    return sec;
  }

  /**
   * The campaign a row belongs to: its name, its date, its colour.
   *
   * A link, into that client's own calendar with the campaign already
   * filtered, which is the nearest thing to "open that moment" that
   * exists: the moment and its whole rollout, in one view.
   */
  function campChip(m: HqMomentRef): HTMLElement {
    const kind = (m.type ?? '').toLowerCase().includes('show') ? 'show'
      : (m.type ?? '').toLowerCase().includes('release') ? 'release'
      : 'other';
    const a = el('a', `hq-camp hq-camp-${kind}`);
    a.href = `/portal/${encodeURIComponent(m.clientSlug)}#/calendar/${encodeURIComponent(m.id)}`;
    a.title = m.type ? `${m.type}: ${m.title}` : m.title;
    a.appendChild(el('span', 'hq-camp-n', m.title));
    if (m.date) a.appendChild(el('span', 'hq-camp-d', shortDay(m.date)));
    return a;
  }

  function rowNode(r: HqRow): HTMLElement {
    const row = el('div', 'hq-row');
    row.dataset.key = r.key;

    // The tick box, but only where the server would accept one.
    if (r.tickTo) {
      const tick = el('button', 'hq-tick');
      tick.type = 'button';
      tick.setAttribute('aria-pressed', 'false');
      tick.setAttribute('aria-label', `Mark "${r.title}" done`);
      tick.appendChild(icon('check'));
      tick.addEventListener('click', () => void doTick(row, r));
      row.appendChild(tick);
    } else {
      row.appendChild(el('div', 'hq-tick-none'));
    }

    const main = el('div', 'hq-row-main');
    main.appendChild(el('div', 'hq-row-title', r.title));
    // Notes, under the title, because that is where the reason a step
    // moved is written and it is the thing you want without opening
    // Notion. One line: CSS cuts it, so a note with room to spare is
    // not given an ellipsis it did not need.
    if (r.notes) main.appendChild(el('div', 'hq-row-note', r.notes));

    const meta = el('div', 'hq-row-meta');
    const chip = el('a', 'hq-client', r.clientName);
    chip.href = `/portal/${r.clientSlug}`;
    meta.appendChild(chip);
    meta.appendChild(el('span', `hq-own hq-own-${r.owner}`,
      r.owner === 'blueprint' ? 'Blueprint' : 'Client'));
    if (r.type) meta.appendChild(el('span', 'hq-type', r.type));
    // Owner says whose it is; Flow says what kind of job it is. The
    // two together are the whole answer to "what am I looking at".
    if (r.flow) meta.appendChild(el('span', 'hq-flow', r.flow));
    // Grouping by campaign already says which one every row in the
    // section belongs to, so the chip would be the same word repeated
    // down the list.
    if (r.moment && GROUP !== 'campaign') meta.appendChild(campChip(r.moment));
    const when = whenLabel(r.date);
    meta.appendChild(el('span', `hq-when${when.late ? ' hq-when-late' : ''}`, when.text));
    main.appendChild(meta);
    row.appendChild(main);

    const acts = el('div', 'hq-row-acts');
    if (r.snoozable) addSnooze(acts, row, r);
    row.appendChild(acts);

    return row;
  }

  /* ── snooze ──────────────────────────────────────────────────── */

  function closeMenus() {
    for (const m of qq('.hq-menu')) m.hidden = true;
  }

  /** Appends the button and its menu straight onto the actions cell,
   *  which is the positioned ancestor the menu hangs off. */
  function addSnooze(acts: HTMLElement, row: HTMLElement, r: HqRow) {
    const btn = el('button', 'pt-btn pt-btn-icon');
    btn.type = 'button';
    btn.title = 'Snooze';
    btn.setAttribute('aria-label', `Snooze "${r.title}"`);
    btn.appendChild(icon('clock'));

    const menu = el('div', 'hq-menu');
    menu.hidden = true;

    const option = (label: string, days: number) => {
      const b = el('button', undefined, label);
      b.type = 'button';
      b.addEventListener('click', () => {
        closeMenus();
        void doSnooze(row, r, snoozeTo(r.date, days));
      });
      return b;
    };
    menu.append(option('Tomorrow', 1), option('Next week', 7));
    menu.appendChild(el('div', 'hq-menu-sep'));

    const pick = el('label', 'hq-menu-pick');
    pick.appendChild(el('span', undefined, 'Pick a date'));
    const input = el('input');
    input.type = 'date';
    input.value = r.date;
    // Nothing on this calendar is in the past on purpose, and a
    // snooze backwards is not a snooze.
    input.min = isoToday();
    input.addEventListener('change', () => {
      const v = input.value;
      if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
      closeMenus();
      void doSnooze(row, r, v);
    });
    pick.appendChild(input);
    menu.appendChild(pick);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = !menu.hidden;
      closeMenus();
      menu.hidden = wasOpen;
    });

    acts.append(btn, menu);
  }

  /* ── the writes ──────────────────────────────────────────────── */

  async function patch(url: string, body: unknown): Promise<boolean> {
    try {
      const res = await fetch(url, {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      return res.ok;
    } catch {
      return false;
    }
  }

  /** Where a tick goes, by kind. The portal's own endpoints for a step
   *  and a content card; HQ's for a next action, which lives on the
   *  Clients row and has no status to write. */
  function tickRequest(r: HqRow): { url: string; body: unknown } {
    if (r.kind === 'step') {
      return { url: `/portal/${r.clientSlug}/step/${r.id}`, body: { status: 'Done' } };
    }
    if (r.kind === 'content') {
      return { url: `/portal/${r.clientSlug}/content/${r.id}`, body: { status: 'Posted' } };
    }
    return { url: `/portal/hq/client/${r.id}`, body: { nextActionDate: null } };
  }

  function snoozeRequest(r: HqRow, to: string): { url: string; body: unknown } {
    if (r.kind === 'step') {
      return { url: `/portal/${r.clientSlug}/step/${r.id}`, body: { date: to } };
    }
    if (r.kind === 'content') {
      return { url: `/portal/${r.clientSlug}/content/${r.id}`, body: { postDate: to } };
    }
    return { url: `/portal/hq/client/${r.id}`, body: { nextActionDate: to } };
  }

  async function doTick(row: HTMLElement, r: HqRow) {
    row.dataset.busy = 'true';
    const { url, body } = tickRequest(r);
    const ok = await patch(url, body);
    delete row.dataset.busy;

    if (!ok) {
      toast(`That did not save. ${r.clientName}'s row is unchanged.`, true);
      return;
    }

    // The payload is edited in place rather than refetched. A refetch
    // would be a full read of five Notion databases to learn one thing
    // we already know, and the ninety-second cache would hand back the
    // old answer anyway.
    applyTick(r);
    toast('Done.');
    draw('today');
  }

  async function doSnooze(row: HTMLElement, r: HqRow, to: string) {
    row.dataset.busy = 'true';
    const { url, body } = snoozeRequest(r, to);
    const ok = await patch(url, body);
    delete row.dataset.busy;

    if (!ok) {
      toast(`That did not save. ${r.clientName}'s row is unchanged.`, true);
      return;
    }

    applyDate(r, to);
    toast(`Moved to ${shortDay(to)}.`);
    draw('today');
  }

  function applyTick(r: HqRow) {
    if (r.kind === 'step') {
      const it = (HQ?.calendar ?? []).find((x: any) => x.id === r.id);
      if (it) it.status = 'Done';
      return;
    }
    if (r.kind === 'content') {
      const it = (HQ?.content ?? []).find((x: any) => x.id === r.id);
      if (it) it.status = 'Posted';
      return;
    }
    const c = (HQ?.clients ?? []).find((x: any) => x.pageId === r.id);
    if (c) c.nextActionDate = null;
  }

  function applyDate(r: HqRow, to: string) {
    if (r.kind === 'step') {
      const it = (HQ?.calendar ?? []).find((x: any) => x.id === r.id);
      if (it) it.date = to;
      return;
    }
    if (r.kind === 'content') {
      const it = (HQ?.content ?? []).find((x: any) => x.id === r.id);
      if (it) it.postDate = to;
      return;
    }
    const c = (HQ?.clients ?? []).find((x: any) => x.pageId === r.id);
    if (c) c.nextActionDate = to;
  }

  /* ══ SEARCH ═════════════════════════════════════════════════ */

  const MAX_RESULTS = 12;

  interface Hit { what: string; title: string; who: string; href: string; }

  function searchAll(raw: string): Hit[] {
    const term = raw.trim().toLowerCase();
    if (term.length < 2) return [];
    const hits: Hit[] = [];
    const byId = new Map(clients().map((c) => [c.pageId, c]));

    for (const c of clients()) {
      if (c.artist.toLowerCase().includes(term)) {
        hits.push({
          what: 'Client', title: c.artist, who: c.stage ?? '',
          href: `/portal/${c.slug}`,
        });
      }
    }
    for (const m of (HQ?.calendar ?? [])) {
      if (!m.title || !m.title.toLowerCase().includes(term)) continue;
      const c = m.clientId ? byId.get(m.clientId) : null;
      if (!c) continue;
      hits.push({
        what: m.kind === 'Moment' ? 'Moment' : 'Step', title: m.title,
        who: c.artist, href: `/portal/${c.slug}#calendar`,
      });
    }
    for (const p of (HQ?.content ?? [])) {
      if (!p.title || !p.title.toLowerCase().includes(term)) continue;
      const c = p.clientId ? byId.get(p.clientId) : null;
      if (!c) continue;
      hits.push({
        what: 'Content', title: p.title, who: c.artist,
        href: `/portal/${c.slug}#content`,
      });
    }

    return hits.slice(0, MAX_RESULTS);
  }

  function wireSearch() {
    const input = q<HTMLInputElement>('[data-q]');
    const panel = q('[data-results]');
    if (!input || !panel) return;

    const render = () => {
      const hits = searchAll(input.value);
      clear(panel);

      if (input.value.trim().length < 2) { panel.hidden = true; return; }

      if (!hits.length) {
        panel.appendChild(el('div', 'hq-results-none', 'Nothing matches.'));
        panel.hidden = false;
        return;
      }

      for (const h of hits) {
        const a = el('a', 'hq-result');
        a.href = h.href;
        a.append(
          el('span', 'hq-result-what', h.what),
          el('span', 'hq-result-title', h.title),
          el('span', 'hq-result-who', h.who),
        );
        panel.appendChild(a);
      }
      panel.hidden = false;
    };

    input.addEventListener('input', render);
    input.addEventListener('focus', render);
    // Escape closes it and gives the box back, which is what a search
    // field that covers the page has to do.
    input.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') { panel.hidden = true; input.blur(); }
    });
  }

  /* ── boot ────────────────────────────────────────────────────── */

  async function boot() {
    // Before the first draw, so Today opens the way it was left.
    loadHqPrefs();
    const started = performance.now();
    let res: Response;
    try {
      res = await fetch('/portal/hq/data', { credentials: 'same-origin' });
    } catch {
      show(q('[data-state="loading"]'), false);
      show(q('[data-state="locked"]'), true);
      return;
    }

    if (!res.ok) {
      show(q('[data-state="loading"]'), false);
      show(q('[data-state="locked"]'), true);
      return;
    }

    HQ = await res.json();
    const ms = Math.round(performance.now() - started);

    const who = q('[data-who]');
    if (who) who.textContent = String(HQ?.viewer?.email ?? '');

    // The spec asks for page load timing, so it is on the page rather
    // than in a console nobody has open: server time as the endpoint
    // measured it, and the round trip as the browser saw it.
    const timing = q('[data-timing]');
    if (timing) {
      const server = Number(HQ?.timing?.totalMs ?? 0);
      timing.textContent = `${ms}ms · server ${server}ms${HQ?.timing?.cached ? ' · cached' : ''}`;
    }

    show(q('[data-state="loading"]'), false);
    show(q('[data-app]'), true);
    wireSearch();
    bindSheet();
    q('[data-drawer-close]')?.addEventListener('click', closeCalDrawer);
    q('[data-scrim]')?.addEventListener('click', closeCalDrawer);

    // One listener for every menu on the page, rather than one per
    // row: a click anywhere else closes whatever is open.
    document.addEventListener('click', (e) => {
      const t = e.target as Element | null;
      if (t && t.closest('.hq-menu')) return;
      closeMenus();
      const panel = q('[data-results]');
      if (panel && t && !t.closest('[data-search]')) panel.hidden = true;
    });

    window.addEventListener('hashchange', route);
    route();
  }

  void boot();
</script>
