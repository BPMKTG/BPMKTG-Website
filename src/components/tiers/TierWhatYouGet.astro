---
import type { TierCard } from '../../data/tiers';

// Generic 3-col deliverable-card grid. Used for "What's Included" on
// tier pages and for "Coverage Formats" + "Deliverable Examples" on
// the Event Media page.
interface Props {
  eyebrow: string;
  headline: string;
  sub?: string;
  cards: TierCard[];
  id?: string;
}
const { eyebrow, headline, sub, cards, id = 'deliverables' } = Astro.props;
---
<section class="tier-deliv" id={id}>
  <div class="container">
    <header class="tier-section-head wide">
      <p class="label" data-reveal="left">{eyebrow}</p>
      <h2 data-reveal set:html={headline}></h2>
      {sub && <p class="tier-section-sub" data-reveal>{sub}</p>}
    </header>

    <div class="tier-deliv-grid" data-reveal-group>
      {cards.map((c, i) => (
        <article class:list={["tier-deliv-card card-trace card-inner-glow", { "is-soon": c.badge }]} data-reveal data-scroll-focus>
          <div class="tier-deliv-top">
            <span class="tier-deliv-num" data-icon-pop>{String(i + 1).padStart(2, '0')}</span>
            {c.badge && <span class="tier-deliv-badge">{c.badge}</span>}
          </div>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* This is the centerpiece of a tier page — keep card density high,
     but tighten outer breathing room. */
  .tier-deliv { padding: 4rem 0; position: relative; isolation: isolate; }
  .tier-section-head { max-width: 60ch; margin-bottom: 2.25rem; }
  .tier-section-head.wide { max-width: 70ch; }
  .tier-section-head h2 { margin-top: 0.85rem; text-wrap: balance; }
  .tier-section-sub { color: var(--ink); opacity: 0.78; font-size: 1rem; margin-top: 0.85rem; max-width: 60ch; }

  .tier-deliv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .tier-deliv-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.3s ease;
  }
  .tier-deliv-card:hover {
    border-color: rgba(98, 166, 219, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -22px rgba(0, 0, 0, 0.6);
  }
  .tier-deliv-card::before {
    content: "";
    position: absolute; inset: -1px -1px auto -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--bp-blue), transparent);
    opacity: 0.55;
  }
  .tier-deliv-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .tier-deliv-num {
    font-family: var(--font-display);
    color: var(--bp-blue);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
  }
  /* "Coming Soon" chip + dimmed treatment for not-yet-available cards. */
  .tier-deliv-badge {
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bp-light);
    background: rgba(98, 166, 219, 0.12);
    border: 1px solid rgba(98, 166, 219, 0.45);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    white-space: nowrap;
  }
  .tier-deliv-card.is-soon {
    opacity: 0.62;
    border-style: dashed;
  }
  .tier-deliv-card.is-soon::before { opacity: 0.25; }
  .tier-deliv-card h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }
  .tier-deliv-card p { color: var(--muted); font-size: 0.92rem; line-height: 1.55; }

  @media (max-width: 980px) { .tier-deliv-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .tier-deliv-grid { grid-template-columns: 1fr; } }
</style>
