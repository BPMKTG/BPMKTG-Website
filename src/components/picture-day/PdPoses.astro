---
// 4 · Example poses, in the three groups a parent shops by.
//
// Team shots, individual poses, buddy poses. Each group is its own
// uniform grid: the team frames are 3:2 and everything else is 2:3,
// and the tiles are set to the matching aspect-ratio, so object-fit
// has nothing to crop. That is also why there is no per-photo focus
// value any more; there is no crop to steer.
//
// Same convention as the wedding gallery: drop a file in
// src/assets/images/picture-day/ and add a row to the right list in
// src/data/picture-day.ts. A row with no file renders a placeholder
// rather than collapsing the grid, and the whole section hides itself
// while no real photo exists at all.
//
// The lightbox is indexed across every group, so Next walks the team
// shots into the individuals and on into the buddies, which is what
// someone browsing expects.
import { Image, getImage } from 'astro:assets';
import { photoGroups } from '../../data/picture-day';

const glob = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/picture-day/*.{jpg,jpeg,png}',
  { eager: true }
);

const bySlug: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(glob)) {
  const slug = path.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, '');
  bySlug[slug] = mod.default;
}

// One running index across all three groups, so the lightbox can walk
// the whole gallery in page order.
let n = 0;
const groups = await Promise.all(
  photoGroups.map(async group => ({
    ...group,
    tiles: await Promise.all(
      group.photos.map(async photo => {
        const src = bySlug[photo.slug];
        return {
          ...photo,
          src,
          index: src ? n++ : -1,
          full: src
            ? (await getImage({ src, width: 1600, format: 'webp', quality: 86 })).src
            : undefined,
        };
      })
    ),
  }))
);

const live = groups.filter(g => g.tiles.some(t => t.src));
---
{live.length > 0 && (
  <section class="pd-section" id="poses">
    <div class="pd-wrap">
      <header class="pd-head">
        <p class="pd-eyebrow" data-reveal>Example poses</p>
        <h2 class="pd-h2 pd-ruled" data-reveal style="--reveal-delay:.05s">Pick a look</h2>
        <p class="pd-lede" data-reveal style="--reveal-delay:.08s">
          Poses from recent Blueprint shoots, cheer and otherwise, so you
          can see what reads well on camera. Come with one in mind or
          choose at the table. Tap any photo to see it bigger.
        </p>
      </header>

      {live.map(group => (
        <section class="pd-group" aria-labelledby={`grp-${group.id}`}>
          <h3 class="pd-group-head" id={`grp-${group.id}`} data-reveal>
            <span class="pd-group-name">{group.label}</span>
            <span class="pd-group-rule" aria-hidden="true"></span>
            <span class="pd-group-count">{group.tiles.filter(t => t.src).length}</span>
          </h3>

          <div class:list={['pd-collage', { 'pd-collage-wide': group.wide }]}>
            {group.tiles.map(tile => (
              tile.src ? (
                <button
                  type="button"
                  class="pd-tile"
                  data-pd-photo
                  data-full={tile.full}
                  data-caption={tile.alt}
                  aria-label={`See a larger view: ${tile.alt}`}
                >
                  <Image
                    src={tile.src}
                    alt={tile.alt}
                    widths={group.wide ? [460, 920, 1380] : [280, 560, 840]}
                    sizes={group.wide
                      ? '(max-width: 760px) 100vw, 50vw'
                      : '(max-width: 520px) 50vw, (max-width: 980px) 33vw, 25vw'}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ) : (
                <div class="pd-tile pd-tile-empty" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                       stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <circle cx="12" cy="12" r="3.2" />
                  </svg>
                  <span>Coming soon</span>
                </div>
              )
            ))}
          </div>
        </section>
      ))}
    </div>

    {/* Same shape as the wedding gallery's: a real <dialog>, so Escape,
        the backdrop and focus trapping are the platform's job. */}
    <dialog class="pd-lb" data-pd-lb aria-label="Larger view of the photo">
      <img data-pd-lb-img src="" alt="" />
      <div class="pd-lb-bar">
        <p class="pd-lb-cap" data-pd-lb-cap></p>
        <div class="pd-lb-nav">
          <button type="button" class="pd-lb-btn" data-pd-lb-prev aria-label="Previous photo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <button type="button" class="pd-lb-btn" data-pd-lb-next aria-label="Next photo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </button>
          <button type="button" class="pd-lb-btn" data-pd-lb-close aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
      </div>
    </dialog>
  </section>
)}
