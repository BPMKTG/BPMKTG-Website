---
// 3 · Packages.
//
// One side, not two. The cards keep the entrance the rest of the site
// uses — the one-time 3D swing-in on scroll from OfferStack and
// WedPackages, staggered on a private --card-flip-delay — but there is
// no flip and nothing hidden behind it. A parent reads the price and
// what they get without tapping anything, which is what they came for.
//
// Worth knowing if you ever bring the two-sided version back: Safari
// ignores backface-visibility when transform-style: preserve-3d sits
// on a grid container and paints the rotated back face, mirrored, over
// the front. Driving the swap from `visibility` instead is what fixed
// it. See the git history on this file.
import { packages, ORDER_FORM_URL, addOns } from '../../data/picture-day';
---
<section class="pd-section" id="packages">
  <div class="pd-wrap">
    <header class="pd-head">
      <p class="pd-eyebrow" data-reveal>Packages</p>
      <h2 class="pd-h2 pd-ruled" data-reveal style="--reveal-delay:.05s">Pick a package</h2>
      <p class="pd-lede" data-reveal style="--reveal-delay:.08s">
        Every package includes the team photo. Add-ons are below,
        and you add them to your order form when you fill it out.
      </p>
    </header>

    <div class="pd-cards">
      {packages.map((pkg, i) => (
        <article
          class:list={['pd-card', { 'pd-card-pop': pkg.popular }]}
          data-reveal="flip"
          style={`--card-flip-delay:${i * 0.3}s`}
        >
          {pkg.popular && <span class="pd-badge">Most Popular</span>}

          <p class="pd-pkg-backdrop">{pkg.backdrop}</p>
          <h3 class="pd-pkg-name">{pkg.name}</h3>
          <p class="pd-price">{pkg.price}</p>

          <ul class="pd-includes">
            {pkg.includes.map(line => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" />
                </svg>
                <span>{line}</span>
              </li>
            ))}
          </ul>

          <p class="pd-card-foot">
            <a class="pt-btn pt-btn-primary" href={ORDER_FORM_URL}
               target="_blank" rel="noopener">
              Order this package
            </a>
          </p>
        </article>
      ))}
    </div>

    <div class="pd-addons" data-reveal>
      <span class="pd-addons-label">Add-ons</span>
      {addOns.map(a => (
        <span class="pd-addon">
          <span class="pd-addon-label">{a.label}</span>
          <span class="pd-addon-price">{a.price}</span>
        </span>
      ))}
    </div>
  </div>
</section>
