---
// Three-package offer stack — the wedding analogue of the homepage's
// OfferStack, retuned light: white cards, hairline rules, a gold-edged
// featured card instead of the animated conic-gradient border.
import { packages, WEDDING_CALENDLY_URL } from '../../data/weddings';
---
<section class="packages wed-section wed-grid-bg" id="packages">
  <div class="wed-container">
    <header class="head">
      <p class="wed-label wed-label--center" data-reveal>Packages</p>
      <h2 data-reveal>Three ways to <em class="script">book us.</em></h2>
      <p class="wed-lede" data-reveal>
        Every package below is film-led, because that is what we have spent
        years doing. Photo can be added to any of them, or built into
        The Legacy, where one crew covers both.
      </p>
    </header>

    <div class="cards" data-reveal-group>
      {packages.map(pkg => (
        <article class:list={['card', { 'card--featured': pkg.featured }]} data-reveal="flip" data-wed-focus>
          {pkg.featured && <span class="ribbon">Most booked</span>}

          <p class="eyebrow">{pkg.eyebrow}</p>
          <h3>{pkg.name}</h3>
          <p class="positioning">{pkg.positioning}</p>

          <div class="price">
            <span class="price-num">{pkg.price}</span>
            <span class="price-cadence">{pkg.cadence}</span>
          </div>

          <p class="best-for"><span>Best for</span> {pkg.bestFor}</p>

          <ul class="includes">
            {pkg.includes.map(item => (
              <li>
                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true">
                  <path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <a
            href={WEDDING_CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['wed-btn', 'card-cta', pkg.featured ? 'wed-btn--gold' : 'wed-btn--ghost']}
          >
            Check your date
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <p class="note" data-reveal>
      Every package includes a planning call, a written coverage plan, licensed
      music, and a private online gallery you can share with anyone.
      Travel within 90 miles is included.
    </p>
  </div>
</section>

<style>
  .packages { background: var(--wed-bg); }
  .head { max-width: 60ch; margin: 0 auto 3.5rem; text-align: center; }
  .head h2 { margin: 1.1rem 0 1.4rem; }
  .head .wed-lede { margin: 0 auto; }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    /* One shared camera, so all three cards spin toward the same vanishing
       point instead of each pivoting in its own little box. */
    perspective: 1900px;
    perspective-origin: center 40%;
  }
  /* Sequential deal-in. Slower stagger than the EDM stack (0.3s) so the
     three cards read as one unhurried gesture rather than a dealt hand. */
  .card:nth-child(1) { --reveal-delay: 0s; }
  .card:nth-child(2) { --reveal-delay: 0.26s; }
  .card:nth-child(3) { --reveal-delay: 0.52s; }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--wed-card);
    border: 1px solid var(--wed-line-soft);
    border-radius: var(--wed-radius-lg);
    padding: 2.25rem 1.9rem 2rem;
    box-shadow: 0 24px 55px -45px rgba(35, 42, 59, 0.6);
    /* All four properties are named HERE, in one declaration, because this
       scoped rule out-specifies `[data-reveal="flip"]` in wedding.css and
       would otherwise replace its transition wholesale, leaving the cards
       to snap into place with no spin at all.
       Note hover moves border and shadow only, never transform: sharing
       the transform property would cut the 1.5s spin to the hover
       duration. (The EDM tier cards don't lift on hover for the same
       reason.) */
    transition:
      opacity 1.5s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
      transform 1.5s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
      box-shadow 0.45s ease,
      border-color 0.35s ease;
  }
  .card:hover,
  .card.is-focus {
    border-color: rgba(38, 79, 160, 0.28);
    box-shadow: 0 34px 70px -45px rgba(35, 42, 59, 0.65);
  }
  .card--featured:hover,
  .card--featured.is-focus {
    border-color: rgba(176, 141, 79, 0.7);
    box-shadow: 0 34px 70px -42px rgba(176, 141, 79, 0.65);
  }

  /* Featured card: a warm gold edge + champagne wash instead of the EDM
     site's animated conic border. Same job, quieter voice. */
  .card--featured {
    border-color: rgba(176, 141, 79, 0.45);
    background:
      linear-gradient(180deg, rgba(242, 232, 214, 0.55) 0%, #ffffff 45%),
      var(--wed-card);
    box-shadow: 0 30px 70px -42px rgba(176, 141, 79, 0.55);
  }
  .ribbon {
    position: absolute;
    top: -0.72rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--wed-gold);
    color: #fff;
    padding: 0.3rem 0.95rem;
    border-radius: 999px;
    font-family: var(--wed-display);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .eyebrow {
    font-family: var(--wed-display);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--wed-navy);
  }
  .card--featured .eyebrow { color: var(--wed-gold); }

  .card h3 {
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    font-weight: 400;
    line-height: 1.05;
  }
  .positioning {
    font-family: var(--wed-serif);
    font-size: 1.1rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
    color: var(--wed-ink-2);
    /* Lock to three lines so the price rule sits level across all cards. */
    min-height: calc(1.4em * 3);
  }

  .price {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.1rem 0;
    margin-top: 0.25rem;
    border-top: 1px solid var(--wed-line-soft);
    border-bottom: 1px solid var(--wed-line-soft);
  }
  .price-num {
    font-family: var(--wed-serif);
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1;
    color: var(--wed-ink);
  }
  .price-cadence {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--wed-muted);
  }

  .best-for {
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--wed-muted);
    min-height: calc(1.55em * 3);
  }
  .best-for span {
    display: block;
    font-family: var(--wed-display);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--wed-gold);
    margin-bottom: 0.35rem;
  }

  .includes {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .includes li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--wed-ink-2);
  }
  .includes svg {
    flex-shrink: 0;
    margin-top: 0.28rem;
    color: var(--wed-navy);
  }
  .card--featured .includes svg { color: var(--wed-gold); }

  .card-cta { margin-top: 1.5rem; width: 100%; }

  .note {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--wed-muted);
    max-width: 68ch;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; }
    .positioning, .best-for { min-height: 0; }
  }
  @media (max-width: 760px) {
    /* Match the slide-up fallback wedding.css uses at this width. */
    .card {
      transition:
        opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
        transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
        box-shadow 0.45s ease,
        border-color 0.35s ease;
    }
    .card:nth-child(2) { --reveal-delay: 0.12s; }
    .card:nth-child(3) { --reveal-delay: 0.24s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { opacity: 1; transform: none; transition: none; }
  }
</style>
