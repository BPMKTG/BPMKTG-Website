---
// The offer, stated plainly, directly under the hero.
//
// This section exists because the Irresistible Offer Formula doc makes the
// his & hers crew the load-bearing idea: it is simultaneously the USP, the
// hook, the comfort guarantee, and the answer to the two biggest
// objections ("a stranger of the wrong gender in the room" and "things got
// missed while you were on the other side of the venue"). The page used to
// jump straight from the hero into the films, which meant a couple could
// scroll the whole gallery without ever learning what actually makes this
// team different.
//
// Each card is a pain from that doc, answered.
import { WEDDING_CALENDLY_URL } from '../../data/weddings';

const cards = [
  {
    label: 'His',
    title: 'A guy with the groomsmen',
    body: 'Mason is in that room the whole morning, shooting photo and video both. The groom\'s side is usually what gets skipped, because one vendor cannot be in two places. Yours is not something we catch up with on the way to the ceremony.',
  },
  {
    label: 'Hers',
    title: 'A girl with the bridesmaids',
    body: 'Makenzie is in that room all morning, also shooting both. The hour before you walk down the aisle is the most unguarded of the day, and it should not be the hour you spend aware of a stranger with a camera.',
  },
  {
    label: 'Both',
    title: 'Together for the rest of it',
    body: 'Once the two of you are in the same room we go back to our lanes: Makenzie on photo, Mason on video. One team who already knows the whole plan, not two vendors meeting for the first time at your venue.',
  },
];
---
<section class="both wed-section wed-grid-bg" id="both-sides">
  <div class="wed-container">
    <header class="head">
      <p class="wed-label wed-label--center" data-reveal>The Difference</p>
      <h2 data-reveal>Every part of your day.<br /><em class="script">Both sides of it.</em></h2>
      <p class="wed-lede" data-reveal>
        Most wedding coverage is one person choosing which half of your morning
        to be in. We are a married couple who both shoot, which means both halves
        happen at once, and neither one is a stranger.
      </p>
    </header>

    <div class="cards" data-reveal-group>
      {cards.map(card => (
        <article class="card" data-reveal="deal" data-wed-focus>
          <p class="card-label">{card.label}</p>
          <h3>{card.title}</h3>
          <p class="card-body">{card.body}</p>
        </article>
      ))}
    </div>

    <a href={WEDDING_CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="line" data-reveal>
      <span class="line-dot" aria-hidden="true"></span>
      <span class="line-text">
        <strong>One wedding per weekend.</strong> When it is yours, it is the only
        one we are thinking about.
      </span>
      <span class="line-arrow" aria-hidden="true">&#8594;</span>
    </a>
  </div>
</section>

<style>
  .both { background: var(--wed-bg-2); }
  .head { max-width: 62ch; margin: 0 auto 3.5rem; text-align: center; }
  .head h2 { margin: 1.1rem 0 1.4rem; }
  .head .wed-lede { margin: 0 auto; }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    perspective: 1800px;
    perspective-origin: center 35%;
  }
  .card {
    background: var(--wed-card);
    border: 1px solid var(--wed-line-soft);
    border-radius: var(--wed-radius-lg);
    padding: 2rem 1.85rem 2.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    box-shadow: 0 24px 55px -48px rgba(35, 42, 59, 0.6);
    /* Deal-in timing is declared here, not in wedding.css: a scoped
       component rule out-specifies [data-reveal="deal"] and would replace
       its transition wholesale. Hover moves border and shadow only, never
       transform, which the reveal owns. */
    transition:
      opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
      transform 1.2s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
      box-shadow 0.35s ease,
      border-color 0.3s ease;
  }
  .card:hover,
  .card.is-focus {
    border-color: rgba(38, 79, 160, 0.24);
    box-shadow: 0 32px 66px -46px rgba(35, 42, 59, 0.62);
  }

  .card-label {
    font-family: var(--wed-display);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--wed-gold);
  }
  .card h3 {
    font-size: clamp(1.4rem, 2.1vw, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--wed-ink);
  }
  .card-body {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--wed-muted);
  }

  /* Scarcity line, pulled from USP option 5. Reads as a note, not a card. */
  .line {
    margin: 3rem auto 0;
    max-width: 62ch;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.35rem;
    border: 1px solid rgba(176, 141, 79, 0.4);
    border-radius: 999px;
    background: rgba(242, 232, 214, 0.45);
    font-size: 0.94rem;
    line-height: 1.45;
    color: var(--wed-ink-2);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .line:hover {
    background: rgba(242, 232, 214, 0.8);
    border-color: rgba(176, 141, 79, 0.7);
    transform: translateY(-1px);
  }
  .line-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--wed-gold);
    flex-shrink: 0;
  }
  .line-text { flex: 1; }
  .line-text strong { color: var(--wed-ink); font-weight: 500; }
  .line-arrow {
    color: var(--wed-gold);
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .line:hover .line-arrow { transform: translateX(4px); }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; }
  }
  @media (max-width: 760px) {
    .card {
      transition:
        opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
        transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
        box-shadow 0.35s ease,
        border-color 0.3s ease;
    }
  }
  @media (max-width: 520px) {
    .line { border-radius: var(--wed-radius); align-items: flex-start; }
    .line-arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { opacity: 1; transform: none; transition: border-color 0.3s ease, box-shadow 0.35s ease; }
    .line, .line-arrow { transition: none; }
    .line:hover { transform: none; }
  }
</style>
