---
// Risk reversal, sitting directly under the pricing where the hesitation
// actually happens.
//
// Only the guarantees marked confirmed in the offer doc are here. The
// backup-shooter guarantee is deliberately absent: the GUARANTEE page
// flags it as not yet confirmed and says only to promise it if a real
// backup plan exists. (The older OBJECTIONS page does use that line in a
// sales-call script. Do not put it on the site until someone confirms the
// arrangement is real.)
const guarantees = [
  {
    title: 'Delivery, in writing',
    body: 'Your teaser within 72 hours. Your full film and gallery within six weeks. You get the date when you book, not a vague "sometime in the spring".',
  },
  {
    title: 'A reply within one business day',
    body: 'Every inquiry, every question after you book. You will never be the couple wondering whether their vendor went dark.',
  },
  {
    title: 'Nobody unexpected in the room',
    body: 'On the two- and three-person crews, a guy is with the groomsmen and a girl is with the bridesmaids. You never have to think about who is standing there.',
  },
  {
    title: 'Revised until it is right',
    body: 'If your film or gallery does not match the style we agreed on, we keep working on it until it does.',
  },
];
---
<section class="guarantee wed-section" id="guarantee">
  <div class="wed-container">
    <header class="head">
      <p class="wed-label wed-label--center" data-reveal>Our Promise</p>
      <h2 data-reveal>There is no <em class="script">reshoot day.</em></h2>
      <p class="wed-lede" data-reveal>
        Which is exactly why the parts you are worried about are the parts we
        put in writing.
      </p>
    </header>

    <ul class="grid" data-reveal-group>
      {guarantees.map(item => (
        <li class="item" data-reveal>
          <span class="tick" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none">
              <path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .guarantee { background: var(--wed-bg); }
  .head { max-width: 56ch; margin: 0 auto 3rem; text-align: center; }
  .head h2 { margin: 1.1rem 0 1.3rem; }
  .head .wed-lede { margin: 0 auto; }

  .grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1040px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 3rem;
  }
  .item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--wed-line-soft);
  }
  .tick {
    flex-shrink: 0;
    width: 26px; height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(242, 232, 214, 0.9);
    border: 1px solid rgba(176, 141, 79, 0.45);
    color: var(--wed-gold);
    margin-top: 0.15rem;
  }
  .item h3 {
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--wed-ink);
    margin-bottom: 0.35rem;
  }
  .item p {
    font-size: 0.93rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--wed-muted);
  }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
