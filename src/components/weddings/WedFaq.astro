---
// FAQ — native <details>/<summary> so it works with zero JS and stays
// keyboard-accessible for free.
import { faqs } from '../../data/weddings';
---
<section class="faq wed-section" id="faq">
  <div class="wed-container inner">
    <header class="head">
      <p class="wed-label" data-reveal="left">Questions</p>
      <h2 data-reveal>Before you <em class="script">ask.</em></h2>
      <p class="wed-lede" data-reveal>
        If yours isn't here, bring it to the call. We would rather answer
        it properly than have you guess from a website.
      </p>
    </header>

    <div class="list" data-reveal-group>
      {faqs.map((item, i) => (
        <details class="qa" name="wed-faq" open={i === 0} data-reveal>
          <summary>
            <span class="q">{item.q}</span>
            <span class="chev" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--wed-bg-2); }
  .inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4rem;
    align-items: start;
  }
  .head { position: sticky; top: 6rem; }
  .head h2 { margin: 1.1rem 0 1.3rem; }

  .list { display: flex; flex-direction: column; }

  .qa {
    border-top: 1px solid var(--wed-line-soft);
  }
  .qa:last-child { border-bottom: 1px solid var(--wed-line-soft); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.25s ease;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--wed-navy); }
  .q {
    font-family: var(--wed-serif);
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
    font-weight: 500;
    line-height: 1.25;
    color: inherit;
  }
  .chev {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px; height: 30px;
    border-radius: 50%;
    border: 1px solid var(--wed-line);
    color: var(--wed-navy);
    background: rgba(255, 255, 255, 0.7);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1),
                background 0.25s ease, color 0.25s ease;
  }
  .qa[open] .chev { transform: rotate(180deg); background: var(--wed-navy); color: #fff; }

  .a { padding: 0 0 1.45rem; max-width: 62ch; }
  .a p {
    font-size: 0.98rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--wed-muted);
  }

  @media (max-width: 900px) {
    .inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .head { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chev, summary { transition: none; }
  }
</style>
