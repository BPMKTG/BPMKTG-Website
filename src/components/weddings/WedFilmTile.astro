---
// A single wedding film tile.
//
// Not a reuse of FilmTile: that component paints a dark gradient caption
// over the photo and leans on the EDM tokens. Here the caption sits
// *below* a clean frame, which is what keeps the section airy.
//
// Every tile degrades gracefully, because none of the real assets exist
// yet: no poster image renders a designed placeholder panel, and no
// vimeoId renders a non-interactive tile with a "Coming soon" badge
// rather than a button that opens an empty player.
import { Image } from 'astro:assets';

interface Props {
  slug: string;
  title: string;
  tag: string;
  category: string;
  vimeoId?: string;
  youtubeId?: string;
  preview?: string;
  orientation?: 'h' | 'v';
  posterImg?: ImageMetadata;
  /**
   * Escape hatch for a poster that is not a local asset (a YouTube
   * thumbnail, say). `posterImg` always wins, so dropping a real file in
   * replaces it without touching this.
   */
  posterUrl?: string;
  /**
   * True when `posterImg` is another film's frame borrowed via
   * `posterSlug` rather than this tile's own poster. Only the vertical
   * tiles act on it: see `letterbox` below.
   */
  posterBorrowed?: boolean;
  /**
   * Drop the title/tag caption under the frame. Used by the hero film in
   * WedFilms, where the section heading directly above already says what
   * the film is and the caption only repeated it. The title still feeds
   * the lightbox caption and the aria-label.
   */
  hideMeta?: boolean;
  feature?: boolean;
}

const {
  slug,
  title,
  tag,
  category,
  vimeoId,
  youtubeId,
  preview,
  orientation = 'h',
  posterImg,
  posterUrl,
  posterBorrowed = false,
  hideMeta = false,
  feature = false,
} = Astro.props;

// One tile, either platform. The lightbox reads provider + id off the
// dataset rather than assuming Vimeo, so adding a third host later is a
// case in one switch instead of a rewrite.
const provider = vimeoId ? 'vimeo' : youtubeId ? 'youtube' : undefined;
const videoId  = vimeoId ?? youtubeId;
const playable = Boolean(provider);
const Tag = playable ? 'button' : 'div';
// A borrowed poster is a 16:9 frame from another film. Cropping one into
// a 4:5 tile keeps under half its width, dead centre, which cuts the
// subject in two more often than not. Those tiles letterbox the whole
// frame over a blurred fill of itself instead. Real posters always cover,
// so this turns itself off the moment `thumbnails/<slug>.jpg` lands.
const letterbox = posterBorrowed && orientation === 'v';

// Match the frame's aspect ratio, or the source's when letterboxing.
// A mismatch here crops at build AND again under object-fit: cover.
const imgW = orientation === 'h' || letterbox ? 1280 : 900;
const imgH = orientation === 'h' || letterbox ? 720  : 1125;
---
<Tag
  class:list={['wtile', { 'wtile--feature': feature, 'wtile--idle': !playable }]}
  type={playable ? 'button' : undefined}
  data-orientation={orientation}
  data-slug={slug}
  data-video-provider={provider}
  data-video-id={videoId}
  data-caption={`${title} · ${tag}`}
  data-wed-video={playable ? '' : undefined}
  data-wed-focus
  aria-label={playable ? `Play ${title}` : undefined}
>
  <span class="frame">
    <span class="badge">{category}</span>

    {posterImg ? (
      letterbox ? (
        <span class="lbx">
          <Image class="lbx-fill" src={posterImg} alt="" width={320} height={180} format="webp" quality={40} loading="lazy" aria-hidden="true" />
          <Image class="lbx-img" src={posterImg} alt={title} width={imgW} height={imgH} format="webp" quality={84} loading="lazy" />
        </span>
      ) : (
        <Image src={posterImg} alt={title} width={imgW} height={imgH} format="webp" quality={84} loading="lazy" />
      )
    ) : posterUrl ? (
      <img src={posterUrl} alt={title} width={imgW} height={imgH} loading="lazy" />
    ) : (
      <span class="placeholder" aria-hidden="true">
        <svg viewBox="0 0 48 34" width="42" height="30" fill="none" stroke="currentColor" stroke-width="1.2">
          <rect x="1" y="1" width="31" height="32" rx="4" />
          <path d="M32 12.5 47 5.5v23l-15-7z" stroke-linejoin="round" />
          <circle cx="16.5" cy="17" r="6.5" />
        </svg>
        <span class="placeholder-text">Film coming soon</span>
      </span>
    )}

    {preview && (
      <video class="preview" preload="none" muted playsinline loop>
        <source src={preview} type="video/mp4" />
      </video>
    )}

    {playable && (
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><polygon points="8,5 19,12 8,19" /></svg>
      </span>
    )}
  </span>

  {!hideMeta && (
    <span class="meta">
      <span class="meta-title">{title}</span>
      <span class="meta-tag">{tag}</span>
    </span>
  )}
</Tag>

<style>
  .wtile {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    width: 100%;
    background: transparent;
    border: none;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .wtile--idle { cursor: default; }

  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--wed-radius);
    background: var(--wed-bg-2);
    border: 1px solid var(--wed-line-soft);
    aspect-ratio: 16 / 9;
    box-shadow: 0 18px 40px -34px rgba(35, 42, 59, 0.55);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.2, 0.7, 0.3, 1),
                border-color 0.4s ease;
  }
  .wtile[data-orientation="v"] .frame { aspect-ratio: 4 / 5; }
  .wtile--feature .frame { aspect-ratio: 16 / 9; border-radius: var(--wed-radius-lg); }

  .wtile:not(.wtile--idle):hover .frame,
  .wtile:not(.wtile--idle):focus-visible .frame {
    transform: translateY(-4px);
    border-color: rgba(38, 79, 160, 0.22);
    box-shadow: 0 30px 60px -36px rgba(35, 42, 59, 0.6);
  }

  .frame > :global(img),
  .preview {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .frame > :global(img) {
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.3, 1);
    /* Very slow drift so a still poster never sits completely dead.
       Alternates, so it breathes in and out rather than snapping back. */
    animation: wedKenBurns 26s ease-in-out infinite alternate;
    transform-origin: center;
  }
  /* Stagger neighbours so a row of tiles doesn't pulse in unison. */
  .wtile[data-stagger="1"] .frame > :global(img) { animation-delay: -7s; }
  .wtile[data-stagger="2"] .frame > :global(img) { animation-delay: -14s; }
  .wtile:not(.wtile--idle):hover .frame > :global(img),
  .wtile.is-focus .frame > :global(img) {
    /* Hand the transform over to the hover zoom while it's held. */
    animation-play-state: paused;
    transform: scale(1.04);
  }

  /* ── Letterboxed stand-in ──
     A borrowed 16:9 frame inside a vertical tile: contained over a
     blurred fill of itself, so the whole frame reads instead of a
     centre crop under half its width. Goes away on its own the moment a
     real vertical poster lands in thumbnails/. */
  .lbx { position: absolute; inset: 0; display: block; }
  .lbx > :global(.lbx-fill) {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    /* Overscaled so the blur has no soft edge to bleed at the frame. */
    transform: scale(1.25);
    filter: blur(22px) saturate(0.7) brightness(1.12);
    opacity: 0.75;
  }
  .lbx > :global(.lbx-img) {
    position: absolute;
    top: 50%; left: 0;
    width: 100%; height: auto;
    transform: translateY(-50%);
    display: block;
    box-shadow: 0 14px 34px -20px rgba(35, 42, 59, 0.55);
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .wtile:not(.wtile--idle):hover .lbx > :global(.lbx-img),
  .wtile.is-focus .lbx > :global(.lbx-img) { transform: translateY(-50%) scale(1.04); }

  .preview {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  .wtile:hover .preview,
  .wtile:focus-visible .preview { opacity: 1; }

  /* ── Placeholder panel (no poster yet) ──
     Champagne-to-blue wash with the blueprint grid at low opacity, so an
     un-filled tile still looks designed rather than broken. */
  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    color: var(--wed-navy);
    background:
      linear-gradient(150deg, var(--wed-blue-pale) 0%, #fbf7f2 48%, var(--wed-gold-pale) 100%);
  }
  .placeholder::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(38, 79, 160, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(38, 79, 160, 0.09) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: radial-gradient(70% 70% at 50% 50%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000 20%, transparent 100%);
  }
  .placeholder > * { position: relative; z-index: 1; opacity: 0.62; }
  /* Slow light sweep. Until real films land every tile here is an empty
     panel, and without this the section reads as a grid of dead boxes. */
  .placeholder::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      112deg,
      transparent 34%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 66%
    );
    background-size: 260% 100%;
    animation: wedSheen 11s ease-in-out infinite;
    pointer-events: none;
  }
  .placeholder-text {
    font-family: var(--wed-display);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /* ── Category badge ── */
  .badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    z-index: 4;
    padding: 0.34rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(38, 79, 160, 0.16);
    color: var(--wed-navy);
    font-family: var(--wed-display);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .wtile--feature .badge { top: 1.15rem; left: 1.15rem; font-size: 0.62rem; padding: 0.45rem 0.9rem; }

  /* ── Play affordance ──
     Always visible at rest (this page has no hover-reveal cursor to hint
     with) and fills to navy on hover. */
  .play {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    width: 58px; height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.88);
    color: var(--wed-navy);
    backdrop-filter: blur(4px);
    box-shadow: 0 10px 30px -14px rgba(35, 42, 59, 0.55);
    pointer-events: none;
    transition: background 0.35s ease, color 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .play svg { margin-left: 2px; }
  .wtile--feature .play { width: 84px; height: 84px; }
  .wtile--feature .play svg { width: 30px; height: 30px; }
  .wtile:hover .play,
  .wtile:focus-visible .play {
    background: var(--wed-navy);
    color: #fff;
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* ── Caption, below the frame ── */
  .meta { display: flex; flex-direction: column; gap: 0.15rem; padding-left: 0.15rem; }
  .meta-title {
    font-family: var(--wed-serif);
    font-size: 1.28rem;
    font-weight: 500;
    color: var(--wed-ink);
    line-height: 1.15;
  }
  .wtile--feature .meta-title { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .meta-tag {
    font-family: var(--wed-display);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--wed-gold);
  }

  /* Touch: there is no hover, so the tile nearest the middle of the
     viewport gets the same emphasis instead. wedding.client.ts toggles
     .is-focus as you scroll. */
  @media (hover: none) {
    .wtile:hover .frame { transform: none; box-shadow: 0 18px 40px -34px rgba(35, 42, 59, 0.55); }
    .wtile:hover .frame > :global(img) { transform: none; }
    .wtile:hover .play { background: rgba(255,255,255,0.88); color: var(--wed-navy); transform: translate(-50%, -50%); }

    .wtile.is-focus:not(.wtile--idle) .frame {
      border-color: rgba(38, 79, 160, 0.28);
      box-shadow: 0 26px 55px -34px rgba(35, 42, 59, 0.5);
    }
    .wtile.is-focus:not(.wtile--idle) .play {
      background: var(--wed-navy);
      color: #fff;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame, .frame > :global(img), .play, .preview { transition: none; }
    .lbx > :global(.lbx-img) { transition: none; }
    .frame > :global(img) { animation: none; }
    .placeholder::after { animation: none; opacity: 0; }
  }
</style>
