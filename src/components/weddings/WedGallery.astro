---
// Photo gallery. Same convention as the films: drop
// `src/assets/images/weddings/gallery/<slug>.jpg` and the tile fills in.
//
// Until an image exists a tile renders a placeholder panel and is NOT a
// button — there is nothing to enlarge, so it should not behave like
// there is. Tile shape comes from `orientation` either way, so the
// masonry rhythm is already correct with zero photos in the folder.
//
// Three service lines share this one wall rather than getting a section
// each: with a handful of frames apiece, three thin walls read worse
// than one strong one. The tab bar below is built from the categories
// that have at least one REAL image, and hides itself entirely while
// only one does, so the page never offers a tab onto an empty room.
import { Image, getImage } from 'astro:assets';
import { galleryPhotos, photoCategories } from '../../data/weddings';

const galleryGlob = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/weddings/gallery/*.{jpg,jpeg,png}',
  { eager: true }
);

const imageBySlug: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(galleryGlob)) {
  const slug = path.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, '');
  imageBySlug[slug] = mod.default;
}

const tiles = await Promise.all(
  galleryPhotos.map(async photo => {
    const src = imageBySlug[photo.slug];
    return {
      ...photo,
      src,
      full: src ? (await getImage({ src, width: 1800, format: 'webp', quality: 86 })).src : undefined,
    };
  })
);

const hasAnyPhotos = tiles.some(t => t.src);

// A tab earns its place only once that category has a real image on
// disk. Scaffolded-but-unshot categories stay invisible, and the whole
// bar disappears while weddings is the only line with photography.
const tabs = photoCategories.filter(c =>
  tiles.some(t => t.category === c.id && t.src)
);
const showTabs = tabs.length > 1;
---
<section class="gallery wed-section" id="gallery">
  <div class="wed-container">
    <header class="head">
      <p class="wed-label" data-reveal="left">The Gallery</p>
      <h2 data-reveal>Stills from the <em class="script">whole story.</em></h2>
      <p class="wed-lede wed-narrow" data-reveal>
        The night you asked, the session before the invitations, and the day
        itself. Shot by the same crew, on the same timeline, graded to match
        your film, so your photos and your video finally look like they came
        from one wedding.
      </p>
    </header>

    {showTabs && (
      <div class="tabs" role="group" aria-label="Filter the gallery by session type" data-reveal>
        <button type="button" class="tab is-on" aria-pressed="true" data-filter="all">All</button>
        {tabs.map(c => (
          <button type="button" class="tab" aria-pressed="false" data-filter={c.id}>{c.label}</button>
        ))}
        <span class="sr-only" role="status" data-gallery-status></span>
      </div>
    )}

    {!hasAnyPhotos && (
      <p class="empty-note" data-reveal>
        <span class="empty-dot" aria-hidden="true"></span>
        Gallery in progress. Images drop in here as we finish each wedding.
      </p>
    )}

    <div class="masonry" data-reveal-group>
      {tiles.map(tile => (
        tile.src ? (
          <button
            class="gtile"
            type="button"
            data-orientation={tile.orientation}
            data-category={tile.category}
            data-wed-photo
            data-full={tile.full}
            data-caption={`${tile.caption} · ${tile.tag}`}
            data-reveal="deal"
            data-wed-focus
            aria-label={`Open larger view: ${tile.caption}`}
          >
            <span class="img-wrap">
              <Image
                src={tile.src}
                alt={tile.caption}
                width={1100}
                height={tile.orientation === 'v' ? 1466 : tile.orientation === 'w' ? 733 : 1100}
                format="webp"
                quality={84}
                loading="lazy"
              />
            </span>
            <span class="cap">
              <strong>{tile.caption}</strong>
              <span>{tile.tag}</span>
            </span>
          </button>
        ) : (
          <div
            class="gtile gtile--empty"
            data-orientation={tile.orientation}
            data-category={tile.category}
            data-reveal="deal"
          >
            <span class="ph" aria-hidden="true">
              <svg viewBox="0 0 40 32" width="34" height="27" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="1" y="5" width="38" height="26" rx="4" />
                <path d="M12 5l3-4h10l3 4" stroke-linejoin="round" />
                <circle cx="20" cy="18" r="7" />
              </svg>
            </span>
            <span class="cap cap--empty">
              <strong>{tile.caption}</strong>
              <span>{tile.tag}</span>
            </span>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<!-- Photo lightbox -->
<dialog class="wplb" data-wed-plb>
  <button type="button" class="wplb-close" data-wed-plb-close aria-label="Close">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    </svg>
  </button>
  <button type="button" class="wplb-arrow wplb-prev" data-wed-plb-prev aria-label="Previous photo">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="wplb-arrow wplb-next" data-wed-plb-next aria-label="Next photo">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <figure>
    <img alt="" data-wed-plb-img />
    <figcaption data-wed-plb-cap></figcaption>
  </figure>
</dialog>

<script>
  const initWedGallery = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-wed-plb]');
    const openers = Array.from(document.querySelectorAll<HTMLElement>('[data-wed-photo]'));
    if (!dialog || !openers.length) return;

    const img = dialog.querySelector<HTMLImageElement>('[data-wed-plb-img]');
    const cap = dialog.querySelector<HTMLElement>('[data-wed-plb-cap]');
    let current = -1;

    // Prev/next walks the FILTERED set, not every photo on the page.
    // Opening from the Engagements tab and arrowing into a wedding frame
    // would be a bug, not a feature.
    let active = openers;

    const showAt = (idx: number) => {
      if (!img || !cap || !active.length) return;
      const n = active.length;
      current = ((idx % n) + n) % n;
      const btn = active[current];
      img.src = btn.dataset.full || '';
      img.alt = btn.dataset.caption || '';
      // Keep the modal image out of the page-wide fade-in system so it can
      // never get stranded at opacity 0.
      img.removeAttribute('data-wed-loading');
      img.style.opacity = '1';
      cap.textContent = btn.dataset.caption || '';
    };

    const open = (btn: HTMLElement) => {
      showAt(Math.max(0, active.indexOf(btn)));
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
      document.body.style.overflow = '';
      if (img) img.removeAttribute('src');
      current = -1;
    };

    openers.forEach(btn => btn.addEventListener('click', () => open(btn)));
    dialog.querySelector('[data-wed-plb-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-wed-plb-prev]')?.addEventListener('click', e => { e.stopPropagation(); showAt(current - 1); });
    dialog.querySelector('[data-wed-plb-next]')?.addEventListener('click', e => { e.stopPropagation(); showAt(current + 1); });
    dialog.addEventListener('click', e => { if (e.target === dialog) close(); });
    dialog.addEventListener('cancel', e => { e.preventDefault(); close(); });

    document.addEventListener('keydown', e => {
      if (!dialog.open) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); showAt(current + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); showAt(current - 1); }
    });

    // Touch swipe — >50px navigates, anything smaller is a tap.
    let startX = 0;
    let swiping = false;
    dialog.addEventListener('pointerdown', e => {
      if (e.pointerType !== 'touch') return;
      startX = e.clientX; swiping = true;
    });
    dialog.addEventListener('pointerup', e => {
      if (!swiping || e.pointerType !== 'touch') return;
      swiping = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) < 50) return;
      showAt(dx < 0 ? current + 1 : current - 1);
    });
    dialog.addEventListener('pointercancel', () => { swiping = false; });

    // ── Category filter ──
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab[data-filter]'));
    if (!tabs.length) return;
    const allTiles = Array.from(document.querySelectorAll<HTMLElement>('.gtile[data-category]'));
    const status = document.querySelector<HTMLElement>('[data-gallery-status]');

    const applyFilter = (filter: string) => {
      allTiles.forEach(tile => {
        const on = filter === 'all' || tile.dataset.category === filter;
        tile.hidden = !on;
        // A tile filtered out before the reveal observer ever saw it would
        // come back stranded at opacity 0, so anything shown is revealed
        // outright. By the time anyone clicks a tab they have scrolled here.
        if (on) tile.classList.add('is-in');
      });
      active = openers.filter(btn => !btn.hidden);
      tabs.forEach(t => {
        const on = t.dataset.filter === filter;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-pressed', String(on));
      });
      if (status) {
        const n = allTiles.filter(t => !t.hidden).length;
        status.textContent = `Showing ${n} photo${n === 1 ? '' : 's'}.`;
      }
    };

    tabs.forEach(tab =>
      tab.addEventListener('click', () => applyFilter(tab.dataset.filter || 'all'))
    );
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWedGallery, { once: true });
  } else {
    initWedGallery();
  }
</script>

<style>
  .gallery { background: var(--wed-bg-2); }
  .head { max-width: 66ch; margin-bottom: 2.5rem; }
  .head h2 { margin: 1.1rem 0 1.5rem; }

  /* ── Category filter ──
     Only rendered once more than one service line has real photography. */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.25rem;
  }
  .tab {
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--wed-line);
    background: rgba(255, 255, 255, 0.6);
    color: var(--wed-ink-2);
    font-family: var(--wed-display);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .tab:hover { border-color: rgba(38, 79, 160, 0.3); color: var(--wed-navy); }
  .tab.is-on {
    background: var(--wed-navy);
    border-color: var(--wed-navy);
    color: #fff;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .empty-note {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--wed-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    color: var(--wed-muted);
  }
  .empty-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--wed-gold);
    flex-shrink: 0;
  }

  /* Grid rhythm: H tiles are square, V tiles are 4:3 tall. Row height is
     derived from the column width so both land on exact ratios. */
  .masonry {
    --mw: calc(min(100vw, var(--wed-max)) - 3rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: calc((var(--mw) - 11rem) / 12);
    gap: 1rem;
    grid-auto-flow: dense;
    /* One camera for the whole grid's deal-in. */
    perspective: 2000px;
    perspective-origin: center 35%;
  }
  .gtile {
    grid-row: span 3;
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 1px solid var(--wed-line-soft);
    border-radius: var(--wed-radius);
    overflow: hidden;
    background: #fff;
    color: inherit;
    text-align: left;
    font: inherit;
    cursor: pointer;
    /* Same trap as the package cards: this scoped rule out-specifies
       `[data-reveal="deal"]`, so the deal-in timing has to be declared
       here or the tiles snap in. And hover must not touch transform,
       which the deal-in owns. The image zoom carries the hover instead. */
    transition:
      opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
      transform 1.2s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
      box-shadow 0.45s ease,
      border-color 0.35s ease;
  }
  /* Row spans set the tile's aspect against the column width:
     2 rows = 3:2 landscape, 3 rows = square, 4 rows = 3:4 portrait. */
  /* .gtile and .gtile--empty both set `display`, which out-specifies the
     UA `[hidden] { display: none }`. Without this the filter is inert. */
  .gtile[hidden] { display: none; }
  .gtile[data-orientation="w"] { grid-row: span 2; }
  .gtile[data-orientation="v"] { grid-row: span 4; }
  .gtile:not(.gtile--empty):hover,
  .gtile:not(.gtile--empty):focus-visible {
    border-color: rgba(38, 79, 160, 0.3);
    box-shadow: 0 28px 55px -34px rgba(35, 42, 59, 0.55);
  }

  .img-wrap { display: block; width: 100%; height: 100%; overflow: hidden; line-height: 0; }
  .img-wrap :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.3, 1);
    animation: wedKenBurns 32s ease-in-out infinite alternate;
    transform-origin: center;
  }
  /* Offset neighbours so the wall doesn't breathe in unison. */
  .gtile:nth-child(3n)   .img-wrap :global(img) { animation-delay: -9s; }
  .gtile:nth-child(3n+1) .img-wrap :global(img) { animation-delay: -19s; }
  .gtile:hover .img-wrap :global(img),
  .gtile.is-focus .img-wrap :global(img) {
    animation-play-state: paused;
    transform: scale(1.04);
  }

  /* Caption — a soft white wash rather than the EDM black gradient. */
  .cap {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 2.5rem 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
    pointer-events: none;
  }
  .gtile:hover .cap, .gtile:focus-visible .cap { opacity: 1; transform: none; }
  .cap strong {
    font-family: var(--wed-serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--wed-ink);
  }
  .cap span {
    font-family: var(--wed-display);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wed-gold);
  }

  /* ── Empty tile ── */
  .gtile--empty {
    cursor: default;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, var(--wed-blue-pale) 0%, #fbf7f2 50%, var(--wed-gold-pale) 100%);
  }
  .gtile--empty::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(38, 79, 160, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(38, 79, 160, 0.075) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(72% 72% at 50% 50%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(72% 72% at 50% 50%, #000 20%, transparent 100%);
    pointer-events: none;
  }
  .ph { position: relative; z-index: 1; color: var(--wed-navy); opacity: 0.5; }
  /* Same slow sweep as the film placeholders, so the two empty states
     read as one system while we wait on real photography. */
  .gtile--empty::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      112deg,
      transparent 34%,
      rgba(255, 255, 255, 0.5) 50%,
      transparent 66%
    );
    background-size: 260% 100%;
    animation: wedSheen 13s ease-in-out infinite;
    pointer-events: none;
  }
  .gtile--empty:nth-child(even)::after { animation-delay: -6s; }
  .cap--empty {
    position: static;
    opacity: 1;
    transform: none;
    background: none;
    padding: 0.75rem 1rem 0;
    align-items: center;
    text-align: center;
    z-index: 1;
  }
  .cap--empty strong { font-size: 0.95rem; color: var(--wed-ink-2); }

  @media (max-width: 1080px) {
    .masonry {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: calc((var(--mw) - 8rem) / 9);
    }
  }
  @media (max-width: 700px) {
    .masonry {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
      grid-auto-rows: calc((var(--mw) - 3.25rem) / 6);
    }
    .gtile {
      transition:
        opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
        transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
        box-shadow 0.45s ease,
        border-color 0.35s ease;
    }
    .cap { opacity: 1; transform: none; padding: 1.75rem 0.7rem 0.6rem; }
    .cap strong { font-size: 0.85rem; }
  }

  /* ═════════ Photo lightbox ═════════ */
  .wplb {
    background: transparent;
    border: none;
    padding: 0;
    width: 100vw; height: 100vh;
    max-width: 100vw; max-height: 100vh;
    overflow: visible;
    user-select: none;
    -webkit-user-select: none;
  }
  .wplb::backdrop { background: rgba(252, 250, 248, 0.97); }
  .wplb[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: wplbIn 0.28s ease;
  }
  @keyframes wplbIn { from { opacity: 0; } to { opacity: 1; } }

  .wplb figure {
    margin: 0;
    max-width: min(92vw, 1500px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    pointer-events: none;
  }
  .wplb img {
    max-width: 100%;
    max-height: 78vh;
    width: auto; height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 40px 90px -35px rgba(35, 42, 59, 0.5);
    pointer-events: auto;
  }
  .wplb figcaption {
    font-family: var(--wed-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--wed-ink-2);
    text-align: center;
    pointer-events: auto;
  }
  .wplb-close, .wplb-arrow {
    position: fixed;
    width: 46px; height: 46px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--wed-line);
    color: var(--wed-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 12px 30px -20px rgba(35, 42, 59, 0.5);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .wplb-close { top: 1.25rem; right: 1.25rem; }
  .wplb-close:hover { background: var(--wed-navy); color: #fff; transform: rotate(90deg); }
  .wplb-arrow { top: 50%; transform: translateY(-50%); }
  .wplb-prev { left: 1.5rem; }
  .wplb-next { right: 1.5rem; }
  .wplb-arrow:hover { background: var(--wed-navy); color: #fff; }
  .wplb-prev:hover { transform: translateY(-50%) translateX(-3px); }
  .wplb-next:hover { transform: translateY(-50%) translateX(3px); }

  @media (max-width: 600px) {
    .wplb-close, .wplb-arrow { width: 40px; height: 40px; }
    .wplb-prev { left: 0.7rem; }
    .wplb-next { right: 0.7rem; }
  }
  @media (hover: none) {
    .gtile.is-focus:not(.gtile--empty) {
      border-color: rgba(38, 79, 160, 0.28);
      box-shadow: 0 26px 55px -34px rgba(35, 42, 59, 0.5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gtile, .img-wrap :global(img), .cap, .tab,
    .wplb-close, .wplb-arrow { transition: none; }
    .gtile { opacity: 1; transform: none; }
    .img-wrap :global(img) { animation: none; }
    .gtile--empty::after { animation: none; opacity: 0; }
    .wplb-close:hover { transform: none; }
    .wplb-prev:hover { transform: translateY(-50%); }
    .wplb-next:hover { transform: translateY(-50%); }
  }
</style>
