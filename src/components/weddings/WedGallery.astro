---
// Photo gallery. Same convention as the films: drop
// `src/assets/images/weddings/gallery/<slug>.jpg` and the tile fills in.
//
// Until an image exists a tile renders a placeholder panel and is NOT a
// button — there is nothing to enlarge, so it should not behave like
// there is. Tile shape comes from `orientation` either way, so the
// masonry rhythm is already correct with zero photos in the folder.
import { Image, getImage } from 'astro:assets';
import { galleryPhotos } from '../../data/weddings';

const galleryGlob = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/weddings/gallery/*.{jpg,jpeg,png}',
  { eager: true }
);

const imageBySlug: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(galleryGlob)) {
  const slug = path.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, '');
  imageBySlug[slug] = mod.default;
}

const tiles = await Promise.all(
  galleryPhotos.map(async photo => {
    const src = imageBySlug[photo.slug];
    return {
      ...photo,
      src,
      full: src ? (await getImage({ src, width: 1800, format: 'webp', quality: 86 })).src : undefined,
    };
  })
);

const hasAnyPhotos = tiles.some(t => t.src);
---
<section class="gallery wed-section" id="gallery">
  <div class="wed-container">
    <header class="head">
      <p class="wed-label" data-reveal="left">The Gallery</p>
      <h2 data-reveal>Stills from the <em class="script">same day.</em></h2>
      <p class="wed-lede wed-narrow" data-reveal>
        Shot by the same crew, on the same timeline, graded to match your film,
        so your photos and your video finally look like they came from one wedding.
      </p>
    </header>

    {!hasAnyPhotos && (
      <p class="empty-note" data-reveal>
        <span class="empty-dot" aria-hidden="true"></span>
        Gallery in progress. Images drop in here as we finish each wedding.
      </p>
    )}

    <div class="masonry" data-reveal-group>
      {tiles.map(tile => (
        tile.src ? (
          <button
            class="gtile"
            type="button"
            data-orientation={tile.orientation}
            data-wed-photo
            data-full={tile.full}
            data-caption={`${tile.caption} · ${tile.tag}`}
            data-reveal="scale"
            aria-label={`Open larger view: ${tile.caption}`}
          >
            <span class="img-wrap">
              <Image
                src={tile.src}
                alt={tile.caption}
                width={1100}
                height={tile.orientation === 'v' ? 1466 : 1100}
                format="webp"
                quality={84}
                loading="lazy"
              />
            </span>
            <span class="cap">
              <strong>{tile.caption}</strong>
              <span>{tile.tag}</span>
            </span>
          </button>
        ) : (
          <div
            class="gtile gtile--empty"
            data-orientation={tile.orientation}
            data-reveal="scale"
          >
            <span class="ph" aria-hidden="true">
              <svg viewBox="0 0 40 32" width="34" height="27" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="1" y="5" width="38" height="26" rx="4" />
                <path d="M12 5l3-4h10l3 4" stroke-linejoin="round" />
                <circle cx="20" cy="18" r="7" />
              </svg>
            </span>
            <span class="cap cap--empty">
              <strong>{tile.caption}</strong>
              <span>{tile.tag}</span>
            </span>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<!-- Photo lightbox -->
<dialog class="wplb" data-wed-plb>
  <button type="button" class="wplb-close" data-wed-plb-close aria-label="Close">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    </svg>
  </button>
  <button type="button" class="wplb-arrow wplb-prev" data-wed-plb-prev aria-label="Previous photo">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="wplb-arrow wplb-next" data-wed-plb-next aria-label="Next photo">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <figure>
    <img alt="" data-wed-plb-img />
    <figcaption data-wed-plb-cap></figcaption>
  </figure>
</dialog>

<script>
  const initWedGallery = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-wed-plb]');
    const openers = Array.from(document.querySelectorAll<HTMLElement>('[data-wed-photo]'));
    if (!dialog || !openers.length) return;

    const img = dialog.querySelector<HTMLImageElement>('[data-wed-plb-img]');
    const cap = dialog.querySelector<HTMLElement>('[data-wed-plb-cap]');
    let current = -1;

    const showAt = (idx: number) => {
      if (!img || !cap) return;
      const n = openers.length;
      current = ((idx % n) + n) % n;
      const btn = openers[current];
      img.src = btn.dataset.full || '';
      img.alt = btn.dataset.caption || '';
      // Keep the modal image out of the page-wide fade-in system so it can
      // never get stranded at opacity 0.
      img.removeAttribute('data-wed-loading');
      img.style.opacity = '1';
      cap.textContent = btn.dataset.caption || '';
    };

    const open = (btn: HTMLElement) => {
      showAt(Math.max(0, openers.indexOf(btn)));
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
      document.body.style.overflow = '';
      if (img) img.removeAttribute('src');
      current = -1;
    };

    openers.forEach(btn => btn.addEventListener('click', () => open(btn)));
    dialog.querySelector('[data-wed-plb-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-wed-plb-prev]')?.addEventListener('click', e => { e.stopPropagation(); showAt(current - 1); });
    dialog.querySelector('[data-wed-plb-next]')?.addEventListener('click', e => { e.stopPropagation(); showAt(current + 1); });
    dialog.addEventListener('click', e => { if (e.target === dialog) close(); });
    dialog.addEventListener('cancel', e => { e.preventDefault(); close(); });

    document.addEventListener('keydown', e => {
      if (!dialog.open) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); showAt(current + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); showAt(current - 1); }
    });

    // Touch swipe — >50px navigates, anything smaller is a tap.
    let startX = 0;
    let active = false;
    dialog.addEventListener('pointerdown', e => {
      if (e.pointerType !== 'touch') return;
      startX = e.clientX; active = true;
    });
    dialog.addEventListener('pointerup', e => {
      if (!active || e.pointerType !== 'touch') return;
      active = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) < 50) return;
      showAt(dx < 0 ? current + 1 : current - 1);
    });
    dialog.addEventListener('pointercancel', () => { active = false; });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWedGallery, { once: true });
  } else {
    initWedGallery();
  }
</script>

<style>
  .gallery { background: var(--wed-bg-2); }
  .head { max-width: 66ch; margin-bottom: 2.5rem; }
  .head h2 { margin: 1.1rem 0 1.5rem; }

  .empty-note {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--wed-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    color: var(--wed-muted);
  }
  .empty-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--wed-gold);
    flex-shrink: 0;
  }

  /* Grid rhythm: H tiles are square, V tiles are 4:3 tall. Row height is
     derived from the column width so both land on exact ratios. */
  .masonry {
    --mw: calc(min(100vw, var(--wed-max)) - 3rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: calc((var(--mw) - 11rem) / 12);
    gap: 1rem;
    grid-auto-flow: dense;
  }
  .gtile {
    grid-row: span 3;
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 1px solid var(--wed-line-soft);
    border-radius: var(--wed-radius);
    overflow: hidden;
    background: #fff;
    color: inherit;
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1),
                box-shadow 0.45s ease, border-color 0.35s ease;
  }
  .gtile[data-orientation="v"] { grid-row: span 4; }
  .gtile:not(.gtile--empty):hover,
  .gtile:not(.gtile--empty):focus-visible {
    transform: translateY(-4px);
    border-color: rgba(38, 79, 160, 0.22);
    box-shadow: 0 28px 55px -34px rgba(35, 42, 59, 0.55);
  }

  .img-wrap { display: block; width: 100%; height: 100%; overflow: hidden; line-height: 0; }
  .img-wrap :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .gtile:hover .img-wrap :global(img) { transform: scale(1.04); }

  /* Caption — a soft white wash rather than the EDM black gradient. */
  .cap {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 2.5rem 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
    pointer-events: none;
  }
  .gtile:hover .cap, .gtile:focus-visible .cap { opacity: 1; transform: none; }
  .cap strong {
    font-family: var(--wed-serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--wed-ink);
  }
  .cap span {
    font-family: var(--wed-display);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wed-gold);
  }

  /* ── Empty tile ── */
  .gtile--empty {
    cursor: default;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, var(--wed-blue-pale) 0%, #fbf7f2 50%, var(--wed-gold-pale) 100%);
  }
  .gtile--empty::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(38, 79, 160, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(38, 79, 160, 0.075) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(72% 72% at 50% 50%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(72% 72% at 50% 50%, #000 20%, transparent 100%);
    pointer-events: none;
  }
  .ph { position: relative; z-index: 1; color: var(--wed-navy); opacity: 0.5; }
  .cap--empty {
    position: static;
    opacity: 1;
    transform: none;
    background: none;
    padding: 0.75rem 1rem 0;
    align-items: center;
    text-align: center;
    z-index: 1;
  }
  .cap--empty strong { font-size: 0.95rem; color: var(--wed-ink-2); }

  @media (max-width: 1080px) {
    .masonry {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: calc((var(--mw) - 8rem) / 9);
    }
  }
  @media (max-width: 700px) {
    .masonry {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
      grid-auto-rows: calc((var(--mw) - 3.25rem) / 6);
    }
    .cap { opacity: 1; transform: none; padding: 1.75rem 0.7rem 0.6rem; }
    .cap strong { font-size: 0.85rem; }
  }

  /* ═════════ Photo lightbox ═════════ */
  .wplb {
    background: transparent;
    border: none;
    padding: 0;
    width: 100vw; height: 100vh;
    max-width: 100vw; max-height: 100vh;
    overflow: visible;
    user-select: none;
    -webkit-user-select: none;
  }
  .wplb::backdrop { background: rgba(252, 250, 248, 0.97); }
  .wplb[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: wplbIn 0.28s ease;
  }
  @keyframes wplbIn { from { opacity: 0; } to { opacity: 1; } }

  .wplb figure {
    margin: 0;
    max-width: min(92vw, 1500px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    pointer-events: none;
  }
  .wplb img {
    max-width: 100%;
    max-height: 78vh;
    width: auto; height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 40px 90px -35px rgba(35, 42, 59, 0.5);
    pointer-events: auto;
  }
  .wplb figcaption {
    font-family: var(--wed-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--wed-ink-2);
    text-align: center;
    pointer-events: auto;
  }
  .wplb-close, .wplb-arrow {
    position: fixed;
    width: 46px; height: 46px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--wed-line);
    color: var(--wed-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 12px 30px -20px rgba(35, 42, 59, 0.5);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .wplb-close { top: 1.25rem; right: 1.25rem; }
  .wplb-close:hover { background: var(--wed-navy); color: #fff; transform: rotate(90deg); }
  .wplb-arrow { top: 50%; transform: translateY(-50%); }
  .wplb-prev { left: 1.5rem; }
  .wplb-next { right: 1.5rem; }
  .wplb-arrow:hover { background: var(--wed-navy); color: #fff; }
  .wplb-prev:hover { transform: translateY(-50%) translateX(-3px); }
  .wplb-next:hover { transform: translateY(-50%) translateX(3px); }

  @media (max-width: 600px) {
    .wplb-close, .wplb-arrow { width: 40px; height: 40px; }
    .wplb-prev { left: 0.7rem; }
    .wplb-next { right: 0.7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gtile, .img-wrap :global(img), .cap,
    .wplb-close, .wplb-arrow { transition: none; }
    .wplb-close:hover { transform: none; }
    .wplb-prev:hover { transform: translateY(-50%); }
    .wplb-next:hover { transform: translateY(-50%); }
  }
</style>
