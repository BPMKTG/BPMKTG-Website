---
import { getImage } from 'astro:assets';

// Per-artist photos for the clickable marquee names (existing asset library).
import gabeImg          from '../assets/images/client-banner/gabetoldmeto-fluffycloud.jpg';
import mgImg            from '../assets/images/hero/hero-4-martingarrix-wickedoaks.jpg';
import excisionImg      from '../assets/images/hero/hero-1-excision-magenta-713.jpg';
import subtronicsImg    from '../assets/images/carousel/carousel-subtronics-levelup.jpg';
import doctorpImg       from '../assets/images/carousel/carousel-flux-doctorp-rv.jpg';
import adventureclubImg from '../assets/images/portfolio/adventureclub-silo.jpg';
import atliensImg       from '../assets/images/carousel/carousel-atliens-sidestage.jpg';
import theresistanceImg from '../assets/images/portfolio/portfolio-hero-theresistance-grimefest.jpg';
import voydImg          from '../assets/images/backgrounds/bg-1-svddendeath-red-wickedoaks.jpg';
import levelupImg       from '../assets/images/carousel/carousel-levelup-wide.jpg';
import sanpachoImg      from '../assets/images/carousel/carousel-sanpacho-redlasers.jpg';
import yookieImg        from '../assets/images/portfolio/yookie-grimefest-bassface.jpg';
import automhateImg     from '../assets/images/portfolio/automhate-grimefest.jpg';
import alienparkImg     from '../assets/images/hero/hero-2-alienpark-green-silo.jpg';
import neotekImg        from '../assets/images/portfolio/neotek-silo-onstage.jpg';
import laurenmiaImg     from '../assets/images/portfolio/laurenmia-fluffycloud-silo.jpg';
import silverpandaImg   from '../assets/images/client-banner/silverpanda-fluffycloud.jpg';
import allReasonImg     from '../assets/images/carousel/carousel-allthereason-graffiti.jpg';
import sqishiImg        from '../assets/images/portfolio/blankface-b2b-sqishi-surprised-grimefest.jpg';
import ognixinImg       from '../assets/images/portfolio/ognixin-grimefest.jpg';
import izzyvadimImg     from '../assets/images/portfolio/izyyvadim-grimefest-smoking.jpg';
import rzrktImg         from '../assets/images/portfolio/rzrkt-drinkurwater-vulcangasco.jpg';
import skyvakImg        from '../assets/images/client-banner/skyvak-embershores.jpg';
import ophionImg        from '../assets/images/client-banner/ophion-grimefest.jpg';
import destroyahImg     from '../assets/images/client-banner/krazzb2bdestroyah-1.jpg';
import spiraImg         from '../assets/images/portfolio/spira-toatsatx.jpg';
import legendImg        from '../assets/images/portfolio/legendofshellda-toatsatx.jpg';

// Ordered artist list. Names without a media entry below stay text-only.
const artists = [
  'Gabetoldmeto', 'Martin Garrix', 'Excision', 'Flux Pavilion', 'Subtronics',
  'Doctor P', 'Slander', 'Adventure Club', 'Wooli', 'ATLiens',
  'Crankdat', 'Kai Wachi', 'The Resistance', 'Svdden Death', 'Voyd',
  'Space Laces', 'Level Up', 'Dion Timmer', 'San Pacho', 'Drinkurwater',
  'Inzo', 'Beauz', 'AlleyCvt', 'Yookie', 'Ahee',
  'Automhate', 'Alien Park', 'Neotek', 'Lauren Mia', 'Silver Panda',
  'Perry Wayne', 'All The Reason', 'Blankface', 'Sqishi', 'OG Nixin',
  'Izzy Vadim', 'Rzrkt', 'Nimda', 'Yvm3', 'Skyvak',
  'Ophion', 'Mushroom Cloud', 'Destroyah', 'Krazz', 'Spira',
  'LegendOfShellda',
];

// Map of artist name → media. `img` opens a photo; `vimeo` opens a video.
// Names omitted here render as plain text with no clickable behavior.
const artistMedia: Record<string, { img?: ImageMetadata; vimeo?: string }> = {
  'Gabetoldmeto':   { img: gabeImg },
  'Martin Garrix':  { img: mgImg },
  'Excision':       { img: excisionImg },
  'Flux Pavilion':  { vimeo: '1130704802' },
  'Subtronics':     { img: subtronicsImg },
  'Doctor P':       { img: doctorpImg },
  'Adventure Club': { img: adventureclubImg },
  'Wooli':          { vimeo: '1122000651' },
  'ATLiens':        { img: atliensImg },
  'Kai Wachi':      { vimeo: '1122111561' },
  'The Resistance': { img: theresistanceImg },
  'Voyd':           { img: voydImg },
  'Level Up':       { img: levelupImg },
  'Dion Timmer':    { vimeo: '1194917343' },
  'San Pacho':      { img: sanpachoImg },
  'Beauz':          { vimeo: '1096994614' },
  'Yookie':         { img: yookieImg },
  'Ahee':           { vimeo: '1122005048' },
  'Automhate':      { img: automhateImg },
  'Alien Park':     { img: alienparkImg },
  'Neotek':         { img: neotekImg },
  'Lauren Mia':     { img: laurenmiaImg },
  'Silver Panda':   { img: silverpandaImg },
  'Perry Wayne':    { vimeo: '1122003672' },
  'All The Reason': { img: allReasonImg },
  'Blankface':      { vimeo: '1194847014' },
  'Sqishi':         { img: sqishiImg },
  'OG Nixin':       { img: ognixinImg },
  'Izzy Vadim':     { img: izzyvadimImg },
  'Rzrkt':          { img: rzrktImg },
  'Skyvak':         { img: skyvakImg },
  'Ophion':         { img: ophionImg },
  'Destroyah':      { img: destroyahImg },
  'Spira':          { img: spiraImg },
  'LegendOfShellda':{ img: legendImg },
};

// Pre-generate optimized lightbox renditions for photo entries; pass the
// vimeo id straight through for video entries.
const artistLB: Record<string, { full?: string; vimeo?: string; caption: string }> = {};
for (const [name, m] of Object.entries(artistMedia)) {
  artistLB[name] = {
    caption: name,
    ...(m.img   ? { full: (await getImage({ src: m.img, width: 1400, format: 'webp', quality: 84 })).src } : {}),
    ...(m.vimeo ? { vimeo: m.vimeo } : {}),
  };
}

// Duplicate the list so the CSS animation can translate -50% for a seamless loop
const trackList = [...artists, ...artists];
---
<section class="marquee" aria-label="Artists in the field">
  <div class="container">
    <p class="marquee-label" data-reveal="left">In The Field With</p>
  </div>

  <div class="marquee-track" data-reveal aria-hidden="true">
    <ul class="marquee-row" role="presentation">
      {trackList.map((name) => {
        const lb = artistLB[name];
        return (
        <li class="marquee-item">
          <span class="sep" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor">
              <polygon points="2.5,1.5 10,6 2.5,10.5" />
            </svg>
          </span>
          {lb ? (
            <button
              type="button"
              class="artist artist--clickable"
              data-artist-open
              data-full={lb.full ?? ''}
              data-vimeo={lb.vimeo ?? ''}
              data-caption={lb.caption}
              tabindex="-1"
              aria-label={`${lb.vimeo ? 'Play video' : 'View photo'} of ${name}`}
            >
              {name}
              <span class="artist-info" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                  <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="12" cy="7.6" r="1.25" fill="currentColor"/>
                  <path d="M12 10.8v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
            </button>
          ) : (
            <span class="artist">{name}</span>
          )}
        </li>
        );
      })}
    </ul>
  </div>

  <!-- Artist media lightbox — opens a photo or video when a clickable name is tapped. -->
  <dialog class="artist-lightbox" data-artist-lightbox aria-label="Artist media">
    <button type="button" class="artist-lb-close" data-artist-lb-close aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <figure>
      <div class="artist-lb-media" data-artist-lb-media></div>
      <figcaption data-artist-lb-caption></figcaption>
    </figure>
  </dialog>
</section>

<script>
  // Marquee motion. Mobile/touch keeps the plain auto-scroll. Desktop drives
  // the timeline manually so the cursor can do carousel-style edge-hover:
  // near the right edge scrolls forward (faster toward the edge), near the
  // left edge reverses, and the middle is the normal auto-scroll speed.
  const init = () => {
    document.querySelectorAll<HTMLElement>('.marquee').forEach(marquee => {
      if (marquee.dataset.marqueeInit) return;
      marquee.dataset.marqueeInit = '1';

      const row = marquee.querySelector<HTMLElement>('.marquee-row');
      if (!row) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const isMobile = window.innerWidth < 700;
      const duration = isMobile ? 130_000 : 180_000;

      const animation = row.animate(
        [
          { transform: 'translate3d(0, 0, 0)' },
          { transform: 'translate3d(-50%, 0, 0)' },
        ],
        { duration, iterations: Infinity, easing: 'linear' }
      );
      animation.pause();

      let visible = false;
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      // ── Mobile / touch: unchanged auto-scroll, gated to visibility ──
      if (!fine) {
        const applyState = () => {
          if (visible && !document.hidden) animation.play();
          else animation.pause();
        };
        document.addEventListener('visibilitychange', applyState);
        const io = new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          applyState();
        }, { threshold: 0.15 });
        io.observe(marquee);
        return;
      }

      // ── Desktop: manual timeline + edge-hover speed/direction control ──
      const MAX = 7;       // peak speed multiplier at the very edge
      const EDGE = 0.30;   // edge zone = 30% of width on each side
      let rate = 1, targetRate = 1, raf = 0, last = 0;

      const onMove = (e: PointerEvent) => {
        const r = marquee.getBoundingClientRect();
        const x = e.clientX - r.left;
        const w = r.width || 1;
        const edgePx = w * EDGE;
        if (x < edgePx) {
          const t = 1 - x / edgePx;             // 0 inner → 1 at left edge
          targetRate = -(0.6 + t * t * MAX);    // reverse, faster toward edge
        } else if (x > w - edgePx) {
          const t = (x - (w - edgePx)) / edgePx; // 0 → 1 toward right edge
          targetRate = 0.6 + t * t * MAX;        // forward, faster toward edge
        } else {
          targetRate = 1;                        // normal auto-scroll
        }
      };
      const onLeave = () => { targetRate = 1; };
      marquee.addEventListener('pointermove', onMove);
      marquee.addEventListener('pointerleave', onLeave);

      const tick = (now: number) => {
        if (!last) last = now;
        const dt = now - last;
        last = now;
        rate += (targetRate - rate) * 0.18;      // smooth ramp toward target
        if (visible && !document.hidden) {
          let t = (animation.currentTime as number || 0) + dt * rate;
          t = ((t % duration) + duration) % duration; // seamless wrap both ways
          animation.currentTime = t;
        }
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);

      const io = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
      }, { threshold: 0.15 });
      io.observe(marquee);
    });
  };

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  // Artist media lightbox — photo or vimeo video. Idempotent across view
  // transitions; delegates clicks so the duplicated marquee copies all work.
  const initArtistLB = () => {
    const dialog   = document.querySelector<HTMLDialogElement>('[data-artist-lightbox]');
    const media    = dialog?.querySelector<HTMLElement>('[data-artist-lb-media]');
    const cap      = dialog?.querySelector<HTMLElement>('[data-artist-lb-caption]');
    const closeBtn = dialog?.querySelector<HTMLButtonElement>('[data-artist-lb-close]');
    if (!dialog || !media || !cap || dialog.dataset.albInit) return;
    dialog.dataset.albInit = '1';

    // Emptying the container removes any <img>/<iframe> immediately — this
    // both stops a playing Vimeo embed and prevents the previous asset from
    // flashing when a new artist is opened or the lightbox is closed.
    const clear = () => { media.innerHTML = ''; };

    const closeLB = () => {
      const cursor = document.querySelector<HTMLElement>('.bp-cursor');
      if (cursor) document.body.appendChild(cursor);
      clear();
      if (dialog.open) dialog.close();
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-artist-open]');
      if (!btn) return;
      clear();   // wipe old content before loading the new asset (no flash)

      const vimeo = btn.dataset.vimeo;
      if (vimeo) {
        const iframe = document.createElement('iframe');
        iframe.src = `https://player.vimeo.com/video/${vimeo}?autoplay=1&title=0&byline=0&portrait=0&dnt=1`;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.setAttribute('allowfullscreen', '');
        iframe.title = btn.dataset.caption || '';
        media.appendChild(iframe);
        media.dataset.kind = 'video';
      } else {
        const img = document.createElement('img');
        img.src = btn.dataset.full || '';
        img.alt = btn.dataset.caption || '';
        media.appendChild(img);
        media.dataset.kind = 'photo';
      }
      cap.textContent = btn.dataset.caption || '';
      if (!dialog.open) dialog.showModal();
      const cursor = document.querySelector<HTMLElement>('.bp-cursor');
      if (cursor) dialog.appendChild(cursor);
    });

    closeBtn?.addEventListener('click', closeLB);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) closeLB(); });
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); closeLB(); });
  };

  document.addEventListener('astro:page-load', initArtistLB);
  if (document.readyState !== 'loading') initArtistLB();
  else document.addEventListener('DOMContentLoaded', initArtistLB, { once: true });
</script>

<style>
  .marquee {
    background: transparent;
    padding: 2rem 0 2.25rem;
    overflow: hidden;
    position: relative;
  }
  .marquee-label {
    text-align: center;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--bp-light);
    font-family: var(--font-display);
  }

  .marquee-track {
    display: flex;
    width: 100%;
    overflow: hidden;
    /* Edge fade in/out */
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .marquee-row {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    will-change: transform;
    /* The motion is driven by JS via Web Animations API (see <script> below)
       so we can smoothly change playback rate on hover without jumping. */
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 1.6rem;        /* spacing between play button and artist within item */
    padding-right: 1.6rem; /* spacing between items */
  }

  .artist {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    transition: color 0.2s;
  }
  .marquee-item:hover .artist { color: var(--bp-light); }

  /* Clickable artist names — open a photo/video in the lightbox. The ⓘ icon
     stays visible (also on touch) to signal the name is tappable. */
  .artist--clickable {
    appearance: none;
    background: none;
    border: none;
    margin: 0;
    padding: 0;
    cursor: pointer;
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.2rem;
    line-height: 1;
  }
  .artist-info {
    color: var(--bp-blue);
    opacity: 0.78;
    margin-top: -0.15em;          /* sit at the top-right corner of the name */
    display: inline-flex;
    transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .artist--clickable:hover { color: var(--bp-light); }
  .artist--clickable:hover .artist-info {
    opacity: 1;
    color: var(--bp-light);
    transform: scale(1.12);
  }

  /* ── Artist media lightbox ── */
  .artist-lightbox {
    border: none;
    padding: 0;
    margin: auto;
    background: transparent;
    max-width: min(900px, 92vw);
    max-height: 90vh;
    color: var(--ink);
    overflow: visible;
  }
  .artist-lightbox::backdrop {
    background: rgba(6, 6, 14, 0.85);
    backdrop-filter: blur(16px);
  }
  .artist-lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .artist-lb-media img {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    max-height: 80vh;
    object-fit: contain;
    margin: 0 auto;
    border-radius: 14px;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .artist-lb-media iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 14px;
    background: #000;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .artist-lightbox figcaption {
    color: var(--bp-light);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }
  .artist-lb-close {
    position: fixed;
    top: 1.25rem; right: 1.25rem;
    appearance: none;
    background: transparent;
    border: 1px solid rgba(98, 166, 219, 0.4);
    border-radius: 999px;
    width: 44px; height: 44px;
    color: var(--bp-light);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .artist-lb-close:hover {
    background: rgba(98, 166, 219, 0.14);
    border-color: rgba(98, 166, 219, 0.7);
    transform: rotate(90deg);
  }

  .sep {
    color: var(--bp-orange);
    display: inline-flex;
    align-items: center;
    opacity: 0.85;
    filter: drop-shadow(0 0 6px rgba(227, 112, 59, 0.35));
    transition: transform 0.4s cubic-bezier(.2,.7,.3,1);
  }
  /* Easter egg: while the marquee is being slowed by hover, the
     play-button separators slowly rotate. Stops when pointer leaves. */
  .marquee:hover .sep {
    animation: sepSpin 5s linear infinite;
  }
  @keyframes sepSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee:hover .sep { animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { overflow-x: auto; }
  }

  @media (max-width: 700px) {
    .marquee { padding: 1.5rem 0 1.75rem; }
    .artist { font-size: 0.85rem; letter-spacing: 0.18em; }
    .marquee-item { gap: 1.1rem; padding-right: 1.1rem; }
  }
</style>
