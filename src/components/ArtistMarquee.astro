---
import { getImage } from 'astro:assets';

// Per-artist photos for the clickable marquee names (existing asset library).
import mgImg          from '../assets/images/portfolio/martingarrix-onstage-pyro.jpg';
import excisionImg    from '../assets/images/hero/hero-1-excision-magenta-713.jpg';
import subtronicsImg  from '../assets/images/portfolio/subtronics-dancefestopia.jpg';
import fluxImg        from '../assets/images/carousel/carousel-flux-doctorp-rv.jpg';
import atliensImg     from '../assets/images/portfolio/atliens-dft-sidestage.jpg';
import wooliImg       from '../assets/images/portfolio/wooli-dft-pyro-lasers.jpg';
import sanpachoImg    from '../assets/images/portfolio/sanpacho-silo.jpg';
import alienparkImg   from '../assets/images/portfolio/alienpark-dft.jpg';
import svddendeathImg from '../assets/images/portfolio/svddendeath-wickedoaks.jpg';
import aheeImg        from '../assets/images/portfolio/ahee-dft.jpg';
import neotekImg      from '../assets/images/portfolio/neotek-silo-onstage.jpg';
import yookieImg      from '../assets/images/portfolio/yookie-grimefest-bassface.jpg';
import allReasonImg   from '../assets/images/portfolio/allthereason-vulcangasco.jpg';

const artists = [
  'Gabetoldmeto', 'Martin Garrix', 'Excision', 'Flux Pavilion', 'Subtronics',
  'Doctor P', 'Slander', 'Adventure Club', 'Crankdat', 'Kai Wachi',
  'ATLiens', 'Wooli', 'The Resistance', 'Svdden Death', 'Voyd',
  'Space Laces', 'Level Up', 'Dion Timmer', 'San Pacho', 'Drinkurwater',
  'Inzo', 'Beauz', 'AlleyCvt', 'Yookie', 'Ahee',
  'Automhate', 'Alien Park', 'Neotek', 'Lauren Mia', 'Silver Panda',
  'Perry Wayne', 'All The Reason', 'Blankface', 'Sqishi', 'OG Nixin',
  'Izzy Vadim', 'Rzrkt', 'Nimda', 'Yvm3', 'Skyvak',
  'Ophion', 'Mushroom Cloud', 'Destroyah', 'Krazz', 'Spira',
  'LegendOfShellda',
];

// Map of artist name → photo + caption for the names that open a lightbox.
const artistMedia: Record<string, { img: ImageMetadata; caption: string }> = {
  'Martin Garrix':  { img: mgImg,          caption: 'Martin Garrix — Wicked Oaks' },
  'Excision':       { img: excisionImg,    caption: 'Excision — 713 Music Hall, Houston' },
  'Subtronics':     { img: subtronicsImg,  caption: 'Subtronics — Dancefestopia' },
  'Flux Pavilion':  { img: fluxImg,        caption: 'Flux Pavilion — Wicked Oaks' },
  'ATLiens':        { img: atliensImg,     caption: 'ATLiens — Dancefestopia' },
  'Wooli':          { img: wooliImg,       caption: 'Wooli — Dancefestopia' },
  'San Pacho':      { img: sanpachoImg,    caption: 'San Pacho — Silo, Dallas' },
  'Alien Park':     { img: alienparkImg,   caption: 'Alien Park — Dancefestopia' },
  'Svdden Death':   { img: svddendeathImg, caption: 'Svdden Death — Wicked Oaks' },
  'Ahee':           { img: aheeImg,        caption: 'AHEE — Dancefestopia' },
  'Neotek':         { img: neotekImg,      caption: 'Neotek — Silo, Dallas' },
  'Yookie':         { img: yookieImg,      caption: 'Yookie — Grimefest' },
  'All The Reason': { img: allReasonImg,   caption: 'All The Reason — Vulcan Gas Co.' },
};

// Pre-generate optimized lightbox renditions for each clickable artist.
const artistLB: Record<string, { full: string; caption: string }> = {};
for (const [name, m] of Object.entries(artistMedia)) {
  artistLB[name] = {
    full: (await getImage({ src: m.img, width: 1400, format: 'webp', quality: 84 })).src,
    caption: m.caption,
  };
}

// Duplicate the list so the CSS animation can translate -50% for a seamless loop
const trackList = [...artists, ...artists];
---
<section class="marquee" aria-label="Artists in the field">
  <div class="container">
    <p class="marquee-label" data-reveal="left">In The Field With</p>
  </div>

  <div class="marquee-track" data-reveal aria-hidden="true">
    <ul class="marquee-row" role="presentation">
      {trackList.map((name) => {
        const lb = artistLB[name];
        return (
        <li class="marquee-item">
          <span class="sep" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor">
              <polygon points="2.5,1.5 10,6 2.5,10.5" />
            </svg>
          </span>
          {lb ? (
            <button
              type="button"
              class="artist artist--clickable"
              data-artist-open
              data-full={lb.full}
              data-caption={lb.caption}
              tabindex="-1"
              aria-label={`View photo of ${name}`}
            >
              {name}
              <span class="artist-info" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                  <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="12" cy="7.6" r="1.25" fill="currentColor"/>
                  <path d="M12 10.8v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
            </button>
          ) : (
            <span class="artist">{name}</span>
          )}
        </li>
        );
      })}
    </ul>
  </div>

  <!-- Artist photo lightbox — opens when a clickable marquee name is tapped. -->
  <dialog class="artist-lightbox" data-artist-lightbox aria-label="Artist photo">
    <button type="button" class="artist-lb-close" data-artist-lb-close aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <figure>
      <img data-artist-lb-img alt="" />
      <figcaption data-artist-lb-caption></figcaption>
    </figure>
  </dialog>
</section>

<script>
  // Web Animations API instead of CSS animation so hover can smoothly
  // change playback rate WITHOUT jumping to a new playhead position.
  const init = () => {
    document.querySelectorAll<HTMLElement>('.marquee').forEach(marquee => {
      if (marquee.dataset.marqueeInit) return;
      marquee.dataset.marqueeInit = '1';

      const row = marquee.querySelector<HTMLElement>('.marquee-row');
      if (!row) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const isMobile = window.innerWidth < 700;
      const duration = isMobile ? 130_000 : 180_000;

      const animation = row.animate(
        [
          { transform: 'translate3d(0, 0, 0)' },
          { transform: 'translate3d(-50%, 0, 0)' },
        ],
        { duration, iterations: Infinity, easing: 'linear' }
      );

      // Hold at frame 0 until the marquee actually enters the viewport,
      // so the user sees the big names first instead of arriving mid-scroll.
      animation.pause();

      let hovering = false;
      let visible = false;

      const applyState = () => {
        if (!visible) { animation.pause(); return; }
        animation.play();
        animation.updatePlaybackRate(hovering ? 0.3 : 1);
      };

      // updatePlaybackRate keeps the current visual position and just changes
      // how fast time advances — no jump.
      marquee.addEventListener('pointerenter', () => { hovering = true;  applyState(); });
      marquee.addEventListener('pointerleave', () => { hovering = false; applyState(); });

      // Pause when tab is hidden so we don't burn cycles in the background
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) animation.pause();
        else applyState();
      });

      // Only animate while the marquee is in view
      const io = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        applyState();
      }, { threshold: 0.15 });
      io.observe(marquee);
    });
  };

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  // Artist photo lightbox — opens the tapped name's photo. Idempotent across
  // view transitions; delegates clicks so the duplicated marquee copies all
  // work without per-button rebinding.
  const initArtistLB = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-artist-lightbox]');
    const img    = dialog?.querySelector<HTMLImageElement>('[data-artist-lb-img]');
    const cap    = dialog?.querySelector<HTMLElement>('[data-artist-lb-caption]');
    const close  = dialog?.querySelector<HTMLButtonElement>('[data-artist-lb-close]');
    if (!dialog || !img || !cap || dialog.dataset.albInit) return;
    dialog.dataset.albInit = '1';

    const closeLB = () => {
      const cursor = document.querySelector<HTMLElement>('.bp-cursor');
      if (cursor) document.body.appendChild(cursor);
      if (dialog.open) dialog.close();
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-artist-open]');
      if (!btn) return;
      img.src = btn.dataset.full ?? '';
      img.alt = btn.dataset.caption ?? '';
      cap.textContent = btn.dataset.caption ?? '';
      if (!dialog.open) dialog.showModal();
      // Keep the custom cursor visible above the modal backdrop.
      const cursor = document.querySelector<HTMLElement>('.bp-cursor');
      if (cursor) dialog.appendChild(cursor);
    });
    close?.addEventListener('click', closeLB);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) closeLB(); });
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); closeLB(); });
  };

  document.addEventListener('astro:page-load', initArtistLB);
  if (document.readyState !== 'loading') initArtistLB();
  else document.addEventListener('DOMContentLoaded', initArtistLB, { once: true });
</script>

<style>
  .marquee {
    background: transparent;
    padding: 2rem 0 2.25rem;
    overflow: hidden;
    position: relative;
  }
  .marquee-label {
    text-align: center;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--bp-light);
    font-family: var(--font-display);
  }

  .marquee-track {
    display: flex;
    width: 100%;
    overflow: hidden;
    /* Edge fade in/out */
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .marquee-row {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    will-change: transform;
    /* The motion is driven by JS via Web Animations API (see <script> below)
       so we can smoothly change playback rate on hover without jumping. */
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 1.6rem;        /* spacing between play button and artist within item */
    padding-right: 1.6rem; /* spacing between items */
  }

  .artist {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    transition: color 0.2s;
  }
  .marquee-item:hover .artist { color: var(--bp-light); }

  /* Clickable artist names — open a photo in the lightbox. The ⓘ icon stays
     visible (also on touch) to signal the name is tappable. */
  .artist--clickable {
    appearance: none;
    background: none;
    border: none;
    margin: 0;
    padding: 0;
    cursor: pointer;
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.2rem;
    line-height: 1;
  }
  .artist-info {
    color: var(--bp-blue);
    opacity: 0.78;
    margin-top: -0.15em;          /* sit at the top-right corner of the name */
    display: inline-flex;
    transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .artist--clickable:hover { color: var(--bp-light); }
  .artist--clickable:hover .artist-info {
    opacity: 1;
    color: var(--bp-light);
    transform: scale(1.12);
  }

  /* ── Artist photo lightbox ── */
  .artist-lightbox {
    border: none;
    padding: 0;
    margin: auto;
    background: transparent;
    max-width: min(640px, 92vw);
    max-height: 90vh;
    color: var(--ink);
    overflow: visible;
  }
  .artist-lightbox::backdrop {
    background: rgba(6, 6, 14, 0.85);
    backdrop-filter: blur(16px);
  }
  .artist-lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .artist-lightbox img {
    width: 100%;
    height: auto;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 14px;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .artist-lightbox figcaption {
    color: var(--bp-light);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }
  .artist-lb-close {
    position: fixed;
    top: 1.25rem; right: 1.25rem;
    appearance: none;
    background: transparent;
    border: 1px solid rgba(98, 166, 219, 0.4);
    border-radius: 999px;
    width: 44px; height: 44px;
    color: var(--bp-light);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .artist-lb-close:hover {
    background: rgba(98, 166, 219, 0.14);
    border-color: rgba(98, 166, 219, 0.7);
    transform: rotate(90deg);
  }

  .sep {
    color: var(--bp-orange);
    display: inline-flex;
    align-items: center;
    opacity: 0.85;
    filter: drop-shadow(0 0 6px rgba(227, 112, 59, 0.35));
    transition: transform 0.4s cubic-bezier(.2,.7,.3,1);
  }
  /* Easter egg: while the marquee is being slowed by hover, the
     play-button separators slowly rotate. Stops when pointer leaves. */
  .marquee:hover .sep {
    animation: sepSpin 5s linear infinite;
  }
  @keyframes sepSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee:hover .sep { animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { overflow-x: auto; }
  }

  @media (max-width: 700px) {
    .marquee { padding: 1.5rem 0 1.75rem; }
    .artist { font-size: 0.85rem; letter-spacing: 0.18em; }
    .marquee-item { gap: 1.1rem; padding-right: 1.1rem; }
  }
</style>
