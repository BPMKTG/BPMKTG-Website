---
import { getImage } from 'astro:assets';

// Per-artist photos for the clickable marquee names (existing asset library).
import gabeImg          from '../assets/images/client-banner/gabetoldmeto-fluffycloud.jpg';
import mgImg            from '../assets/images/hero/hero-4-martingarrix-wickedoaks.jpg';
import excisionImg      from '../assets/images/hero/hero-1-excision-magenta-713.jpg';
import subtronicsImg    from '../assets/images/carousel/carousel-subtronics-levelup.jpg';
import doctorpImg       from '../assets/images/carousel/carousel-flux-doctorp-rv.jpg';
import adventureclubImg from '../assets/images/portfolio/adventureclub-silo.jpg';
import atliensImg       from '../assets/images/carousel/carousel-atliens-sidestage.jpg';
import theresistanceImg from '../assets/images/portfolio/portfolio-hero-theresistance-grimefest.jpg';
import voydImg          from '../assets/images/backgrounds/bg-1-svddendeath-red-wickedoaks.jpg';
import levelupImg       from '../assets/images/carousel/carousel-levelup-wide.jpg';
import sanpachoImg      from '../assets/images/carousel/carousel-sanpacho-redlasers.jpg';
import yookieImg        from '../assets/images/portfolio/yookie-grimefest-bassface.jpg';
import automhateImg     from '../assets/images/portfolio/automhate-grimefest.jpg';
import alienparkImg     from '../assets/images/hero/hero-2-alienpark-green-silo.jpg';
import neotekImg        from '../assets/images/portfolio/neotek-silo-onstage.jpg';
import laurenmiaImg     from '../assets/images/portfolio/laurenmia-fluffycloud-silo.jpg';
import silverpandaImg   from '../assets/images/client-banner/silverpanda-fluffycloud.jpg';
import allReasonImg     from '../assets/images/carousel/carousel-allthereason-graffiti.jpg';
import sqishiImg        from '../assets/images/portfolio/blankface-b2b-sqishi-surprised-grimefest.jpg';
import ognixinImg       from '../assets/images/portfolio/ognixin-grimefest.jpg';
import izzyvadimImg     from '../assets/images/portfolio/izyyvadim-grimefest-smoking.jpg';
import rzrktImg         from '../assets/images/portfolio/rzrkt-drinkurwater-vulcangasco.jpg';
import skyvakImg        from '../assets/images/client-banner/skyvak-embershores.jpg';
import ophionImg        from '../assets/images/client-banner/ophion-grimefest.jpg';
import destroyahImg     from '../assets/images/client-banner/krazzb2bdestroyah-1.jpg';
import spiraImg         from '../assets/images/portfolio/spira-toatsatx.jpg';
import legendImg        from '../assets/images/portfolio/legendofshellda-toatsatx.jpg';

// Ordered artist list. Names without a media entry below stay text-only.
const artists = [
  'Gabetoldmeto', 'Martin Garrix', 'Excision', 'Flux Pavilion', 'Subtronics',
  'Doctor P', 'Slander', 'Adventure Club', 'Wooli', 'ATLiens',
  'Crankdat', 'Kai Wachi', 'The Resistance', 'Svdden Death', 'Voyd',
  'Space Laces', 'Level Up', 'Dion Timmer', 'San Pacho', 'Drinkurwater',
  'Inzo', 'Beauz', 'AlleyCvt', 'Yookie', 'Ahee',
  'Automhate', 'Alien Park', 'Neotek', 'Lauren Mia', 'Silver Panda',
  'Perry Wayne', 'All The Reason', 'Blankface', 'Sqishi', 'OG Nixin',
  'Izzy Vadim', 'Rzrkt', 'Nimda', 'Yvm3', 'Skyvak',
  'Ophion', 'Mushroom Cloud', 'Destroyah', 'Krazz', 'Spira',
  'LegendOfShellda',
];

// Map of artist name → media. `img` opens a photo; `vimeo` opens a video.
// `loc` is the venue/event shown after the name in the lightbox caption
// ("ARTIST — LOCATION", same as the portfolio). `cap` overrides the whole
// caption (e.g. for b2b sets). Names omitted here render as plain text.
const artistMedia: Record<string, { img?: ImageMetadata; vimeo?: string; loc: string; cap?: string }> = {
  'Gabetoldmeto':   { img: gabeImg,          loc: 'Fluffy Cloud' },
  'Martin Garrix':  { img: mgImg,            loc: 'Wicked Oaks' },
  'Excision':       { img: excisionImg,      loc: '713 Music Hall, Houston' },
  'Flux Pavilion':  { vimeo: '1130704802',   loc: 'Wicked Oaks' },
  'Subtronics':     { img: subtronicsImg,    loc: 'Dancefestopia' },
  'Doctor P':       { img: doctorpImg,       loc: 'Wicked Oaks', cap: 'Doctor P X Flux Pavilion — Wicked Oaks' },
  'Adventure Club': { img: adventureclubImg, loc: 'Silo, Dallas' },
  'Wooli':          { vimeo: '1122000651',   loc: 'Silo, Dallas' },
  'ATLiens':        { img: atliensImg,       loc: 'Dancefestopia' },
  'Kai Wachi':      { vimeo: '1122111561',   loc: 'Dancefestopia' },
  'The Resistance': { img: theresistanceImg, loc: 'Grimefest' },
  'Voyd':           { img: voydImg,          loc: 'Wicked Oaks' },
  'Level Up':       { img: levelupImg,       loc: 'Dancefestopia' },
  'Dion Timmer':    { vimeo: '1194917343',   loc: '713 Music Hall, Houston' },
  'San Pacho':      { img: sanpachoImg,      loc: 'Silo, Dallas' },
  'Beauz':          { vimeo: '1096994614',   loc: 'NOTO Houston' },
  'Yookie':         { img: yookieImg,        loc: 'Grimefest' },
  'Ahee':           { vimeo: '1122005048',   loc: 'Dancefestopia' },
  'Automhate':      { img: automhateImg,     loc: 'Grimefest' },
  'Alien Park':     { img: alienparkImg,     loc: 'Silo, Dallas' },
  'Neotek':         { img: neotekImg,        loc: 'Silo, Dallas' },
  'Lauren Mia':     { img: laurenmiaImg,     loc: 'Silo, Dallas' },
  'Silver Panda':   { img: silverpandaImg,   loc: 'Fluffy Cloud' },
  'Perry Wayne':    { vimeo: '1122003672',   loc: 'Dancefestopia' },
  'All The Reason': { img: allReasonImg,     loc: 'Vulcan Gas Co.' },
  'Blankface':      { vimeo: '1194847014',   loc: 'Grimefest', cap: 'Blankface b2b Sqishi — Grimefest' },
  'Sqishi':         { img: sqishiImg,        loc: 'Grimefest', cap: 'Blankface b2b Sqishi — Grimefest' },
  'OG Nixin':       { img: ognixinImg,       loc: 'Grimefest' },
  'Izzy Vadim':     { img: izzyvadimImg,     loc: 'Grimefest' },
  'Rzrkt':          { img: rzrktImg,         loc: 'Vulcan Gas Co.' },
  'Skyvak':         { img: skyvakImg,        loc: 'Ember Shores' },
  'Ophion':         { img: ophionImg,        loc: 'Grimefest' },
  'Destroyah':      { img: destroyahImg,     loc: 'Grimefest', cap: 'Destroyah b2b Krazz — Grimefest' },
  'Spira':          { img: spiraImg,         loc: 'Toats, Austin' },
  'LegendOfShellda':{ img: legendImg,        loc: 'Toats, Austin' },
};

// Pre-generate optimized lightbox renditions for photo entries; pass the
// vimeo id straight through for video entries. Caption = cap override, else
// "ARTIST — LOCATION".
const artistLB: Record<string, { full?: string; vimeo?: string; caption: string }> = {};
for (const [name, m] of Object.entries(artistMedia)) {
  artistLB[name] = {
    caption: m.cap ?? (m.loc ? `${name} — ${m.loc}` : name),
    ...(m.img   ? { full: (await getImage({ src: m.img, width: 1400, format: 'webp', quality: 84 })).src } : {}),
    ...(m.vimeo ? { vimeo: m.vimeo } : {}),
  };
}

// Duplicate the list so the CSS animation can translate -50% for a seamless loop
const trackList = [...artists, ...artists];
---
<section class="marquee" aria-label="Artists in the field">
  <div class="container">
    <p class="marquee-label" data-reveal="left">In The Field With</p>
  </div>

  <div class="marquee-track" data-reveal aria-hidden="true">
    <ul class="marquee-row" role="presentation">
      {trackList.map((name) => {
        const lb = artistLB[name];
        return (
        <li class="marquee-item">
          <span class="sep" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor">
              <polygon points="2.5,1.5 10,6 2.5,10.5" />
            </svg>
          </span>
          {lb ? (
            <button
              type="button"
              class="artist artist--clickable"
              data-artist-open
              data-full={lb.full ?? ''}
              data-vimeo={lb.vimeo ?? ''}
              data-caption={lb.caption}
              tabindex="-1"
              aria-label={`${lb.vimeo ? 'Play video' : 'View photo'} of ${name}`}
            >
              {name}
              <span class="artist-info" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                  <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="12" cy="7.6" r="1.25" fill="currentColor"/>
                  <path d="M12 10.8v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
            </button>
          ) : (
            <span class="artist">{name}</span>
          )}
        </li>
        );
      })}
    </ul>
  </div>

  <!-- Artist media lightbox — opens a photo or video when a clickable name is tapped. -->
  <dialog class="artist-lightbox" data-artist-lightbox aria-label="Artist media">
    <button type="button" class="artist-lb-close" data-artist-lb-close aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <figure>
      <div class="artist-lb-media" data-artist-lb-media></div>
      <figcaption data-artist-lb-caption></figcaption>
    </figure>
  </dialog>
</section>

<script>
  // Marquee motion + media lightbox. Re-inits on every astro:page-load and
  // fully tears down on astro:before-swap — listeners via one AbortController,
  // plus the rAF loop, IntersectionObservers, the open lightbox, and the
  // cursor are all released — so nothing accumulates across navigations.
  let inited = false;
  let ac: AbortController | null = null;
  let raf = 0;
  let ios: IntersectionObserver[] = [];

  const cleanup = () => {
    inited = false;
    if (ac) { ac.abort(); ac = null; }
    cancelAnimationFrame(raf); raf = 0;
    ios.forEach(io => { try { io.disconnect(); } catch {} });
    ios = [];
    const dlg = document.querySelector<HTMLDialogElement>('[data-artist-lightbox]');
    if (dlg) {
      const media = dlg.querySelector<HTMLElement>('[data-artist-lb-media]');
      if (media) media.innerHTML = '';
      if (dlg.open) { try { dlg.close(); } catch {} }
    }
    const cursor = document.querySelector<HTMLElement>('.bp-cursor');
    if (cursor && cursor.parentElement !== document.body) document.body.appendChild(cursor);
  };

  const init = () => {
    if (inited) return;
    const marquees = document.querySelectorAll<HTMLElement>('.marquee');
    const dialog = document.querySelector<HTMLDialogElement>('[data-artist-lightbox]');
    if (!marquees.length && !dialog) return;
    inited = true;
    ac = new AbortController();
    const signal = ac.signal;

    // ── Marquee motion ──
    marquees.forEach(marquee => {
      const row = marquee.querySelector<HTMLElement>('.marquee-row');
      if (!row) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const isMobile = window.innerWidth < 700;
      const duration = isMobile ? 130_000 : 180_000;

      const animation = row.animate(
        [
          { transform: 'translate3d(0, 0, 0)' },
          { transform: 'translate3d(-50%, 0, 0)' },
        ],
        { duration, iterations: Infinity, easing: 'linear' }
      );
      animation.pause();
      // The WAAPI animation is cancelled in cleanup so a re-init never leaves
      // a second timeline running on the same row.
      const anim = animation;
      const cancelAnim = () => { try { anim.cancel(); } catch {} };

      let visible = false;
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      // ── Mobile / touch: plain auto-scroll, gated to visibility ──
      if (!fine) {
        const applyState = () => {
          if (visible && !document.hidden) animation.play();
          else animation.pause();
        };
        document.addEventListener('visibilitychange', applyState, { signal });
        signal.addEventListener('abort', cancelAnim);
        const io = new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          applyState();
        }, { threshold: 0.15 });
        io.observe(marquee);
        ios.push(io);
        return;
      }

      // ── Desktop: manual timeline + edge-hover speed/direction control ──
      const MAX = 7;          // peak speed multiplier at the very edge
      const EDGE_PX = 180;    // edge zone width (px) — reaches a bit further in
      const SLOW = 0.3;       // playback rate when hovering the middle zone
      let rate = 1, targetRate = 1, last = 0;

      const onMove = (e: PointerEvent) => {
        const r = marquee.getBoundingClientRect();
        const x = e.clientX - r.left;
        const w = r.width || 1;
        const edgePx = Math.min(EDGE_PX, w * 0.35);
        if (x < edgePx) {
          const t = 1 - x / edgePx;
          targetRate = -(0.6 + t * t * MAX);
        } else if (x > w - edgePx) {
          const t = (x - (w - edgePx)) / edgePx;
          targetRate = 0.6 + t * t * MAX;
        } else {
          targetRate = SLOW;
        }
      };
      const onLeave = () => { targetRate = 1; };
      marquee.addEventListener('pointermove', onMove, { signal });
      marquee.addEventListener('pointerleave', onLeave, { signal });
      signal.addEventListener('abort', cancelAnim);

      const tick = (now: number) => {
        if (!last) last = now;
        const dt = now - last;
        last = now;
        rate += (targetRate - rate) * 0.18;
        if (visible && !document.hidden) {
          let t = (animation.currentTime as number || 0) + dt * rate;
          t = ((t % duration) + duration) % duration;
          animation.currentTime = t;
        }
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);

      const io = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
      }, { threshold: 0.15 });
      io.observe(marquee);
      ios.push(io);
    });

    // ── Media lightbox (photo or vimeo video) ──
    if (dialog) {
      const media    = dialog.querySelector<HTMLElement>('[data-artist-lb-media]');
      const cap      = dialog.querySelector<HTMLElement>('[data-artist-lb-caption]');
      const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-artist-lb-close]');

      if (media && cap) {
        // Emptying the container removes any <img>/<iframe> immediately — stops
        // a playing Vimeo embed and prevents the previous asset from flashing.
        const clear = () => { media.innerHTML = ''; };

        const closeLB = () => {
          const cursor = document.querySelector<HTMLElement>('.bp-cursor');
          if (cursor && cursor.parentElement !== document.body) document.body.appendChild(cursor);
          clear();
          if (dialog.open) dialog.close();
        };

        document.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-artist-open]');
          if (!btn) return;
          clear();
          const vimeo = btn.dataset.vimeo;
          if (vimeo) {
            const iframe = document.createElement('iframe');
            iframe.src = `https://player.vimeo.com/video/${vimeo}?autoplay=1&title=0&byline=0&portrait=0&dnt=1`;
            iframe.allow = 'autoplay; fullscreen; picture-in-picture';
            iframe.setAttribute('allowfullscreen', '');
            iframe.title = btn.dataset.caption || '';
            media.appendChild(iframe);
            media.dataset.kind = 'video';
          } else {
            const img = document.createElement('img');
            img.src = btn.dataset.full || '';
            img.alt = btn.dataset.caption || '';
            media.appendChild(img);
            media.dataset.kind = 'photo';
          }
          cap.textContent = btn.dataset.caption || '';
          if (!dialog.open) dialog.showModal();
          const cursor = document.querySelector<HTMLElement>('.bp-cursor');
          if (cursor) dialog.appendChild(cursor);
        }, { signal });

        closeBtn?.addEventListener('click', closeLB, { signal });
        dialog.addEventListener('click', (e) => { if (e.target === dialog) closeLB(); }, { signal });
        dialog.addEventListener('cancel', (e) => { e.preventDefault(); closeLB(); }, { signal });
      }
    }
  };

  document.addEventListener('astro:before-swap', cleanup);
  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
</script>

<style>
  .marquee {
    background: transparent;
    padding: 2rem 0 2.25rem;
    overflow: hidden;
    position: relative;
  }
  .marquee-label {
    text-align: center;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--bp-light);
    font-family: var(--font-display);
  }

  .marquee-track {
    display: flex;
    width: 100%;
    overflow: hidden;
    /* Edge fade in/out */
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .marquee-row {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    will-change: transform;
    /* The motion is driven by JS via Web Animations API (see <script> below)
       so we can smoothly change playback rate on hover without jumping. */
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 1.6rem;        /* spacing between play button and artist within item */
    padding-right: 1.6rem; /* spacing between items */
  }

  .artist {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    transition: color 0.2s;
  }
  .marquee-item:hover .artist { color: var(--bp-light); }

  /* Clickable artist names — open a photo/video in the lightbox. The ⓘ icon
     stays visible (also on touch) to signal the name is tappable. */
  .artist--clickable {
    appearance: none;
    background: none;
    border: none;
    margin: 0;
    padding: 0;
    cursor: pointer;
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.2rem;
    line-height: 1;
  }
  .artist-info {
    color: var(--bp-blue);
    opacity: 0.78;
    margin-top: -0.15em;          /* sit at the top-right corner of the name */
    display: inline-flex;
    transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .artist--clickable:hover { color: var(--bp-light); }
  .artist--clickable:hover .artist-info {
    opacity: 1;
    color: var(--bp-light);
    transform: scale(1.12);
  }

  /* ── Artist media lightbox ── (mirrors the portfolio photo/video lightbox:
     full-viewport dialog that flex-centers a shrink-to-fit figure, so photos
     of any orientation land at a consistent size and videos open large) */
  .artist-lightbox {
    border: none;
    padding: 0;
    margin: 0;
    background: transparent;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    color: var(--ink);
    overflow: visible;
  }
  .artist-lightbox::backdrop {
    background: rgba(6, 6, 14, 0.88);
    backdrop-filter: blur(16px);
  }
  .artist-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: albFade 0.25s ease;
  }
  @keyframes albFade { from { opacity: 0; } to { opacity: 1; } }
  .artist-lightbox figure {
    margin: 0;
    max-width: min(94vw, 1600px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }
  .artist-lb-media { display: flex; align-items: center; justify-content: center; }
  /* :global() is required — the <img>/<iframe> are created in JS and so carry
     no Astro scoped-cid attribute; the normal scoped selector wouldn't match.
     Sized to match the portfolio lightbox. */
  .artist-lb-media :global(img) {
    max-width: min(94vw, 1600px);
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(98, 166, 219, 0.15);
  }
  .artist-lb-media :global(iframe) {
    width: min(94vw, 1360px);
    aspect-ratio: 16 / 9;
    max-height: 82vh;
    border: 0;
    border-radius: 12px;
    background: #000;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(98, 166, 219, 0.2);
  }
  .artist-lightbox figcaption {
    color: var(--bp-light);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }
  .artist-lb-close {
    position: fixed;
    top: 1.25rem; right: 1.25rem;
    appearance: none;
    background: transparent;
    border: 1px solid rgba(98, 166, 219, 0.4);
    border-radius: 999px;
    width: 44px; height: 44px;
    color: var(--bp-light);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .artist-lb-close:hover {
    background: rgba(98, 166, 219, 0.14);
    border-color: rgba(98, 166, 219, 0.7);
    transform: rotate(90deg);
  }

  .sep {
    color: var(--bp-orange);
    display: inline-flex;
    align-items: center;
    opacity: 0.85;
    filter: drop-shadow(0 0 6px rgba(227, 112, 59, 0.35));
    transition: transform 0.4s cubic-bezier(.2,.7,.3,1);
  }
  /* Easter egg: while the marquee is being slowed by hover, the
     play-button separators slowly rotate. Stops when pointer leaves. */
  .marquee:hover .sep {
    animation: sepSpin 5s linear infinite;
  }
  @keyframes sepSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee:hover .sep { animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { overflow-x: auto; }
  }

  @media (max-width: 700px) {
    .marquee { padding: 1.5rem 0 1.75rem; }
    .artist { font-size: 0.85rem; letter-spacing: 0.18em; }
    .marquee-item { gap: 1.1rem; padding-right: 1.1rem; }
  }
</style>
