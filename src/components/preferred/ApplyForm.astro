---
// Blueprint Preferred™ application form.
//
// Native markup and native validation, styled with the site's own
// tokens. It posts in the background so the applicant never leaves the
// page: Web3Forms decides success or failure, and a second fire-and-
// forget POST appends a row to a Google Sheet when one is configured.
//
// With no access key set, this renders a pending notice instead of a
// form, rather than shipping inputs that silently drop submissions.
import {
  WEB3FORMS_ACCESS_KEY,
  APPLICATION_SHEET_WEBHOOK,
  CONTACT_EMAIL,
} from '../../config/cta';
import { applicationSections, formCopy, SKILL_MAX } from '../../data/preferred';

const live = WEB3FORMS_ACCESS_KEY !== '';

// Stars are radios in reverse DOM order so a pure-CSS sibling selector
// can fill the chosen star and every lower one, with no JS needed for
// the visual state. JS only handles enabling, clearing and the readout.
const starValues = Array.from({ length: SKILL_MAX }, (_, i) => SKILL_MAX - i);
const skillId = (skill: string) => skill.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<section class="section apply" id="apply">
  <div class="container">
    <div class="apply-head">
      <p class="label" data-reveal="left">{formCopy.eyebrow}</p>
      <h2 data-reveal>{formCopy.headline}</h2>
      <p class="apply-lede" data-reveal>{formCopy.lede}</p>
    </div>

    {live ? (
      <div class="apply-shell" data-reveal>
        <form
          class="apply-form"
          data-apply-form
          data-access-key={WEB3FORMS_ACCESS_KEY}
          data-sheet-webhook={APPLICATION_SHEET_WEBHOOK}
          novalidate
        >
          {applicationSections.map(section => (
            <fieldset class="apply-fieldset">
              <legend>{section.legend}</legend>
              {section.hint && <p class="apply-hint">{section.hint}</p>}

              {section.skills && (
                <ul class="skill-list" data-skill-list>
                  {section.skills.map(skill => (
                    <li class="skill is-off" data-skill-row data-skill={skill}>
                      <label class="skill-check">
                        <input type="checkbox" data-skill-toggle />
                        <span class="skill-box" aria-hidden="true"></span>
                        <span class="skill-name">{skill}</span>
                      </label>

                      <div class="skill-rate">
                        <div class="skill-stars" role="radiogroup" aria-label={`${skill} skill level out of ${SKILL_MAX}`}>
                          {starValues.map(n => (
                            <Fragment>
                              <input
                                class="skill-star-input"
                                type="radio"
                                name={skill}
                                id={`${skillId(skill)}-${n}`}
                                value={String(n)}
                                disabled
                              />
                              <label class="skill-star" for={`${skillId(skill)}-${n}`}>
                                <span class="sr-only">{n} out of {SKILL_MAX}</span>
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                  <path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 9.4l6.5-.9L12 2.6z" />
                                </svg>
                              </label>
                            </Fragment>
                          ))}
                        </div>
                        <span class="skill-value" data-skill-value aria-hidden="true"></span>
                      </div>

                      <p class="apply-error" data-error-for={skill} hidden></p>
                    </li>
                  ))}
                </ul>
              )}

              <div class="apply-rows">
                {(section.fields ?? []).map(f => (
                  <div class:list={['apply-field', `is-${f.width ?? 'full'}`]}>
                    <label for={`f-${f.name}`}>
                      {f.label}
                      {f.required && <span class="apply-req" aria-hidden="true">*</span>}
                      {!f.required && <span class="apply-opt">optional</span>}
                    </label>

                    {f.type === 'textarea' ? (
                      <textarea
                        id={`f-${f.name}`}
                        name={f.name}
                        rows="3"
                        required={f.required}
                        placeholder={f.placeholder}
                      ></textarea>
                    ) : f.type === 'select' ? (
                      <select id={`f-${f.name}`} name={f.name} required={f.required}>
                        <option value="">Choose one</option>
                        {f.options?.map(o => <option value={o}>{o}</option>)}
                      </select>
                    ) : (
                      <input
                        id={`f-${f.name}`}
                        type={f.type}
                        name={f.name}
                        required={f.required}
                        placeholder={f.placeholder}
                      />
                    )}

                    {f.help && <p class="apply-help">{f.help}</p>}
                    <p class="apply-error" data-error-for={f.name} hidden></p>
                  </div>
                ))}
              </div>
            </fieldset>
          ))}

          {/* Web3Forms' own honeypot. Bots fill it, people never see it. */}
          <input type="checkbox" name="botcheck" class="apply-botcheck" tabindex="-1" autocomplete="off" />

          <div class="apply-actions">
            <button type="submit" class="button accent apply-submit">
              <span data-submit-label>{formCopy.submitLabel}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </button>
            <p class="apply-required-note">Fields marked * are required.</p>
          </div>

          <p class="apply-formerror" data-form-error hidden role="alert">
            {formCopy.errorBody}{' '}
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </p>
        </form>

        <div class="apply-success" data-apply-success hidden role="status">
          <span class="apply-success-mark" aria-hidden="true">✓</span>
          <h3>{formCopy.successHeadline}</h3>
          <p>{formCopy.successBody}</p>
        </div>
      </div>
    ) : (
      <div class="apply-pending" data-reveal>
        <span class="apply-pending-dot" aria-hidden="true"></span>
        <p>
          {formCopy.pendingNote} In the meantime, email{' '}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with your portfolio
          and your market, and we'll add you by hand.
        </p>
      </div>
    )}
  </div>
</section>

<script>
  // Submits without leaving the page. Web3Forms is authoritative: its
  // response decides what the applicant sees. The Sheet write is fired
  // separately and never allowed to affect that, because a spreadsheet
  // being down is not a reason to tell someone their application failed.
  const init = () => {
    const form = document.querySelector<HTMLFormElement>('[data-apply-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const shell = form.closest('.apply-shell');
    const success = shell?.querySelector<HTMLElement>('[data-apply-success]');
    const formError = form.querySelector<HTMLElement>('[data-form-error]');
    const button = form.querySelector<HTMLButtonElement>('.apply-submit');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    const originalLabel = label?.textContent ?? 'Send application';

    const fieldError = (name: string, message: string | null) => {
      const el = form.querySelector<HTMLElement>(`[data-error-for="${CSS.escape(name)}"]`);
      if (el) {
        el.textContent = message ?? '';
        el.hidden = !message;
      }
      // A radio group resolves to a RadioNodeList, not an element, so
      // this has to be guarded: reaching for .classList on one throws,
      // and inside the async submit handler that surfaces as a rejected
      // promise rather than an error, i.e. the form silently does nothing.
      const control = form.elements.namedItem(name);
      if (control instanceof HTMLElement) {
        control.classList.toggle('has-error', Boolean(message));
      }
    };

    // ─── Skills matrix ───
    // Stars stay disabled until the skill is ticked, so a rating can
    // never be submitted for something the applicant did not claim.
    const skillRows = Array.from(form.querySelectorAll<HTMLElement>('[data-skill-row]'));

    const ratingOf = (row: HTMLElement) =>
      row.querySelector<HTMLInputElement>('.skill-star-input:checked')?.value ?? '';

    const syncRow = (row: HTMLElement) => {
      const on = row.querySelector<HTMLInputElement>('[data-skill-toggle]')?.checked ?? false;
      row.classList.toggle('is-off', !on);
      row.querySelectorAll<HTMLInputElement>('.skill-star-input').forEach(r => {
        r.disabled = !on;
        if (!on) r.checked = false;
      });
      const readout = row.querySelector<HTMLElement>('[data-skill-value]');
      const rating = on ? ratingOf(row) : '';
      if (readout) readout.textContent = rating ? `${rating}/10` : '';
      if (!on) fieldError(row.dataset.skill ?? '', null);
    };

    skillRows.forEach(row => {
      row.querySelector('[data-skill-toggle]')?.addEventListener('change', () => syncRow(row));
      row.querySelectorAll('.skill-star-input').forEach(r =>
        r.addEventListener('change', () => {
          const readout = row.querySelector<HTMLElement>('[data-skill-value]');
          if (readout) readout.textContent = `${ratingOf(row)}/10`;
          fieldError(row.dataset.skill ?? '', null);
        }),
      );
    });

    // Native constraint validation, surfaced inline instead of as the
    // browser's popup, which does not match anything else on the site.
    const validate = () => {
      let firstBad: HTMLElement | null = null;
      const controls = Array.from(
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input[name], select[name], textarea[name]',
        ),
      ).filter(c => c.name !== 'botcheck');

      controls.forEach(c => {
        if (c.checkValidity()) {
          fieldError(c.name, null);
          return;
        }
        const message = c.validity.valueMissing
          ? 'This one is required.'
          : c.validity.typeMismatch && c.type === 'email'
            ? "That doesn't look like an email address."
            : c.validity.typeMismatch && c.type === 'url'
              ? 'Include the full link, starting with https://'
              : 'Check this one.';
        fieldError(c.name, message);
        if (!firstBad) firstBad = c;
      });

      // A ticked skill with no stars is the one invalid state native
      // validation cannot see, since the radios carry no `required`.
      skillRows.forEach(row => {
        const on = row.querySelector<HTMLInputElement>('[data-skill-toggle]')?.checked ?? false;
        const skill = row.dataset.skill ?? '';
        if (on && !ratingOf(row)) {
          fieldError(skill, 'Give this one a rating, or untick it.');
          if (!firstBad) firstBad = row.querySelector<HTMLElement>('.skill-star-input:last-of-type');
        } else {
          fieldError(skill, null);
        }
      });

      if (firstBad) {
        (firstBad as HTMLElement).focus();
        (firstBad as HTMLElement).scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
      return !firstBad;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (formError) formError.hidden = true;
      if (!validate()) return;

      const data = Object.fromEntries(new FormData(form).entries());

      // Every skill ships on every submission, blank when unclaimed, so
      // the Sheet keeps one stable filterable column per skill instead
      // of a ragged set that depends on what each applicant ticked.
      const rated: string[] = [];
      skillRows.forEach(row => {
        const skill = row.dataset.skill ?? '';
        const rating = ratingOf(row);
        data[skill] = rating;
        if (rating) rated.push(`${skill} ${rating}/10`);
      });
      // One readable line for the notification email, which is a worse
      // place to read ten separate columns.
      data['Skills summary'] = rated.length ? rated.join(', ') : 'None selected';

      const payload = {
        ...data,
        access_key: form.dataset.accessKey,
        subject: `Blueprint Preferred application: ${data['Name'] ?? 'unknown'}`,
        from_name: 'Blueprint Preferred applications',
        replyto: data['Email'],
      };

      if (button) button.disabled = true;
      if (label) label.textContent = 'Sending…';

      // Best effort, deliberately not awaited into the success path.
      const webhook = form.dataset.sheetWebhook;
      if (webhook) {
        // text/plain keeps this a CORS "simple request", so Apps Script
        // accepts it without a preflight. We cannot read the response
        // and do not need to.
        fetch(webhook, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ ...data, submittedAt: new Date().toISOString() }),
        }).catch(() => { /* the inbox still has it */ });
      }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok && json.success) {
          form.hidden = true;
          if (success) {
            success.hidden = false;
            success.scrollIntoView({ block: 'center', behavior: 'smooth' });
          }
          return;
        }
        throw new Error(json.message ?? 'Submission rejected');
      } catch {
        if (formError) formError.hidden = false;
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = originalLabel;
      }
    });

    // Clear a field's error as soon as it becomes valid again.
    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement | null;
      if (t?.name && t.checkValidity()) fieldError(t.name, null);
    });
  };

  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
</script>

<style>
  .apply-head { max-width: 58ch; margin-bottom: 2.5rem; }
  .apply-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 800;
    margin: 0.5rem 0 0.75rem;
  }
  .apply-lede { margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }

  .apply-shell {
    max-width: 820px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  .apply-fieldset { border: 0; padding: 0; margin: 0 0 2.25rem; min-width: 0; }
  .apply-fieldset:last-of-type { margin-bottom: 1.5rem; }
  .apply-fieldset legend {
    padding: 0;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bp-blue);
  }
  .apply-hint {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
    max-width: 60ch;
  }

  .apply-rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    margin-top: 1.25rem;
  }
  .apply-field { min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .apply-field.is-full { grid-column: 1 / -1; }

  .apply-field label {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }
  .apply-req { color: var(--bp-orange); }
  .apply-opt {
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--dim);
    letter-spacing: 0.04em;
  }

  .apply-field input,
  .apply-field select,
  .apply-field textarea {
    width: 100%;
    min-width: 0;
    font-family: inherit;
    font-size: 0.93rem;
    color: var(--ink);
    background: rgba(8, 8, 16, 0.6);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.7rem 0.85rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .apply-field textarea { resize: vertical; line-height: 1.6; }
  .apply-field select {
    appearance: none;
    /* Chevron drawn inline so the control matches the dark theme rather
       than inheriting the OS select styling. */
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
                      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 18px) calc(50% + 2px), calc(100% - 13px) calc(50% + 2px);
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }
  .apply-field select option { background: #12131c; color: var(--ink); }

  .apply-field input::placeholder,
  .apply-field textarea::placeholder { color: var(--dim); }

  .apply-field input:focus,
  .apply-field select:focus,
  .apply-field textarea:focus {
    outline: none;
    border-color: rgba(98, 166, 219, 0.55);
    background: rgba(12, 14, 24, 0.85);
    box-shadow: 0 0 0 3px rgba(98, 166, 219, 0.14);
  }
  .apply-field :global(.has-error) { border-color: rgba(227, 112, 59, 0.6); }

  .apply-help { margin: 0; font-size: 0.78rem; color: var(--dim); line-height: 1.5; }
  .apply-error { margin: 0; font-size: 0.78rem; color: var(--bp-orange); }

  /* ─── Skills matrix ─── */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .skill-list { list-style: none; padding: 0; margin: 1.25rem 0 1.75rem; display: grid; gap: 0.3rem; }
  .skill {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    border: 1px solid transparent;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .skill:hover { background: rgba(255, 255, 255, 0.02); }
  .skill:not(.is-off) {
    background: rgba(98, 166, 219, 0.05);
    border-color: rgba(98, 166, 219, 0.18);
  }

  .skill-check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }
  .skill-check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .skill-box {
    width: 17px; height: 17px;
    flex: none;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 5px;
    position: relative;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .skill-check input:checked + .skill-box {
    background: var(--bp-blue);
    border-color: var(--bp-blue);
  }
  .skill-check input:checked + .skill-box::after {
    content: '';
    position: absolute;
    left: 5px; top: 1px;
    width: 4px; height: 9px;
    border: solid #07121d;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .skill-check input:focus-visible + .skill-box {
    box-shadow: 0 0 0 3px rgba(98, 166, 219, 0.3);
  }
  .skill:not(.is-off) .skill-name { color: var(--ink); }

  .skill-rate { display: flex; align-items: center; gap: 0.6rem; }

  /* Reverse order so `:checked ~ label` reaches the lower stars. */
  .skill-stars { display: flex; flex-direction: row-reverse; justify-content: flex-end; }
  .skill-star-input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .skill-star {
    display: inline-flex;
    padding: 2px;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.14);
    transition: color 0.12s ease, transform 0.12s ease;
  }
  .skill-star svg { width: 17px; height: 17px; fill: currentColor; }
  .skill-star-input:checked ~ .skill-star { color: var(--bp-blue); }
  .skill-star:hover { color: var(--bp-light); transform: scale(1.12); }
  .skill-star-input:focus-visible + .skill-star {
    outline: 2px solid rgba(98, 166, 219, 0.6);
    outline-offset: 1px;
    border-radius: 3px;
  }

  .is-off .skill-star { cursor: not-allowed; color: rgba(255, 255, 255, 0.07); }
  .is-off .skill-star:hover { transform: none; color: rgba(255, 255, 255, 0.07); }

  .skill-value {
    min-width: 3.4ch;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--bp-light);
  }

  .skill .apply-error { grid-column: 1 / -1; }

  @media (max-width: 560px) {
    .skill { grid-template-columns: minmax(0, 1fr); }
    .skill-rate { justify-content: space-between; }
  }

  /* Honeypot. Off-screen rather than display:none, which some bots skip. */
  .apply-botcheck {
    position: absolute !important;
    left: -9999px !important;
    width: 1px; height: 1px;
    opacity: 0;
  }

  .apply-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .apply-submit[disabled] { opacity: 0.6; cursor: progress; }
  .apply-required-note { margin: 0; font-size: 0.78rem; color: var(--dim); }

  .apply-formerror {
    margin: 1.1rem 0 0;
    padding: 0.85rem 1rem;
    border-left: 2px solid var(--bp-orange);
    background: rgba(227, 112, 59, 0.07);
    border-radius: 0 8px 8px 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .apply-formerror a { color: var(--bp-light); }

  /* ─── Success ─── */
  .apply-success { text-align: center; padding: clamp(1.5rem, 4vw, 3rem) 1rem; }
  .apply-success-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(98, 166, 219, 0.5);
    color: var(--bp-light);
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }
  .apply-success h3 {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 800;
    margin: 0 0 0.75rem;
  }
  .apply-success p {
    margin: 0 auto;
    max-width: 48ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  /* ─── Pending (no access key yet) ─── */
  .apply-pending {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    max-width: 640px;
    padding: 1.15rem 1.35rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.02);
  }
  .apply-pending p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .apply-pending a { color: var(--bp-light); }
  .apply-pending-dot {
    width: 7px; height: 7px; flex: none;
    margin-top: 0.5rem;
    border-radius: 50%;
    background: var(--dim);
  }

  @media (max-width: 640px) {
    .apply-rows { grid-template-columns: minmax(0, 1fr); }
    .apply-actions { flex-direction: column; align-items: stretch; }
    .apply-submit { justify-content: center; }
    .apply-required-note { text-align: center; }
  }
</style>
