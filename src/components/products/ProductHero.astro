---
// Detail-page hero for a single digital product.
//
// Same HUD family as the tier heroes (deep-space base, nebula, blueprint
// grid, vector chrome, big outlined numeral top-right, info LEFT and
// offer card RIGHT) so a product page reads as part of the same system.
// It is not the same component: the offer card here carries file-type
// chips and a status-aware buy control instead of a plain CTA link.
import BuyButton from './BuyButton.astro';
import type { Product } from '../../data/products';

interface Props { product: Product; }
const { product } = Astro.props;
const { hero } = product;

const topTicks = Array.from({ length: 19 }, (_, i) => 80 + i * 78);
---
<section class="prod-hero" aria-labelledby="prod-hero-title">
  <div class="prod-hero-base" aria-hidden="true"></div>
  <div class="prod-hero-nebula" aria-hidden="true"></div>
  <div class="prod-hero-grid" aria-hidden="true"></div>

  <svg class="prod-hud" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="hud-stroke" fill="none">
      <path d="M 24 64 L 24 24 L 64 24" />
      <path d="M 1536 24 L 1576 24 L 1576 64" />
      <path d="M 24 836 L 24 876 L 64 876" />
      <path d="M 1536 876 L 1576 876 L 1576 836" />
    </g>
    <g class="hud-stroke hud-orbits" fill="none">
      <circle cx="1780" cy="500" r="940" />
      <circle cx="1780" cy="500" r="780" />
      <circle cx="1780" cy="500" r="630" />
    </g>
    <g class="hud-stroke hud-radar" fill="none" transform="translate(320, 290)">
      <circle r="170" />
      <circle r="120" />
      <circle r="72" />
      <circle r="32" />
      <line x1="-200" y1="0" x2="200" y2="0" stroke-dasharray="2 9" />
      <line x1="0" y1="-200" x2="0" y2="200" stroke-dasharray="2 9" />
      <circle cx="118" cy="-72" r="10" />
      <circle cx="118" cy="-72" r="4" class="hud-marker-dot" />
    </g>
    <g class="hud-stroke hud-ticks" fill="none">
      {topTicks.map(x => <line x1={x} y1="10" x2={x} y2="24" />)}
      {topTicks.map(x => <line x1={x} y1="876" x2={x} y2="890" />)}
    </g>
    <line x1="280" y1="852" x2="1080" y2="852" class="hud-horizon" stroke-linecap="round" />
  </svg>

  <div class="prod-hud-marker" aria-hidden="true">
    <span class="prod-hud-bar"></span>
    <span class="prod-hud-marker-label">Tool</span>
    <span class="prod-hud-marker-number">{product.number}</span>
  </div>

  <div class="container prod-hero-inner">
    <div class="prod-hero-layout">
      <div class="prod-hero-left">
        <p class="label" data-reveal="left">{hero.eyebrow}</p>
        <h1 id="prod-hero-title" data-reveal>{product.name}</h1>
        <p class="prod-hero-positioning" data-reveal set:html={hero.headline}></p>
        <p class="prod-hero-sub" data-reveal>{hero.sub}</p>

        <ul class="prod-hero-pills" data-reveal-group>
          {hero.pills.map(p => <li class="prod-hero-pill" data-reveal>{p}</li>)}
        </ul>

        <div class="prod-hero-ctas" data-reveal>
          <BuyButton
            slug={product.slug}
            status={product.status}
            price={product.price}
          />
          <a href="/products" class="button ghost">All tools</a>
        </div>
      </div>

      <aside class="prod-offer-card" data-reveal aria-label={`${product.name} summary`}>
        <header class="prod-offer-head">
          <span class="prod-offer-num">{product.number}</span>
          <div class="prod-offer-id">
            <p class="prod-offer-label">Tool</p>
            <p class="prod-offer-name">{product.shortName}</p>
          </div>
        </header>

        <div class="prod-offer-divider" aria-hidden="true"></div>

        <div class="prod-offer-price">
          <span class="prod-offer-price-num">{product.price}</span>
          <span class="prod-offer-price-note">one-time · yours to keep</span>
        </div>

        <ul class="prod-offer-highlights">
          {hero.highlights.map(h => (
            <li>
              <strong>{h.value}</strong>
              <span>{h.unit}</span>
            </li>
          ))}
        </ul>

        <ul class="prod-offer-files" aria-label="File formats">
          {product.fileTypes.map(t => <li>{t}</li>)}
        </ul>

        <div class="prod-offer-cta">
          <BuyButton
            slug={product.slug}
            status={product.status}
            price={product.price}
            block
          />
        </div>

        <p class="prod-offer-foot">{product.formatNote}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .prod-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(540px, 66vh, 700px);
    display: flex;
    align-items: center;
    isolation: isolate;
  }

  .prod-hero-base {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 100%, rgba(38, 79, 160, 0.22), transparent 70%),
      linear-gradient(180deg, #050514 0%, #02020a 100%);
  }
  .prod-hero-nebula {
    position: absolute; inset: 0; z-index: 1;
    background:
      radial-gradient(ellipse 55% 65% at 88% 92%, rgba(150, 70, 210, 0.26), transparent 60%),
      radial-gradient(ellipse 70% 60% at 80% 60%, rgba(80, 40, 160, 0.13), transparent 70%);
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .prod-hero-grid {
    position: absolute; inset: 0; z-index: 2;
    background-image:
      linear-gradient(rgba(98, 166, 219, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(98, 166, 219, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(80% 80% at 50% 40%, #000 50%, transparent 100%);
    pointer-events: none;
  }

  .prod-hud { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; pointer-events: none; }
  .prod-hud :global(.hud-stroke) { stroke: rgba(98, 166, 219, 0.32); stroke-width: 1; }
  .prod-hud :global(.hud-orbits) { stroke: rgba(98, 166, 219, 0.18); }
  .prod-hud :global(.hud-radar)  { stroke: rgba(98, 166, 219, 0.28); }
  .prod-hud :global(.hud-ticks)  { stroke: rgba(98, 166, 219, 0.4); }
  .prod-hud :global(.hud-marker-dot) { fill: var(--bp-blue); }
  .prod-hud :global(.hud-horizon) {
    stroke: rgba(98, 166, 219, 0.55);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 4px rgba(98, 166, 219, 0.6));
  }

  .prod-hud-marker {
    position: absolute;
    top: 2.5rem;
    right: clamp(1.5rem, 4vw, 3.5rem);
    z-index: 4;
    display: grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: 0.5rem 0.75rem;
    pointer-events: none;
  }
  .prod-hud-bar { width: 26px; height: 1px; background: var(--bp-blue); grid-row: 2; grid-column: 1; }
  .prod-hud-marker-label {
    grid-row: 2; grid-column: 2;
    font-family: var(--font-display);
    color: var(--bp-blue);
    font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.32em; text-transform: uppercase;
  }
  .prod-hud-marker-number {
    grid-row: 1 / 3; grid-column: 3;
    font-family: var(--font-display);
    font-size: clamp(6rem, 11vw, 11rem);
    font-weight: 900; line-height: 0.85; letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(98, 166, 219, 0.22);
    margin-left: 0.25rem;
  }

  .prod-hero-inner {
    position: relative; z-index: 5; width: 100%;
    padding: 7rem 1.5rem 3rem;
    max-width: var(--max-width);
  }
  .prod-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .prod-hero-left h1 {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.7vw, 2.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0.5rem 0 0.9rem;
  }
  .prod-hero-positioning {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
    margin: 0 0 0.85rem;
    max-width: 30ch;
  }
  .prod-hero-sub {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
    max-width: 46ch;
    margin: 0 0 1.5rem;
  }

  .prod-hero-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 1.75rem;
  }
  .prod-hero-pill {
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--bp-light);
    background: rgba(98, 166, 219, 0.08);
    border: 1px solid rgba(98, 166, 219, 0.22);
    border-radius: 999px;
    padding: 0.38rem 0.8rem;
  }

  .prod-hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }

  /* ─── Offer card ─── */
  .prod-offer-card {
    background: linear-gradient(180deg, rgba(26, 28, 40, 0.92), rgba(14, 15, 24, 0.92));
    border: 1px solid rgba(98, 166, 219, 0.22);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 2.6vw, 2.1rem);
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(6px);
  }
  .prod-offer-head { display: flex; align-items: center; gap: 1rem; }
  .prod-offer-num {
    font-family: var(--font-display);
    font-size: 2.1rem; font-weight: 900; line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.2px rgba(98, 166, 219, 0.7);
  }
  .prod-offer-label {
    font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--dim); margin: 0 0 0.15rem;
  }
  .prod-offer-name { font-weight: 700; margin: 0; font-size: 1.02rem; }
  .prod-offer-divider { height: 1px; background: var(--line); margin: 1.15rem 0; }

  .prod-offer-price { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .prod-offer-price-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    font-weight: 900; line-height: 1;
  }
  .prod-offer-price-note { color: var(--muted); font-size: 0.82rem; }

  .prod-offer-highlights {
    list-style: none; padding: 0;
    margin: 1.35rem 0 1.1rem;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1rem;
  }
  .prod-offer-highlights li { min-width: 0; overflow-wrap: break-word; }
  .prod-offer-highlights strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem; color: var(--bp-light); line-height: 1.1;
  }
  .prod-offer-highlights span { font-size: 0.78rem; color: var(--muted); }

  .prod-offer-files {
    list-style: none; padding: 0; margin: 0 0 1.35rem;
    display: flex; flex-wrap: wrap; gap: 0.4rem;
  }
  .prod-offer-files li {
    font-family: var(--font-display);
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
  }

  .prod-offer-cta { display: flex; }
  .prod-offer-foot {
    margin: 0.9rem 0 0;
    text-align: center;
    font-size: 0.76rem;
    color: var(--dim);
  }

  @media (max-width: 900px) {
    .prod-hero-layout { grid-template-columns: minmax(0, 1fr); }
    .prod-hero-inner { padding: 6rem 1.5rem 3rem; }
    /* The "Tool" label sits at the same height as the eyebrow once the
       layout is single-column, so drop it and keep only the numeral,
       which reads as chrome rather than colliding with the copy. */
    .prod-hud-marker { top: 1.25rem; opacity: 0.7; }
    .prod-hud-bar,
    .prod-hud-marker-label { display: none; }
  }
  @media (max-width: 600px) {
    .prod-hero-inner { padding: 5rem 1.25rem 2.5rem; }
    .prod-hero-left h1 { font-size: clamp(1.5rem, 7vw, 2rem); }
    .prod-hero-ctas { width: 100%; }
    .prod-hero-ctas > :global(*) { flex: 1 1 100%; justify-content: center; }
    .prod-offer-highlights { gap: 0.75rem; }
  }
</style>
