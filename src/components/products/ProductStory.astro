---
// The long-form sell: lead prose, then the named points that carry
// the argument. Headline stays white per the site accent policy
// (colour punctuates on Hero / Who It's For / FAQ only).
import type { Product } from '../../data/products';

interface Props { product: Product; }
const { product } = Astro.props;
const { story } = product;
---
<section class="section prod-story" id="why">
  <div class="container">
    <div class="prod-story-head">
      <p class="label" data-reveal="left">Why it exists</p>
      <h2 data-reveal>{story.headline}</h2>
    </div>

    <div class="prod-story-body">
      <div class="prod-story-prose">
        {story.paragraphs.map(p => <p data-reveal>{p}</p>)}
      </div>

      <ol class="prod-story-points" data-reveal-group>
        {story.points.map((point, i) => (
          <li class="prod-point card-trace card-inner-glow" data-reveal>
            <span class="prod-point-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .prod-story { position: relative; }
  .prod-story-head { margin-bottom: 2.5rem; }
  .prod-story-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0.5rem 0 0;
    max-width: 22ch;
  }

  .prod-story-body {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .prod-story-prose p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75;
    margin: 0 0 1.1rem;
  }
  .prod-story-prose p:first-child {
    color: var(--ink);
    font-size: 1.08rem;
  }
  .prod-story-prose p:last-child { margin-bottom: 0; }

  .prod-story-points { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .prod-point {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    --trace-color: var(--bp-blue);
  }
  .prod-point:nth-child(2) { --trace-color: var(--bp-orange); }
  .prod-point:nth-child(3) { --trace-color: #9b7ce0; }
  .prod-point:nth-child(4) { --trace-color: var(--bp-light); }

  .prod-point-num {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--trace-color, var(--bp-blue));
    opacity: 0.8;
    padding-top: 0.18rem;
  }
  .prod-point h3 {
    font-size: 1.02rem;
    font-weight: 700;
    margin: 0 0 0.45rem;
    line-height: 1.3;
  }
  .prod-point p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .prod-story-body { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  }
  @media (max-width: 600px) {
    .prod-point { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; padding: 1.25rem; }
  }
</style>
