---
// NOTE: Astro's ClientRouter (view transitions) was intentionally removed.
// It was the root of repeated, hard-to-reproduce lightbox/navigation freezes:
// the persisted full-screen canvas + lightbox dialogs conflicted with the
// transition's compositor, and a stalled transition could strand a page with
// dead navigation. Every navigation is now a clean full page load — each
// page's scripts initialise from scratch (via DOMContentLoaded), so there is
// no persisted state, no stuck transition, and nothing to leak across pages.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpaceBackground from '../components/SpaceBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Blueprint Marketing builds growth systems for EDM artists, turning content, shows, and releases into real fans and real revenue.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href="/brand/icon-white.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Roboto:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <SpaceBackground />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/motion.client.ts';
    </script>
  </body>
</html>
