---
// Chrome for the client portal.
//
// Deliberately NOT the marketing Layout, and deliberately NOT
// global.css. The marketing site is a dark theme whose :root sets a
// near-black background and a near-white --ink; the portal is light,
// so importing it would mean fighting it on every element. portal.css
// carries its own token set and is self-contained.
//
// It is also global rather than scoped, because almost everything in
// the portal is built by client-side JS from the Notion payload and
// Astro's scoped styles only reach nodes that exist at build time.
import '../styles/portal.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en" class="pt-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f9fc" />
    <!-- Never indexed. noindex rather than a robots.txt Disallow on
         purpose: a disallowed path cannot be crawled, so a search engine
         never sees the noindex and an already-known URL can linger in
         results. The same value is also sent as an X-Robots-Tag header
         by every /portal route. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href="/brand/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Roboto:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="pt">
    <slot />
  </body>
</html>
