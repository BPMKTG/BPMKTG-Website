# Cloudflare Pages — caching headers.
#
# Everything under /_astro/ is content-hashed by Astro (the hash is in the
# filename, e.g. index.D3CamDhX.css), so a new build always emits new
# filenames. That makes these assets safe to cache forever. Without this,
# Cloudflare Pages serves them with `max-age=0, must-revalidate`, forcing a
# revalidation round-trip on every visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand SVGs/icons and video files are NOT content-hashed, so they can't be
# "immutable" — cache for a week and revalidate. Long enough to help repeat
# visits, short enough that a replacement propagates quickly.
/brand/*
  Cache-Control: public, max-age=604800
/videos/*
  Cache-Control: public, max-age=604800

# Favicon
/favicon.ico
  Cache-Control: public, max-age=604800
