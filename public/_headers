# Cloudflare Pages — caching headers.
#
# Everything under /_astro/ is content-hashed by Astro (the hash is in the
# filename, e.g. index.D3CamDhX.css), so a new build always emits new
# filenames. That makes these assets safe to cache forever. Without this,
# Cloudflare Pages serves them with `max-age=0, must-revalidate`, forcing a
# revalidation round-trip on every visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand SVGs/icons and video files are NOT content-hashed, so they can't be
# "immutable" — cache for a week and revalidate. Long enough to help repeat
# visits, short enough that a replacement propagates quickly.
/brand/*
  Cache-Control: public, max-age=604800
/videos/*
  Cache-Control: public, max-age=604800

# Favicon and the app tile. Same reasoning as /brand: not content-hashed,
# so a week rather than immutable. A returning visitor keeps the old mark
# until this lapses, which is the cost of a stable filename.
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# Client portal. Never indexed, never cached by a shared cache, and no
# referrer so a portal URL (which carries the client's slug) is not sent
# to any site a client clicks through to. The Functions under
# /portal/ set the same headers on their own responses; this covers the
# static shell asset at /portal/ itself.
/portal/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# Rebelz Cheer picture day. Unlisted but public: handed out as a link in
# a team group text, so unlike /portal it SHOULD be cached and its link
# preview should work. Only the indexing rule is shared.
# Both spellings: the built page is /picture-day/index.html, so a
# visitor can land on either and a rule for one does not cover the other.
/picture-day
  X-Robots-Tag: noindex, nofollow
/picture-day/
  X-Robots-Tag: noindex, nofollow
