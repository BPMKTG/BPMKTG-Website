# Local secrets for `wrangler pages dev`. Copy to .dev.vars and fill in.
# .dev.vars is gitignored; this example file is not.
#
# Notion integration token. The integration must be shared with BOTH the
# Artist Intake and Clients databases, or every write 404s.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Set to get an email when an intake lands. Omit to skip.
WEB3FORMS_KEY=

# Optional. Signs client-portal session cookies. Any random string of 16+
# characters. When unset the portal falls back to signing with
# NOTION_TOKEN, which works fine; the only difference is that rotating the
# Notion token then signs every client out.
PORTAL_SECRET=

# Needed for client-portal sign-in. Without it no code is ever sent and
# nobody can log in. Get one from Resend, with sending access on a
# verified domain. See docs/PORTAL_SETUP.md for the DNS records.
RESEND_API_KEY=

# Comma-separated. These addresses can sign in to EVERY client portal,
# and their writes are stamped Blueprint rather than Client.
ADMIN_EMAILS=

# Optional. The From line on a sign-in code. Must be a verified sender
# on the Resend account. Defaults to the one in src/server/portal-login.ts.
PORTAL_MAIL_FROM=

# ── Reports and audits (see docs/REPORTS_SETUP.md) ──────────────────

# Signs the ten-minute token the PDF renderer uses to open /print/*.
# Any random string of 16+ characters. When unset the print routes fall
# back to the same secret the portal session uses, which works; the only
# difference is that rotating one rotates both.
PRINT_SIGNING_SECRET=

# Browser Rendering, reached over its REST API rather than a binding:
# Pages Functions cannot bind it. The token needs Browser Rendering
# Edit and nothing else. Without both of these, Preview still works
# and Publish answers 503.
CF_ACCOUNT_ID=
CF_BROWSER_TOKEN=

# The Drive service account that reads each client's Report Covers
# folder, as the whole JSON key file on one line. Optional: without it
# the cover falls back to the Clients row's Hero Photo, and then to the
# blue grid. Scope is drive.readonly. See docs/REPORTS_SETUP.md for
# making one and for the Workspace sharing setting.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Not a variable. REPORTS_BUCKET (R2) is a BINDING, so it cannot live
# in this file. `wrangler pages dev` takes it as a flag, and in the
# cloud it is set in the Pages dashboard:
#
#   wrangler pages dev dist --r2 REPORTS_BUCKET=bpmktg-reports
#
# Browser Rendering renders by fetching a URL, so it cannot reach a
# localhost origin. Test Preview and Publish against a deployment.
